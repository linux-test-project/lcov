#   the Free Software Foundation; either version 2 of the License, or (at
#   your option) any later version.
#
#   This program is distributed in the hope that it will be useful, but
#   WITHOUT ANY WARRANTY;  without even the implied warranty of
#   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
#   General Public License for more details.
#
#   You should have received a copy of the GNU General Public License
#   along with this program;  if not, see
#   <http://www.gnu.org/licenses/>.
#
#
# geninfo
#
#   This script generates .info files from data files as created by code
#   instrumented with gcc's built-in profiling mechanism. Call it with
#   --help and refer to the geninfo man page to get information on usage
#   and available options.
#
#
# Authors:
#   2002-08-23 created by Peter Oberparleiter <Peter.Oberparleiter@de.ibm.com>
#                         IBM Lab Boeblingen
#        based on code by Manoj Iyer <manjo@mail.utexas.edu> and
#                         Megan Bock <mbock@us.ibm.com>
#                         IBM Austin
#   2002-09-05 / Peter Oberparleiter: implemented option that allows file list
#   2003-04-16 / Peter Oberparleiter: modified read_gcov so that it can also
#                parse the new gcov format which is to be introduced in gcc 3.3
#   2003-04-30 / Peter Oberparleiter: made info write to STDERR, not STDOUT
#   2003-07-03 / Peter Oberparleiter: added line checksum support, added
#                --no-checksum
#   2003-09-18 / Nigel Hinds: capture branch coverage data from GCOV
#   2003-12-11 / Laurent Deniel: added --follow option
#                workaround gcov (<= 3.2.x) bug with empty .da files
#   2004-01-03 / Laurent Deniel: Ignore empty .bb files
#   2004-02-16 / Andreas Krebbel: Added support for .gcno/.gcda files and
#                gcov versioning
#   2004-08-09 / Peter Oberparleiter: added configuration file support
#   2008-07-14 / Tom Zoerner: added --function-coverage command line option
#   2008-08-13 / Peter Oberparleiter: modified function coverage
#                implementation (now enabled per default)
#   July 2020 /  Henry Cox: henry.cox@mediatek.com
#                Refactor to use common lcovutil package.
#                Add filters to suppress certain line and branch coverpoints
#   Sept 2020 /  Henry Cox:  modify to use common lcov package for coverage
#                data representation.

use strict;
use warnings;
use File::Basename qw(basename dirname fileparse);
use File::Spec::Functions qw /abs2rel catdir file_name_is_absolute splitdir
                              splitpath catpath catfile/;
use File::Temp;
use File::Copy qw(copy move);
use File::Path;
use Cwd qw/abs_path getcwd realpath/;
use Time::HiRes;    # for profiling
use Capture::Tiny;
use FindBin;
use Storable;
use POSIX;

# Windows path handling - see comment in jacoco2lcov
use lib "$FindBin::RealBin/../lib",
    do { (my $d = $0) =~ s{\\}{/}g; $d =~ s{[^/]*$}{}; $d . '../lib' };
use lcovutil qw (define_errors parse_ignore_errors
                 $tool_name $tool_dir $lcov_version $lcov_url
                 ignorable_error ignorable_warning is_ignored
                 set_info_callback info init_verbose_flag $verbose
                 debug $debug
                 $br_coverage $func_coverage
                 system_no_output $devnull $dirseparator
                 die_handler warn_handler
                 parse_cov_filters summarize_cov_filters
                 $EXCL_START $EXCL_STOP $EXCL_BR_START $EXCL_BR_STOP
                 $EXCL_EXCEPTION_BR_START $EXCL_EXCEPTION_BR_STOP
                 $EXCL_CALLGRAPH_START $EXCL_CALLGRAPH_STOP
                 $EXCL_LINE $EXCL_BR_LINE $EXCL_EXCEPTION_LINE $EXCL_CALLGRAPH_LINE

                 %excluded_files
                 warn_file_patterns
                 @extractVersionScript

                 $ERROR_GCOV $ERROR_GRAPH $ERROR_PACKAGE $ERROR_CHILD
                 $ERROR_EMPTY $ERROR_PARALLEL $ERROR_UNSUPPORTED $ERROR_PATH
                 $ERROR_INCONSISTENT_DATA $ERROR_UTILITY $ERROR_FORMAT
                 report_parallel_error check_parent_process
                 summarize_messages
                 is_external @internal_dirs
                 parseOptions
                 @comments
                 $maxParallelism init_parallel_params $maxMemory
                );

our @gcov_tool;

# Constants

use constant {
              GCOV_VERSION_8_0_0 => 0x80000,
              GCOV_VERSION_4_7_0 => 0x40700,
              GCOV_VERSION_4_2_0 => 0x40200,
};

# Compatibility mode values
our $COMPAT_VALUE_OFF  = 0;
our $COMPAT_VALUE_ON   = 1;
our $COMPAT_VALUE_AUTO = 2;

# Compatibility mode value names
our %COMPAT_NAME_TO_VALUE = ("off"  => $COMPAT_VALUE_OFF,
                             "on"   => $COMPAT_VALUE_ON,
                             "auto" => $COMPAT_VALUE_AUTO,);

# Compatibility modes
our $COMPAT_MODE_LIBTOOL   = 1 << 0;
our $COMPAT_MODE_HAMMER    = 1 << 1;
our $COMPAT_MODE_SPLIT_CRC = 1 << 2;

# Compatibility mode names
our %COMPAT_NAME_TO_MODE = ("libtool"       => $COMPAT_MODE_LIBTOOL,
                            "hammer"        => $COMPAT_MODE_HAMMER,
                            "split_crc"     => $COMPAT_MODE_SPLIT_CRC,
                            "android_4_4_0" => $COMPAT_MODE_SPLIT_CRC,);

# Map modes to names
our %COMPAT_MODE_TO_NAME = ($COMPAT_MODE_LIBTOOL   => "libtool",
                            $COMPAT_MODE_HAMMER    => "hammer",
                            $COMPAT_MODE_SPLIT_CRC => "split_crc",);

# Compatibility mode default values
our %COMPAT_MODE_DEFAULTS = ($COMPAT_MODE_LIBTOOL   => $COMPAT_VALUE_ON,
                             $COMPAT_MODE_HAMMER    => $COMPAT_VALUE_AUTO,
                             $COMPAT_MODE_SPLIT_CRC => $COMPAT_VALUE_AUTO,);

# Compatibility mode auto-detection routines
our %COMPAT_MODE_AUTO = ($COMPAT_MODE_HAMMER    => 0,    # no gcc/3.3 support
                         $COMPAT_MODE_SPLIT_CRC => 1,    # will be done later
);

our $trace_data;

# Prototypes
sub print_usage(*);
sub gen_info(@);
sub process_dafile($$$$);
sub match_filename($@);
sub solve_ambiguous_match($$$);
sub split_filename($);
sub solve_relative_path($$);
sub compute_internal_directories(@);
sub read_gcov_header($);
sub read_gcov_file($$$$$);
sub attach_to_statements($$$$$$;$);
sub block_graph($);
sub my_info(@);
set_info_callback(\&my_info);
sub process_intermediate($$$$);
sub map_llvm_version($);
sub version_to_str($);
sub get_gcov_version();
sub process_graphfile($$);
sub filter_fn_name($$);
sub filter_fn_name_list($$);
sub demangle_name_list($);
sub read_callgraph_info($);
sub _cached_callgraph_info($);
sub _parse_callgraph_info($);
sub _pack_callgraph_info($);
sub _unpack_callgraph_info($);
sub read_declaration_file($$);
sub declaration_is_pure($$);
sub pure_declarations($$);
sub arc_location($);
sub some_locations($);
sub pairing_file_key($);
sub join_call_sites($$$);
sub graph_error($$);
sub graph_read(*$;$$);
sub graph_skip(*$;$);
sub uniq(@);
sub sort_uniq(@);
sub graph_cleanup($);
sub graph_find_base($);
sub graph_from_bb($$$$);
sub graph_add_order($$$);
sub read_gcno_word(*;$$);
sub read_gcno_value(*$;$$);
sub read_gcno_string(*$);
sub read_gcno_lines_record(*$$$$$$);
sub read_gcno_function_record(*$$$$$);
sub read_gcno($);
sub get_gcov_capabilities();
sub int_handler();
sub compat_name($);
sub parse_compat_modes($);
sub is_compat($);
sub which($);

# Global variables
our $gcov_version;
our $gcov_version_string;
our $graph_file_extension = '.gcno';
our $data_file_extension  = '.gcda';
# Where join_call_sites() leaves its result:  a key in gcov's own per-file JSON
# hash, holding the finished call sites of that file.  It travels with the file
# data rather than beside it, so that renaming the file
# (adjust_source_filenames) or dropping it (filter_source_files) takes the
# file's call sites along with it
our $callSiteKey = 'lcov_call_sites';
# ..and where the linkage half of the same data goes:  the set of symbols this
# translation unit defines with external linkage, keyed by mangled name, which
# is the only spelling the callgraph info has.  One table per unit, shared by
# every file of it - a symbol's linkage is a property of the symbol, and the
# unit is the scope the compiler told us about it in
our $externalKey = 'lcov_external_symbols';
# ..and where the calls which could not be written as call sites go:  the set of
# symbols called from a site this format cannot express, again keyed by mangled
# name and again one table per unit.  A call gcov placed in a file it described
# nothing else about is such a site - see join_call_sites() - and all that
# survives it is that the callee was called from somewhere the report cannot name
our $externalCallersKey = 'lcov_external_callers';
our @data_directory;
our $buildDirSearchPath;
our $test_name = "";
our $output_filename;
our $single_file;                 # Write result into single merged file or not
our $files_created = 0;           # Number of output files created
our $base_directory;
our $opt_no_compat_libtool;
our $initial;
our $no_recursion = 0;
our $maxdepth;
our $no_markers = 0;
our $gcov_caps;
our %compat_value;
our $intermediate;
our $intervalMonitor;             # class for progress reporting
our $totalChildCpuTime    = 0;
our $intervalChildCpuTime = 0;    # since last update

# for performance tweaking/tuning
# $defaultChunkSize and $defaultInterval held in $lcovutil - so they
# can be set from command line/RC file processing.
our @large_files;
# $callFromLcov is set when lcov calls geninfo, then:
#   - picked up from --rc (in geninfo)
#   - written to the profile file (in the command line section
#   - then found by 'spreadsheet.py' - which can then do a better job of
#     figuring out who called what
our $callFromLcov;

our $cwd = getcwd();
chomp($cwd);

lcovutil::save_cmd_line(\@ARGV, $lcovutil::tool_dir);

#
# Code entry point
#

# Register handler routine to be called when interrupted
$SIG{"INT"}    = \&int_handler;
$SIG{__WARN__} = \&warn_handler;
$SIG{__DIE__}  = \&die_handler;

# Set LC_ALL so that gcov output will be in a unified format
$ENV{"LC_ALL"} = "C";

# retrieve settings from RC file - use these if not overridden on command line
my %geninfo_opts = ("test-name|t=s"       => \$test_name,
                    'call-from-lcov'      => \$callFromLcov,
                    "output-filename|o=s" => \$output_filename,
                    "base-directory|b=s"  => \$base_directory,
                    "follow|f"            => \$lcovutil::opt_follow,
                    "compat-libtool"      => \$lcovutil::opt_compat_libtool,
                    "no-compat-libtool"   => \$opt_no_compat_libtool,
                    "gcov-tool=s"         => \@gcov_tool,
                    "initial|i"           => \$initial,
                    "all"                 => \$lcovutil::geninfo_captureAll,
                    "no-recursion"        => \$no_recursion,
                    "no-markers"          => \$no_markers,
                    "external|e"          => \$lcovutil::opt_external,
                    "no-external"         => \$lcovutil::opt_no_external,
                    "compat=s"            => \$lcovutil::geninfo_opt_compat,
                    'large-file=s'        => \@large_files);

# Parse command line options
if (!lcovutil::parseOptions(\%lcovutil::geninfo_rc_opts, \%geninfo_opts,
                            \$output_filename)) {
    print(STDERR "Use $tool_name --help to get usage information\n");
    exit(1);
}

@gcov_tool = @lcovutil::rc_gcov_tool unless @gcov_tool;
# translate windows paths, if necessary
lcovutil::posix_paths(\$base_directory, \@gcov_tool);

$buildDirSearchPath =
    SearchPath->new('build directory', @lcovutil::build_directory);

eval {
    map { qr($_) } @large_files;
};
die("invalid 'large-file' regexp: $@")
    if ($@);

if ($lcovutil::geninfo_captureAll && $initial) {
    lcovutil::ignorable_error($lcovutil::ERROR_USAGE,
                              "'--all' ignored when '--initial' is used");
    $lcovutil::geninfo_captureAll = undef;
}

# Merge options
if (defined($opt_no_compat_libtool)) {
    $lcovutil::opt_compat_libtool = ($opt_no_compat_libtool ? 0 : 1);
    $opt_no_compat_libtool        = undef;
}

if (defined($lcovutil::opt_external)) {
    $lcovutil::opt_no_external = !$lcovutil::opt_external;
    $lcovutil::opt_external    = undef;
}

my $start = Time::HiRes::gettimeofday();

@data_directory = @ARGV;

debug("$lcov_version\n");

if (0 == scalar(@gcov_tool)) {
    # not specified - use gcov by default - expected to be in user's path
    push(@gcov_tool, 'gcov');
} else {
    @gcov_tool =
        split($lcovutil::split_pattern,
              join($lcovutil::split_char, @gcov_tool));
    my $tool = $gcov_tool[0];
    my (undef, $dir, $file) = splitpath($tool);

    if ($dir eq "") {
        $tool = which($tool);
    } elsif (!file_name_is_absolute($tool)) {
        $tool = abs_path($tool);
    }
    unless (defined($tool) && -x $tool) {
        die("cannot access gcov tool '$gcov_tool[0]'");
    }
    $gcov_tool[0] = $tool;
    if (scalar(@gcov_tool) > 1) {
        foreach my $e (@gcov_tool) {
            $e = "'$e'" if ($e =~ /\s/);
        }
    }
}
if (scalar(@lcovutil::extractVersionScript) > 1) {
    foreach my $e (@lcovutil::extractVersionScript) {
        $e = "'$e'" if ($e =~ /\s/);
    }
}

# Check gcov tool
if (system_no_output(3, @gcov_tool, "--help") == -1) {
    die("failed execution of gcov_tool \"" .
        join(' ', @gcov_tool) . " --help\": $!");
}

($gcov_version, $gcov_version_string) = get_gcov_version();
$gcov_caps = get_gcov_capabilities();

# Determine intermediate mode
if ($lcovutil::rc_intermediate eq "0") {
    $intermediate = 0;
} elsif ($lcovutil::rc_intermediate eq "1") {
    $intermediate = 1;
} elsif (lc($lcovutil::rc_intermediate) eq "auto") {
    # Use intermediate format if supported by gcov and not conflicting with
    # exception branch exclusion
    $intermediate = (($gcov_caps->{'intermediate-format'} &&
                          !$lcovutil::exclude_exception_branch) ||
                         $gcov_caps->{'json-format'}) ? 1 : 0;
} else {
    die("invalid value for geninfo_intermediate: " .
        "'$lcovutil::rc_intermediate'\n");
}

if ($gcov_version >= (9 << 16) &&
    !$intermediate) {
    lcovutil::ignorable_error($ERROR_UNSUPPORTED,
        "geninfo does not support text format for gcov/9 or higher (your version appears to be '$gcov_version_string').\n  Please remove config file entry 'geninfo_intermediate = 0'."
    );
    $intermediate = 1;
}

if ($intermediate) {
    info("Using intermediate gcov format\n");
    if ($lcovutil::exclude_exception_branch && !$gcov_caps->{'json-format'}) {
        die("excluding exception branches is not compatible with " .
            "text intermediate format\n");
    }
}

# Determine gcov options
push(@gcov_tool, "-b")
    if ($gcov_caps->{'branch-probabilities'} &&
        ($lcovutil::br_coverage ||
         $lcovutil::func_coverage ||
         $lcovutil::opt_adjust_unexecuted_blocks));
push(@gcov_tool, "-c")
    if ($gcov_caps->{'branch-counts'} &&
        $lcovutil::br_coverage);
push(@gcov_tool, "-a")
    if ($gcov_caps->{'all-blocks'} &&
        $lcovutil::opt_gcov_all_blocks &&
        $lcovutil::br_coverage         &&
        !$intermediate);
if ($gcov_caps->{'hash-filenames'}) {
    push(@gcov_tool, "-x");
} else {
    push(@gcov_tool, "-p") if ($gcov_caps->{'preserve-paths'});
}
push(@gcov_tool, '-i') if $intermediate;
# Read the JSON from gcov's stdout rather than from the '.gcov.json.gz' file it
#   would otherwise write:  the same data, without compressing it only to
#   decompress it again.  '--preserve' is asking for the file, so it gets it
our $gcov_stdout =
    ($intermediate &&
     $gcov_caps->{'json-format'} &&
     $gcov_caps->{stdout}        &&
     !$lcovutil::preserve_intermediates);
push(@gcov_tool, '--stdout') if $gcov_stdout;

if ($lcovutil::mcdc_coverage) {
    if ($gcov_caps->{'conditions'}) {
        push(@gcov_tool, '--conditions');
    } else {
        $lcovutil::mcdc_coverage = 0;
        lcovutil::ignorable_error($lcovutil::ERROR_USAGE,
            "MC/DC coverage enabled but \"$gcov_tool[0]\" does not support the '--conditions' option."
        );
    }
}

if ($lcovutil::callgraph_coverage &&
    $gcov_version < (14 << 16)) {
    # Callgraph coverage needs the compiler's static call graph and gcov's
    #   count for each call it makes.  '-fcallgraph-info' is a gcc/10 feature,
    #   but the counts are the per-line 'calls' entries of gcov's JSON format
    #   version 2, which is gcov/14 - see join_call_sites.  An older gcov has
    #   nothing to pair the edges with, so every one of them would be unpaired.
    # Also need gcov's JSON format output and support for the '-b' flag.
    #   Both must be present by this point - or we would have errored out
    #   above.
    $lcovutil::callgraph_coverage = 0;
    my $msg =
        "--callgraph-coverage requires gcov 14 or later for the call counts" .
        " paired with '-fcallgraph-info' data (your version appears to be" .
        " '$gcov_version_string').";
    lcovutil::ignorable_error($lcovutil::ERROR_UNSUPPORTED, $msg);
}

# Determine compatibility modes
parse_compat_modes($lcovutil::geninfo_opt_compat);

if ($no_markers) {
    lcovutil::ignorable_error($lcovutil::ERROR_USAGE,
                   "use new '--filter' option or old '--no-markers' - not both")
        if (@lcovutil::opt_filter);
} elsif (!@lcovutil::opt_filter) {
    # don't apply the backward-compatible options if user specifies any filters
    lcovutil::info(1,
        "$lcovutil::tool_name:  applying '--filter region,branch_region,callgraph_region' by default - see the '--no-markers' section in the man page for more information.\n"
    );
    push(@lcovutil::opt_filter, "region");
    push(@lcovutil::opt_filter, "branch_region") if $br_coverage;
    push(@lcovutil::opt_filter, "callgraph_region")
        if $lcovutil::callgraph_coverage;
} else {
    lcovutil::info(
        "Note: 'region', 'branch_region' and 'callgraph_region' filters are not applied by default when '--filter' is specified.  See the '--no-markers section in the man page for more information.\n"
    ) unless grep({ /region/ } @lcovutil::opt_filter);
}
parse_cov_filters(@lcovutil::opt_filter);

# Make sure test names only contain valid characters
if ($test_name =~ s/\W/_/g) {
    lcovutil::ignorable_warning($lcovutil::ERROR_FORMAT,
                                "invalid characters removed from testname");
}

# Adjust test name to include uname output if requested
if ($lcovutil::geninfo_adjust_testname) {
    # POSIX::uname, not a forked 'uname -a':  there is no 'uname' on a native
    #   Windows Perl, and it returns the same fields in the same order
    $test_name .= '__' . join(' ', POSIX::uname());
    $test_name =~ s/\W/_/g;
}

# Make sure base_directory contains an absolute path specification
if ($base_directory) {
    $base_directory = solve_relative_path($cwd, $base_directory);
    push(@ReadCurrentSource::source_directories, $base_directory);
}

# Determine checksum mode - normalize to boolean
$lcovutil::verify_checksum =
    defined($lcovutil::verify_checksum) && $lcovutil::verify_checksum;

# Determine max depth for recursion
if ($no_recursion) {
    $maxdepth = "-maxdepth 1";
} else {
    $maxdepth = "";
}

# Check for directory name
if (!@data_directory) {
    die("No directory specified\n" .
        "Use $tool_name --help to get usage information\n");
} else {
    my @dirs;
    foreach my $arg (@data_directory) {
        # handle windows path...
        my $pattern = lcovutil::posix_path($arg);
        if (-d $pattern) {
            $pattern =~ s#$lcovutil::dirseparator_re$##;    # trailing slash
            push(@dirs, $pattern);
            next;
        }
        $pattern =~ s/([^\\]) /$1\\ /g          # explicitly escape spaces
            unless $^O =~ /Win/;

        my @glob = glob($pattern);

        my $count = 0;
        foreach (@glob) {

            stat($_);
            if (!-r _) {
                ignorable_error($ERROR_GCOV, "cannot read $_!");
            } else {
                push(@dirs, $_);
                $count++;
            }
        }
        if (0 == $count) {
            ignorable_error($ERROR_EMPTY, "$pattern does not match anything.");
        }
    }
    @data_directory = @dirs;
}

if ($gcov_version < GCOV_VERSION_4_2_0) {
    die("Your toolchain version is too old and is no longer supported by lcov.  Please upgrade - or use an older lcov release."
    );
}

# Check output filename
$single_file = defined($output_filename);

# use absolute path: we change directories while processing files
$output_filename = catfile($cwd, $output_filename)
    if (defined($output_filename) &&
        ($output_filename ne "-") &&
        !file_name_is_absolute($output_filename));

# Build list of directories to identify external files
compute_internal_directories(@data_directory, $base_directory);

if ($initial && $lcovutil::br_coverage && !$intermediate) {
    lcovutil::ignorable_error($lcovutil::ERROR_USAGE,
        "--initial cannot generate branch coverage data with this compiler/toolchain version."
    );
    $lcovutil::br_coverage = 0;
}

lcovutil::ignorable_error($lcovutil::ERROR_USAGE,
                "--fail_under_lines not supported unless output file specified")
    if (defined($lcovutil::fail_under_lines) && !$single_file);

# where to write parallel child data
my $tempFileDir =
    File::Temp->newdir("geninfo_datXXXX",
                       DIR     => $lcovutil::tmp_dir,
                       CLEANUP => !defined($lcovutil::preserve_intermediates));

lcovutil::info("Writing temporary data to $tempFileDir\n");
# ..and under it, the parsed callgraph info of the capture, keyed by the file's
#   identity - see _cached_callgraph_info()
my $callgraphCacheDir;
# Do something
my $processedFiles = 0;
my $exit_code      = 0;
# gen_info() accumulates into the file-scope $processedFiles internally and
# returns the running total; use assignment (not +=) to avoid double-counting
eval { $processedFiles = gen_info(@data_directory); };
if ($@) {
    $exit_code = 1;
    print(STDERR $@);
}

if (0 == $exit_code) {
    eval {
        my $now = Time::HiRes::gettimeofday();
        # have to check the loaded input data for exclusion markers because the
        #  data was generated directly from the gcov files - did not go through
        #  TraceFile::load which explicitly checks
        if ($single_file && defined($trace_data)) {
            $trace_data->applyFilters();
            # ..and only now, with every object merged and filtered, is it known
            #   whether this run captured any call site at all
            $trace_data->dropUnmeasurableCallgraph();
            my $f = Time::HiRes::gettimeofday();
            $trace_data->add_comments(@lcovutil::comments);
            $trace_data->write_info_file($output_filename,
                                         $lcovutil::verify_checksum);
            $files_created++;
            my $then = Time::HiRes::gettimeofday();
            $lcovutil::profileData{filter} = $f - $now;
            $lcovutil::profileData{write}  = $then - $f;
        }
        if ($files_created == 0) {
            lcovutil::ignorable_error($lcovutil::ERROR_EMPTY,
                                      "no data generated\n");
        }
        my $then = Time::HiRes::gettimeofday();
        $lcovutil::profileData{emit} = $then - $now;
        if (defined($trace_data)) {
            info("Finished .info-file creation\n");
            $trace_data->print_summary()
                if ($lcovutil::verbose >= 0);
        }
        summarize_cov_filters();
        # print warnings
        lcovutil::warn_file_patterns();
        $buildDirSearchPath->warn_unused(
                              @lcovutil::build_directory ? '--build-directory' :
                                  'build_directory = ');
        ReadCurrentSource::warn_sourcedir_patterns();
    };
    if ($@) {
        # eval of filter application failed - set error return code, but
        #  still try to emit profile
        print(STDERR $@);
        $exit_code = 1;
    }
}
# $trace_data may be undef if no non-empty GCDA files found and the
#  'empty' warning is ignored
if (0 == $exit_code &&
    defined($trace_data) &&
    $single_file) {

    $trace_data->checkCoverageCriteria();
    CoverageCriteria::summarize();
    $exit_code = 1 if $CoverageCriteria::coverageCriteriaStatus;
}
summarize_messages();
my $end = Time::HiRes::gettimeofday();
$lcovutil::profileData{total} = $end - $start;

lcovutil::cleanup_callbacks();

lcovutil::save_profile(
     (defined($output_filename) && '-' ne $output_filename) ? $output_filename :
         "geninfo");

# exit with non-zero status if --keep-going and some errors detected
$exit_code = 1
    if (0 == $exit_code &&
        (!(defined($trace_data) && $single_file) ||
         lcovutil::saw_error()));
# Drop our reference to the child data directory first:  'File::Temp' removes
#   it from its destructor, and 'temp_cleanup' can only take the parent away
#   once the parent is empty.
$tempFileDir = undef;
lcovutil::temp_cleanup();
exit($exit_code);

#
# print_usage(handle)
#
# Print usage information.
#

sub print_usage(*)
{
    local *HANDLE = $_[0];

    print(HANDLE <<END_OF_USAGE);
Usage: $tool_name [OPTIONS] DIRECTORY

Traverse DIRECTORY and create a tracefile for each compiler coverage data file
found (.gcda/.gcno). Note that you may specify more than one directory, all of
which are then processed sequentially.

COMMON OPTIONS
  -h, --help                        Print this help, then exit
      --version                     Print version number, then exit
  -v, --verbose                     Increase verbosity level
  -q, --quiet                       Decrease verbosity level (e.g. to turn off
                                    progress messages)
      --debug                       Increase debug verbosity level
      --config-file FILENAME        Specify configuration file location
      --rc SETTING=VALUE            Override configuration file setting
      --ignore-errors ERRORS        Continue after ERRORS (see man page for full
                                    list of errors and their meaning)
      --keep-going                  Do not stop if an error occurs
      --tempdir DIRNAME             Parent dir for temporary/intermediate data
      --preserve                    Keep intermediate files for debugging

OPTIONS
  -i, --initial                     Capture initial zero coverage data
  --all                             Capture both .gcda and lone .gcno data
  -t, --test-name NAME              Use test case NAME for resulting data
  -o, --output-filename OUTFILE     Write data only to OUTFILE
  -f, --follow                      Follow links when searching .da/.gcda files
  -b, --base-directory DIR          Use DIR as base directory for relative paths
      --build-directory DIR         Search DIR for .gcno files (if not found
                                    with .gcda)
      --(no-)function-coverage      Enable (disable) function coverage
      --(no-)branch-coverage        Enable (disable) branch coverage
      --mcdc                        Enable MC/DC coverage
      --(no-)checksum               Enable (disable) line checksumming
      --(no-)compat-libtool         Enable (disable) libtool compatibility mode
      --gcov-tool TOOL              Specify gcov tool location
      --filter TYPE                 Apply FILTERS to input data (see man page
                                    for full list of filters and their effects)
      --demangle-cpp [PARAM]        Demangle C++ function names
      --no-recursion                Exclude subdirectories from processing
      --no-markers                  Ignore exclusion markers in source code
      --(no-)external               Include (ignore) data for external files
      --compat MODE=on|off|auto     Set compat MODE (libtool, hammer, split_crc)
      --include PATTERN             Include files matching PATTERN
      --exclude PATTERN             Exclude files matching PATTERN
      --substitute REGEXP           Change source file names according to REGEXP
      --erase-functions REGEXP      Exclude data for functions matching REGEXP
      --omit-lines REGEXP           Ignore data in lines matching REGEXP
      --forget-test-names           Merge data for all tests names
      --version-script SCRIPTNAME   Call script to find revision control version
                                    ID of source file
      --resolve-script SCRIPTNAME   Call script to find source file from path
  -j, --parallel [N]                Use parallel processing with at most N jobs
      --memory MB                   Use at most MB memory in parallel processing
      --profile [FILENAME]          Write performance statistics to FILENAME
                                    (default: OUTPUT_FILENAME.json)

For more information see the geninfo man page.
END_OF_USAGE

}

package IntervalMonitor;

use constant {
              TOTAL_FILES      => 0,
              TOTAL_CHUNKS     => 1,
              CHUNK_SIZE       => 2,
              PROCESSED_CHUNKS => 3,
              INTERVAL_LENGTH  => 4,
              START_TIME       => 5,    # start processing worklist
              LAST_UPDATE      => 6,    # number files processed at last update
              INTERVAL_START   => 7,
              INTERVAL_COUNTS  =>
                  8,    # source files and coverpoints found since update

              FILE_COUNT     => 0,
              LINE_COUNT     => 1,
              BRANCH_COUNT   => 2,
              FUNCTION_COUNT => 3,
};

sub new
{
    my ($class, $totalFiles, $nChunks, $chunkSize, $intervalLength) = @_;
    my $start = Time::HiRes::gettimeofday();
    my $self = [$totalFiles, $nChunks, $chunkSize, 0,
                $intervalLength, $start, 0, $start,
                [0, 0, 0, 0]
    ];
    bless $self, $class;
    return $self;
}

sub checkUpdate
{
    my ($self, $processedFiles) = @_;

    if ($self->[INTERVAL_LENGTH] &&
        $self->[INTERVAL_LENGTH] <= ($processedFiles - $self->[LAST_UPDATE])) {
        my $filesLastInterval = $processedFiles - $self->[LAST_UPDATE];
        $self->[LAST_UPDATE] = $processedFiles;
        my $now          = Time::HiRes::gettimeofday();
        my $elapsed      = $now - $self->[START_TIME];
        my $intervalTime = $now - $self->[INTERVAL_START];
        my $rate         = ($processedFiles) / $elapsed;
        my $average      = $totalChildCpuTime / ($processedFiles);
        my $interval     = $intervalChildCpuTime / $filesLastInterval;
        $intervalChildCpuTime = 0;
        $self->[INTERVAL_START] = $now;
        # compute average wall clock files/s and individual s/file (actual CPU)
        #  for overall processing of all files and for files during this
        #  interval.  Might be useful to observe performance issues during
        #  execution.
        my $total = $self->[TOTAL_FILES];
        lcovutil::info(
            "elapsed:%0.1fm: remaining:%d files %0.1fm: %0.2f files/s %0.2f s/file (interval:%0.2f f/s %0.2f s/f)\n",
            $elapsed / 60,
            $total - $processedFiles,
            ($total - $processedFiles) / ($rate * 60),
            $rate,
            $average,
            $filesLastInterval / $intervalTime,
            $interval);
        # how many new source files and new coverpoints have been found
        #   in this interval?
        if (defined($trace_data)) {
            my @counts       = $trace_data->count_totals();
            my $intervalData = $self->[INTERVAL_COUNTS];
            if ($counts[0] !=
                $intervalData->[FILE_COUNT] ||    # number source files
                $counts[1]->[0] !=
                $intervalData->[LINE_COUNT] ||    # line coverpoints
                $counts[2]->[0] !=
                $intervalData->[BRANCH_COUNT] ||    # branch coverpoints
                $counts[3]->[0] != $intervalData->[FUNCTION_COUNT]
                )    # function coverpoints
            {
                lcovutil::info(1,
                               "  added files:%d ln:%d br:%d fn:%d\n",
                               $counts[0] - $intervalData->[FILE_COUNT],
                               $counts[1]->[0] - $intervalData->[LINE_COUNT],
                               $counts[2]->[0] - $intervalData->[BRANCH_COUNT],
                               $counts[3]->[0] - $intervalData->[FUNCTION_COUNT]
                );
                $self->[INTERVAL_COUNTS] = [$counts[0], $counts[1]->[0],
                                            $counts[2]->[0], $counts[3]->[0]
                ];
            }
        }
    }
}

package BuildWorkList;

sub new
{
    my $class = shift;
    my $self  = [[], {}, {}];    # [worklist, processedFiles, messages]
    return bless $self, $class;
}

sub worklist
{
    my $self = shift;
    # we saved the messages for the end...
    foreach my $msg (values %{$self->[2]}) {
        lcovutil::ignorable_error($msg->[0], $msg->[1]);
    }
    return $self->[0];
}

sub find_corresponding_gcno_file
{
    my ($gcda_file, $searchdir) = @_;
    my ($name, $d, $e) = File::Basename::fileparse($gcda_file, qr/\.[^.]*/);
    my $gcno_file = File::Spec->catfile($d, $name . ".gcno");
    foreach ($gcno_file) {
        return $gcno_file if (-f $gcno_file || -l $gcno_file);

        my $alt    = lcovutil::subst_file_name($gcno_file);
        my $prefix = "looking for GCNO matching '$gcda_file':\n";
        if ($alt ne $gcno_file) {
            $gcno_file = $alt;
            lcovutil::info(1, "$prefix  at '$gcno_file'\n");
            $prefix = '';
            return $gcno_file if (-f $gcno_file || -l $gcno_file);
        }
        # check to see if this file is in a different directory
        my $dir = $d;
        $dir =~ s#^$searchdir##g;
        $prefix = "looking for GCNO matching '$gcda_file' prefix:'$dir':\n";
        # handle case that gcda and gcno are in different directories
        #  - say, where is the gcda that we found, then see if gcno is
        #    in the same directory. If not, then look in a gcno path and
        #    link both gcda and gcno into this tempdir, run gcov, then
        #    unlink
        # from the directory where the gcda file is found:
        #   strip off the directory where we start the search
        #   then strip off the GCOV_PREFIX (if there is one)
        #   then append the remaining path to the GCDA file, to the
        #   'GCNO_PATH' that we were provided.
        #     - if there is a file there:  use it.
        foreach my $d (@$buildDirSearchPath) {
            # is the GCNO in the relative path from build_dir?
            my $build_directory = $d->[0];
            $gcno_file =
                File::Spec->catfile($build_directory, $dir, $name . ".gcno");

            lcovutil::info(1, "$prefix  at '$gcno_file'\n");
            $prefix = '';
            if (-f $gcno_file || -l $gcno_file) {
                ++$d->[1];
                return $gcno_file;
            }

            # is the GCNO in the relative path after we apply substitutions?
            $alt = lcovutil::subst_file_name($gcno_file);
            if ($alt ne $gcno_file) {
                $gcno_file = $alt;
                lcovutil::info(1, "$prefix  at '$gcno_file'\n");
                $prefix = '';
                if (-f $gcno_file || -l $gcno_file) {
                    ++$d->[1];
                    return $gcno_file;
                }
            }
        }    # foreach build_directory

        if (@lcovutil::resolveCallback) {
            $gcno_file = File::Spec->catfile($d, $name . ".gcno");

            $gcno_file = SearchPath::resolveCallback($gcno_file, 1);
            return $gcno_file if (-f $gcno_file || -l $gcno_file);
        }
    }    # foreach switch

    # skip the .gcda file if there is no .gcno
    lcovutil::ignorable_error(
        $lcovutil::ERROR_PATH,
        (lcovutil::is_ignored($lcovutil::ERROR_PATH) ? 'skipping' :
             'cannot process') .
            " .gcda file $gcda_file because corresponding .gcno file '$gcno_file' is missing"
            .
            (
            $lcovutil::verbose ||
                lcovutil::message_count($lcovutil::ERROR_PATH) == 0 ?
                " (see the '--build-directory' entry in 'man geninfo' for suggestions)"
            :
                '') .
            '.');

    return undef;
}

sub add_worklist_entry
{
    my ($self, $filename, $directory) = @_;
    if (exists($self->[1]->{$filename})) {
        lcovutil::ignorable_error(
                                 $lcovutil::ERROR_USAGE,
                                 "duplicate file $filename in both " .
                                     $self->[1]->{$filename} .
                                     " and $directory"
                                     .
                                     (
                                    lcovutil::is_ignored($lcovutil::ERROR_USAGE)
                                    ? ' (skip latter)' :
                                        ''));
        return;
    }
    $self->[1]->{$filename} = $directory;

    my ($gcda_file, $gcno_file);
    if ($filename !~ /$data_file_extension$/) {
        $gcno_file = $filename;
    } else {
        $gcda_file = $filename;
        $gcno_file = find_corresponding_gcno_file($filename, $directory);
        return unless $gcno_file;    # would have errored out

        my ($vol, $dir, $name) = File::Spec->splitpath($gcno_file);
        # remove trailing slash
        $self->[1]->{$gcno_file} = substr($dir, 0, -1);
    }
    push(@{$self->[0]}, [$directory, $gcda_file, $gcno_file]);
}

sub find_files
{
    my $self        = shift;
    my $processGcno = shift;
    my ($type, $ext);

    if ($processGcno) {
        $type = "graph";
        $ext  = $graph_file_extension;
    } else {
        $type = "data";
        $ext  = $data_file_extension;
    }
    foreach my $directory (@_) {
        unless (-e $directory) {
            # hold error until the end of processing - we might be looking
            #  for both .gcno and .gcda files - and don't want to generate
            #   the same 'no such directory' message twice.  Nor do we want
            #  to produce an error if only one type of file is in this
            # directory
            $self->[2]->{$directory} = [$lcovutil::ERROR_USAGE,
                                        "no such file or directory '$directory'"
            ];
            next;
        }
        if (-d $directory) {
            lcovutil::info("Scanning $directory for $ext files ...\n");

            my $now    = Time::HiRes::gettimeofday();
            my $follow = $lcovutil::opt_follow ? '-follow' : '';
            # 'shell_quote', not a bare pair of single quotes:  a directory name
            #   is allowed to contain a single quote, which ends the quoting and
            #   lets the shell interpret whatever follows
            my $cmd =
                'find ' .
                lcovutil::shell_quote($directory) .
                " $maxdepth $follow -name \\*$ext -type f" .
                " -o -name \\*$ext -type l";
            my ($stdout, $stderr, $code) = Capture::Tiny::capture {
                system($cmd);
            };
            lcovutil::ignorable_error($lcovutil::ERROR_UTILITY,
                                      "error in \"$cmd\": $stderr")
                if ($code);

            my $time = Time::HiRes::gettimeofday() - $now;
            if (exists($lcovutil::profileData{find}) &&
                exists($lcovutil::profileData{find}{$directory})) {
                $lcovutil::profileData{find}{$directory} += $time;
            } else {
                $lcovutil::profileData{find}{$directory} = $time;
            }
            # split on crlf
            my @found = split(/[\x0A\x0D]/, $stdout);
            if (!@found) {
                if (!defined($processGcno) || $processGcno != 2) {
                    # delay message: might be a file of other type here
                    $self->[2]->{$directory} = [
                                             $lcovutil::ERROR_EMPTY,
                                             "no $ext files found in $directory"
                    ];
                }

                next;
            }
            # we found something here - remove the pending error message, if any
            delete($self->[2]->{$directory})
                ;    # if exists($self->[2]->{$directory});
            lcovutil::info("Found %d %s files in %s\n",
                           scalar(@found), $type, $directory);
            # keep track of directory where we found the file
            foreach my $entry (@found) {
                # don't add gcno file again, if we already handled the .gcda
                $self->add_worklist_entry($entry, $directory)
                    unless (defined($processGcno) &&
                            $processGcno == 2 &&
                            exists($self->[1]->{$entry}));
            }
        } elsif (!defined($processGcno) || $processGcno == 1) {
            my ($name, $d, $e) =
                File::Basename::fileparse($directory, qr/\.[^.]*/);
            if ($e ne $ext &&
                (!$lcovutil::geninfo_captureAll || $e ne $graph_file_extension)
            ) {
                $self->[2]->{$directory} = [
                       $lcovutil::ERROR_USAGE,
                       "$directory has unsupported extension: expected '$ext'" .
                           ($initial ? " for initial capture" : "")
                ];
                next;
            }
            delete($self->[2]->{$directory});
            # use the directory where we find the file as the base dir
            $self->add_worklist_entry($directory, $d);
        }
    }
}

package main;

#
# gen_info(directory_list)
#
# Traverse each DIRECTORY in list and create a .info file for each data file found.
# The .info file contains TEST_NAME in the following format:
#
#   TN:<test name>
#
# For each source file name referenced in the data file, there is a section
# containing source code and coverage data.  See geninfo(1) man page for
# more details.
#
# In addition to the main source code file there are sections for each
# #included file containing executable code. Note that the absolute path
# of a source file is generated by interpreting the contents of the respective
# graph file. Relative filenames are prefixed with the directory in which the
# graph file is found. Note also that symbolic links to the graph file will be
# resolved so that the actual file path is used instead of the path to a link.
# This approach is necessary for the mechanism to work with the /proc/gcov
# files.
#
# Die on error.
#

my $chunkSize;    # LCOV_UNREACHABLE_LINE - follows main's 'exit'

sub _process_one_chunk($$$$)
{
    my ($chunk, $chunkId, $combined, $pid) = @_;

    my $start = Time::HiRes::gettimeofday();

    my $idx = 0;
    foreach my $data (@$chunk) {
        my $now = Time::HiRes::gettimeofday();
        if (defined($pid) &&
            0 != $pid) {
            # if parent died, then time for me to go
            lcovutil::check_parent_process();
        }

        my ($searchdir, $gcda_file, $gcno_file) = @$data;

        # "name" will be .gcno if "$initial" else will be $gcda
        my $name = defined($gcda_file) ? $gcda_file : $gcno_file;
        info(1,
             "Processing $name" .
                 (defined($pid) ? " in child $pid" : "") . "\n");
        my $context = MessageContext->new("capturing from $name");

        # multiple gcda files may refer to the same source - so generate the
        #  same 'source.gcda' output file - so they each need a different directory
        #  This is necessary to preserve intermediates, and if we are running
        #  in parallel; we don't want to overwrite and don't want multiple children to
        #  conflict.
        my $tmp;
        $tmp = File::Temp->newdir(
                          "geninfo_XXXXX",
                          DIR     => $tempFileDir,
                          CLEANUP => !defined($lcovutil::preserve_intermediates)
        ) if ($intermediate || defined($gcda_file));

        # keep track of order - so we can estimate which files were processed
        # at same time
        $lcovutil::profileData{order}{$name} =
            ($chunkId * $chunkSize) + $idx;
        ++$idx;

        my $trace;
        if ($intermediate) {
            $trace =
                process_intermediate($searchdir, $gcda_file,
                                     $gcno_file, $tmp->dirname);
        } elsif (!defined($gcda_file)) {
            # just read the gcno file and set all the counters to zero
            $trace = process_graphfile($searchdir, $gcno_file);
        } else {
            $trace =
                process_dafile($searchdir, $gcda_file,
                               $gcno_file, $tmp->dirname);
        }
        my $then = Time::HiRes::gettimeofday();
        $lcovutil::profileData{parse}{$name} = $then - $now;

        if (defined($trace)) {

            if (!$single_file) {
                # Create one .info file per input file
                $trace->applyFilters();
                $trace->add_comments(@lcovutil::comments);
                $trace->write_info_file(solve_relative_path(
                                                           $cwd, $name . ".info"
                                        ),
                                        $lcovutil::verify_checksum);
                my $then = Time::HiRes::gettimeofday();
                $lcovutil::profileData{filter_file}{$name} = $then - $now;
                $files_created++;
            } else {
                if (defined($combined)) {
                    $combined->merge_tracefile($trace, TraceInfo::UNION);
                } else {
                    $combined = $trace;
                }
                my $end = Time::HiRes::gettimeofday();
                $lcovutil::profileData{append}{$name} = $end - $then;
            }
        }
        my $done = Time::HiRes::gettimeofday();
        die("unexpected duplicate file '$name'")
            if exists($lcovutil::profileData{file}{$name});
        $lcovutil::profileData{file}{$name} = $done - $now;
    }
    my $end = Time::HiRes::gettimeofday();

    return $combined;
}

sub gen_info(@)
{
    my $builder = BuildWorkList->new();

    $builder->find_files($initial, @_);
    if (!defined($initial) &&
        defined($lcovutil::geninfo_captureAll) &&
        $lcovutil::geninfo_captureAll) {
        $builder->find_files(2, @_);
    }
    my $filelist = $builder->worklist();
    my @sorted_filelist;
    if ($lcovutil::sort_inputs) {
        @sorted_filelist = sort({
                                    my $na = $a->[0] .
                                        (defined($a->[1]) ? $a->[1] : $a->[2]);
                                    my $nb = $b->[0] .
                                        (defined($b->[1]) ? $b->[1] : $b->[2]);
                                    $na cmp $nb
        } @$filelist);
        $filelist = \@sorted_filelist;
    }
    my $total = scalar(@$filelist);
    if (1 < $lcovutil::maxParallelism) {
        my $floor =
            $lcovutil::maxParallelism ?
            (int($total / $lcovutil::maxParallelism)) :
            1;
        if (defined($lcovutil::defaultChunkSize)) {
            if ($lcovutil::defaultChunkSize =~ /^(\d+)\s*(%?)$/) {
                if (defined($2) && $2) {
                    # a percentage
                    $chunkSize = int($total * $1 / 100);
                } else {
                    # an absolute value
                    $chunkSize = $1;
                }
            } else {
                lcovutil::ignorable_error($lcovutil::ERROR_FORMAT,
                    "geninfo_chunk_size '$lcovutil::defaultChunkSize' is not recognized"
                );
            }
        }
        # Need to balance time in child vs. time to merge child data -
        #   - if we have too many children, then they finish and wait in the
        #     queue to be merged.
        #   - if we have too few, then the merge time in child gets long
        # build up in set to 80% of
        $chunkSize = int(0.8 * $floor) unless defined($chunkSize);

        $chunkSize = 1 if $chunkSize < 2;
    } else {
        $chunkSize = 1;
    }
    my @worklist;
    my $serialChunk = [1, []];
    my $nChunks =
        int(floor((scalar(@$filelist) + $chunkSize - 1) / $chunkSize));
    for (my $i = 0; $i < $nChunks; ++$i) {
        push(@worklist, [0, []]);
    }
    my $work = $filelist;    # default to the original order
    my %predictedTime;       # file entry (stringified ref) -> predicted seconds
    my %fileSize;            # file entry (stringified ref) -> its size on disk
    if ($lcovutil::profileHistoryCallback &&
        ($chunkSize > 1 || exists($ENV{LCOV_FORCE_PARALLEL}))) {
        my (@predicted, @unknown);
        foreach my $j (@$filelist) {
            my ($dir, $gcda, $gcno) = @$j;
            my $key       = defined($gcda) ? $gcda : $gcno;
            my $k         = substr($key, length($dir) + 1);
            my $predicted = $lcovutil::profileHistoryCallback->history($k);
            if (defined($predicted)) {
                push(@predicted, [$j, $predicted, $key]);
                $predictedTime{$j} = $predicted;
            } else {
                # put the ones we don't know about at the start of the list
                #  - work on them first, trusting that we will have parallelism
                #    capacity for the ones we know about
                push(@unknown, $j);
            }
        }
        @predicted =
            sort({ $b->[1] <=> $a->[1] or $a->[2] cmp $b->[2] } @predicted);

        lcovutil::info(scalar(@unknown) . ' (of ' .
                           (scalar(@predicted) + scalar(@unknown)) .
                           ") files do not appear in \'--history\' profile.\n")
            if (@unknown);
        if (@predicted) {
            my @order = map({ $_->[0] } @predicted);
            # unknown to the back...
            push(@order, @unknown);
            $work = \@order;
        }
    }
    my $chunkId = 0;
    my @dedicated;    # [$j, $estimate] : files that get their own forked chunk
    FILE: foreach my $j (@$work) {
        my ($dir, $gcda, $gcno) = @$j;
        my $maxSize = 0;
        foreach my $f ($gcda, $gcno) {
            next unless defined($f);    # might not be a GCDA file
            my $filename = $dir . $lcovutil::dirseparator . $f;
            if (grep({ $filename =~ $_ } @main::large_files)) {
                # memory-safety knob:  run this file serially in the parent so
                #  it does not contend for memory with N forked workers.  Do
                #  not also give it a dedicated forked chunk.
                lcovutil::info(1, "large file: $filename\n");
                push(@{$serialChunk->[1]}, $j);
                next FILE;
            }
            my $size = -s $filename;
            $maxSize = $size if defined($size) && $size > $maxSize;
        }
        # Keep it:  it is also what the memory throttle weighs a forked chunk by
        #   (see the 'unitWeight' below), and a stat per file per throttle
        #   decision would be a stat per file many times over.
        $fileSize{$j} = $maxSize;
        # A file predicted (from history) to run at least
        #  $dedicate_segment_threshold seconds - or, absent history, whose
        #  largest on-disk coverage file is at least
        #  $geninfo_dedicate_segment_size bytes - gets its own forked chunk,
        #  scheduled ahead of the round-robin chunks, so a single huge
        #  compilation unit does not serialize the tail of the run.
        if (1 < $lcovutil::maxParallelism) {
            my $predicted = $predictedTime{$j};
            if (defined($predicted)) {
                if ($lcovutil::dedicate_segment_threshold &&
                    $predicted >= $lcovutil::dedicate_segment_threshold) {
                    push(@dedicated, [$j, $predicted]);
                    next FILE;
                }
            } elsif ($lcovutil::dedicate_segment_size &&
                     $maxSize >= $lcovutil::dedicate_segment_size) {
                # no history: estimate order by file size (bytes)
                push(@dedicated, [$j, $maxSize]);
                next FILE;
            }
        }
        die("unexpected chunkId $chunkId") if $chunkId >= $nChunks;
        my $chunk = $worklist[$chunkId++];
        push(@{$chunk->[1]}, $j);
        if ($chunkId == $nChunks) {
            $chunkId = 0;
        }
    }    #foreach DATA_FILE
         # dedicated files each get a size-1 forked chunk.  worklist is a
         #  pop() stack, so push them ascending-by-estimate: the largest is
         #  popped (forked) first, just after the serial chunk.
    if (@dedicated) {
        @dedicated = sort({ $a->[1] <=> $b->[1] } @dedicated);
        lcovutil::info(
               scalar(@dedicated) . " file(s) assigned a dedicated segment.\n");
        push(@worklist, [0, [$_->[0]]]) foreach (@dedicated);
    }
    # serial chunk is at the top of the stack - so serial processing
    #  happens before we fork multiple processes
    push(@worklist, $serialChunk)
        if (@{$serialChunk->[1]});

    # Process all files in list
    my $tempFileExt = '';
    $tempFileExt = ".gz"
        if (defined($output_filename) && $output_filename =~ /\.gz$/);

    my $totalChunks     = scalar(@worklist);
    my $processedChunks = 0;

    # process at least 5% of files before printing stats
    $lcovutil::defaultInterval = 5 unless defined($lcovutil::defaultInterval);

    my $intervalLength = int($total * $lcovutil::defaultInterval / 100);
    my $start          = Time::HiRes::gettimeofday();

    $intervalMonitor =
        IntervalMonitor->new($total, $totalChunks, $chunkSize, $intervalLength);

    lcovutil::info("using: chunkSize: %d, nchunks:%d, intervalLength:%d\n",
                   $chunkSize, $totalChunks, $intervalLength);
    $lcovutil::profileData{chunkSize} = $chunkSize;
    $lcovutil::profileData{nChunks}   = $totalChunks;
    $lcovutil::profileData{interval}  = $intervalLength;
    $lcovutil::profileData{nFiles}    = $total;
    $lcovutil::maxParallelism         = 1 unless scalar(@worklist) > 1;

    lcovutil::ForkManager->new(
             operation => 'geninfo',
             phase     => 'capture',
             tempDir   => $tempFileDir,
             prefix    => 'geninfo',
             # a capture child holds the data it read out of gcov, so this is a place
             #   where the process count has to answer to the memory the children are
             #   actually using
             memoryThrottle => 1,
             # ..and how much data that is scales with how much coverage data the
             #   chunk has to read, which is all that can be known about it before
             #   gcov has run.  Note that this weighs a chunk in bytes where the other
             #   clients weigh theirs in records:  the rate which turns a weight into
             #   memory is measured per client, so the two never meet.
             unitWeight => sub {
                 my $chunk  = shift;
                 my $weight = 0;
                 $weight += $fileSize{$_} // 0 foreach (@{$chunk->[1]});
                 return $weight;
             },
             # believe a child which said in its gcov log that it could not allocate
             #   memory, and not only one which the OS killed:  either way the chunk
             #   it was working on is retried
             retryOnOOM => 1,
             # a chunk can legitimately produce nothing to merge, e.g. when all of its
             #   files were excluded
             mayNotDump => 1,
             remaining  => sub { return $total + 1; },
             next       => sub {
                 # A chunk which is not to be forked is processed here, in order:  the
                 #   serial chunk is at the top of the stack, so that happens before
                 #   there are any children to contend with.
                 # Some files are very large - and run out of memory if we
                 # try to process them in parallel with anything else.
                 # Note that user has to identify them manually...we don't
                 # try to automate that.
                 while (@worklist) {
                     my $chunk = pop(@worklist);
                     ++$processedChunks;
                     return ($chunk, $processedChunks)
                         if (1 < $lcovutil::maxParallelism &&
                             1 != $chunk->[0]);
                     # not parallel..
                     my $saveParallel = $lcovutil::maxParallelism;
                     $lcovutil::maxParallelism = 1;
                     if ($chunk->[0]) {
                         my $num = scalar(@{$chunk->[1]});
                         lcovutil::info("Processing $num file" .
                                        ($num == 1 ? '' : 's') .
                                        " from chunk 0 serially\n");
                     }
                     my $now = Time::HiRes::gettimeofday();
                     $trace_data =
                         _process_one_chunk($chunk->[1], $processedChunks,
                                            $trace_data, undef);
                     $processedFiles += scalar(@{$chunk->[1]});
                     if ($chunk->[0]) {
                         lcovutil::info("Finished processing chunk 0\n");
                     }
                     my $then = Time::HiRes::gettimeofday();
                     $lcovutil::maxParallelism = $saveParallel;
                     $lcovutil::profileData{process}{$processedChunks} =
                         $then - $now;
                 }
                 return ();
             },
             more  => sub { return scalar(@worklist); },
             child => sub {
                 my ($chunk, $chunkId) = @_;
                 #   set my output file to temp location so my dump won't collide
                 #   with another child - then merge at the end...
                 # would be better if the various gcov data readers would build a
                 #   data structure that we could dump - rather than printing a
                 #   .info file that we have to parse....but so be it.
                 my $childStart = Time::HiRes::gettimeofday();
                 $buildDirSearchPath->reset();
                 $output_filename =
                     File::Spec->catfile($tempFileDir,
                                         "geninfo_$$.info" . $tempFileExt);
                 my $childInfo;
                 # set count to zero so we know how many got created in
                 # the child process
                 $files_created = 0;
                 my $now    = Time::HiRes::gettimeofday();
                 my $status = 0;
                 eval {
                     $childInfo =
                         _process_one_chunk($chunk->[1], $chunkId, $childInfo,
                                            $$);
                 };
                 if ($@) {
                     $status = 1;         # error
                     print(STDERR $@);    # capture messages in $stderr
                 }
                 foreach my $f ($output_filename) {
                     unlink $f
                         if -f $f && !$lcovutil::preserve_intermediates;
                 }
                 my $buildDirCounts = $buildDirSearchPath->current_count();

                 my $then = Time::HiRes::gettimeofday();
                 # keep separate timestamp for when this child block was entered
                 # vs when fork() was called - lest this job waited in queue for
                 # a while
                 $lcovutil::profileData{process}{$chunkId} = $then - $now;
                 $lcovutil::profileData{child}{$chunkId} = $then - $childStart;
                 # NOTE:  nothing to send if we extracted nothing/there is no
                 #   childInfo data
                 return (undef, $status) unless defined($childInfo);
                 return ([$single_file ? $childInfo : undef,
                          $buildDirCounts,
                          [$files_created, scalar(@{$chunk->[1]}), $then]
                         ],
                         $status);
             },
             preMerge => sub {
                 my $ctx = shift;
                 debug("merge child $ctx->{child} (parent $$) status " .
                       "$ctx->{rawStatus} from $tempFileDir\n");
             },
             merge => sub {
                 my ($chunk, $chunkId, $payload, $ctx) = @_;
                 my ($childInfo, $buildDirCounts, $counts) = @$payload;
                 $files_created  += $counts->[0];
                 $processedFiles += $counts->[1];
                 my $childFinish = $counts->[2];
                 $buildDirSearchPath->update_count(@$buildDirCounts);
                 my $childCpuTime = $lcovutil::profileData{child}{$chunkId};
                 $totalChildCpuTime    += $childCpuTime;
                 $intervalChildCpuTime += $childCpuTime;

                 my $now = Time::HiRes::gettimeofday();
                 $lcovutil::profileData{undump}{$chunkId} =
                     $now - $ctx->{reapAt};
                 if (defined($childInfo)) {
                     if (defined($trace_data)) {
                         $trace_data->merge_tracefile($childInfo,
                                                      TraceInfo::UNION);
                         my $final = Time::HiRes::gettimeofday();
                         $lcovutil::profileData{append}{$chunkId} =
                             $final - $now;
                     } else {
                         $trace_data = $childInfo;
                     }
                     my $end = Time::HiRes::gettimeofday();
                     $lcovutil::profileData{merge}{$chunkId} = $end - $now;
                     $lcovutil::profileData{queue}{$chunkId} =
                         $ctx->{reapAt} - $childFinish;
                 }
                 $intervalMonitor->checkUpdate($processedFiles);
             },
             postReap => sub {
                 my $ctx     = shift;
                 my $chunkId = $ctx->{id};
                 $lcovutil::profileData{chunk}{$chunkId} =
                     Time::HiRes::gettimeofday() - $ctx->{forkAt};
                 if (exists($lcovutil::profileData{process}{$chunkId}) &&
                     exists($lcovutil::profileData{merge}{$chunkId})) {
                     $lcovutil::profileData{work}{$chunkId} =
                         $lcovutil::profileData{process}{$chunkId} +
                         $lcovutil::profileData{merge}{$chunkId};
                 }
             },
             requeue => sub {
                 my ($chunk, $chunkId, $why) = @_;
                 # a chunk we never managed to fork was counted as processed on the
                 #   way past
                 --$processedChunks if ('fork' eq $why);
                 push(@worklist, $chunk);
             },
             forkFailWhen     => sub { return 'process chunk'; },
             retryWhen        => sub { return 'compute job ' . $_[0]->{id}; },
             mergeFailMessage => sub {
                 my $ctx = shift;
                 return "unable to deserialize $ctx->{dumpfile}: $ctx->{error}";
             },
             childFailMessage => sub {
                 return 'ignoring data in chunk ' . $_[0]->{id};
             },)->run();

    info("Finished processing %d "
             .
             ($initial ? 'GCNO' :
                  ($lcovutil::geninfo_captureAll ? 'GCDA/GCNO' : 'GCDA')) .
             " file%s\n",
         $processedFiles,
         1 == $processedFiles ? '' : 's');
    # Report whether files were excluded.
    if (%lcovutil::excluded_files) {
        my $count = scalar keys %lcovutil::excluded_files;

        info("Excluded data for %d file%s due to include/exclude options\n",
             $count, 1 == $count ? '' : 's');
    }
    return $processedFiles;
}

#
# process_dafile(dirname, da_filename, gcno_filename, tempdir)
#
# Create a .info file for a single data file.
# Used by gcc/4.8.3
#
# Die on error.
#

sub process_dafile($$$$)
{
    my ($dirname, $gcda_file, $gcno_file, $tempdir) = @_;
    my $da_filename;        # Name of data file to process
    my $source_dir;         # Directory of source file
    my $bb_filename;        # Name of respective graph file
    my $graph;              # Contents of graph file
    my $instr;              # Contents of graph file part 2
    my $object_dir;         # Directory containing all object files
    my $source_filename;    # Name of a source code file
    my $gcov_file;          # Name of a .gcov file
    my @gcov_content;       # Content of a .gcov file
    my @matches;            # List of absolute paths matching filename
    my $base_dir;           # Base directory for current file

    # Get path to data file in absolute and normalized form (begins with /,
    # contains no more ../ or ./)
    $da_filename = solve_relative_path($cwd, $gcda_file);
    #my $gcno_filename = solve_relative_path($cwd, $gcno_file);

    # Get directory and basename of data file
    my ($da_dir, $da_basename) = split_filename($da_filename);

    $source_dir = $da_dir;
    if (is_compat($COMPAT_MODE_LIBTOOL)) {
        # Avoid files from .libs dirs
        $source_dir =~ s/\.libs$//;
    }

    # Construct base_dir for current file
    if ($base_directory) {
        $base_dir = $base_directory;
    } else {
        $base_dir = $source_dir;
    }

    # Construct name of graph file
    $bb_filename = solve_relative_path($cwd, $gcno_file);

    # Find out the real location of graph file in case we're just looking at
    # a link
    while (readlink($bb_filename)) {
        my $last_dir = dirname($bb_filename);

        $bb_filename = readlink($bb_filename);
        $bb_filename = solve_relative_path($last_dir, $bb_filename);
    }

    # Ignore empty graph file (e.g. source file with no statement)
    if (-z $bb_filename) {
        lcovutil::ignorable_error($lcovutil::ERROR_EMPTY, "empty $bb_filename");
        chdir($cwd) or die("can't cd back to $cwd: $!");
        return undef;
    }

    # Read contents of graph file into hash. We need it later to find out
    # the absolute path to each .gcov file created as well as for
    # information about functions and their source code positions.
    ($instr, $graph) = read_gcno($bb_filename);

    # Try to find base directory automatically if requested by user
    if ($lcovutil::rc_auto_base) {
        $base_dir =
            find_base_from_source($base_dir,
                                  [keys(%{$instr}), keys(%{$graph})]);
    }

    adjust_source_filenames($instr, $base_dir);
    adjust_source_filenames($graph, $base_dir);

    # Set $object_dir to real location of object files. This may differ
    # from $da_dir if the graph file is just a link to the "real" object
    # file location.
    $object_dir = dirname($bb_filename);
    # $da_filename is already absolute; catfile with a base would double-prefix it
    my $da_arg = $da_filename;
    # my $da_arg = File::Spec->catfile($base_dir, $da_filename);
    # Is the data file in a different directory? (this happens e.g. with
    # the gcov-kernel patch).
    if ($object_dir ne $da_dir) {
        # Use links in tempdir
        $da_arg = File::Basename::basename($da_filename);
        my $gcda = File::Spec->catfile($tempdir, $da_arg);
        symlink($da_filename, $gcda) or
            die("cannot create link $gcda: $!\n");
        my $gcno = File::Spec->catfile($tempdir,
                                       File::Basename::basename($bb_filename));
        symlink($bb_filename, $gcno) or
            die("cannot create link $gcno: $!\n");
        $object_dir = '.';
    }

    chdir($tempdir) or die("can't cd to $tempdir: $!");
    # Execute gcov command and suppress standard output
    #  also redirect stderr to /dev/null if 'quiet'
    # HGC: what we really want to do is to redirect stdout/stderr
    #  unless verbose - but echo them for non-zero exit status.
    my $now = Time::HiRes::gettimeofday();
    debug("call gcov: " . join(' ', @gcov_tool) . " $da_arg -o $object_dir\n");
    lcovutil::info(2,
                  "process $da_arg (for $base_dir/$da_filename in $tempdir)\n");
    my ($out, $err, $code) =
        system_no_output(1 + 2 + 4, @gcov_tool, $da_arg, "-o", $object_dir);
    my $then = Time::HiRes::gettimeofday();
    # keyed by the data file alone, as 'process_intermediate' does:  the two
    #   readers write the same profile, so they have to agree on its shape.  The
    #   extra '{$dirname}' level this used to have made 'exec' a table of tables
    #   for a text-format capture, which is not what the consumers of the
    #   profile expect - the per-data-file times were reported against the
    #   search directory rather than against the '.gcda', or dropped.
    $lcovutil::profileData{exec}{$gcda_file} = $then - $now;

    if (0 != $code) {
        check_gcov_fail($err, $da_filename);
    }
    print_gcov_warnings('stdout', $out, 0, {})
        if ('' ne $out &&
            (0 != $code ||
             $lcovutil::verbose > 1));
    print_gcov_warnings('stderr', $err, 0, {})
        if ('' ne $err &&
            (0 != $code ||
             $lcovutil::verbose));

    # Change back to initial directory
    debug(2, "chdir back to $cwd\n");
    chdir($cwd) or die("can't cd back to $cwd: $!");
    # Collect data from resulting .gcov files and create .info file
    # this version of gcov wrote the files to "." - but we want to
    # save them in tempdir
    my @gcov_list;
    foreach my $f (glob("$tempdir/*.gcov $tempdir/.*.gcov")) {
        # Skip gcov file for gcc built-in code
        push(@gcov_list, $f) unless ($f eq "<built-in>.gcov");
    }

    # Check for files
    if (!@gcov_list) {
        lcovutil::ignorable_error($lcovutil::ERROR_EMPTY,
                      "gcov did not create any files for " . "$da_filename!\n");
    }

    if ($code) {
        ignorable_error($ERROR_UTILITY,
                        "GCOV command failed for $da_filename!");
        return undef;
    }

    my $traceFile = TraceFile->new();
    # Traverse the list of generated .gcov files and combine them into a
    # single .info file
    foreach $gcov_file (@gcov_list) {
        GCOV_FILE_LOOP: {
            next unless -f $gcov_file;    # skip if we didn't copy it over

            my ($source, $object) = read_gcov_header($gcov_file);
            if (!defined($source)) {
                # Derive source file name from gcov file name if
                # header format could not be parsed
                $source = $gcov_file;
                $source =~ s/\.gcov$//;
            }

            $source = solve_relative_path($base_dir, $source);

            # apply more patterns here
            $source = ReadCurrentSource::resolve_path($source, 1);

            @matches = match_filename($source, keys(%{$instr}));

            # Skip files that are not mentioned in the graph file
            if (!@matches) {
                lcovutil::ignorable_error($lcovutil::ERROR_MISMATCH,
                                          "cannot find an entry for " .
                                              $gcov_file .
                                              " in $graph_file_extension file");
                unlink($gcov_file) unless $lcovutil::preserve_intermediates;
                next;
            }
            if (scalar(@matches) == 1) {
                # Just one match
                $source_filename = $matches[0];
            } else {
                # Try to solve the ambiguity
                $source_filename =
                    solve_ambiguous_match($gcov_file, \@matches,
                                          \@gcov_content);
            }
            $source_filename =
                ReadCurrentSource::resolve_path($source_filename, 1);

            if (TraceFile::skipCurrentFile($source_filename)) {
                $lcovutil::excluded_files{$source_filename} = 1;
                unlink($gcov_file) unless $lcovutil::preserve_intermediates;
                next GCOV_FILE_LOOP;
            }

            # Skip external files if requested
            if (is_external($source_filename)) {
                info("  ignoring data for external file $source_filename\n");
                unlink($gcov_file) unless $lcovutil::preserve_intermediates;
                next;
            }

            my $fileData = $traceFile->data($source_filename);
            if (@lcovutil::extractVersionScript) {
                my $version = lcovutil::extractFileVersion($source_filename);
                $fileData->version($version)
                    if (defined($version) && $version ne "");
            }

            # read the GCNO file to find function decls
            if ($lcovutil::func_coverage &&
                exists($graph->{$source_filename})) {
                my $fn_data = $graph->{$source_filename};

                my $functionMap = $fileData->testfnc($test_name);
                # Normalize function names - need to demangle here because the
                # graph data came from reading the gcno file and isn't demangled
                # already.  Collect the names and demangle them in one batched
                # subprocess call rather than forking once per function.
                my (@names, @lines);
                while (my ($fn, $ln_data) = each(%$fn_data)) {
                    next if ($fn eq "");
                    push(@names, $fn);
                    push(@lines, $ln_data->[0]);
                }
                my @filtered =
                    filter_fn_name_list(\@names,
                                        defined($lcovutil::demangle_cpp_cmd));
                for (my $i = 0; $i <= $#filtered; ++$i) {
                    $functionMap->define_function($filtered[$i], $lines[$i]);
                }
            }

            # Read in contents of gcov file
            my ($lineMap, $branchMap, $functionMap) =
                read_gcov_file($fileData, $gcov_file, $da_filename,
                               $source, $test_name);

            # Skip empty files
            if (0 == $lineMap->found()) {
                lcovutil::ignorable_error($lcovutil::ERROR_EMPTY,
                                          "$gcov_file is empty");
                $traceFile->remove($source_filename);
                unlink($gcov_file) unless $lcovutil::preserve_intermediates;
                next;
            }

            # append test-specific coverage to summary DB
            # 'read_gcov_file' collects a branch or function map only when that
            #   kind of coverage was asked for, and returns undef for the
            #   others, so only union the ones which exist - the same test the
            #   intermediate-format reader makes below.  Handing undef to
            #   'union' is not harmless:  the pure-Perl implementation quietly
            #   treats it as an empty map, but the XS one insists on a real
            #   object and croaks 'BranchData: not a reference', so with the
            #   extension loaded every text-format capture without
            #   '--branch-coverage' failed.
            $fileData->sum()->union($lineMap);
            $fileData->sumbr()->union($branchMap)
                if $lcovutil::br_coverage;
            $fileData->func()->union($functionMap)
                if $lcovutil::func_coverage;

            # Remove .gcov file after processing
            unlink($gcov_file) unless $lcovutil::preserve_intermediates;
        }
    }

    return $traceFile;
}

#
# compute_internal_directories(list)
#
# Walk directory tree to find set of 'internal' directories
#   - soft links within the 'internal' tree which point to directories outside
#     the tree cause those target directories to be considered 'internal' if
#     the "--follow" flag is specified - else, 'external'
#

sub compute_internal_directories(@)
{
    my @dirstack;
    foreach my $entry (@_) {
        next unless (defined($entry));
        # do not apply substitution patterns to the dir name -
        #   if user really wants that, they can specify a substitution and/or
        #   include/exclude patterns
        my $p = solve_relative_path($cwd, $entry);
        push(@dirstack, $p)
            if $lcovutil::opt_follow && !grep($p eq $_, @dirstack);
        push(@lcovutil::internal_dirs, $p)
            unless
            grep($p eq $_ || ($lcovutil::case_insensitive && lc($p) eq lc($_)),
                 @lcovutil::internal_dirs);
        if (!file_name_is_absolute($entry) &&
            $entry ne $p) {
            push(@lcovutil::internal_dirs, $entry)
                unless grep($entry eq $_ || ($lcovutil::case_insensitive &&
                                             lc($entry) eq lc($_)),
                            @lcovutil::internal_dirs);
        }
    }

    my %visited;
    while (@dirstack) {
        my $top = pop(@dirstack);
        if (-l $top) {
            my $t = Cwd::realpath($top);
            die("expected directory found '$t'") unless -d $t;
            unless (exists($visited{$t})) {
                lcovutil::info(1,
                            "internal directory: target '$t' of link '$top'\n");
                $visited{$t} = $top;
                push(@dirstack, $t);
                push(@lcovutil::internal_dirs, $t)
                    if lcovutil::is_external($t);
            }
            next;
        }
        opendir(my $dh, $top) or die("can't open directory: $!");
        while (my $e = readdir($dh)) {
            next if $e eq '.' || $e eq '..';
            my $p = File::Spec->catfile($top, $e);
            if (-l $p) {
                my $l = Cwd::realpath($p);
                push(@dirstack, $p) if (-d $l);
            } elsif (-d $p) {
                push(@dirstack, $p) unless exists($visited{$p});
                $visited{$p} = $top;
            }
        }    # while
        closedir($dh);
    }

    if (@lcovutil::internal_dirs) {
        lcovutil::info("Recording 'internal' directories:\n\t" .
                       join("\n\t", @lcovutil::internal_dirs) . "\n");
    }

    # Function is_external() requires all internal_dirs to end with a slash
    foreach my $dir (@lcovutil::internal_dirs) {
        $dir =~ s#$lcovutil::dirseparator_re*$#$lcovutil::dirseparator#;
    }
}

#
# solve_relative_path(path, dir)
#
# Solve relative path components of DIR which, if not absolute, resides in PATH.
#

sub solve_relative_path($$)
{
    my ($path, $dir) = @_;

    # handle possible windows path
    $dir = lcovutil::posix_path($dir);

    my $result = $dir;
    # Prepend path if not absolute
    if (!File::Spec->file_name_is_absolute($dir)) {
        $result = File::Spec->catfile($path, $result);
    }
    # can't just use Cwd::abs_path on the pathname because it understands
    #  soft links and resolves them - so we end up pointing to the actual file
    #  and not to the carefully constructed linked-build paths that the user
    #  wanted. Have to do it the hard way
    # return Cwd::abs_path($result);

    # Remove // in favor of /
    # '$sep_re' is the separator to match with, '$sep' the one to write:  a
    #   Windows separator cannot be interpolated into a pattern as it stands
    my $sep    = $lcovutil::dirseparator;
    my $sep_re = $lcovutil::dirseparator_re;
    $result =~ s#$sep_re$sep_re#$sep#g;

    # Remove . in middle or at end of path
    while ($result =~ s#$sep_re\.($sep_re|$)#$sep#) {
    }

    # Remove trailing /
    $result =~ s#$sep_re$##g if ($result ne $sep);

    # change "X/dirname/../Y" into "X/Y"
    while ($result =~ s#$sep_re[^$sep_re]+$sep_re\.\.($sep_re|$)#$sep#) {
    }
    # change "dirname/../Y" into "./Y" (i.e., at head of path)
    $result =~ s#^[^$sep_re]+$sep_re\.\.$sep_re#.$sep#;

    # Remove preceding ..
    $result =~ s#^$sep_re\.\.$sep_re#$sep#g;

    return $result;
}

#
# match_filename(gcov_filename, list)
#
# Return a list of those entries of LIST which match the relative filename
# GCOV_FILENAME.
#

sub match_filename($@)
{
    my ($filename, @list) = @_;
    my ($vol, $dir, $file) = splitpath($filename);
    my @comp  = splitdir($dir);
    my $comps = scalar(@comp);
    my $entry;
    my @result;

    entry:
    foreach $entry (@list) {
        my ($evol, $edir, $efile) = splitpath($entry);
        # Filename component must match
        if ($efile ne $file) {
            next;
        }
        # Check directory components last to first for match
        my @ecomp  = splitdir($edir);
        my $ecomps = scalar(@ecomp);
        if ($ecomps < $comps) {
            next;
        }
        for (my $i = 0; $i < $comps; $i++) {
            if ($comp[$comps - $i - 1] ne $ecomp[$ecomps - $i - 1]) {
                next entry;
            }
        }
        push(@result, $entry);
    }

    return @result;
}

#
# solve_ambiguous_match(rel_filename, matches_ref, gcov_content_ref)
#
# Try to solve ambiguous matches of mapping (gcov file) -> (source code) file
# by comparing source code provided in the GCOV file with that of the files
# in MATCHES. REL_FILENAME identifies the relative filename of the gcov
# file.
#
# Return the one real match or die if there is none.
#

sub solve_ambiguous_match($$$)
{
    my $rel_name = $_[0];
    my $matches  = $_[1];
    my $content  = $_[2];
    local *SOURCE;

    # Check the list of matches
    foreach my $filename (@$matches) {

        # Compare file contents
        open(SOURCE, "<", $filename) or
            die("cannot read $filename: $!\n");

        my $no_match = 0;
        for (my $index = 2; <SOURCE>; $index += 3) {
            chomp;

            # Also remove CR from line-end
            s/\015$//;

            if ($_ ne $content->[$index]) {
                $no_match = 1;
                last;
            }
        }

        close(SOURCE) or die("unable to close $filename: $!\n");

        if (!$no_match) {
            info("Solved source file ambiguity for $rel_name\n");
            return $filename;
        }
    }

    die("could not match gcov data for $rel_name!\n");
}

#
# split_filename(filename)
#
# Return (path, filename, extension) for a given FILENAME.
#

sub split_filename($)
{
    my ($vol, $dir, $name) = File::Spec->splitpath($_[0]);

    my @file_components = split('\.', $name);
    my $extension       = pop(@file_components);

    return ($vol . $dir, join(".", @file_components), $extension);
}

#
# read_gcov_header(gcov_filename)
#
# Parse file GCOV_FILENAME and return a list containing the following
# information:
#
#   (source, object)
#
# where:
#
# source: complete relative path of the source code file (gcc >= 3.3 only)
# object: name of associated graph file
#
# Die on error.
#

sub read_gcov_header($)
{
    my $source;
    my $object;
    local *INPUT;

    if (!open(INPUT, "<", $_[0])) {
        ignorable_error($ERROR_GCOV, "cannot read $_[0]: $!");
        return (undef, undef);
    }

    while (<INPUT>) {
        chomp($_);

        # Also remove CR from line-end
        s/\015$//;

        if (/^\s+-:\s+0:Source:(.*)$/) {
            # Source: header entry
            $source = $1;
        } elsif (/^\s+-:\s+0:Object:(.*)$/) {
            # Object: header entry
            $object = $1;
        } else {
            last;
        }
    }

    close(INPUT) or die("unable to close $_[0]: $!\n");

    return ($source, $object);
}

#
# attach_to_statements(fileData, filename, lineMap, branchMap, mcdcMap, unexec
#                      [, graph])
#
# Each branch block and MC/DC group gcov wrote on a line which has no line
#   coverpoint in 'lineMap' must be in the middle of a multiline statement -
#   so we associate it with a statement before it (i.e., the closest one
#   above).  Move the block there.
#   It keeps track of the line it was actually written from - see
#   BranchBlock::locationOffset and MCDC_Block::groupKey.
#   The statement is the one 'graph' names for the line (see block_graph),
#   else the nearest statement before it:  the largest line number less
#   than this one which contains a 'linecov' coverpoint.
#   Data with no statement above, or too far away (see
#   BranchBlock::MAX_LOCATION_OFFSET) is left where it is.
# 'unexec' is a hash of the lines gcov marked as holding an unexecuted block
#   -> their non-zero count.  An unexecuted block on a line which holds no
#   branch is consistent if 'graph' says it is the target of an untaken
#   branch.  If 'graph' does not know the line, it is consistent if the nearest
#   statement before it holds branch data.  Otherwise the line's count is
#   inconsistent:  set it to zero (see 'geninfo_unexecuted_blocks') or warn.
#

sub attach_to_statements($$$$$$;$)
{
    my ($fileData, $filename, $lineMap, $branchMap, $mcdcMap, $unexec, $graph)
        = @_;
    my @statement = sort { $a <=> $b } $lineMap->keylist();
    # the greatest line in @statement which is less than 'line', or undef
    my $before = sub {
        my $line = shift;
        my ($lo, $hi) = (0, scalar(@statement));
        while ($lo < $hi) {
            my $mid = ($lo + $hi) >> 1;
            if ($statement[$mid] < $line) {
                $lo = $mid + 1;
            } else {
                $hi = $mid;
            }
        }
        return $lo ? $statement[$lo - 1] : undef;
    };

    my %orphan;
    foreach my $map ($branchMap, $mcdcMap) {
        next unless defined($map);
        foreach my $line ($map->keylist()) {
            $orphan{$line} = 1 unless defined($lineMap->value($line));
        }
    }
    foreach my $line (sort { $a <=> $b } keys(%orphan)) {
        my $to = &$before($line);
        my $owner;
        $owner = $graph->{anchor}->{$line} if defined($graph);
        $to    = $owner
            if (defined($owner) &&
                TraceFile::_locationsFit($line, $owner, $branchMap, $mcdcMap));
        next
            unless (defined($to) &&
                    TraceFile::_locationsFit($line, $to, $branchMap, $mcdcMap));
        TraceFile::_moveBranches($branchMap, $line, $to)
            if defined($branchMap);
        TraceFile::_moveMCDC($fileData, $mcdcMap, $line, $to)
            if defined($mcdcMap);
        lcovutil::debug(1,
                   "$filename:$line: attached branch/MC/DC data to line $to\n");
    }

    foreach my $line (sort { $a <=> $b } keys(%$unexec)) {
        next
            if (!defined($branchMap) ||
                defined($branchMap->value($line)));
        my $hit = $unexec->{$line};
        if (defined($graph) && exists($graph->{explained}->{$line})) {
            next if $graph->{explained}->{$line};
        } else {
            my $to = &$before($line);
            next if (defined($to) && defined($branchMap->value($to)));
        }
        lcovutil::debug(
            "$filename:$line: unexecuted block on non-branch line with count=$hit\n"
        );
        if ($lcovutil::opt_adjust_unexecuted_blocks) {
            $lineMap->remove($line);
            $lineMap->append($line, 0);
        } elsif (lcovutil::warn_once(
                                "unexecuted block", $ERROR_INCONSISTENT_DATA)) {
            lcovutil::ignorable_warning($ERROR_INCONSISTENT_DATA,
                "$filename:$line: unexecuted block on non-branch line with non-zero hit count.  Use \"geninfo --rc geninfo_unexecuted_blocks=1 to set count to zero."
            );
        }
    }
}

#
# block_graph(lines)
#
# What the basic block ids of gcov's JSON 'lines' (format 2, gcc 14 and later)
#   tell us about the lines attach_to_statements has to place.  Ids are numbered
#   per function, so only a line which names its function is used.  Returns
#   undef if no line has block ids, else a hash of
#   'anchor' -> line with no count -> the greatest line before this one which
#               has a count (i.e., a linecov count) and holds one of its
#               blocks, or a branch to one of them.
#               Its blocks are those it lists, and the sources of its branches
#   'explained' -> line with a non-zero count, an unexecuted block and no
#               branch -> 1 if one of its blocks is the target of an untaken
#               branch, 0 if not.  A line some instance of which does not name
#               its function or blocks is not in the hash
#

sub block_graph($)
{
    my $lines = shift;
    my (%holder, %target, %untaken, %orphan, %marked, %unknown, $seen);
    foreach my $d (@$lines) {
        my $line = $d->{"line_number"};
        next unless defined($line);
        my $fn    = $d->{"function_name"};
        my $count = $d->{"count"};
        my $isMark =
            (defined($count) &&
             $count != 0 &&
             $d->{"unexecuted_block"} &&
             !@{$d->{"branches"}});
        if (!defined($fn) || !exists($d->{"block_ids"})) {
            $unknown{$line} = 1 if $isMark;
            next;
        }
        $seen = 1;
        my @ids = map({ "$fn\0$_" } @{$d->{"block_ids"}});
        my @src;
        foreach my $b (@{$d->{"branches"}}) {
            next unless exists($b->{"destination_block_id"});
            my $to = "$fn\0" . $b->{"destination_block_id"};
            push(@{$target{$to}}, $line) if defined($count);
            $untaken{$to} = 1 if (defined($b->{"count"}) && 0 == $b->{"count"});
            push(@src, "$fn\0" . $b->{"source_block_id"})
                if exists($b->{"source_block_id"});
        }
        if (defined($count)) {
            push(@{$holder{$_}}, $line) foreach (@ids);
            push(@{$marked{$line}}, \@ids) if $isMark;
        } else {
            push(@{$orphan{$line}}, @ids, @src);
        }
    }
    return undef unless $seen;
    my (%anchor, %explained);
    while (my ($line, $ids) = each(%orphan)) {
        my $best;
        foreach my $id (@$ids) {
            foreach my $m (@{$holder{$id} // []}, @{$target{$id} // []}) {
                $best = $m if ($m < $line && (!defined($best) || $m > $best));
            }
        }
        $anchor{$line} = $best if defined($best);
    }
    while (my ($line, $instances) = each(%marked)) {
        next if exists($unknown{$line});
        $explained{$line} =
            (grep({ !grep({ $untaken{$_} } @$_) } @$instances)) ? 0 : 1;
    }
    return {
            anchor    => \%anchor,
            explained => \%explained
    };
}

#
# read_gcov_file(gcov_filename, gcda_filename, source_filename)
#
# Parse file GCOV_FILENAME (.gcov file format) and return the list:
# (reference to gcov_content, reference to gcov_branch, reference to gcov_func)
# Used by gcc/5.2.0
#
# gcov_content is a list of 3 elements
# (flag, count, source) for each source code line:
#
# $result[($line_number-1)*3+0] = instrumentation flag for line $line_number
# $result[($line_number-1)*3+1] = execution count for line $line_number
# $result[($line_number-1)*3+2] = source code text for line $line_number
#
# gcov_branch is a BranchData instance - see lcovutil.pm
#
# gcov_func is a list of 2 elements
# (number of calls, function name) for each function
#
# Die on error.
#

sub read_gcov_file($$$$$)
{
    my ($fileData, $gcovFilename, $da_filename, $source_filename, $test_name) =
        @_;
    my $lineMap = $fileData->test($test_name);
    my $branchMap;
    $branchMap = $fileData->testbr($test_name)
        if $lcovutil::br_coverage;
    my $functionMap;
    $functionMap = $fileData->testfnc($test_name)
        if $lcovutil::func_coverage;

    my $f     = InOutFile->in($gcovFilename, $lcovutil::demangle_cpp_cmd);
    my $input = $f->hdl();

    # Expect gcov format as used in gcc >= 3.3
    debug("reading $gcovFilename\n");
    # line content "/*EOF*/" occurs when gcov knows the
    # number of lines in the file but can't find the source code -
    # most of the time, that is deliberate because we run gcov in a
    # temp directory in order to avoid conflicts from parallel execution
    # we do a bit of error checking that the content is not inconsistent
    # - e.g., if we find the file due to fully qualified paths, and find
    # a non-EOF line following an EOF line.
    my $foundEOF = 0;
    my %hasUnexecBlock;    # hash of lines which have 'unexec' marker
    my $branchBlock;
    my $branchId;
    my $branchLine  = -1;
    my $gcovBlockId = -1;
    my $prevLine    = 0;

    while (<$input>) {
        chomp($_);
        # Also remove CR from line-end
        s/\015$//;

        if (/^\s*(\d+|\$+|\%+):\s*(\d+)-block\s+(\d+)\s*$/) {
            next unless $lcovutil::br_coverage;
            # Block information - used to group related branches
            # line=$2, blockId=$3
            if ($branchLine != $2 ||
                $gcovBlockId != $3) {
                # gcov data contains "block ..." leaders in places which
                #   don't contain any branches
                if (defined($branchBlock) && !$branchBlock->empty()) {
                    $branchMap->insertBlock($branchBlock, $branchLine);
                    $branchBlock = undef;
                }
            }
            # 'block' doesn't necessarily contain any branches - e.g.,
            #  testcase 'genhtml/exception':  sees:
            #    - 2 blocks on line 11 both containing 2 branches (blocks 0
            #      and 1), followed by
            #    - 3 blocks which do not contain branches (blocks 2, 3, 4),
            #      followed by
            #    - blocks 5, 6, and 7 which contain 2 branches each, followed
            #      by
            #    - blocks 8, 9, 10, 11, 12 - containing no branches.
            $gcovBlockId = $3;
            my $existing = $branchMap->value($2);
            if (defined($branchBlock)) {
                die("expected empty reused block")
                    unless $branchBlock->empty();
            } else {
                $branchBlock = BranchBlock->new();
            }
            $branchLine = $2;
            $branchId   = 0;
        } elsif (/^branch\s+(\d+)\s+taken\s+(\d+)(?:\s+\(([^)]*)\))?/) {
            next unless $lcovutil::br_coverage;
            # $1 is branch ID, $2 is hit count
            my ($id, $count, $t) = ($1, $2, $3);
            $t =~ /^(throw|fallthrough)?$/ or
                die("unexpected $t")
                if defined($t);
            my $type;
            if (!defined($t) || '' eq $t) {
                $type = BranchElement::VANILLA;
            } elsif ($t eq 'throw') {
                $type = BranchElement::EXCEPT;
            } else {
                die("unexpected type '$t'") unless $t eq 'fallthrough';
                $type = BranchElement::FALLTHROUGH;
            }
            # expect that all branches within the block are contiguous -
            #   not interleaved with branches from other blocks
            $branchBlock->appendElement(
                         BranchElement->new($branchId++, $count, undef, $type));
        } elsif (/^branch\s+(\d+)\s+never\s+executed/) {
            next unless $lcovutil::br_coverage;
            # this branch not taken
            $branchBlock->appendElement(BranchElement->new($branchId++, '-'));
        } elsif (/^function\s+(.+)\s+called\s+(\d+)\s+/) {
            next unless $lcovutil::func_coverage;
            my $name  = $1;
            my $count = $2;
            my $fn    = filter_fn_name($name, 0);
            my $func  = $functionMap->findName($fn);
            if ($func) {
                $func->addAlias($fn, $count);
            } else {
                lcovutil::info("$source_filename: unknown function '$fn'" .
                               ($name ne $fn ? " ($name)" : '') .
                               " not in GCNO file  - skipped\n");
            }
        } elsif (/^call/) {
            # Function call return data
        } elsif (/^\s*([^:]+):\s*([^:]+):(.*)$/) {
            my ($count, $line, $code) = ($1, $2, $3);
            # Skip instance-specific counts
            next if $line <= $prevLine;
            $prevLine = $line;
            # skip fake line inserted by gcov
            if ($code eq '/*EOF*/') {
                $foundEOF = 1;
            } elsif ($foundEOF) {
                # data looks inconsistent...we started finding some EOF entries
                # and now we found a following entry which claims not to be EOF
                lcovutil::ignorable_error($ERROR_FORMAT,
                    "non-EOF for $source_filename:$line at $gcovFilename:$. while processing $da_filename: '$code'"
                );
            }
            # Strip unexecuted basic block marker
            if ($count =~ /^([^*]+)\*$/) {
                # need to do something about lines which have non-zero count
                #  but unexecuted block.  If there are no branches associated
                #  with this line, then we should mark the line as not hit.
                # Otherwise, result is misleading because we can see
                #  (for example) a non-zero hit count for the 'if' clause
                #  of an untaken branch.
                $count = $1;
                $hasUnexecBlock{$line} = $1
                    unless $count == 0;
            }
            # <exec count>:<line number>:<source code>
            if ($line eq "0") {
                # Extra data
                next;
            } elsif ($count eq "-") {
                # Uninstrumented line
                next;
            } else {
                # Check for zero count
                if ($count =~ /^[#=]/) {
                    $count = 0;
                }
                $lineMap->append($line, $count);
            }

        }
    }
    $branchMap->insertBlock($branchBlock, $branchLine)
        if (defined($branchMap) &&
            defined($branchBlock) &&
            !$branchBlock->empty());
    attach_to_statements($fileData, $source_filename,
                         $lineMap, $branchMap,
                         undef, \%hasUnexecBlock);
    $branchMap->updateCounts() if defined($branchMap);
    return ($lineMap, $branchMap, $functionMap);
}

#
# read_intermediate_text(gcov_filename, data)
#
# Read gcov intermediate text format in GCOV_FILENAME and add the resulting
# data to DATA in the following format:
#
# data:      source_filename -> file_data
# file_data: concatenated lines of intermediate text data
#

sub read_intermediate_text($$)
{
    my ($gcov_filename, $data) = @_;
    my $filename;

    my $f = InOutFile->in($gcov_filename, $lcovutil::demangle_cpp_cmd);
    my $h = $f->hdl();
    while (my $line = <$h>) {
        if ($line =~ /^file:(.*)$/) {
            $filename = $1;
            $filename =~ s/[\r\n]$//g;
            #filename will be simplified/substituted in 'adjust_source_filenames'
        } elsif (defined($filename)) {
            $data->{$filename} .= $line;
        }
    }
}

#
# read_intermediate_json(gcov_filename, data, basedir_ref)
#
# Read gcov intermediate JSON format in GCOV_FILENAME and add the resulting
# data to DATA in the following format:
#
# data:      source_filename -> file_data
# file_data: GCOV JSON data for file
#
# GCOV_FILENAME is a reference to the JSON text itself if gcov wrote it to
# stdout.  Also store the value for current_working_directory to BASEDIR_REF.
#

sub read_intermediate_json($$$)
{
    my ($gcov_filename, $data, $basedir_ref) = @_;
    # intermediate JSON contains the demangled name
    my $json =
        ref($gcov_filename) ? JsonSupport::decode($$gcov_filename) :
        JsonSupport::load($gcov_filename);    # imported from lcovutil.pm
    if (!defined($json) ||
        !exists($json->{"files"}) ||
        ref($json->{"files"}) ne "ARRAY") {
        my $name =
            ref($gcov_filename) ? "gcov's standard output" : $gcov_filename;
        die("Unrecognized JSON output format in $name\n");
    }

    $$basedir_ref = $json->{"current_working_directory"};

    # Workaround for bug in MSYS GCC 9.x that encodes \ as \n in gcov JSON
    # output
    if ($^O eq "msys" && $$basedir_ref =~ /\n/) {
        $$basedir_ref =~ s#\n#/#g;
    }

    for my $file (@{$json->{"files"}}) {
        # decode_json() is decoding UTF-8 strings from the JSON file into
        # Perl's internal encoding, but filenames on the filesystem are
        # usually UTF-8 encoded, so the filename strings need to be
        # converted back to UTF-8 so that they actually match the name
        # on the filesystem.
        utf8::encode($file->{"file"});

        my $filename = $file->{"file"};
        $data->{$filename} = $file;
    }
}

#
# intermediate_text_to_info(data)
#
# Write DATA in info format to file descriptor FD.
#
# data:      filename -> file_data:
# file_data: concatenated lines of intermediate text data
#
# Note: To simplify processing, gcov data is not combined here, that is counts
#       that appear multiple times for the same lines/branches are not added.
#       This is done by lcov/genhtml when reading the data files.
#

sub intermediate_text_to_info($)
{
    my $data = shift;
    return if (!%{$data});

    my $traceFile = TraceFile->new();
    while (my ($filename, $fileStr) = each(%$data)) {
        # note that we already substituted the source file name and handled
        # include/exclude directives - so no need to check here
        # see 'adjust_source_filenames() and 'filter_source_files()

        if (TraceFile::skipCurrentFile($filename)) {
            $lcovutil::excluded_files{$filename} = 1;
            next;
        }
        lcovutil::info(1, "emit data for $filename\n");

        # there is no meaningful parse location for this data
        my $fileData    = $traceFile->data($filename);
        my $functionMap = $fileData->testfnc($test_name);
        my $branchMap   = $fileData->testbr($test_name);
        my $lineMap     = $fileData->test($test_name);

        if (@lcovutil::extractVersionScript) {
            my $version = lcovutil::extractFileVersion($filename);
            $fileData->version($version)
                if (defined($version) && $version ne "");
        }
        my $branch_num;
        my $branchBlock;
        my $branchLine = -1;
        my %unexecBlock;    # see attach_to_statements
        for my $line (split(/\n/, $fileStr)) {
            if ($line =~ /^lcount:(\d+),(\d+)(,(\d+))?/) {
                # lcount:<line>,<count>
                # lcount:<line>,<count>,<has_unexecuted_blocks>  (gcc 8)
                my $lineNo = $1;
                my $hit    = $2;
                $lineMap->append($lineNo, $hit);
                $unexecBlock{$lineNo} += $hit
                    if ($4 && $hit != 0);

                # Intermediate text format does not provide
                # branch numbers, and the same branch may appear
                # multiple times on the same line (e.g. in
                # template instances). Synthesize a branch
                # number based on the assumptions:
                # a) the order of branches is fixed across
                #    instances
                # b) an instance starts with an lcount line
                $branch_num = 0;
            } elsif ($line =~ /^function:((\d+)(,(\d+))?),(\d+),(.+)$/) {
                next unless $lcovutil::func_coverage;

                # function:<line>,<endline,>?<count>,<name>
                my ($lineNo, $endline, $hit, $name) = ($2, $4, $5, $6);
                my $func =
                    $functionMap->define_function($name, $lineNo, $endline);
                $func->addAlias($name, $hit);
            } elsif ($line =~ /^branch:(\d+),(taken|nottaken|notexec)/) {
                next
                    unless $lcovutil::br_coverage;
                my $lineNo = $1;
                my $c;
                # branch:<line>,taken|nottaken|notexec
                if ($2 eq "taken") {
                    $c = 1;
                } elsif ($2 eq "nottaken") {
                    $c = 0;
                } else {
                    $c = "-";
                }
                if (!defined($branchBlock) ||
                    $lineNo != $branchLine) {
                    $branchMap->insertBlock($branchBlock, $branchLine)
                        if $branchBlock;

                    # "block" is always zero for intermediate text
                    $branchBlock = BranchBlock->new();
                    $branch_num  = 0;
                    $branchLine  = $lineNo;
                }
                $branchBlock->appendElement(
                                         BranchElement->new($branch_num++, $c));
            }
        }
        $branchMap->insertBlock($branchBlock, $branchLine)
            if $branchBlock;
        attach_to_statements($fileData, $filename, $lineMap, $branchMap,
                             undef, \%unexecBlock);
        $branchMap->updateCounts();
        # now go through lines, functions, branches - append to test_name data
        $fileData->sum()->union($lineMap);
        $fileData->sumbr()->union($branchMap);
        $fileData->func()->union($functionMap);
    }
    return $traceFile;
}

package ExprMap;

sub new
{
    my ($class, $filename) = @_;
    return bless [{}, $filename], $class;
}

sub recordOrMergeBlock
{
    # if new block has same expression as an existing block on this line,
    #   then merge the new one into the existing block and return undef.
    # Otherwise, return the new block (so it can be inserted into this
    #   location)
    my ($self, $line, $block) = @_;

    my $key = "$line:";
    my $sep = '';

    foreach my $br (@{$block->elements()}) {
        my $expr = $br->expr();
        $key .= $sep . $br->signature();
        $key .= $expr
            if defined($expr);
        $sep = '#';
    }
    my $table = $self->[0];
    if (exists($table->{$key})) {
        my $existing = $table->{$key};
        $existing->merge($block, $self->[1], $line);
        return undef;
    } else {
        $table->{$key} = $block;
        return $block;
    }
}

#
# intermediate_json_to_info(data)
#
# Write DATA in info format to file descriptor FD.
#
# data:      filename -> file_data:
# file_data: GCOV JSON data for file
#
# Note: To simplify processing, gcov data is not combined here, that is counts
#       that appear multiple times for the same lines/branches are not added.
#       This is done by lcov/genhtml when reading the data files.
#

package main;

# Whether the declaration at one 'file:line' carries a 'pure' or 'const'
# attribute.  Keyed by location and not by symbol:  one header declares the
# same function for every object which includes it, and one process can be
# asked about it more than once
my %pureDeclaration;    # LCOV_UNREACHABLE_LINE - follows main's 'exit'

# The lines of a file a node label points at, or [] if it cannot be read.
# $ci_dir is where the callgraph info was found - the directory the
# compiler ran in -  so a label's relative file name is relative to it.
# gcov's file names use the same correspondence that join_call_sites() relies on
sub read_declaration_file($$)
{
    my ($file, $ci_dir) = @_;
    my $path = $file;
    $path = File::Spec->catfile($ci_dir, $file)
        if !File::Spec->file_name_is_absolute($path) && !-r $path;
    my @lines;
    if (open(my $handle, '<', $path)) {
        @lines = <$handle>;
        close($handle);
    } else {
        # Not an error:  the answer is "no attribute", which is what every
        #   release before this one assumed for every declaration
        lcovutil::debug(1, "cannot read declaration file '$path': $!\n");
    }
    return \@lines;
}

# Does the declaration at line $line - the one a node label pointed at - carry a
# 'pure' or 'const' attribute?
#
# Read the declaration because the callgraph doesn't carry the attribute:  a
# node label is 'name\nfile:line:col\n..'
# It tells us where the declaration is on the build host - so we can go look.
#
# The location is the declarator, and an attribute can be on either side of it -
# '__attribute__((pure)) int f(int);' as well as 'int f(int) __attribute__((pure));'
# - and either can be on a line of its own.  So the logical declaration is read:
# forward to the ';' which ends it or the '{' which starts a body, and back to
# the ';', '{' or '}' which ended whatever came before.  A body is never read:
# an attribute inside one belongs to something else.
sub declaration_is_pure($$)
{
    my ($lines, $line) = @_;
    return 0 if $line < 1 || $line > scalar(@$lines);
    my $limit = 4;    # a declaration is not twenty lines long
    my $text  = '';
    for (my $i = $line - 2; $i >= 0 && $i >= $line - 1 - $limit; --$i) {
        my $l = $lines->[$i];
        if ($l =~ /^.*[;{}]([^;{}]*)$/) {
            $text = $1 . $text;
            last;
        }
        $text = $l . $text;
    }
    for (my $i = $line - 1; $i < scalar(@$lines) && $i < $line + $limit; ++$i) {
        my $l = $lines->[$i];
        if ($l =~ /^([^;{]*)[;{]/) {
            $text .= $1;
            last;
        }
        $text .= $l;
    }
    # glibc's own spelling, which is what 'atoi', 'strlen' and 'abs' are
    #   declared with
    return 1 if $text =~ /\b__attribute_(?:pure|const)__\b/;
    # ..the C++11 and C23 spelling
    return 1 if $text =~ /\[\[[^\]]*\bgnu::(?:pure|const)\b/;
    # ..and the general one, which is a list:  '__attribute__((pure))',
    #   '__attribute__((__pure__))', '__attribute__((pure, nonnull(1)))'.  Only
    #   inside the attribute's own parentheses, so that the 'const' of a
    #   'const char *' parameter - which is not an attribute and says nothing
    #   about the call - cannot match
    while ($text =~ /__attribute__\s*\(\((.*?)\)\)/gs) {
        return 1 if $1 =~ /\b(?:__)?(?:pure|const)(?:__)?\b/;
    }
    return 0;
}

# Which of the symbols the callgraph info names are declared 'pure' or 'const',
# given { file => { line => [symbol, ..] } } and the directory the callgraph
# info was found in.  Reads each file at most once, and only if some line of it
# is not already known.
sub pure_declarations($$)
{
    my ($needed, $ci_dir) = @_;
    my %pure;
    foreach my $file (sort(keys(%$needed))) {
        my $lines;
        foreach my $line (sort({ $a <=> $b } keys(%{$needed->{$file}}))) {
            my $key = "$file:$line";
            if (!exists($pureDeclaration{$key})) {
                $lines = read_declaration_file($file, $ci_dir)
                    unless defined($lines);
                $pureDeclaration{$key} = declaration_is_pure($lines, $line);
            }
            next unless $pureDeclaration{$key};
            $pure{$_} = 1 foreach (@{$needed->{$file}->{$line}});
        }
    }
    return \%pure;
}

# Parse a '-fcallgraph-info' file:  the static call graph of one translation
# unit, which the compiler wrote beside the '.gcno' as '<base>.ci'.  It is VCG,
# one 'node:' per function and one 'edge:' per call site:
#
#   node: { title: "_Z5multiR1S" label: "int multi(S&)\ncs.cpp:4:5\n.." }
#   edge: { sourcename: "_Z5multiR1S" targetname: "_Z6freefnii" label: "cs.cpp:4:32" }
#
# This is the only place the callee of a call site can be had:  gcov reports
# that a call happened and how often, but not what was called.
#
# Returns two things.  The edges, as
# { caller_symbol => [ [callee_symbol, file, line, column], ... ] }, each list in
# emission order - which is gimple order, and is the order gcov lists the same
# calls in.  That correspondence is the entire basis of the join, so the lists
# must not be sorted.
#
# Edges to a callee gcov cannot count are dropped here, for the same reason the
# unlabelled ones are:  see the 'pure' filter at the end.
#
# ..and the linkage, as { symbol => 1 } for the symbols with external linkage,
# read off the 'node:' titles:  a title is file-qualified exactly when the symbol
# does NOT have external linkage, so a bare one asserts that it does.  That is
# the one direction which can be asserted - "qualified" covers comdats (inline
# functions, template instantiations) as well as static functions, so it does
# not mean "file-local" - and a bare title always means external.  See
# FunctionAlias::is_external and TraceFile::resolveCallSites for how it is used:
# a call from a file which defines no function of that name must have gone to one
# with external linkage, which is what distinguishes an unrelated same-named
#  'static' in a third file from the definition actually called.
#
# The file is kept, and not just the line, because one caller's edges can span
# more than one file:  a function body which '#include's a fragment has call
# sites in the fragment, and a line number alone does not say which file it is a
# line of.  The label spells the file exactly as gcov's own 'file' key does -
# both are the name as given on the compile command line, relative to the same
# directory - which is what lets join_call_sites() compare the two as strings.
sub read_callgraph_info($)
{
    my $ci_file = shift;
    my ($edges, $external, $declaredAt, $callee) =
        @{_cached_callgraph_info($ci_file)};

    # A call to a function declared 'pure' or 'const' is one gcov cannot count:
    #   such a function has none of the effects a call is made for, so the
    #   compiler gives the call no arc in the caller's CFG and gcov reports
    #   nothing for it, while '-fcallgraph-info' lists the edge like any other.
    #   glibc declares 'atoi', 'strlen', 'strcmp' and 'abs' that way, so this is
    #   what ordinary C looks like rather than a corner case.
    # There is no call for the report to count, so the edge is not a call site,
    #   and dropping it makes the two sequences comparable again - the
    #   same reason _parse_callgraph_info() drops the unlabelled edges.  It has
    #   to happen *before* the pairing and not after:  two calls on one line,
    #   one of them to a pure function, leave one arc, and an edge which stayed
    #   would take the arc of the call which really made it (join_call_sites)
    my %needed;
    foreach my $symbol (keys(%$callee)) {
        next unless exists($declaredAt->{$symbol});
        my ($file, $line) = @{$declaredAt->{$symbol}};
        push(@{$needed{$file}->{$line}}, $symbol);
    }
    my $pure = pure_declarations(\%needed, dirname($ci_file));
    if (%$pure) {
        my $dropped = 0;
        foreach my $caller (keys(%$edges)) {
            my @keep = grep({ !exists($pure->{$_->[0]}) } @{$edges->{$caller}});
            next if scalar(@keep) == scalar(@{$edges->{$caller}});
            $dropped += scalar(@{$edges->{$caller}}) - scalar(@keep);
            # ..kept as an empty list rather than deleted, so that a caller
            #   whose every call was to a pure function is still looked at:  an
            #   arc gcov reports for it is then unexplained, and saying so is
            #   join_call_sites' business
            $edges->{$caller} = \@keep;
        }
        lcovutil::info(1,
            "--callgraph-coverage: '$ci_file':  dropped $dropped call site(s) to "
                . scalar(keys(%$pure))
                . " function(s) declared 'pure' or 'const' (" .
                some_locations([sort(keys(%$pure))]) .
                ").  gcov reports no call for one of those, so there is no count to record.\n"
        );
    }

    return ($edges, $external);
}

# What read_callgraph_info() gets out of the '.ci' file itself, before the
#   'pure' filter, which reads the sources relative to the file's directory and
#   so is not a property of the file:  [edges, linkage, declaration location of
#   each symbol, the called symbols].
# Kept for the rest of the capture when the file has more than one link.  A
#   build which runs its tests in several copies of the object tree, each with
#   its own '.gcda' next to a hard link of one '.gcno' and '.ci', asks for the
#   same file once per copy - 17 times over, in the tree this was written for,
#   where one '.ci' is half a gigabyte and takes four seconds to parse.  Loading
#   the stored parse takes a fifth of that, and storing it under half, so a
#   file with one link, which no second '.gcda' can share, is not stored at all.
# The key is the inode, size and modification time:  a file changed during the
#   capture is a different file, and a copy is a different file too, which only
#   costs the parse.  Written under a temporary name and renamed, because the
#   workers are separate processes and one may be reading while another stores
sub _cached_callgraph_info($)
{
    my $ci_file = shift;
    my ($dev, $ino, undef, $nlink, undef, undef, undef, $size, undef, $mtime) =
        stat($ci_file);
    return _parse_callgraph_info($ci_file)
        unless defined($nlink) && $nlink > 1;

    unless (defined($callgraphCacheDir)) {
        $callgraphCacheDir = File::Spec->catdir("$tempFileDir", 'callgraph');
        mkdir($callgraphCacheDir) unless -d $callgraphCacheDir;
    }
    my $cache = File::Spec->catfile($callgraphCacheDir,
                                    join('_', 'ci', $dev, $ino, $size, $mtime));
    if (-f $cache) {
        lcovutil::info(1,
                     "--callgraph-coverage: reusing the parse of '$ci_file'\n");
        return _unpack_callgraph_info(Storable::retrieve($cache));
    }
    my $parsed = _parse_callgraph_info($ci_file);
    my $tmp    = "$cache.$$";
    if (eval { Storable::store(_pack_callgraph_info($parsed), $tmp) } &&
        rename($tmp, $cache)) {
        lcovutil::info(1,
                     "--callgraph-coverage: keeping the parse of '$ci_file'\n");
    } else {
        # not worth failing the capture over:  the next copy just parses again
        unlink($tmp);
    }
    return $parsed;
}

# The form a parse is stored in:  every string once, in a table, and everything
#   else as packed indexes into it and packed numbers.  The titles and labels
#   of a '.ci' repeat absolute paths and mangled names hundreds of thousands of
#   times, so storing the parse as it is costs 40% of the size of the file, in
#   a directory which is often a RAM disk, for every '.ci' of the capture at
#   once;  this costs 5%, and loads faster too.  The caller's edges stay in
#   their order, which join_call_sites() depends on
sub _pack_callgraph_info($)
{
    my ($edges, $external, $declaredAt, $callee) = @{$_[0]};
    my (%index, @string);
    my $intern = sub {
        my $s = shift;
        return $index{$s} //= do { push(@string, $s); $#string };
    };
    # per caller:  the number of edges and the caller, then per edge:  the
    #   callee, file, line and column
    my @edge;
    while (my ($caller, $list) = each(%$edges)) {
        push(@edge, scalar(@$list), $intern->($caller));
        push(@edge, $intern->($_->[0]), $intern->($_->[1]), $_->[2], $_->[3])
            foreach (@$list);
    }
    my @declared;    # symbol, file, line
    while (my ($symbol, $at) = each(%$declaredAt)) {
        push(@declared, $intern->($symbol), $intern->($at->[0]), $at->[1]);
    }
    return [\@string,
            pack('N*', @edge),
            pack('N*', @declared),
            pack('N*', map({ $intern->($_) } keys(%$external))),
            pack('N*', map({ $intern->($_) } keys(%$callee)))
    ];
}

sub _unpack_callgraph_info($)
{
    my ($string, $edge, $declared, $external, $callee) = @{$_[0]};
    my (%edges, %external, %declaredAt, %callee);
    my @edge = unpack('N*', $edge);
    my $i    = 0;
    while ($i < @edge) {
        my ($n, $caller) = @edge[$i, $i + 1];
        $i += 2;
        my $list = $edges{$string->[$caller]} = [];
        foreach (1 .. $n) {
            push(@$list,
                 [$string->[$edge[$i]],
                  $string->[$edge[$i + 1]],
                  $edge[$i + 2],
                  $edge[$i + 3]
                 ]);
            $i += 4;
        }
    }
    my @declared = unpack('N*', $declared);
    for (my $j = 0; $j < @declared; $j += 3) {
        $declaredAt{$string->[$declared[$j]]} =
            [$string->[$declared[$j + 1]], $declared[$j + 2]];
    }
    $external{$string->[$_]} = 1 foreach (unpack('N*', $external));
    $callee{$string->[$_]}   = 1 foreach (unpack('N*', $callee));
    return [\%edges, \%external, \%declaredAt, \%callee];
}

# The parse itself:  one pass over the file, see read_callgraph_info() for the
#   format and _cached_callgraph_info() for what is returned
sub _parse_callgraph_info($)
{
    my $ci_file  = shift;
    my $edges    = {};
    my $external = {};
    my %declaredAt;    # symbol => [file, line], from the node labels
    my %callee;        # ..the ones which are called, which is all we ask about
    my %fileKey;       # a label's file => its pairing_file_key()

    open(my $handle, '<', $ci_file) or
        die("cannot read callgraph info '$ci_file': $!\n");
    while (my $line = <$handle>) {
        if ($line =~ /^node:\s*\{\s*title:\s*"([^"]*)"/) {
            my $title = $1;
            # A mangled name never contains a colon, so a title which has one
            #   is qualified and the symbol is not external.  A node for a
            #   symbol this unit only *declares* - a callee defined elsewhere,
            #   which the compiler marks 'shape : ellipse' - is bare too, and
            #   saying it is external is equally true;  it names no function of
            #   this unit, so nothing here has that name to record it against
            my $colon = rindex($title, ':');
            $external->{$title} = 1 if $colon < 0;
            # ..and where the compiler saw it:  the second line of the label,
            #   which is the declarator of a symbol this unit only declares and
            #   the definition of one it defines.  '<built-in>' is neither and
            #   has no text to read
            if ($line =~ /\slabel:\s*"[^"\\]*\\n([^"\\:]+):(\d+):\d+/) {
                $declaredAt{substr($title, $colon + 1)} = [$1, $2];
            }
            next;
        }
        next
            unless $line =~
            /^edge:\s*\{\s*sourcename:\s*"([^"]*)"\s+targetname:\s*"([^"]*)"(?:\s+label:\s*"([^"]*)")?/;
        my ($caller, $callee, $label) = ($1, $2, $3);
        # An edge with no 'label:' is not a call site in the source:
        #   '_Unwind_Resume' is inserted by the compiler for exception cleanup,
        #   and gcov reports no call for it either - so dropping it is what
        #   makes the two sequences the same length
        next unless defined($label) && $label =~ /^(.*):(\d+):(\d+)$/;
        my ($file, $line_no, $column) = ($1, $2, $3);
        # ..in the spelling gcov's side is compared to - see pairing_file_key()
        $file = ($fileKey{$file} //= pairing_file_key($file));
        # Local and comdat symbols are file-qualified - 'cs.cpp:_ZN1S1mEd' -
        #   while gcov reports the bare symbol.  A mangled name never contains
        #   a colon, so everything up to the last one is the qualification.
        #   Found with rindex() and not a substitution:  the qualification is
        #   an absolute path, and the substitution was a fifth of the parse
        $caller = substr($caller, rindex($caller, ':') + 1);
        # '_sub_I_'/'_sub_D_' are the generated static constructor and
        #   destructor which call __gcov_init/__gcov_exit.  They are in no
        #   source file, and gcov knows nothing about them
        next if $caller =~ /^_sub_[ID]_/;
        $callee = substr($callee, rindex($callee, ':') + 1);
        $callee{$callee} = 1;
        push(@{$edges->{$caller}}, [$callee, $file, $line_no, $column]);
    }
    close($handle);
    return [$edges, $external, \%declaredAt, \%callee];
}

# Where one of gcov's call arcs is - used for messaging.
# An arc is reported under every line its block was built from, so there can
# be more than one, and which of them the call is really at is not known
# when this is needed - so we report all of them.
sub arc_location($)
{
    my $arc = shift;
    return join('/', sort(keys(%{$arc->[1]})));
}

# The locations of the calls one side of the pairing has and the other does not,
# for a message:  enough of them to find the code, not all of them.  A unit
# built with inlining on can have hundreds, and the first few say as much as the
# whole list does.
sub some_locations($)
{
    my $at    = shift;
    my $limit = 3;
    return join(', ', @$at) if scalar(@$at) <= $limit;
    return join(', ', @$at[0 .. $limit - 1]) . ', ...';
}

# The spelling of a file name the pairing compares:  '.' and 'dir/..' collapsed,
# and repeated separators folded.  The callgraph info spells a file exactly as
# the compile command line did, and gcov usually does too - but gcov collapses
# 'dir/..' where it can see that 'dir' exists from where it runs, so a source
# compiled as '/build/obj/../s.c' is '/build/s.c' to gcov and not to the
# callgraph info, and none of its calls would pair.  Where gcov can see depends
# on the directory it happens to run in, so rather than guess which spelling it
# chose, both sides are compared in this one.  Lexical, which a symbolic link
# 'dir' makes wrong about the file it names - but this is only ever a key, and
# two different files of one unit collapsing onto one name is not a thing a
# build does.  A leading '..' of a relative name has nothing to collapse into
# and stays
sub pairing_file_key($)
{
    my $path = shift;
    my $sep  = $lcovutil::dirseparator_re;
    # the common case, and nearly all of them:  nothing to collapse
    return $path
        unless $path =~ /(?:^|$sep)\.\.?(?:$sep|$)|$sep$sep/;
    my $absolute = $path =~ /^$sep/;
    my @kept;
    foreach my $part (split(/$sep+/, $path)) {
        next if $part eq '' || $part eq '.';
        if ($part eq '..') {
            if (@kept && $kept[-1] ne '..') {
                pop(@kept);
                next;
            }
            # '/..' is '/'
            next if $absolute;
        }
        push(@kept, $part);
    }
    my $key = join($lcovutil::dirseparator, @kept);
    return $absolute ? $lcovutil::dirseparator . $key : $key;
}

# Pair the callgraph info's edges against gcov's call data, and leave the result
# on the file data of the file each site's *caller* is defined in, as
#
#   [ caller_name, line, column, ordinal, count, callee_name, site_file ]
#
# for intermediate_json_to_info to hang off the caller's FunctionEntry once that
# exists.  'site_file' is the data of the file the call is written in, and is
# undef when that is the file the caller is defined in - which is the ordinary
# case.  See the site file below.
#
# The pairing is per caller function and by order:  the edge list and
# gcov's 'calls' entries are both in gimple order, so order is the only sound
# correspondence between the two.  The column is not - the compiler folds the
# location of a call nested in an argument list onto the enclosing call, so
# 'sum2(i ? y() : 0, w())' has two of its three edges at one column, and sorting
# by column measurably assigns the wrong counts.  Order alone is not enough
# either, because a call the two producers do not both know about shifts
# everything after it, so the walk is forward-only and matched on the line each
# side gives:  see the alignment below, which is where the two disagreeing is
# turned into named calls with no count instead of a lost function.
#
# It is done over the whole translation unit and not per file, because the
# callgraph info is per unit and one caller's sites can land in more than one of
# its files;  and before source filtering, because the two sequences have to be
# the two sequences the compiler and gcov actually emitted.
sub join_call_sites($$$)
{
    my ($data, $edges, $ci_file) = @_;

    # This is the pairing pass:  each call the callgraph info lists is matched
    #   with the count gcov reports for it, so that a call site ends up with both
    #   a callee and a count.  The 'pairing' entry of the documentation glossary
    #   defines the term and names the three ways a call can fail to pair;  what
    #   follows is how the match is computed and what is done about each failure
    #
    # The callgraph info only ever says 'mangled', while lcov names a function
    #   by its demangled name under '--demangle-cpp'.  gcov gives both
    #   spellings, so the join goes through the map from one to the other;
    #   getting this wrong makes the metric silently empty
    my %name;
    # ..and where each caller is *defined*, which is the only file whose section
    #   can hold its call sites:  an 'FNC:' record is keyed by the index of the
    #   caller in the section it is written to.  A site written in some other
    #   file still goes there, and names that other file - see the site file
    #   below
    my %callerFile;
    # ..and which coverpoint each caller belongs to - its file and the line it
    #   starts on - which is not the same question as which symbol it is:  two
    #   symbols defined at one location are aliases of one function, and one
    #   'FNL:' index answers for all of them.  The sites of every alias are
    #   therefore written under that one index, which is why the ordinals below
    #   are numbered per location and not per symbol
    my %callerCoverpoint;
    # ..and the callees of the sites that drop:  what is left of a site which
    #   cannot be written is the fact that its callee was called from somewhere
    #   unnameable, and that is a property of the callee - see
    #   $externalCallersKey
    my %externalCallers;
    # ..and the files of the unit by the name the edges use for them, which is
    #   gcov's name for them in the spelling pairing_file_key() gives both
    my %fileData;
    foreach my $file_data (values(%$data)) {
        $fileData{pairing_file_key($file_data->{'file'})} = $file_data;
        foreach my $d (@{$file_data->{'functions'}}) {
            $name{$d->{'name'}} =
                $lcovutil::demangle_cpp_cmd ? $d->{'demangled_name'} :
                $d->{'name'};
            $callerFile{$d->{'name'}} = $file_data;
            $callerCoverpoint{$d->{'name'}} =
                $file_data->{'file'} . ':' . $d->{'start_line'};
        }
    }
    # ..and a callee defined in some other translation unit is not in that map
    #   at all, so those are demangled here, in one batch.  Deliberately not
    #   through filter_fn_name_list():  the callee is the last field of the
    #   'FNC:' record and keeps its commas, exactly like the names in the map
    #   above, and the two spellings have to agree or the callee side of the
    #   report cannot resolve them
    if ($lcovutil::demangle_cpp_cmd) {
        my %external;
        foreach my $edgeList (values(%$edges)) {
            foreach my $e (@$edgeList) {
                $external{$e->[0]} = 1 unless exists($name{$e->[0]});
            }
        }
        my @symbols = sort(keys(%external));
        if (@symbols) {
            my @demangled = demangle_name_list(\@symbols);
            $name{$symbols[$_]} = $demangled[$_] foreach (0 .. $#symbols);
        }
    }

    # gcov reports calls line by line;  the sequence to pair against is all of
    #   one function's calls in block order, which is gimple order
    # 'source_block_id' is the block the call leaves from, and a block ends at
    #   its call, so within one caller the block names the call arc.  It is not
    #   unique across the unit - every caller numbers its own blocks - which is
    #   why it is only ever looked up under a caller
    # One arc is reported under *every* line its block was built from, so the
    #   entry holds the set of them and not a line:  a call in an '#include'd
    #   fragment is listed both at its line in the fragment and at a line of the
    #   including file, and only the callgraph info says which of the two the
    #   call is really at.  The pairing below reads the location from the edge
    #   and uses this set to check it
    my %calls;   # caller symbol => { block id => [count, {"file:line" => fd}] }
    my %orphan;  # calls gcov could not attribute:  file => line => [ .. ]
    foreach my $file (keys(%fileData)) {
        my $file_data = $fileData{$file};
        foreach my $d (@{$file_data->{'lines'}}) {
            next unless exists($d->{'calls'}) && @{$d->{'calls'}};
            my $lineNo = $d->{'line_number'};
            if (!defined($d->{'function_name'})) {
                # gcov names the function a line belongs to only when that
                #   function is defined in the same file as the line, so a call
                #   on a line which came from an '#include'd fragment has no
                #   caller here.  Held rather than dropped:  the callgraph info
                #   does know which function the line is in, and the pass below
                #   asks it
                foreach my $c (@{$d->{'calls'}}) {
                    push(@{$orphan{$file}->{$lineNo}},
                         [$c->{'source_block_id'}, $c->{'returned'},
                          $file_data
                         ]);
                }
                next;
            }
            foreach my $c (@{$d->{'calls'}}) {
                my $entry =
                    ($calls{$d->{'function_name'}}->{$c->{'source_block_id'}}
                     ||= [$c->{'returned'}, {}]);
                $entry->[1]->{"$file:$lineNo"} = $file_data;
            }
        }
    }

    # Attribute the orphans, which gcov cannot do but the callgraph info can:
    #  an edge at the orphan's (file, line) names the function whose body that
    #  line is in
    my %edgeOwners;    # file => line => { caller symbol => number of edges }
    foreach my $caller (keys(%$edges)) {
        # ..only the ones gcov described - see the caller loop, below
        next unless exists($callerFile{$caller});
        foreach my $e (@{$edges->{$caller}}) {
            my (undef, $file, $line) = @$e;
            ++$edgeOwners{$file}->{$line}->{$caller};
        }
    }
    # How many of a caller's arcs gcov reports at each "file:line" - see the
    #   claim below.  Counted when a caller is first asked about, which is only
    #   ever the owners of an orphaned line
    my %arcsAt;    # caller symbol => { "file:line" => number of arcs }
    my $spokenFor = sub {
        my ($caller, $arc) = @_;
        my $at = $arcsAt{$caller};
        unless (defined($at)) {
            $at = $arcsAt{$caller} = {};
            foreach my $a (values(%{$calls{$caller}})) {
                ++$at->{$_} foreach (keys(%{$a->[1]}));
            }
        }
        foreach my $where (keys(%{$arc->[1]})) {
            my $colon = rindex($where, ':');
            my $edges = $edgeOwners{substr($where, 0, $colon)}
                ->{substr($where, $colon + 1)}->{$caller} // 0;
            return 1 if $edges >= $at->{$where};
        }
        return 0;
    };
    # What the pass decides is applied after it, so that every decision is
    #   made against what gcov reported and none against what an earlier line
    #   of this pass added:  the answer then does not depend on the order the
    #   lines are visited in
    # The claims, as [arc, "file:line", file data], and the arcs created, as
    #   caller symbol => { block id => [count, {"file:line" => file data}] }
    my @claims;
    my %created;
    my $unattributed = 0;
    foreach my $file (keys(%orphan)) {
        foreach my $line (keys(%{$orphan{$file}})) {
            my @owners = keys(%{$edgeOwners{$file}->{$line} || {}});
            # One entry per block:  a line inlined into many bodies (e.g., a
            #   destructor in <bits/allocator.h>) repeats the same few blocks
            #   thousands of times, and against the thousands of owners such a
            #   line has, the pairs of the two were nearly all of the capture's
            #   time.  The entries of one block are kept by count, which is what
            #   the claim below asks, and the last is the one the sole owner
            #   gets because it is the one whose assignment used to land last
            # block => [last entry, number of entries, {count => entry}]
            my %byBlock;
            foreach my $o (@{$orphan{$file}->{$line}}) {
                my $b = ($byBlock{$o->[0]} ||= [undef, 0, {}]);
                $b->[0] = $o;
                ++$b->[1];
                $b->[2]->{$o->[1] // 0} = $o;
            }
            # First the arcs an owner already has:  this is the fragment's line
            #   turning up as a second mapping of a call gcov did attribute, so
            #   all it adds is that location - which is the one the edge names.
            # The block id is not evidence of that on its own.  Every function
            #   numbers its blocks from zero, and gcov folds every function's
            #   arcs at one line into one record - all the instantiations of a
            #   template in a header, for instance - with nothing to say which
            #   function an arc came from, so an owner which has a block of that
            #   number may have it by coincidence:  on one real unit, the
            #   block id alone made thousands of claims whose count disagreed
            #   with the owner's arc, and a quarter of a million where both
            #   counts were 0, which says nothing either way.  So two things
            #   are asked of it as well:
            #     - the counts agree.  It is one arc reported under two lines,
            #       so it cannot have two counts;
            #     - the arc is not spoken for.  It is at some line of the owner
            #       already, and if the owner has as many edges at that line as
            #       gcov has arcs there, then every arc there is the call written
            #       there - this one included - and none of them is a call written
            #       in the fragment.  That is what a coincidence looks like:  the
            #       owner's own call at its own line, which would be taken from
            #       the edge it belongs to.
            #   An arc which is not claimed is not lost:  it is the owner's own
            #   call, which pairs at its own line as it did before, and the edge
            #   at the fragment's line becomes one with no arc
            my %claimed;
            foreach my $caller (@owners) {
                my $blocks = $calls{$caller};
                next unless defined($blocks);
                foreach my $block (grep({ exists($blocks->{$_}) }
                                        keys(%byBlock))
                ) {
                    my $arc = $blocks->{$block};
                    my $o   = $byBlock{$block}->[2]->{$arc->[0] // 0};
                    next unless defined($o) && !&$spokenFor($caller, $arc);
                    push(@claims, [$arc, "$file:$line", $o->[2]]);
                    $claimed{$block} = 1;
                }
            }
            # ..then the arcs gcov reported nowhere else, which are the caller's
            #   calls that only the fragment holds.  Only when the line is in
            #   the body of exactly one function:  a fragment '#include'd into
            #   two bodies has an edge from each, nothing chooses between them,
            #   and guessing would put a count on the wrong call.  Nor when that
            #   one function has an arc of its own with this block id - which it
            #   does not claim, or it would have been claimed above - because
            #   the arc here is then not that function's.  Those stay orphaned,
            #   and the length check below reports them
            foreach my $block (keys(%byBlock)) {
                next if $claimed{$block};
                my ($o, $n) = @{$byBlock{$block}};
                my (undef, $count, $file_data) = @$o;
                if (1 != scalar(@owners) ||
                    (exists($calls{$owners[0]}) &&
                        exists($calls{$owners[0]}->{$block}))
                ) {
                    $unattributed += $n;
                    next;
                }
                # one arc of the owner's may be reported under more than one of
                #   the fragment's lines, which makes it one arc at all of them
                my $arc = ($created{$owners[0]}->{$block} ||= [$count, {}]);
                $arc->[1]->{"$file:$line"} = $file_data;
            }
        }
    }
    $_->[0]->[1]->{$_->[1]} = $_->[2] foreach (@claims);
    foreach my $caller (keys(%created)) {
        my $blocks = ($calls{$caller} ||= {});
        $blocks->{$_} = $created{$caller}->{$_}
            foreach (keys(%{$created{$caller}}));
    }

    # The ordinals handed out so far, keyed by coverpoint and location:  the
    #   ordinal this callee has been given there, and the next unused one.
    #   Outside the loop below because the namespace an ordinal numbers belongs
    #   to the coverpoint and not to the symbol - see %callerCoverpoint - so the
    #   aliases of one function must not each start over at zero.
    # One ordinal per callee at a location, and so one site:  every arc which
    #   leaves this place for this callee folds into it and adds its count.  The
    #   ordinal is what distinguishes two *different* callees the compiler gave
    #   one location ('sum2(i ? y() : 0, w())' puts the edge to 'w' and the edge
    #   to 'sum2' at one column), which is the job it is here to do.
    # A location is a line *and* a column, so this folds nothing the report could
    #   have shown apart:  'freefn(x, 1) + freefn(x, 2)' calls one function twice
    #   on one line at two columns, and those keep their own keys and their own
    #   counts.  Only the same line and the same column merge, because a line, a
    #   column and a callee is all a report can name a call by - it is what the
    #   source view underlines and what a differential report categorizes - so
    #   two records there would be two rows nothing could tell apart.
    # The compiler generates more than one arc for one written call whenever the
    #   call needs a cleanup path:  a local with a non-trivial destructor plus a
    #   call which may throw gives two identical '.ci' edges at the closing
    #   brace, and gcov counts them apart - the normal path with the calls it
    #   made, the unwind path with zero.  Two coverpoints there would say that
    #   half of a destructor call the tests executed 61770 times was missed, and
    #   the report cannot even point at the one that was:  a location and a
    #   callee is the finest thing it can name, which is exactly a call as it is
    #   written.  So that is the coverpoint, and the '-fno-exceptions' build of
    #   the same source measures the same number of calls as the default one.
    # Folding is also what merging two inputs has always done with them - see
    #   FunctionEntry::_resolveCallSite, which gives an incoming site the
    #   ordinal its own call to that callee already has - so the two paths into a
    #   report now agree.
    my %ordinal;
    my %nextOrdinal;
    foreach my $caller (sort(keys(%$edges))) {
        # A caller gcov said nothing about is not in this report:  a function
        #   the optimizer removed outright, or one in a file gcov did not
        #   describe.  There is nowhere to record its sites, and nothing
        #   inconsistent about that
        # The test is %callerFile and not %name:  under '--demangle', %name
        #   also holds every callee gcov did not describe, and a symbol can be
        #   both.  gcc 16 gives the complete-object constructor and destructor
        #   (C1/D1) a callgraph node of their own, with one edge to the
        #   base-object body (C2/D2), while gcov describes only that body
        next unless exists($callerFile{$caller});
        my $callerName = $name{$caller};
        my @edgeList   = @{$edges->{$caller}};
        my $blocks     = $calls{$caller} || {};
        # block order is gimple order, which is the order the edges were emitted
        #   in - that correspondence is the whole basis of the pairing
        my @blockIds = sort({ $a <=> $b } keys(%$blocks));

        # Align the two sequences forward only.  Each edge takes the first arc at
        #   or after the cursor which gcov reports at the edge's own location,
        #   and the cursor never goes back:  both sequences are in gimple order,
        #   so an arc the walk steps over is behind every later edge as well.
        # This is the positional zip of two sequences which agree - arc i is at
        #   edge i's location, which is what the location says - and it degrades
        #   one call at a time when they do not, instead of losing the function:
        #     - an edge which finds no arc is a call the compiled code makes and
        #       gcov produced no count for, which is what an inlined call is;
        #     - an arc the walk steps over is a call gcov counted which the
        #       callgraph info does not list, so its callee cannot be named and
        #       there is nothing to record.
        #   Neither is a guess:  the location is the evidence, and it is why the
        #   walk is by location rather than by index.  What the walk cannot say
        #   is which of several calls on one line lost its arc - it hands the
        #   surviving arcs to the earlier edges, which is all a positional
        #   pairing could do - and the voiding below is what is done about that
        my @pairs;    # [edge, arc or undef], one per edge, in edge order
        my $nextArc = 0;
        my @missingAt;         # locations of the edges with no arc
        my @missingCallees;    # ..and what they call, which is the other half
        my @extraAt;           # locations of the arcs with no edge
        foreach my $e (@edgeList) {
            my (undef, $file, $line, $column) = @$e;
            my $at = "$file:$line";
            my $found;
            for (my $j = $nextArc; $j <= $#blockIds; ++$j) {
                next unless exists($blocks->{$blockIds[$j]}->[1]->{$at});
                $found = $j;
                last;
            }
            if (!defined($found)) {
                push(@missingAt, "$at:$column");
                push(@missingCallees, $e->[0]);
                push(@pairs, [$e, undef]);
                next;
            }
            push(@extraAt, arc_location($blocks->{$blockIds[$_]}))
                foreach ($nextArc .. $found - 1);
            $nextArc = $found + 1;
            push(@pairs, [$e, $blocks->{$blockIds[$found]}]);
        }
        push(@extraAt, arc_location($blocks->{$blockIds[$_]}))
            foreach ($nextArc .. $#blockIds);

        # A line which has fewer arcs than it has edges cannot say which of its
        #   calls the arcs it does have belong to, so none of them keeps a count.
        #   The walk gave them to the earliest edges because nothing on the
        #   caller's side distinguishes them, but that answer is not merely
        #   arbitrary - from -O1 it is usually wrong.  gcov counts a call by the
        #   edge which leaves the call other than normally, '-fipa-pure-const'
        #   removes that edge for every callee it can prove nothrow, and which
        #   callees those are has nothing to do with the order the calls are
        #   written in.  Measured on a line calling two functions which ran 3 and
        #   7 times:  one arc survives, and giving it to the earlier edge reports
        #   7 calls to the function which was called 3 times.  An unknown count
        #   says what is known;  a number that is off by a factor of two says
        #   something false, and it is the number the user reads.
        # Per line, because 'file:line' is the granularity the pairing matches
        #   at:  a call on a line where the two sequences do agree is not in
        #   doubt, and voiding it would throw away a count for nothing
        my @ambiguousAt;    # locations of the sites voided by that rule
        my %shortLine;      # "file:line" of every edge which found no arc
        foreach my $pair (@pairs) {
            $shortLine{$pair->[0]->[1] . ':' . $pair->[0]->[2]} = 1
                unless defined($pair->[1]);
        }
        if (%shortLine) {
            foreach my $pair (@pairs) {
                next unless defined($pair->[1]);
                my (undef, $file, $line, $column) = @{$pair->[0]};
                next unless exists($shortLine{"$file:$line"});
                push(@ambiguousAt, "$file:$line:$column");
                $pair->[1] = undef;
            }
        }
        my $missingArcs   = scalar(@missingAt);
        my $extraArcs     = scalar(@extraAt);
        my $ambiguousArcs = scalar(@ambiguousAt);

        # The two do not describe the same function.  Reported whether or
        #   not the data is kept, because a rate computed from a function whose
        #   calls the two producers disagree about is not the rate the user
        #   asked for - '--callgraph-partial-data' says what to keep, and
        #   '--ignore-errors inconsistent' says whether to carry on;  the two are
        #   independent on purpose
        if ($missingArcs || $extraArcs) {
            # A call gcov could not attribute to any function is the one the
            #   callgraph info can usually repair, by naming the function the
            #   line is in - so reaching here with $unattributed set means the
            #   repair did not apply:  the line is in no edge, or in edges of
            #   more than one caller, or its one caller has a call of that block
            #   number already.  No optimization setting helps with that
            # ..and the two directions of the mismatch have different causes and
            #   so different advice, which is why they are said separately
            my @why;
            my $flags = 0;
            if ($unattributed) {
                push(@why,
                    "$unattributed call site(s) in this unit are on lines gcov did not attribute to any function and the callgraph info does not attribute to exactly one; this may be due to a fragment '#include'd into more than one function body - or, where the one function it is in already has a call with the arc's block number, a line whose calls gcov reported together with other functions' calls, as it does for the instantiations of a template."
                );
                $flags |= 0x1;
            } else {
                if ($missingArcs) {
                    push(@why,
                        "Two optimizations remove the arc a call site's count comes from:  a call which was inlined is not in the caller's CFG at all, and '-fipa-pure-const' - on from -O1 - proves callees nothrow and deletes the exceptional edge which is the only thing gcov counts a call by.  Callgraph coverage wants -O0, or '-fno-inline -fno-ipa-pure-const'."
                    );
                    $flags |= 0x2;
                    # ..and the other reason a call has no arc, which no
                    #   optimization setting changes:  a callee declared 'pure'
                    #   or 'const' is never counted (read_callgraph_info).  Such
                    #   a call is dropped rather than reported, but only when
                    #   the declaration the callgraph info points at is the one
                    #   carrying the attribute - a function defined in this unit
                    #   whose prototype in some header declares it 'pure' is
                    #   declared there, and this is what that looks like
                    my %seen;
                    my @named =
                        grep({ !$seen{$_}++ }
                             map({ exists($name{$_}) ? $name{$_} : $_ }
                                 @missingCallees));
                    push(@why,
                        "A call to a function declared 'pure' or 'const' has no arc either, whatever the optimization setting:  if one of these is declared that way somewhere other than where it is defined, add the attribute to the definition as well, or ignore this error.  The call(s) with no arc go to: "
                            . some_locations(\@named)
                            . '.');
                }
                if ($extraArcs) {
                    push(@why,
                        "A call the compiler generated rather than one the source makes - a copy, a conversion, an exception edge - is counted by gcov and has no edge in the callgraph info, so there is no callee to name it by."
                    );
                    $flags |= 0x4;
                }
            }
            my $why =
                lcovutil::warn_once($lcovutil::ERROR_INCONSISTENT_DATA,
                                    "callgraph_$flags") ?
                '  ' . join('  ', @why) :
                '';
            my @what;
            push(@what,
                "$missingArcs of the " .
                    scalar(@edgeList) .
                    " call site(s) callgraph info '$ci_file' lists have no call in gcov's data ("
                    . some_locations(\@missingAt) . ')')
                if $missingArcs;
            push(@what,
                 "$extraArcs of the " .
                     scalar(@blockIds) .
                     " call(s) gcov reports are not in the callgraph info (" .
                     some_locations(\@extraAt) . ')')
                if $extraArcs;
            # ..and the sites which did pair but whose line's pairing cannot be
            #   trusted, which is a consequence of the first clause and not a
            #   third disagreement:  said so the user is not left wondering why
            #   a call gcov clearly counted has no number
            push(@what,
                "$ambiguousArcs further site(s) are on a line with one of those and so cannot be distinguished ("
                    . some_locations(\@ambiguousAt) . ')')
                if $ambiguousArcs;
            my $did =
                $lcovutil::callgraph_partial_data ?
                "keeping the site(s) which did pair and recording the rest with an unknown count ('-'), because '--callgraph-partial-data' is set"
                :
                "dropping this function's callee data - use '--callgraph-partial-data' to keep the site(s) which did pair";
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                                      "--callgraph-coverage: '$callerName':  " .
                                          join(', and ', @what) .
                                          " - $did.  $why");
            next unless $lcovutil::callgraph_partial_data;
        }
        my @sites;
        foreach my $pair (@pairs) {
            my ($e, $arc) = @$pair;
            my ($callee, $file, $line, $column) = @$e;
            my ($count, $file_data);
            if (defined($arc)) {
                $count     = defined($arc->[0]) ? $arc->[0] : 0;
                $file_data = $arc->[1]->{"$file:$line"};
            } else {
                # count of '-' means that the call is in the compiled code and
                #   this capture has no count for it - either gcov didn't
                #   produce one or the counts on its line could not be
                #   distinguished (the voiding above).
                #   In contrast, '0' (zero) would say the tests never made
                #   the call -  which is a different claim and not what
                #   this data appears to say - see FunctionEntry::SITE_COUNT
                $count     = '-';
                $file_data = $fileData{$file};
            }
            # A file gcov did not describe at all has no section, so there is no
            #   name to write the location as and the site cannot be kept.  The
            #   pairing above is still what keeps the caller's *other* sites, so
            #   this is a per-site drop and not the function's
            # The site is dropped, not the fact:  what cannot be written is the
            #   location and count, and what can is that the callee has a caller
            #   this report cannot name, which is exactly what
            #   FunctionAlias::has_external_callers says - the edge, and the
            #   calls it carried.  So this is not an error:  a call which was
            #   made is in the callee's own execution count either way, and
            #   now the edge and its count are in the callee's flag as well.
            #   A callee defined in another translation unit is not in this
            #   unit's table and so keeps no flag from here;  it needs none,
            #   since its own count still holds the call and no site in the
            #   report claims it
            if (!defined($file_data)) {
                $externalCallers{$callee} =
                    exists($externalCallers{$callee}) ?
                    lcovutil::add_site_count($externalCallers{$callee}, $count)
                    :
                    $count;
                next;
            }
            # An 'FNC:' record is keyed by the caller's index in the section it
            #   is written to, so every site goes to the section of the file the
            #   caller is *defined* in.  When the call is written somewhere else
            #   - which is every call in an '#include'd fragment, and every call
            #   a different compilation unit makes to a function of this one -
            #   the record names that other file, and the site carries its name
            #   along to be turned into an index at write time.  See 'FNC:' in
            #   geninfo(1)
            # The file is carried as its data rather than as a name, because the
            #   name it will be written under is not settled yet:  this runs
            #   before adjust_source_filenames(), which rewrites the keys of
            #   %$data and not the 'file' field of what they hold.
            #   intermediate_json_to_info() turns it back into the final name
            my $siteFile;
            $siteFile = $file_data
                if $callerFile{$caller} != $file_data;
            # the ordinal distinguishes the callees the compiler gave one
            #   location.  It is assigned in pairing order because that order
            #   is a property of the compiled code, so two captures of the same
            #   build agree on it
            my $calleeName = exists($name{$callee}) ? $name{$callee} : $callee;
            # ..in the coverpoint's namespace, and one per callee within it:  a
            #   second arc to this callee from here is another way to reach the
            #   one call which is written here, so it is the same site and its
            #   count adds - see %ordinal.  The namespace is the coverpoint's
            #   and not the symbol's, so an alias' call folds in here too
            # ..and the file the call is written in is part of the location, so
            #   it is part of the key:  two sites which share a line and column
            #   but not a file are distinct sites and number their ordinals apart
            my $at    = "$line:$column" . (defined($siteFile) ? ":$file" : '');
            my $where = $callerCoverpoint{$caller} . " $at";
            my $ordinalNo = $ordinal{$where}->{$calleeName};
            if (!defined($ordinalNo)) {
                $ordinalNo = $nextOrdinal{$where}++;
                $ordinal{$where}->{$calleeName} = $ordinalNo;
            }
            my @site = ($callerName, $line, $column, $ordinalNo,
                        $count, $calleeName, $siteFile);
            # ..to the section of the file the caller is defined in, whether or
            #   not that is the file the call is written in
            push(@sites, [$callerFile{$caller}, \@site]);
        }
        foreach my $site (@sites) {
            push(@{$site->[0]->{$callSiteKey}}, $site->[1]);
        }
    }
    # The callees of the dropped sites, handed to every file of the unit the way
    #   the linkage table is:  the flag is set where the callee is *defined*, and
    #   which file of the unit that is is not known here
    if (%externalCallers) {
        $_->{$externalCallersKey} = \%externalCallers foreach (values(%$data));
    }
}

sub intermediate_json_to_info($)
{
    my $data = shift;

    return if (!%{$data});

    my $traceFile = TraceFile->new();
    lcovutil::debug(1,
          "called intermediate_json_to_info " . join(' ', keys(%$data)) . "\n");
    # The name each file's section is written under, by the data it holds:  the
    #   key of %$data and not its 'file' field, because the two differ once the
    #   name has been adjusted (adjust_source_filenames).  Wanted by the call
    #   sites which name the file they are written in - see join_call_sites()
    my %sectionName;
    while (my ($name, $fd) = each(%$data)) {
        $sectionName{$fd} = $name;
    }
    while (my ($filename, $file_data) = each(%$data)) {
        # note that we already substituted the source file name and handled
        # include/exclude directives - so no need to check here
        # see 'adjust_source_filenames() and 'filter_source_files()
        # there is no meaningful parse location for this data
        lcovutil::debug(1, "parse $filename\n");
        if (TraceFile::skipCurrentFile($filename)) {
            $lcovutil::excluded_files{$filename} = 1;
            next;
        }
        my $fileData = $traceFile->data($filename);
        my $lineMap  = $fileData->test($test_name);
        my $functionMap;
        $functionMap = $fileData->testfnc($test_name)
            if $lcovutil::func_coverage;
        my $branchMap;
        $branchMap = $fileData->testbr($test_name)
            if $lcovutil::br_coverage;
        my $mcdcMap;
        $mcdcMap = $fileData->testcase_mcdc($test_name)
            if $lcovutil::mcdc_coverage;
        my $branchExprMap = ExprMap->new($filename);
        my %unexecBlock;    # see attach_to_statements

        if (@lcovutil::extractVersionScript) {
            my $version = lcovutil::extractFileVersion($filename);
            $fileData->version($version)
                if (defined($version) && $version ne "");
        }

        # Function data
        if ($lcovutil::func_coverage) {
            # The set of symbols this translation unit defines with external
            #   linkage, if the callgraph info said - see read_callgraph_info()
            my $external = $file_data->{$externalKey};
            # ..and the symbols of it which were called from a site this format
            #   cannot express - see join_call_sites()
            my $externalCallers = $file_data->{$externalCallersKey};
            for my $d (@{$file_data->{"functions"}}) {
                my $start_line = $d->{"start_line"};
                my $end_line;
                $end_line = $d->{"end_line"}
                    if exists($d->{end_line});
                my $count = $d->{"execution_count"};
                my $name  = $lcovutil::demangle_cpp_cmd ? $d->{demangled_name} :
                    $d->{"name"};
                my $func =
                    $functionMap->define_function($name, $start_line,
                                                  $end_line);
                $func->addAlias($name, $count);
                # ..and its linkage, when the callgraph info said so.  Keyed on
                #   the mangled name, because that is the only spelling the
                #   callgraph info has, while $name may have been demangled
                $func->alias($name)->set_external()
                    if defined($external) && exists($external->{$d->{"name"}});
                # ..and, by the same key, that a call was made to it from a site
                #   which has no record of its own, and how many
                $func->alias($name)
                    ->add_external_calls($externalCallers->{$d->{"name"}})
                    if defined($externalCallers) &&
                    exists($externalCallers->{$d->{"name"}});
            }
            # Callee data:  the sites were paired against the callgraph info
            #   per translation unit, in join_call_sites(), because that is the
            #   unit both halves of the pairing are written in.  What arrives
            #   here is this file's finished list, and all that is left is to
            #   hang each site off the FunctionEntry the loop above created
            foreach my $site (@{$file_data->{$callSiteKey} || []}) {
                my ($caller, $line, $column, $ordinal,
                    $count, $callee, $siteFile) = @$site;
                my $entry = $functionMap->findName($caller);
                if (!defined($entry)) {
                    # LCOV_UNREACHABLE_START
                    # Unreachable, and kept only so that a future change to the
                    #   pairing cannot turn it into a crash:  a site is only
                    #   built for a caller gcov named as a function of some
                    #   file of this unit, and join_call_sites() files it under
                    #   the file that caller is defined in - which is the file
                    #   the loop above has just defined it in
                    lcovutil::debug(1,
                        "$filename:$line: no function '$caller' for call to '$callee'\n"
                    );
                    next;
                    # LCOV_UNREACHABLE_STOP
                }
                # $siteFile is the data of the file the call is *written* in, and
                #   is undef when that is $filename - see join_call_sites().  A
                #   file which was filtered out since has no name here and no
                #   section either, so its 'file' field will do:  a site naming a
                #   file the report does not hold becomes the callee's 'called
                #   from outside' flag at write time - see _pruneUnwritableSites
                if (defined($siteFile)) {
                    $siteFile =
                        exists($sectionName{$siteFile}) ?
                        $sectionName{$siteFile} :
                        $siteFile->{'file'};
                }
                # ..made by the alias the call is in.  Another alias' call to
                #   the same callee from the same place is the same site (see
                #   join_call_sites), and adds that alias to the ones which make
                #   it - see FunctionEntry::SITE_ALIASES
                $entry->addCallSite($line, $column, $ordinal,
                                    $count, $callee, $siteFile, undef, $caller);
            }
        }
        foreach my $d (@{$file_data->{"lines"}}) {
            my $line  = $d->{"line_number"};
            my $count = $d->{"count"};

            my $branches = $d->{"branches"};
            my $unexec   = $d->{"unexecuted_block"};
            my $conditions;
            $conditions = $d->{'conditions'}
                if $lcovutil::mcdc_coverage && exists($d->{'conditions'});

            next unless defined($line);

            # a line without a count has no line coverpoint, but its branch
            #   and MC/DC data belongs to the previoius statement - see
            #   attach_to_statements
            if (defined($count)) {
                $unexecBlock{$line} = $count
                    if (0 == scalar(@$branches) && $unexec && $count != 0);

                # just add the line - worry about filtering later
                $lineMap->append($line, $count);
            }

            # Branch data
            if ($lcovutil::br_coverage) {

                # there may be compiler-generated branch data on
                #  the closing brace of the function...
                $unexec = ($unexec && defined($count) && $count == 0);

                # build a BranchEntry from this data - then either
                #  - insert it into the map:
                #     - if this is the first block we saw on this line, OR
                #     - this BranchEntry is not compatible with any existing
                #       entry on this line (different number of elements
                #       or elements have different expression or different
                #       'exception' tag
                #  - merge it into an existing compatible element
                if (@$branches) {

                    # branch data is not necessarily contiguous
                    #  e.g., 'genhtml/lambda' with gcc/14.2 sees 5
                    #  branches on functional:513, then one at 514
                    #  followed by another at 513 -
                    # so we check to see if we already have a block
                    # here - and merge (rather than appending) if we do
                    my $branchLocation = $branchMap->findOrCreate($line);

                    my $block      = BranchBlock->new();
                    my $branch_num = 0;
                    for my $b (@$branches) {
                        my $brcount = $b->{"count"};
                        if (!defined($brcount) || $unexec) {
                            $brcount = "-";
                        }
                        # need to keep track of whether compiler thinks this
                        #  branch is an exception - so we can skip it later.
                        my $type;
                        if (exists($b->{"throw"}) && $b->{"throw"}) {
                            $type = BranchElement::EXCEPT;
                        } elsif (exists($b->{"fallthrough"}) &&
                                 $b->{"fallthrough"}) {
                            $type = BranchElement::FALLTHROUGH;
                        } else {
                            $type = BranchElement::VANILLA;
                        }
                        my $from;
                        $from = $b->{'source_block_id'}
                            if exists($b->{'source_block_id'});
                        my $to;
                        $to = $b->{'destination_block_id'}
                            if exists($b->{'destination_block_id'});
                        # could record the from/to block address as the
                        #  expression?
                        my $expr;
                        $expr = "$from -> $to"
                            if defined($from) && defined($to);
                        $block->appendElement(BranchElement->new(
                                           $branch_num++, $brcount, $expr, $type
                        ));
                    }
                    my $blk = $branchExprMap->recordOrMergeBlock($line, $block);
                    $branchLocation->insertBlock($block, $line)
                        if $blk;
                }
            }
            if ($conditions && @$conditions) {
                #die("unexpected multiple conditions at $line") if scalar(@$conditions) > 1;
                #lcovutil::debug(1, "MCDC at $filename:$line\n");
                my $mcdc = $mcdcMap->new_mcdc($fileData, $line);

                foreach my $c (@$conditions) {
                    my $count    = $c->{count};
                    my $exprs    = $count / 2;
                    my $coverage = $c->{covered};
                    my $false    = $c->{not_covered_false};
                    my $true     = $c->{not_covered_true};
                    die("expected even condition count: $count") if $count % 2;
                    my @true;
                    my @false;

                    foreach my $m (sort @$false) {
                        $false[$m] = 0;
                    }
                    foreach my $m (sort @$true) {
                        $true[$m] = 0;
                    }
                    for (my $i = 0; $i < $exprs; ++$i) {
                        $mcdc->insertExpr($filename, $exprs, 0,
                                          !defined($false[$i]),
                                          $i, $i);
                        $mcdc->insertExpr($filename, $exprs, 1,
                                          !defined($true[$i]),
                                          $i, $i);
                    }
                }
                $mcdcMap->close_mcdcBlock($mcdc);
            }
        }
        attach_to_statements($fileData,
                             $filename,
                             $lineMap,
                             $branchMap,
                             $mcdcMap,
                             \%unexecBlock,
                             block_graph($file_data->{"lines"}));
        # update the branch counts in this file
        # now go through lines, functions, branches - append to test_name data
        $fileData->sum()->union($lineMap);
        if ($lcovutil::br_coverage) {
            $branchMap->updateCounts();
            $fileData->sumbr()->union($branchMap);
        }
        $fileData->mcdc()->union($mcdcMap)
            if $lcovutil::mcdc_coverage;
        $fileData->func()->union($functionMap)
            if $lcovutil::func_coverage;
    }
    return $traceFile;
}

sub which($)
{
    my $filename = shift;

    return $filename if (file_name_is_absolute($filename));
    foreach my $dir (File::Spec->path()) {
        my $p = catfile($dir, $filename);
        return $p if (-x $p);
    }
    return $filename;
}

sub check_gcov_fail($$)
{
    my ($msg, $filename) = @_;

    if ($msg =~ /version\s+'([^']+)',\s+prefer\s+'([^']+)'/) {
        my $have = $1;
        my $want = $2;
        foreach my $f (\$have, \$want) {
            if ($$f =~ /^(.)0(.)\*$/) {
                # version ID numbering in the gcda/gcno file is not entirely
                # clear to me - but it appears to be "major.0.minor" - where
                # major is integral for versions older than gcc/10, and hex +1
                # for versions after gcc/10.
                my $major =
                    (ord($1) >= ord('A')) ? (ord($1) - ord('A') + 9) : $1;
                $$f = sprintf("%d.%d", $major, $2);
            }
        }
        my $path = which($gcov_tool[0]);
        lcovutil::ignorable_error($lcovutil::ERROR_VERSION,
            "Incompatible GCC/GCOV version found while processing $filename:\n\tYour test was built with '$have'.\n\tYou are trying to capture with gcov tool '$path' which is version '$want'."
        );
        return 1;
    }
    return 0;
}

#
# print_gcov_warnings(type, stderr_file, is_graph, map)
#
# Print GCOV warnings in file STDERR_FILE to STDERR. If IS_GRAPH is non-zero,
# suppress warnings about missing as these are expected. Replace keys found
# in MAP with their values.
#

sub print_gcov_warnings($$$$)
{
    my ($type, $data, $is_graph, $map) = @_;

    my $leader = "$type:\n  ";
    foreach my $line (split('\n', $data)) {
        next if ($is_graph && $line =~ /cannot open data file/);

        for my $key (keys(%{$map})) {
            $line =~ s/\Q$key\E/$map->{$key}/g;
        }

        print(STDERR $leader, $line, "\n");
        $leader = '  ';
    }
}

#
# process_intermediate(directory, file, gcno_file, tempdir)
#
# Create output for a single file (either a data file or a graph file) using
# gcov's intermediate option.
#

sub process_intermediate($$$$)
{
    my ($searchdir, $file, $gcno_file, $tempdir) = @_;
    my $data_file;
    my $errmsg;
    my $errorType = $lcovutil::ERROR_GCOV;
    my %data;
    my $base;
    my $json_basedir;
    my $json_format;
    my $ci_file;               # the '-fcallgraph-info' data for this object
    my $callgraph_info;
    my $callgraph_external;    # ..and its node list's linkage half

    my $filename = defined($file) ? $file : $gcno_file;
    $file = solve_relative_path($cwd, $filename);
    my ($fdir, $fbase, $fext) = split_filename($file);

    my $is_graph = (".$fext" eq $graph_file_extension);

    if ($is_graph) {
        # Process graph file - copy to temp directory to prevent
        # accidental processing of associated data file
        $data_file =
            File::Spec->catfile($tempdir, "$fbase$graph_file_extension");
        if (!copy($file, $data_file)) {
            $errmsg    = "ERROR: Could not copy file $file: $!";
            $errorType = $lcovutil::ERROR_PATH;
            goto err;
        }
    } else {
        $gcno_file = solve_relative_path($cwd, $gcno_file);
        foreach my $f ($file, $gcno_file) {
            my $p = -l $f ? Cwd::abs_path($f) : $f;
            if (!-r $p) {
                $errmsg    = "$f does not exist/is not readable";
                $errorType = $lcovutil::ERROR_PATH;
                goto err;
            }
        }
        # if .gcda and .gcno files are in the same directory, then simply
        #   process in place - otherwise, link the .gcda and .gcno files
        #   into tempdir and run from here
        if (dirname($file) eq dirname($gcno_file)) {
            # Process data file in place
            $data_file = $file;
        } else {
            $data_file = basename($file);
            foreach my $f ($file, $gcno_file) {
                my $l = File::Spec->catfile($tempdir, basename($f));
                debug("create links to process $f in $tempdir\n");
                symlink($f, $l);
                # unclear why symlink returns an error code when it actually
                #  created the link
                if ($? && !-l $l) {
                    $errmsg = "unable to create link for $f: $!";
                    goto err;
                }
            }
        }
    }

    if ($lcovutil::callgraph_coverage) {
        # The callgraph info the compiler wrote for this object:  same directory
        #   and same basename as the '.gcno' geninfo already found, extension
        #   '.ci'.  Read before gcov runs, so that a build which does not have
        #   it can complain before spending a gcov invocation
        my $graph_file = $is_graph ? $file : $gcno_file;
        $graph_file = Cwd::abs_path($graph_file) if -l $graph_file;
        my ($gdir, $gbase, undef) = split_filename($graph_file);
        my $expected = File::Spec->catfile($gdir, "$gbase.ci");
        if (-r $expected) {
            $ci_file = $expected;
            ($callgraph_info, $callgraph_external) =
                read_callgraph_info($ci_file);
        } else {
            # The common case:  the object was not compiled with
            #   '-fcallgraph-info', so there is no callee data to be had.
            #   Complain once - not once per object - otherwise a build
            #   compiled without the flag would issue many, many identical
            #   messages.
            if (lcovutil::warn_once($lcovutil::ERROR_UNSUPPORTED,
                                    'callgraph_ci')
            ) {
                lcovutil::ignorable_error($lcovutil::ERROR_UNSUPPORTED,
                    "--callgraph-coverage: no callgraph info for $graph_file (expected '$expected').  Recompile with '-fcallgraph-info=su,da'."
                );
            }
        }
    }

    # Change directory
    debug(2, "chdir to tempdir $tempdir\n");
    if (!chdir($tempdir)) {
        $errmsg = "Could not change to directory $tempdir: $!";
        goto err;
    }

    # Run gcov on data file
    debug("gcov: " . join(' ', @gcov_tool) . " $data_file\n");
    my $now = Time::HiRes::gettimeofday();
    my ($out, $err, $rc);
    if ($gcov_stdout) {
        # stdout is the JSON - read from a pipe, so that it is never written
        #   anywhere - and its messages are on stderr
        ($err, $rc) = Capture::Tiny::capture_stderr {
            open(my $h, '-|', @gcov_tool, $data_file) or
                return -1;
            local $/;
            $out = <$h>;
            close($h);
            return $?;
        };
    } else {
        ($out, $err, $rc) = system_no_output(1 + 2 + 4, @gcov_tool, $data_file);
    }
    my $then = Time::HiRes::gettimeofday();
    $lcovutil::profileData{exec}{$filename} = $then - $now;
    print_gcov_warnings('stdout', $out, $is_graph, {$data_file => $file,})
        if (!$gcov_stdout &&
            '' ne $out &&
            (0 != $rc ||
             $lcovutil::verbose > 1));
    debug(2, "chdir back to '$cwd'\n");
    chdir($cwd) or die("can't cd back to $cwd: $!");
    print_gcov_warnings('stderr', $err, $is_graph, {$data_file => $file,})
        if ('' ne $err &&
            (0 != $rc ||
             $lcovutil::verbose));

    my $gcovOutGlobPattern =
        "$tempdir/*.gcov $tempdir/.*.gcov $tempdir/*.gcov.json.gz $tempdir/.*gcov.json.gz";

    if (0 != $rc) {
        if (check_gcov_fail($err, $file)) {
            return;
        }
        $errmsg = "GCOV failed for $file";
        # can parse the error log to see if it spaced out - then return
        # code so parent can catch it
        if ($err =~ /out of memory allocating/) {
            lcovutil::info("spaceout calling gcov for '$data_file'\n");
            $errmsg .= ' out of memory';
            $errorType = $lcovutil::ERROR_CHILD
                if 1 != $lcovutil::maxParallelism;
        }
        goto err;
    }

    if ($is_graph) {
        # Remove graph file copy
        unlink($data_file) unless $lcovutil::preserve_intermediates;
    }

    # Parse resulting file(s)
    # 'meson' build system likes to use "." as leading character in generated
    # files.  Seems an unfortunate decision.
    my $start = Time::HiRes::gettimeofday();
    for my $gcov_filename ($gcov_stdout ? (\$out) : glob($gcovOutGlobPattern)) {
        eval {
            if (ref($gcov_filename) || $gcov_filename =~ /\.gcov\.json/) {
                read_intermediate_json($gcov_filename, \%data, \$json_basedir);
                $json_format = 1;
            } else {
                read_intermediate_text($gcov_filename, \%data);
            }
            if (ref($gcov_filename)) {
                # the text is not needed once it is decoded
                undef($out);
            } elsif ($lcovutil::preserve_intermediates) {
                File::Copy::move($gcov_filename, $fdir) or
                    die("cannot rename $gcov_filename: $!");
            } else {
                unlink($gcov_filename);
            }
        };
        if ($@) {
            if (1 != $lcovutil::maxParallelism &&
                $@ =~ /(integrity check failed|cannot start)/) {
                # looks like we ran out of memory..
                # maybe need new error type ERROR_MEMORY
                #$errorType = $lcovutil::ERROR_GCOV;
                $errmsg = $@;
                goto err;
            } else {
                die("read_intermediate failed: $@");
            }
        }
    }
    my $end = Time::HiRes::gettimeofday();
    $lcovutil::profileData{read}{$filename} = $end - $start;

    if (!%data) {
        ignorable_warning($ERROR_GCOV,
                          "GCOV did not produce any data for $file");
        return;
    }

    # Pair the callgraph info against the call data gcov just produced, while
    #   the data is still exactly what the compiler and gcov emitted:  the join
    #   is by order, so it has to see both sequences whole, before any
    #   file of this translation unit can be renamed or dropped
    if (defined($callgraph_info) && $json_format) {
        join_call_sites(\%data, $callgraph_info, $ci_file);
        # ..and hand the linkage half to every file of the unit.  Not joined to
        #   anything:  a symbol's linkage is a property of the symbol, so the
        #   table is consulted by name when the function is defined, in
        #   intermediate_json_to_info().  One table shared by all of them
        #   because the compiler told us about the unit, not about the file
        $_->{$externalKey} = $callgraph_external foreach (values(%data));
    }

    # Determine base directory
    if (defined($base_directory)) {
        $base = $base_directory;
    } elsif (defined($json_basedir)) {
        $base = $json_basedir;
    } else {
        $base = $fdir;

        if (is_compat($COMPAT_MODE_LIBTOOL)) {
            # Avoid files from .libs dirs
            $base =~ s/\.libs$//;
        }

        # Try to find base directory automatically if requested by user
        if ($lcovutil::rc_auto_base) {
            $base = find_base_from_source($base, [keys(%data)]);
        }
    }

    # Apply base file name to relative source files
    adjust_source_filenames(\%data, $base);

    # Remove excluded source files
    filter_source_files(\%data);

    # Generate output
    my $trace =
        $json_format ? intermediate_json_to_info(\%data) :
        intermediate_text_to_info(\%data);
    my $done = Time::HiRes::gettimeofday();
    $lcovutil::profileData{translate}{$filename} = $done - $end;

    return $trace;

    err:
    unlink(glob($gcovOutGlobPattern));    # clean up - in case gcov died
    ignorable_error($errorType, "$errmsg!");
    return undef;
}

# Map LLVM versions to the version of GCC gcov which they emulate.

sub map_llvm_version($)
{
    my $ver = shift;

    return 0x040200 if ($ver >= 0x030400);

    warn("This version of LLVM's gcov is unknown.  " .
         "Assuming it emulates GCC gcov version 4.2.\n");

    return 0x040200;
}

# Return a readable version of encoded gcov version.

sub version_to_str($)
{
    my $ver = shift;

    my $a = $ver >> 16 & 0xff;
    my $b = $ver >> 8 & 0xff;
    my $c = $ver & 0xff;

    return "$a.$b.$c";
}

#
# Get the GCOV tool version. Return an integer number which represents the
# GCOV version. Version numbers can be compared using standard integer
# operations.
#

sub get_gcov_version()
{
    local *HANDLE;
    my ($a, $b, $c) = (4, 2, 0);    # Fallback version

    # Examples for gcov version output:
    #
    # gcov (GCC) 4.4.7 20120313 (Red Hat 4.4.7-3)
    #
    # gcov (crosstool-NG 1.18.0) 4.7.2
    #
    # LLVM (http://llvm.org/):
    #   LLVM version 3.4svn
    #
    # Apple LLVM version 8.0.0 (clang-800.0.38)
    #       Optimized build.
    #       Default target: x86_64-apple-darwin16.0.0
    #       Host CPU: haswell

    if ($lcovutil::verbose) {
        my $which = which($gcov_tool[0]);
        lcovutil::info("gcov is '$which'\n");
    }

    open(GCOV_PIPE, "-|", $gcov_tool[0], '--version') or
        die("cannot execute '$gcov_tool[0] --version': $!\n");
    local $/;
    my $version_string = <GCOV_PIPE>;
    close(GCOV_PIPE);
    if ($?) {
        # Report the exit status - or the signal, if the tool was killed.
        lcovutil::report_exit_status($lcovutil::ERROR_UTILITY,
                                     'unable to determine gcov version',
                                     $?,
                                     "'$gcov_tool[0] --version'",
                                     '');
    }
    # note that a gcov which printed nothing leaves '$version_string' the empty
    #   string, not undef:  a slurp-mode read of an empty stream is defined.
    #   That case is answered by the 'cannot determine gcov version' warning
    #   below

    # Remove all bracketed information
    $version_string =~ s/\([^\)]*\)//g;

    if ($version_string =~ /(\d+)\.(\d+)(\.(\d+))?/) {
        ($a, $b, $c) = ($1, $2, $4);
        $c              = 0 if (!defined($c));
        $version_string = (split('\n', $version_string))[0];
        chomp($version_string);
    } else {
        warn("cannot determine gcov version - assuming $a.$b.$c\n");
    }
    my $result = $a << 16 | $b << 8 | $c;

    if ($version_string =~ /LLVM/) {
        $result = map_llvm_version($result);
        info("Found LLVM gcov version $a.$b.$c, which emulates gcov " .
             "version " . version_to_str($result) . "\n");
    } else {
        info("Found gcov version: " . version_to_str($result) . "\n");
    }

    return ($result, $version_string);
}

#
# info(printf_parameter)
#
# Use printf to write PRINTF_PARAMETER to stdout only when not --quiet
#

sub my_info(@)
{
    # Print info string
    if (defined($output_filename) && ($output_filename eq "-")) {
        # Don't interfere with the .info output to STDOUT
        printf(STDERR @_);
    } else {
        printf(@_);
    }
}

#
# int_handler()
#
# Called when the script was interrupted by an INT signal (e.g. CTRL-C)
#

sub int_handler()
{
    if ($cwd) { chdir($cwd); }
    info("Aborted.\n");
    exit(1);
}

sub process_graphfile($$)
{
    my ($dirname, $file) = @_;
    my $base_dir;

    # Get path to data file in absolute and normalized form (begins with /,
    # contains no more ../ or ./)
    my $graph_filename = solve_relative_path($cwd, $file);

    # Get directory and basename of data file
    my ($graph_dir, $graph_basename) = split_filename($graph_filename);

    my $source_dir = $graph_dir;
    if (is_compat($COMPAT_MODE_LIBTOOL)) {
        # Avoid files from .libs dirs
        $source_dir =~ s/\.libs$//;
    }

    # Construct base_dir for current file
    if ($base_directory) {
        $base_dir = $base_directory;
    } else {
        $base_dir = $source_dir;
    }

    # Ignore empty graph file (e.g. source file with no statement)
    if (-z $graph_filename) {
        lcovutil::ignorable_error($lcovutil::ERROR_EMPTY,
                                  "empty $graph_filename");
        return undef;
    }

    my ($instr, $graph) = read_gcno($graph_filename);

    # Try to find base directory automatically if requested by user
    if ($lcovutil::rc_auto_base) {
        $base_dir =
            find_base_from_source($base_dir,
                                  [keys(%{$instr}), keys(%{$graph})]);
    }

    adjust_source_filenames($instr, $base_dir);
    adjust_source_filenames($graph, $base_dir);

    my $traceFile = TraceFile->new();
    foreach my $filename (sort(keys(%{$instr}))) {
        my $funcdata = $graph->{$filename};
        my $line;
        my $linedata;

        # Skip external files if requested
        if (is_external($filename)) {
            info("  ignoring data for external file $filename\n");
            next;
        }
        # there is no meaningful parse location for this data
        my $fileData    = $traceFile->data($filename);
        my $functionMap = $fileData->testfnc($test_name);
        my $lineMap     = $fileData->test($test_name);

        if (@lcovutil::extractVersionScript) {
            my $version = lcovutil::extractFileVersion($filename);
            $fileData->version($version)
                if (defined($version) && $version ne "");
        }
        if (defined($funcdata) && $lcovutil::func_coverage) {
            my @functions =
                sort({ $funcdata->{$a}->[0] <=> $funcdata->{$b}->[0] }
                     keys(%{$funcdata}));
            # Gather list of instrumented lines and functions.  Demangle all
            # function names in one batched subprocess call rather than forking
            # the demangler once per function.
            my @fnNames =
                filter_fn_name_list(\@functions,
                                    defined($lcovutil::demangle_cpp_cmd));
            for (my $i = 0; $i <= $#functions; ++$i) {
                my $lineNo = $funcdata->{$functions[$i]}->[0];
                my $fnName = $fnNames[$i];
                my $func   = $functionMap->define_function($fnName, $lineNo);
                $func->addAlias($fnName, 0);
            }
        }
        # Print zero line coverage data
        foreach $line (@{$instr->{$filename}}) {
            $lineMap->append($line, 0);
        }
        # now go through lines, functions, branches - append to test_name data
        $fileData->sum()->union($lineMap);
        $fileData->func()->union($functionMap);
    }
    return $traceFile;
}

# Demangle a whole list of function names in a single subprocess invocation
# (chunked to stay under ARG_MAX) instead of forking the demangler once per
# name.  Returns the demangled names in the same order as the input.
# Separate from filter_fn_name_list() because callee symbols must not have the
# delimiter substitution applied to them:  they are compared against the names
# the JSON path takes verbatim from gcov's 'demangled_name', and the callee is
# the last field of the 'FNC:' record, so a comma in it is not ambiguous.
sub demangle_name_list($)
{
    my $names = shift;
    my @out;
    if (@$names) {
        # c++filt (and compatible demanglers) accept the names as argv and
        # emit one demangled name per line, in order.  Chunk the argv so a
        # very long name list cannot overflow the command-line length limit.
        my $argmax = eval { POSIX::sysconf(&POSIX::_SC_ARG_MAX) } || 131072;
        # Leave headroom for the demangler command itself and the environment.
        my $limit = int($argmax / 2);
        my $i     = 0;
        while ($i < @$names) {
            my @chunk;
            my $len = 0;
            while ($i < @$names) {
                my $n = $names->[$i];
                # +1 for the argv NUL separator
                last if (@chunk && $len + length($n) + 1 > $limit);
                push(@chunk, $n);
                $len += length($n) + 1;
                ++$i;
            }
            open(my $fh, '-|', @lcovutil::cpp_demangle, @chunk) or
                die("unable to demangle: $!");
            while (my $line = <$fh>) {
                chomp($line);
                push(@out, $line);
            }
            close($fh);
            if ($?) {
                # '$?', not '$!':  the fork and exec succeeded, so '$!' holds
                #   whatever the last failing syscall left there
                my $cmd = $lcovutil::cpp_demangle[0];
                ($? & 0x7F) &&
                    die("'$cmd' died from signal ", ($? & 0x7F), "\n");
                die("'$cmd' exited with error ", ($? >> 8), "\n");
            }
        }
        die('demangler returned ' .
            scalar(@out) .
            ' names for ' .
            scalar(@$names) .
            ' inputs')
            unless @out == @$names;
    }
    return @out;
}

sub filter_fn_name_list($$)
{
    my ($names, $demangle) = @_;
    my @out = $demangle ? demangle_name_list($names) : @$names;
    # Remove characters used internally as function name delimiters
    s/[,=]/_/g foreach @out;

    return @out;
}

sub filter_fn_name($$)
{
    my ($fn, $demangle) = @_;
    return (filter_fn_name_list([$fn], $demangle))[0];
}

#
# graph_error(filename, message)
#
# Print message about error in graph file. If ignore_graph_error is set, return.
# Otherwise abort.
#

sub graph_error($$)
{
    my ($filename, $msg) = @_;

    ignorable_error($ERROR_GRAPH,
                    "$filename: $msg"
                        .
                        (lcovutil::is_ignored($ERROR_GRAPH) ? ' - skipping' : ''
                        ) .
                        '.');
}

#
# graph_read(handle, bytes[, description, peek])
#
# Read and return the specified number of bytes from handle. Return undef
# if the number of bytes could not be read. If PEEK is non-zero, reset
# file position after read.
#

sub graph_read(*$;$$)
{
    my ($handle, $length, $desc, $peek) = @_;
    my $data;
    my $pos;

    lcovutil::debug(2, $desc);
    if ($peek) {
        $pos = tell($handle);
        if ($pos == -1) {
            lcovutil::ignorable_error($lcovutil::ERROR_CORRUPT,
                                     "Could not get current file position: $!");
            return undef;
        }
    }
    my $result = read($handle, $data, $length);
    # LCOV_EXCL_START
    if ($debug &&
        $debug >= 2) {
        my $op    = $peek ? "peek" : "read";
        my $ascii = "";
        my $hex   = "";
        my $i;

        my $msg = "$op($length)=$result: ";
        for ($i = 0; $i < length($data); $i++) {
            my $c = substr($data, $i, 1);
            my $n = ord($c);

            $hex .= sprintf("%02x ", $n);
            if ($n >= 32 && $n <= 127) {
                $ascii .= $c;
            } else {
                $ascii .= ".";
            }
        }
        lcovutil::debug(2, "$msg$hex |$ascii|\n");
    }
    # LCOV_EXCL_STOP
    if ($peek) {
        if (!seek($handle, $pos, 0)) {
            lcovutil::ignorable_error($lcovutil::ERROR_CORRUPT,
                                      "Could not set file position: $!");
            return undef;
        }
    }
    if ($result != $length) {
        return undef;
    }
    return $data;
}

#
# graph_skip(handle, bytes[, description])
#
# Read and discard the specified number of bytes from handle. Return non-zero
# if bytes could be read, zero otherwise.
#

sub graph_skip(*$;$)
{
    my ($handle, $length, $desc) = @_;

    return defined(graph_read($handle, $length, $desc));
}

#
# uniq(list)
#
# Return list without duplicate entries.
#

sub uniq(@)
{
    my @new_list;
    my %known;

    foreach my $item (@_) {
        next if ($known{$item});
        $known{$item} = 1;
        push(@new_list, $item);
    }

    return @new_list;
}

#
# sort_uniq(list)
#
# Return list in numerically ascending order and without duplicate entries.
#

sub sort_uniq(@)
{
    my %hash;

    foreach (@_) {
        $hash{$_} = 1;
    }
    return sort { $a <=> $b } keys(%hash);
}

#
# parent_dir(dir)
#
# Return parent directory for DIR. DIR must not contain relative path
# components.
#

sub parent_dir($)
{
    my $dir = shift;
    my ($v, $d, $f) = splitpath($dir, 1);
    my @dirs = splitdir($d);

    pop(@dirs);

    return catpath($v, catdir(@dirs), $f);
}

#
# find_base_from_source(base_dir, source_files)
#
# Try to determine the base directory of the object file built from
# SOURCE_FILES. The base directory is the base for all relative filenames in
# the gcov data. It is defined by the current working directory at time
# of compiling the source file.
#
# This function implements a heuristic which relies on the following
# assumptions:
# - all files used for compilation are still present at their location
# - the base directory is either BASE_DIR or one of its parent directories
# - files by the same name are not present in multiple parent directories
#

sub find_base_from_source($$)
{
    my ($base_dir, $source_files) = @_;
    my $old_base;
    my $best_miss;
    my $best_base;
    my %rel_files;

    # Determine list of relative paths
    foreach my $filename (@$source_files) {
        next if (file_name_is_absolute($filename));

        $rel_files{$filename} = 1;
    }

    # Early exit if there are no relative paths
    return $base_dir if (!%rel_files);

    do {
        my $miss = 0;

        foreach my $filename (keys(%rel_files)) {
            if (!-e solve_relative_path($base_dir, $filename)) {
                $miss++;
            }
        }

        debug("base_dir=$base_dir miss=$miss\n");

        # Exit if we find an exact match with no misses
        return $base_dir if ($miss == 0);

        # No exact match, aim for the one with the least source file
        # misses
        if (!defined($best_base) || $miss < $best_miss) {
            $best_base = $base_dir;
            $best_miss = $miss;
        }

        # Repeat until there's no more parent directory
        $old_base = $base_dir;
        $base_dir = parent_dir($base_dir);
    } while ($old_base ne $base_dir);

    return $best_base;
}

#
# adjust_source_filenames(hash, base_dir)
#
# Transform all keys of HASH to absolute form and apply requested
# transformations.
#

sub adjust_source_filenames($$)
{
    my ($hash, $base_dir) = @_;

    foreach my $filename (keys(%{$hash})) {
        my $old_filename = $filename;

        # Convert to absolute canonical form
        $filename = solve_relative_path($base_dir, $filename);

        # Apply adjustment
        $filename = ReadCurrentSource::resolve_path($filename, 1);
        if ($lcovutil::opt_follow && $lcovutil::opt_follow_file_links) {
            $filename = Cwd::realpath($filename);
        }

        if ($filename ne $old_filename) {
            $hash->{$filename} = delete($hash->{$old_filename});
        }
    }
}

#
# filter_source_files(hash)
#
# Remove unwanted source file data from HASH.
#

sub filter_source_files($)
{
    my $hash = shift;

    foreach my $filename (keys(%{$hash})) {
        # Skip external files if requested
        my $external = is_external($filename);
        if ($external ||
            TraceFile::skipCurrentFile($filename)) {
            if ($external) {
                lcovutil::info("Dropping 'external' file '$filename'\n");
            } else {
                lcovutil::info("Excluding file '$filename'\n");
            }
            # Remove file data
            delete($hash->{$filename});
            $lcovutil::excluded_files{$filename} = 1;
        }
    }
}

#
# graph_cleanup(graph)
#
# Remove entries for functions with no lines. Remove duplicate line numbers.
# Sort list of line numbers numerically ascending.
#

sub graph_cleanup($)
{
    my $graph = shift;
    my $filename;

    foreach $filename (keys(%{$graph})) {
        my $per_file = $graph->{$filename};
        my $function;

        foreach $function (keys(%{$per_file})) {
            my $lines = $per_file->{$function};

            if (scalar(@$lines) == 0) {
                # Remove empty function
                delete($per_file->{$function});
                next;
            }
            # Normalize list
            $per_file->{$function} = [uniq(@$lines)];
        }
        if (scalar(keys(%{$per_file})) == 0) {
            # Remove empty file
            delete($graph->{$filename});
        }
    }
}

#
# graph_find_base(bb)
#
# Try to identify the filename which is the base source file for the
# specified bb data.
#

sub graph_find_base($)
{
    my $bb = shift;
    my %file_count;
    my $basefile;

    # Identify base name for this bb data.
    foreach my $func (keys(%{$bb})) {
        my $filedata = $bb->{$func};

        foreach my $file (keys(%{$filedata})) {
            my $count = $file_count{$file};

            # Count file occurrence
            $file_count{$file} = defined($count) ? $count + 1 : 1;
        }
    }
    my $count = 0;
    foreach my $file (keys(%file_count)) {
        if ($file_count{$file} > $count) {
            # The file that contains code for the most functions
            # is likely the base file
            $count    = $file_count{$file};
            $basefile = $file;
        } elsif ($file_count{$file} == $count) {
            # If more than one file could be the basefile, we
            # don't have a basefile
            $basefile = undef;
        }
    }

    return $basefile;
}

#
# graph_from_bb(bb, fileorder, bb_filename, fileorder_first)
#
# Convert data from bb to the graph format and list of instrumented lines.
#
# If FILEORDER_FIRST is set, use fileorder data to determine a functions
# base source file.
#
# Returns (instr, graph).
#
# bb         : function name -> file data
#            : undef -> file order
# file data  : filename -> line data
# line data  : [ line1, line2, ... ]
#
# file order : function name -> [ filename1, filename2, ... ]
#
# graph         : file name -> function data
# function data : function name -> line data
# line data     : [ line1, line2, ... ]
#
# instr     : filename -> line data
# line data : [ line1, line2, ... ]
#

sub graph_from_bb($$$$)
{
    my ($bb, $fileorder, $bb_filename, $fileorder_first) = @_;
    my $graph = {};
    my $instr = {};

    my $basefile = graph_find_base($bb);
    # Create graph structure
    foreach my $func (keys(%{$bb})) {
        my $filedata = $bb->{$func};
        my $order    = $fileorder->{$func};

        # Account for lines in functions
        if (defined($basefile) &&
            defined($filedata->{$basefile}) &&
            !$fileorder_first) {
            # If the basefile contributes to this function,
            # account this function to the basefile.
            $graph->{$basefile}->{$func} = $filedata->{$basefile};
        } else {
            # If the basefile does not contribute to this function,
            # account this function to the first file contributing
            # lines.
            $graph->{$order->[0]}->{$func} =
                $filedata->{$order->[0]};
        }

        foreach my $file (keys(%{$filedata})) {
            # Account for instrumented lines
            my $linedata = $filedata->{$file};
            push(@{$instr->{$file}}, @$linedata);
        }
    }
    # Clean up array of instrumented lines
    foreach my $file (keys(%{$instr})) {
        $instr->{$file} = [sort_uniq(@{$instr->{$file}})];
    }

    return ($instr, $graph);
}

#
# graph_add_order(fileorder, function, filename)
#
# Add an entry for filename to the fileorder data set for function.
#

sub graph_add_order($$$)
{
    my ($fileorder, $function, $filename) = @_;

    my $list = $fileorder->{$function};
    foreach my $item (@$list) {
        if ($item eq $filename) {
            return;
        }
    }
    push(@$list, $filename);
    $fileorder->{$function} = $list;
}

#
# read_gcno_word(handle[, description, peek])
#
# Read and return a word in .gcno format.
#

sub read_gcno_word(*;$$)
{
    my ($handle, $desc, $peek) = @_;

    return graph_read($handle, 4, $desc, $peek);
}

#
# read_gcno_value(handle, big_endian[, description, peek])
#
# Read a word in .gcno format from handle and return its integer value
# according to the specified endianness. If PEEK is non-zero, reset file
# position after read.
#

sub read_gcno_value(*$;$$)
{
    my ($handle, $big_endian, $desc, $peek) = @_;

    my $word = read_gcno_word($handle, $desc, $peek);
    return undef unless defined($word);
    return unpack($big_endian ? 'N' : 'V', $word);
}

#
# read_gcno_string(handle, big_endian)
#
# Read and return a string in .gcno format.
#

sub read_gcno_string(*$)
{
    my ($handle, $big_endian) = @_;

    lcovutil::debug(2, "string");
    # Read string length
    my $length = read_gcno_value($handle, $big_endian, "string length");
    return undef if (!defined($length));
    if ($length == 0) {
        return "";
    }
    $length *= 4;
    # Read string
    my $string = graph_read($handle, $length, "string and padding");
    return undef if (!defined($string));
    $string =~ s/\0//g;

    return $string;
}

#
# read_gcno_lines_record(handle, gcno_filename, bb, fileorder, filename,
#                        function, big_endian)
#
# Read a gcno format lines record from handle and add the relevant data to
# bb and fileorder. Return filename on success, undef on error.
#

sub read_gcno_lines_record(*$$$$$$)
{
    my ($handle, $gcno_filename, $bb, $fileorder, $filename, $function,
        $big_endian)
        = @_;

    lcovutil::debug(2, "lines record");
    # Skip basic block index
    graph_skip($handle, 4, "basic block index") or return undef;
    while (1) {
        # Read line number
        my $lineno = read_gcno_value($handle, $big_endian, "line number");
        return undef if (!defined($lineno));
        if ($lineno == 0) {
            # Got a marker for a new filename
            lcovutil::debug(2, "filename");
            my $string = read_gcno_string($handle, $big_endian);
            return undef if (!defined($string));
            # Check for end of record
            if ($string eq "") {
                return $filename;
            }
            $filename = $string;
            if (!exists($bb->{$function}->{$filename})) {
                $bb->{$function}->{$filename} = [];
            }
            next;
        }
        # Got an actual line number
        if (!defined($filename)) {
            lcovutil::ignorable_error($lcovutil::ERROR_FORMAT,
                                    "unassigned line number in $gcno_filename");
            next;
        }
        # Add to list
        push(@{$bb->{$function}->{$filename}}, $lineno);
        graph_add_order($fileorder, $function, $filename);
    }
}

#
# read_gcno_function_record
#
# Read a gcno format function record from handle and add the relevant data
# to graph. Return (filename, function, artificial) on success, undef on error.
#

sub read_gcno_function_record(*$$$$$)
{
    my ($handle, $bb, $fileorder, $big_endian, $rec_length, $version) = @_;
    my $artificial;

    lcovutil::debug(2, "function record");
    # Skip ident and checksum
    graph_skip($handle, 8, "function ident and checksum") or return undef;
    # must be gcc > 4 - so only split checksum exists
    graph_skip($handle, 4, "function cfg checksum") or return undef;
    # Read function name
    lcovutil::debug(2, "function name");
    my $function = read_gcno_string($handle, $big_endian);
    return undef if (!defined($function));
    if ($version >= GCOV_VERSION_8_0_0) {
        $artificial = read_gcno_value($handle, $big_endian,
                                      "compiler-generated entity flag");
        return undef if (!defined($artificial));
    }
    # Read filename
    lcovutil::debug(2, "filename");
    my $filename = read_gcno_string($handle, $big_endian);
    return undef if (!defined($filename));
    # Read first line number
    my $lineno = read_gcno_value($handle, $big_endian, "initial line number");
    return undef if (!defined($lineno));
    # Skip column and ending line number
    if ($version >= GCOV_VERSION_8_0_0) {
        graph_skip($handle, 4, "column number")      or return undef;
        graph_skip($handle, 4, "ending line number") or return undef;
    }
    # Add to list
    push(@{$bb->{$function}->{$filename}}, $lineno);
    graph_add_order($fileorder, $function, $filename);

    return ($filename, $function, $artificial);
}

#
# map_gcno_version
#
# Map version number as found in .gcno files to the format used in geninfo.
#

sub map_gcno_version($)
{
    my $version = shift;
    my ($major, $minor);

    my $a = $version >> 24;
    my $b = $version >> 16 & 0xff;
    my $c = $version >> 8 & 0xff;

    if ($a < ord('A')) {
        $major = $a - ord('0');
        $minor = ($b - ord('0')) * 10 + $c - ord('0');
    } else {
        $major = ($a - ord('A')) * 10 + $b - ord('0');
        $minor = $c - ord('0');
    }

    return $major << 16 | $minor << 8;
}

sub remove_fn_from_hash($$)
{
    my ($hash, $fns) = @_;

    foreach my $fn (@$fns) {
        delete($hash->{$fn});
    }
}

#
# read_gcno(filename)
#
# Read the contents of the specified .gcno file and return the following
# mapping:
#   graph:    filename -> file_data
#   file_data: function name -> line_data
#   line_data: [ line1, line2, ... ]
#
# See the gcov-io.h file in the gcc 3.3 source code for a description of
# the .gcno format.
#

sub read_gcno($)
{
    my ($gcno_filename) = @_;
    my $file_magic      = 0x67636e6f;
    my $tag_function    = 0x01000000;
    my $tag_lines       = 0x01450000;
    my $big_endian;
    my $filename;
    my $function;
    my $bb        = {};
    my $fileorder = {};
    my $artificial;
    my @artificial_fns;
    local *HANDLE;

    open(HANDLE, "<", $gcno_filename) or goto open_error;
    my $filelength = (stat(HANDLE))[7];
    binmode(HANDLE);
    # Read magic
    my $word = read_gcno_word(*HANDLE, "file magic");
    goto incomplete if (!defined($word));
    # Determine file endianness
    if (unpack("N", $word) == $file_magic) {
        $big_endian = 1;
    } elsif (unpack("V", $word) == $file_magic) {
        $big_endian = 0;
    } else {
        goto magic_error;
    }
    # Read version
    my $version = read_gcno_value(*HANDLE, $big_endian, "compiler version");
    $version = map_gcno_version($version);
    debug(sprintf("found version 0x%08x\n", $version));
    # Skip stamp
    graph_skip(*HANDLE, 4, "file timestamp") or goto incomplete;
    if ($version >= GCOV_VERSION_8_0_0) {
        graph_skip(*HANDLE, 4, "support unexecuted blocks flag") or
            goto incomplete;
    }
    while (!eof(HANDLE)) {
        # Read record tag
        my $tag = read_gcno_value(*HANDLE, $big_endian, "record tag");
        goto incomplete if (!defined($tag));
        # Read record length
        my $length = read_gcno_value(*HANDLE, $big_endian, "record length");
        goto incomplete if (!defined($length));
        # Convert length to bytes
        $length *= 4;
        # Calculate start of next record
        my $next_pos = tell(HANDLE);
        goto tell_error if ($next_pos == -1);
        $next_pos += $length;
        # Catch garbage at the end of a gcno file
        if ($next_pos > $filelength) {
            debug("Overlong record: file_length=$filelength " .
                  "rec_length=$length\n");
            lcovutil::ignorable_error($lcovutil::ERROR_FORMAT,
                              "$gcno_filename: Overlong record at end of file");
            last;
        }
        # Process record
        if ($tag == $tag_function) {
            ($filename, $function, $artificial) =
                read_gcno_function_record(*HANDLE, $bb, $fileorder, $big_endian,
                                          $length, $version);
            goto incomplete if (!defined($function));
            push(@artificial_fns, $function) if ($artificial);
        } elsif ($tag == $tag_lines) {
            # Read lines record
            $filename =
                read_gcno_lines_record(*HANDLE, $gcno_filename, $bb, $fileorder,
                                       $filename, $function, $big_endian);
            goto incomplete if (!defined($filename));
        } else {
            # Skip record contents
            graph_skip(*HANDLE, $length, "unhandled record") or
                goto incomplete;
        }
        # Ensure that we are at the start of the next record
        my $curr_pos = tell(HANDLE);
        goto tell_error if ($curr_pos == -1);
        next if ($curr_pos == $next_pos);
        goto record_error if ($curr_pos > $next_pos);
        graph_skip(*HANDLE, $next_pos - $curr_pos, "unhandled record content")
            or
            goto incomplete;
    }
    close(HANDLE) or die("unable to close $gcno_filename: $!\n");

    # Remove artificial functions from result data
    remove_fn_from_hash($bb, \@artificial_fns);
    remove_fn_from_hash($fileorder, \@artificial_fns);

    my ($instr, $graph) = graph_from_bb($bb, $fileorder, $gcno_filename, 1);
    graph_cleanup($graph);

    return ($instr, $graph);

    open_error:
    graph_error($gcno_filename, "could not open file: $!");
    return undef;
    incomplete:
    graph_error($gcno_filename, "reached unexpected end of file");
    return undef;
    magic_error:
    graph_error($gcno_filename, "found unrecognized gcno file magic");
    return undef;
    tell_error:
    graph_error($gcno_filename, "could not determine file position");
    return undef;
    record_error:
    graph_error($gcno_filename, "found unrecognized record format");
    return undef;
}

#
# get_gcov_capabilities
#
# Determine the list of available gcov options.
#

sub get_gcov_capabilities()
{
    my $help = join(' ', @gcov_tool) . ' --help';
    $help = `$help`;
    if ($?) {
        # '$?', not '$!':  the fork and exec succeeded, so '$!' holds whatever
        #   the last failing syscall left there
        ($? & 0x7F) &&
            die("'$gcov_tool[0] --help' died from signal ", ($? & 0x7F), "\n");
        die("'$gcov_tool[0] --help' exited with error ", ($? >> 8), "\n");
    }
    my %capabilities;
    my %short_option_translations = ('a' => 'all-blocks',
                                     'b' => 'branch-probabilities',
                                     'c' => 'branch-counts',
                                     'f' => 'function-summaries',
                                     'h' => 'help',
                                     'i' => 'intermediate-format',
                                     'l' => 'long-file-names',
                                     'n' => 'no-output',
                                     'o' => 'object-directory',
                                     'p' => 'preserve-paths',
                                     'u' => 'unconditional-branches',
                                     'v' => 'version',
                                     'x' => 'hash-filenames',);

    foreach (split(/\n/, $help)) {
        my $capability;
        if (/--(\S+)/) {
            $capability = $1;
        } else {
            # If the line provides a short option, translate it.
            next if (!/^\s*-(\S)\s/);
            $capability = $short_option_translations{$1};
            next if not defined($capability);
        }
        next if ($capability eq 'help');
        next if ($capability eq 'version');
        next if ($capability eq 'object-directory');

        $capabilities{$capability} = 1;
        debug("gcov has capability '$capability'\n");
    }

    return \%capabilities;
}

#
# compat_name(mode)
#
# Return the name of compatibility mode MODE.
#

sub compat_name($)
{
    my $mode = shift;
    my $name = $COMPAT_MODE_TO_NAME{$mode};

    return $name if (defined($name));

    return "<unknown>";
}

#
# parse_compat_modes(opt)
#
# Determine compatibility mode settings.
#

sub parse_compat_modes($)
{
    my $opt = shift;
    my @opt_list;
    my %specified;

    # Initialize with defaults
    %compat_value = %COMPAT_MODE_DEFAULTS;

    # Add old style specifications
    if (defined($lcovutil::opt_compat_libtool)) {
        $compat_value{$COMPAT_MODE_LIBTOOL} =
            $lcovutil::opt_compat_libtool ? $COMPAT_VALUE_ON :
            $COMPAT_VALUE_OFF;
    }

    # Parse settings
    if (defined($opt)) {
        @opt_list = split(/\s*,\s*/, $opt);
    }
    foreach my $directive (@opt_list) {
        my ($mode, $value);

        # Either
        #   mode=off|on|auto or
        #   mode (implies on)
        if ($directive !~ /^(\w+)=(\w+)$/ &&
            $directive !~ /^(\w+)$/) {
            die("Unknown compatibility mode specification: " . "$directive!\n");
        }
        # Determine mode
        $mode = $COMPAT_NAME_TO_MODE{lc($1)};
        if (!defined($mode)) {
            die("Unknown compatibility mode '$1'!\n");
        }
        $specified{$mode} = 1;
        # Determine value
        if (defined($2)) {
            $value = $COMPAT_NAME_TO_VALUE{lc($2)};
            if (!defined($value)) {
                die("Unknown compatibility mode value '$2'!\n");
            }
        } else {
            $value = $COMPAT_VALUE_ON;
        }
        $compat_value{$mode} = $value;
    }
    # Perform auto-detection
    foreach my $mode (sort(keys(%compat_value))) {
        my $value         = $compat_value{$mode};
        my $is_autodetect = "";
        my $name          = compat_name($mode);

        if ($value == $COMPAT_VALUE_AUTO) {
            my $autodetect = $COMPAT_MODE_AUTO{$mode};

            if (!defined($autodetect)) {
                die("No auto-detection for " . "mode '$name' available!\n");
            }

            if (ref($autodetect) eq "CODE") {
                $value               = &$autodetect();
                $compat_value{$mode} = $value;
                $is_autodetect       = " (auto-detected)";
            }
        }

        if ($specified{$mode}) {
            if ($value == $COMPAT_VALUE_ON) {
                info("Enabling compatibility mode '$name'$is_autodetect\n");
            } elsif ($value == $COMPAT_VALUE_OFF) {
                info("Disabling compatibility mode '$name'$is_autodetect\n");
            } else {
                info("Using delayed auto-detection for " .
                     "compatibility mode '$name'\n");
            }
        }
    }
}

#
# is_compat(mode)
#
# Return non-zero if compatibility mode MODE is enabled.
#

sub is_compat($)
{
    my $mode = shift;

    return $compat_value{$mode} == $COMPAT_VALUE_ON;
}
