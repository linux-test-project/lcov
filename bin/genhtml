                 parseOptions
                 strip_directories
                 parse_cov_filters summarize_cov_filters
                 $FILTER_BRANCH_NO_COND $FILTER_LINE_CLOSE_BRACE @cov_filter
                 rate get_overall_line $default_precision check_precision
                 die_handler warn_handler parse_w3cdtf);

# Global constants
our $title = "LCOV - differential code coverage report";
# the name we were invoked with - which might not be the one worked out by
#   lcovutil:  that one is resolved, so a link is reported as the tool it points
#   at.  'posix_path' makes basename() work on the Windows $0 so
#   git-bash, MSYS or Cygwin perl can be handled - see lcovutil.pm.
lcovutil::set_tool_name(basename(lcovutil::posix_path($0)));

our $debugScheduler = 0;

# if false, then keep track of only enough information to be able to
# produce a valid HTML report.
#   - Do not keep track of everything - say, to enable serialize/deserialize
#     of the complete coverage DB.
#   - In practice: this means to throw away the 'FileDetails' structure after
#     the source file HTML has been constructed.  'FileDetails' is the lion's
#     share of the memory footprint.
# This has the effect of reducing memory footprint and improving parallel
# performance.
our $buildSerializableDatabase = 0;

# Specify coverage rate limits (in %) for classifying file entries
# HI:   $hi_limit <= rate <= 100          graph color: green
# MED: $med_limit <= rate <  $hi_limit    graph color: orange
# LO:          0  <= rate <  $med_limit   graph color: red

# For line coverage/all coverage types if not specified
our $hi_limit  = 90;
our $med_limit = 75;

# For line coverage
our $ln_hi_limit;
our $ln_med_limit;

# For function coverage
our $fn_hi_limit;
our $fn_med_limit;

# For branch coverage
our $br_hi_limit;
our $br_med_limit;

# For MC/DC coverage
our $mcdc_hi_limit;
our $mcdc_med_limit;

# For callgraph (call site) coverage
our $callgraph_hi_limit;
our $callgraph_med_limit;

# Width of overview image
our $overview_width = 80;

# Resolution of overview navigation: this number specifies the maximum
# difference in lines between the position a user selected from the overview
# and the position the source code window is scrolled to.
our $nav_resolution = 4;

# Clicking a line in the overview image should show the source code view at
# a position a bit further up so that the requested line is not the first
# line in the window. This number specifies that offset in lines.
our $nav_offset = 10;

# Clicking on a function name should show the source code at a position a
# few lines before the first line of code of that function. This number
# specifies that offset in lines.
our $func_offset = 2;

our $overview_title = "top level";

# Width for line coverage information in the source code view
our $line_field_width = 12;

# Width for branch coverage information in the source code view
our $br_field_width = 16;

# Width for MC/DC coverage information in the source code view
our $mcdc_field_width = 14;

# Width for owner name in the source code view
our $owner_field_width = 20;

# Width for block age in the source code view
our $age_field_width = 5;

# Width for TLA entry in the source code view
our $tla_field_width = 3;

# Internal Constants

# Header types
our $HDR_DIR      = 0;
our $HDR_FILE     = 1;
our $HDR_SOURCE   = 2;
our $HDR_TESTDESC = 3;
our $HDR_FUNC     = 4;
# the two call site pages of a file:  one direction of the callgraph each - see
#   'write_callgraph_page'
our $HDR_CALLERS = 5;
our $HDR_CALLEES = 6;

# Sort types
our $SORT_FILE      = 0;
our $SORT_LINE      = 1;
our $SORT_FUNC      = 2;
our $SORT_BRANCH    = 3;
our $SORT_MCDC      = 4;
our $SORT_CALLGRAPH = 5;
# ..the file-view sort types are also indices into @fileview_sortname, so a new
#   one goes at the end of that group rather than beside its metric
# function detail sort types
#   - each of them a proportion, ordered lowest first:  see '_rateOrder'
our $SORT_MISSING_LINE      = 6;   # by proportion of hit lines in function
our $SORT_MISSING_BRANCH    = 7;   # by proportion of hit branches in function
our $SORT_MISSING_MCDC      = 8;   # by proportion of hit MC/DC expressions
our $SORT_MISSING_CALLGRAPH = 9;   # by proportion of hit call sites in function
our $SORT_MISSING_CALLERS   = 10;  # by proportion of hit calls into function
# call site page sort types:  the name and the page's own 'Rate' are
#   SORT_FILE and SORT_MISSING_CALLGRAPH
our $SORT_XREF  = 11;    # by the proportion of the other direction
our $SORT_OWNER = 12;    # by who last changed the function
our $SORT_AGE   = 13;    # by how long ago that was

# The two call site pages of a file, in the order the page header names them:
#   one direction of the callgraph each, indexed by CALLGRAPH_VIEW_ and carrying
#   the header type of that page, the name it is written under, what its first
#   column holds, what a column which leads to it is headed and what its own side
#   of a call is called.  One row per page - the two pages differ in their data
#   and in nothing else, so everything which is per page is here.
#   See 'write_callgraph_page'
use constant {
              CALLGRAPH_VIEW_CALLERS => 0,
              CALLGRAPH_VIEW_CALLEES => 1,
              CALLGRAPH_VIEW_COUNT   => 2,
};

#   'siteTitle' is what the location cell of a row leads to, said in the terms of
#     the page the cell is on:  on the callers page that location is the caller's
#     own source line, while on the callees page it is the line of this function
#     which makes the call - the callee's definition is somewhere else entirely,
#     and a reader should not be told to expect it
our @callgraphView = (
         {
          hdr       => $HDR_CALLERS,
          name      => 'callers',
          title     => 'callers',
          column    => 'Caller',
          heading   => ['Called from', 'Call site'],
          hitAlt    => 'unexercised callers of function',
          siteTitle => 'Click to go to caller source line',
         },
         {
          hdr       => $HDR_CALLEES,
          name      => 'callees',
          title     => 'callees',
          column    => 'Callee',
          heading   => ['Call site', 'Callee'],
          hitAlt    => 'unexercised calls made by function',
          siteTitle => 'Click to go to callsite source line (in this function)',
         });

# Call site page: the name of an alias group is - see '_showAliasGroups'
our $ALIAS_GROUP_TITLE =
    'one alias group of this function:  the symbols which make and receive' .
    ' the same calls.  The adjacent rows are the calls of this group';
# ..and what the page says in place of the groups, where they are suppressed
our $ALIAS_GROUPS_SUPPRESSED_NOTE =
    "Alias groups suppressed - see 'suppress_alias_groups' configuration file option";
# ..and a call cell with no calls in it, on a row which contains no call
our $CALLGRAPH_EMPTY_CELL =
    '              <td class="coverCallgraph"></td>' . "\n";
# Call site page:  why the caller rows of a function with several aliases are
#   captioned.  A function which has nothing to say in a direction is not on that
#   direction's page at all - see 'callgraphViewEntries' - so no row of either
#   page has to say that it has nothing to say
our $ALIAS_CAPTION_TITLE =
      'the callers of one alias of this function:  a second symbol for the same'
    . ' definition, which the function table lists under the name in the first'
    . ' column';

# ..and which side of the callgraph boundary a function's callers are on,
#    once beside its name rather than left to be counted out of its rows.
#   Only the answers which involve the boundary are written:
#   'every caller is a site in this report'
#   is both the ordinary case and what the rows themselves show.  See
#   _callgraphCallerNote and lcovutil::classify_callers
our $CALLERS_EXTERNAL_NOTE = 'external callers only';
our $CALLERS_EXTERNAL_TITLE =
    'no call site in this report names this function:  its only callers are' .
    ' outside the callgraph boundary';
our $CALLERS_BOTH_NOTE = 'internal and external callers';
our $CALLERS_BOTH_TITLE =
    'this function is named both by a call site within the callgraph and by' .
    ' one outside of it';
our $CALLERS_UNKNOWN_NOTE = 'callers may be outside the callgraph boundary';
our $CALLERS_UNKNOWN_TITLE =
    "an unknown call count ('-') among the call sites which name this function"
    . ' makes it impossible to tell whether any call came from outside the'
    . ' callgraph boundary';

# ..and the extra last row each of the two sides can have:  an edge which is only
#   a fact about this function, having no call site of its own, because the other
#   end of it is outside the boundary of the report - see FunctionEntry
#   ::has_external_callees and FunctionAlias::has_external_callers.  Named in the
#   angle brackets the sources cannot contain, so that neither can be read as a
#   symbol
# ..and explain that the 'Callgraph:' numbers on the 'callers' detail page
#   is the number of calls made *from* this file (sources in this file) -
#   whereas the row counts calls made *into* the file (or directory, or project)
#   on the other pages ('callee' detail, function call detail, source view,
#   etc.)
our $CALLS_INTO_TITLE =
      'Callgraph edge sources in this file (number of callee sites):  each call'
    . ' location in the table below, once per alias of the function it calls'
    . ' - or, for a function shown as alias groups, once:  its unique call'
    . ' sites.  See \'unique call site\' in genhtml(1)';
# ..and on every other page - the project, a directory, or the other pages of a
#   single file:  the source view, the function detail page and the callees
#   page.  '%s' replaced by page name
our $CALLS_FROM_TITLE =
    'Callgraph edge destinations in this %s (number of caller sites):  every' .
    ' call site record, including several at one location - which the' .
    ' call site pages count as one unique call site where they call the' .
    ' same function.  See \'unique call site\' in genhtml(1)';
our $EXTERNAL_CALLEE_ROW = '&lt;external callee&gt;';
our $EXTERNAL_CALLEE_TITLE =
      'this function calls at least one function which is outside the callgraph'
    . ' boundary:  a function no file of the report defines, or one which an'
    . ' exclude pattern removed from it.  There is no call site'
    . ' row for it because the callee is not within the callgraph boundary,'
    . ' and no count because the site which carried it was outside too';
our $EXTERNAL_CALLER_ROW = '&lt;external callers&gt;';
our $EXTERNAL_CALLER_TITLE =
    'at least one call site outside the callgraph boundary calls this function:'
    . ' a site in a file the report does not contain, one which was excluded,'
    . ' or one in a function which was erased.  We don\'t know the caller'
    . ' name because it is not part of the report.  The count outside the'
    . ' parentheses is the number of calls those sites made';
our $DEDUCED_CALLER_TITLE =
    'this function was entered more often than the call sites in this report' .
    ' account for, so at least one call reached it from outside the callgraph'
    . ' boundary:  an uninstrumented or uncaptured translation unit, a call'
    . ' through a function pointer, or the runtime itself.  The count in'
    . ' parentheses is the number of calls not accounted for';
our $DEDUCED_CALLER_ROW              = '&lt;deduced external callers&gt;';
our $DEDUCED_AND_EXTERNAL_CALLER_ROW = '&lt;external and deduced callers&gt;';
our $EXTERNAL_COUNT_TITLE =
    'a call site outside the callgraph boundary called this function, and' .
    ' how often it called is not recorded';

# Fileview heading types
our $HEAD_NO_DETAIL     = 1;
our $HEAD_DETAIL_HIDDEN = 2;
our $HEAD_DETAIL_SHOWN  = 3;

# Additional offsets used when converting branch coverage data to HTML
our $BR_LEN   = -3;
our $BR_OPEN  = -2;    # 2nd last element
our $BR_CLOSE = -1;    # last  element

