#
# write_file_table(filehandle, callback_type, base_dir, perTestcaseData,
#                  parentSummary, ctrlSettings, activeTlaCols)
#   ctrlSettings = [fileview, sort_type, details_type, sort_name]
#   perTestcaseData = [testhash, testfnchash, testbrhash]
#   activeTlaCols = {coverage_type, [tlas with nonzero count]}
#
# Write a complete file table. OVERVIEW is a reference to a hash containing
# the following mapping:
#
#   filename -> "lines_found,lines_hit,funcs_found,funcs_hit,page_link,
#                func_link" + other file details
#
# TESTHASH is a reference to the following hash:
#
#   filename -> \%testdata
#   %testdata: name of test affecting this file -> \%testcount
#   %testcount: line number -> execution count for a single test
#
# Heading of first column is "Filename" if FILEVIEW is true, "Directory name"
# otherwise.
#

sub write_file_table(*$$$$$$)
{
    local *HTML_HANDLE = $_[0];
    my $callback_type = $_[1];
    my $base_dir      = $_[2];
    my $perTestcaseData =
        $_[3];    # undef or [lineCov, funcCov, branchCov, mcdcCov]
    my $dirSummary = $_[4];    # SummaryInfo object
    my ($fileview, $primary_key, $sort_type, $bin_type) = @{$_[5]};
    my $activeTlaCols = $_[6];
    # $fileview == 0 if listing directories, 1 if listing files
    # $primary_key in ("name", "owner", "date"). If $primary_key is:
    #   - 'name': leftmost column is file/directory name -
    #     this is the original/vanilla genhtml behaviour
    #   - 'owner': leftmost column is author name.  Details for that owner
    #     (for all files in the project, or for all files in this directory)
    #     are shown in a contiguous block.
    #   - 'date': leftmost column is date bin.  Details for that bin are
    #     shown in a contiguous block.
    # $sort_type in ("", "-sort-l", "-sort-b", "-sort-f")
    # $bin_type in ("", "-owner", "-date")
    #   - if $bin_type not "", expand non-empty entries after file/directory
    #     overall count (i.e. - show all the "owners" for this file/directory,
    #     or all date bins for this file/directory)
    #   - $bin_type is applied only if $primary_key is "name"

    $primary_key eq "name" || $bin_type eq "" or
        die(
        "primary key '$primary_key' does not support '$bin_type' detail reporting"
        );

    my $hasBranchData =
        $lcovutil::br_coverage && 0 != $dirSummary->branch_found();
    my $hasMcdcData =
        $lcovutil::mcdc_coverage && 0 != $dirSummary->mcdc_found();
    # ..and the same for functions - except that one of the two reasons the
    #   columns can be missing has a footnote explaining it, so write the reason
    #   down here rather than re-deriving it from '!$includeFunctionColumns'
    #   further down (where "no function data at all" was being reported as
    #   "owner not identified", in reports with no owner data anywhere in them)
    my $hasFunctionData =
        $lcovutil::func_coverage && 0 != $dirSummary->function_found();
    my $elidedFunctionColumnsForOwner =
        $hasFunctionData && 'owner' eq $primary_key;
    my $includeFunctionColumns =
        $hasFunctionData && !$elidedFunctionColumnsForOwner;
    # ..and call sites, which - unlike functions - do have an owner.  See
    #   'CovTypeSummaryCallback::owner'
    my $hasCallgraphData =
        $lcovutil::callgraph_coverage && 0 != $dirSummary->callgraph_found();

    my @tableRows;
    if ($primary_key eq 'name') {
        # sorted list of all the file or directory names
        foreach my $name ($dirSummary->get_sorted_keys($sort_type, 1)) {
            my $entrySummary = $dirSummary->get_source($name);

            if ($entrySummary->type() eq 'directory') {
                if ('directory' eq $dirSummary->type()) {
                    $name = File::Basename::basename($name);
                } elsif ($entrySummary->is_directory(1)) {
                    $name = $lcovutil::dirseparator . $name;
                }
            } else {
                die("unexpected summary type")
                    unless 'file' eq $entrySummary->type();
                $name = File::Basename::basename($name);
            }
            push(@tableRows,
                 FileOrDirectoryCallback->new($name, $entrySummary));
        }

    } elsif ($primary_key eq 'owner') {
        # retrieve sorted list of owner names - alphabetically, by name
        #   or by number of missed lines or missed branches
        my $all = defined($main::show_ownerBins) && $main::show_ownerBins;

        # {owner => {covType => [found, hit]}}:  keyed by coverage type rather
        #   than by a hand-assigned index, so that adding a metric here is one
        #   line rather than a renumbering.  Function coverage is not in this
        #   list - an owner has no function count;  see 'owner_tlaCount'
        my @ownerTypes = ([1, SummaryInfo::LINE_DATA, $SORT_LINE],
                          [$lcovutil::mcdc_coverage, SummaryInfo::MCDC_DATA,
                           $SORT_MCDC
                          ],
                          [$lcovutil::br_coverage, SummaryInfo::BRANCH_DATA,
                           $SORT_BRANCH
                          ],
                          [$lcovutil::callgraph_coverage,
                           SummaryInfo::CALLGRAPH_DATA,
                           $SORT_CALLGRAPH
                          ]);
        my %owners;
        foreach my $d (@ownerTypes) {
            my ($enable, $dataType) = @$d;
            next unless $enable;

            foreach my $owner ($dirSummary->owners($all, $dataType)) {
                $owners{$owner} = {map({ $_->[1] => [0, 0] } @ownerTypes)}
                    unless exists($owners{$owner});

                $owners{$owner}->{$dataType} = [
                        $dirSummary->owner_tlaCount($owner, 'found', $dataType),
                        $dirSummary->owner_tlaCount($owner, 'hit', $dataType)
                ];
            }
        }
        my @sorted = sort(keys(%owners));    # default sort order
                                             # now, sort the owner list...
        foreach my $d (@ownerTypes) {
            my (undef, $dataType, $s) = @$d;
            if ($sort_type eq $s) {
                # sort by number of missed coverpoints of that type
                @sorted = sort({
                                   my $la = $owners{$a}->{$dataType};
                                   my $lb = $owners{$b}->{$dataType};
                                   ($lb->[0] - $lb->[1])
                                       <=> ($la->[0] - $la->[1]) ||
                                       $a cmp $b    # then by name
                } keys(%owners));
                last;
            }
        }

        # don't truncate the 'owner detail table'
        #  if user asked to see the page, then they want to be able to navigate
        #  to all users
        #if (defined($ownerTableElements) &&
        #    $ownerTableElements < scalar(@sorted)) &&
        #    (0 == scalar(@truncateOwnerTableLevels) ||
        #     grep(/$callback_type/, @truncateOwnerTableLevels)))) {
        #    # truncate owner list in header table
        #    splice(@sorted, $ownerTableElements);
        #}

        foreach my $owner (@sorted) {
            push(@tableRows,
                 FileOrDirectoryOwnerCallback->new($owner, $dirSummary));
        }

    } elsif ($primary_key eq 'date') {
        for (my $bin = 0; $bin <= $#SummaryInfo::ageGroupHeader; ++$bin) {
            my $ageval = $dirSummary->age_sample($bin);
            # ..any enabled metric with something in this bin puts a row in the
            #   table
            next
                unless grep({
                                my $covCount = SummaryInfo::covCountMethod($_);
                                SummaryInfo::metricEnabled($_)
                                    &&
                                    0 != $dirSummary->$covCount('found', 'age',
                                                                $ageval);
                } @SummaryInfo::covTypes);
            push(@tableRows,
                 FileOrDirectoryDateCallback->new($bin, $dirSummary));
        }
    } else {
        die("unsupported primary key '$primary_key'");
    }

    # A table keyed by date or owner has the categories its bins have - which
    #   may be fewer than the directory's:  a deleted coverpoint has no current
    #   line, so it has neither a date nor an owner, and an owner whose code is
    #   all exercised is not listed unless 'all' argument.  A category - or a
    #   whole coverage type - which is in none of the rows has no column
    if ($primary_key ne 'name' && !$main::show_zeroTlaColumns) {
        my @types = ([\$hasMcdcData, SummaryInfo::MCDC_DATA],
                     [\$hasBranchData, SummaryInfo::BRANCH_DATA],
                     [\$includeFunctionColumns, SummaryInfo::FUNCTION_DATA],
                     [\$hasCallgraphData, SummaryInfo::CALLGRAPH_DATA]);
        my %binned;
        foreach my $covtype (SummaryInfo::LINE_DATA, map({ $_->[1] } @types)) {
            next
                unless $covtype == SummaryInfo::LINE_DATA ||
                grep({ $_->[1] == $covtype && ${$_->[0]} } @types);
            my @cbs = map({ $_->totalCallback($covtype) } @tableRows);
            next unless grep({ 0 != ($_->get('found') // 0) } @cbs);
            my @tlas;
            foreach my $tla (@{$activeTlaCols->{$covtype} // []}) {
                push(@tlas, $tla)
                    if grep({ 0 != ($_->get($tla) // 0) } @cbs);
            }
            $binned{$covtype} = \@tlas;
        }
        ${$_->[0]} &&= exists($binned{$_->[1]}) foreach (@types);
        $binned{SummaryInfo::LINE_DATA} //= [];
        $activeTlaCols = \%binned;
    }

    # Determine HTML code for column headings
    my $hide = $HEAD_NO_DETAIL;
    my $show = $HEAD_NO_DETAIL;
    if (($dirSummary->type() eq 'directory' ||
         $main::flat ||
         $main::hierarchical) &&
        $show_details
    ) {
        # "detailed" if line coverage hash not empty
        my $detailed =
            defined($perTestcaseData) && scalar(%{$perTestcaseData->[0]});
        $hide = $detailed ? $HEAD_DETAIL_HIDDEN : $HEAD_NO_DETAIL;
        $show = $detailed ? $HEAD_DETAIL_SHOWN : $HEAD_DETAIL_HIDDEN;
    }
    my $file_col_title = ($fileview || $main::flat) ? 'File' : 'Directory';
    # don't insert the 'sort' controls if there is just a single source file
    my $use_sort_button = $sort_tables && 1 < scalar($dirSummary->sources());
    my $file_code =
        get_file_code($hide, $file_col_title,
                      $use_sort_button && $sort_type != $SORT_FILE,
                      $bin_type, $primary_key, $base_dir);
    my $line_code = get_line_code($show,
                                  $sort_type,
                                  "Line Coverage",
                                  $use_sort_button && $sort_type != $SORT_LINE,
                                  $bin_type,
                                  $primary_key,
                                  $base_dir);
    my $func_code = get_func_code($hide,
                                  "Function Coverage",
                                  $use_sort_button && $sort_type != $SORT_FUNC,
                                  $bin_type,
                                  $primary_key,
                                  $base_dir);
    my $br_code = get_br_code($hide,
                              "Branch Coverage",
                              $use_sort_button && $sort_type != $SORT_BRANCH,
                              $bin_type,
                              $primary_key,
                              $base_dir);
    my $mcdc_code = get_mcdc_code($hide,
                                  "MC/DC Coverage",
                                  $use_sort_button && $sort_type != $SORT_MCDC,
                                  $bin_type,
                                  $primary_key,
                                  $base_dir);
    my $callgraph_code =
        get_callgraph_code($hide,
                           "Callgraph Coverage",
                           $use_sort_button && $sort_type != $SORT_CALLGRAPH,
                           $bin_type,
                           $primary_key,
                           $base_dir);

    my @head_columns;

    my @lineCovCols      = (["Rate", 2], "Total");
    my @mcdcCovCols      = ("Rate", "Total");
    my @branchCovCols    = ("Rate", "Total");
    my @functionCovCols  = ("Rate", "Total");
    my @callgraphCovCols = ("Rate", "Total");
    if ($main::show_hitTotalCol) {
        my $t = $main::opt_missed ? "Missed" : "Hit";
        push(@lineCovCols, $t);
        push(@mcdcCovCols, $t);
        push(@branchCovCols, $t);
        push(@functionCovCols, $t);
        push(@callgraphCovCols, $t);
    }
    if ($main::show_tla) {
        my @visit = ([SummaryInfo::LINE_DATA, \@lineCovCols]);
        push(@visit, [SummaryInfo::MCDC_DATA, \@mcdcCovCols])
            if $hasMcdcData;
        push(@visit, [SummaryInfo::BRANCH_DATA, \@branchCovCols])
            if $hasBranchData;
        push(@visit, [SummaryInfo::FUNCTION_DATA, \@functionCovCols])
            if $includeFunctionColumns;
        push(@visit, [SummaryInfo::CALLGRAPH_DATA, \@callgraphCovCols])
            if $hasCallgraphData;
        foreach my $d (@visit) {
            my ($covtype, $cols) = @$d;
            foreach my $tla (@{$activeTlaCols->{$covtype}}) {
                my $label =
                    $main::use_legacyLabels ? $SummaryInfo::tlaToLegacy{$tla} :
                    $tla;
                push(@$cols,
                     [$label,
                      1,
                      $main::use_legacyLabels ?
                          undef :
                          $SummaryInfo::tlaToTitle{$tla}
                     ]);
            }
        }
    }
    # each column group ends with its coverage type, which puts the groups in
    #   the order of the table - see metricColumnRank
    push(@head_columns,
         [$line_code, $#lineCovCols + 2, \@lineCovCols, SummaryInfo::LINE_DATA]
    );
    push(@head_columns,
         [$mcdc_code, $#mcdcCovCols + 1, \@mcdcCovCols, SummaryInfo::MCDC_DATA])
        if $hasMcdcData;
    push(@head_columns,
         [$br_code, $#branchCovCols + 1,
          \@branchCovCols, SummaryInfo::BRANCH_DATA
         ]) if $hasBranchData;
    push(@head_columns,
         [$func_code, $#functionCovCols + 1,
          \@functionCovCols, SummaryInfo::FUNCTION_DATA
         ]) if $includeFunctionColumns;
    push(@head_columns,
         [$callgraph_code, $#callgraphCovCols + 1,
          \@callgraphCovCols, SummaryInfo::CALLGRAPH_DATA
         ]) if $hasCallgraphData;
    my $rank = metricColumnRank($sort_type);
    @head_columns = _inColumnOrder($rank, 3, @head_columns);

    my $showBinDetail = undef;
    if ($bin_type eq '-date' &&
        $dirSummary &&
        $dirSummary->hasDateInfo()) {
        $showBinDetail = 'date';
    } elsif ($bin_type eq '-owner' &&
             $dirSummary &&
             $dirSummary->hasOwnerInfo()) {
        $showBinDetail = 'owner';
    }
    my $num_columns =
        write_file_table_prolog(
                               *HTML_HANDLE,
                               $file_code,
                               defined($showBinDetail) ? $showBinDetail : undef,
                               $primary_key,
                               @head_columns);

    my $all = defined($main::show_ownerBins) && $main::show_ownerBins eq 'all';
    # show only the 'Total' row if all row entries are suppressed
    #  because they have no un-exercised coverpoints
    my $elideEmptyRows = 0;
    if ($primary_key eq 'owner') {
        $elideEmptyRows = $main::show_ownerBins ne 'all';
    } elsif ($primary_key eq 'date') {
        $elideEmptyRows = 1;
    }
    my $suppressedEmptyRow = 0;
    # if only one secondary entry, we don't need the 'Total' header
    my $suppressedSecondaryHeader = 0;

    foreach my $primaryCb (@tableRows) {
        # we need to find the 'owner' and 'date' row data for this file before
        #   we write anything else, because we need to know the number of
        #   rows that the $primary cell will span

        my @secondaryRows;
        my $skippedSecondaryRows = 0;

        if (defined($showBinDetail)) {
            if (defined($primaryCb->summary())) {
                my $source = $primaryCb->summary();

                if ($showBinDetail eq 'owner') {
                    # do I need an option to suppress the list of owners?
                    #  maybe too much information, in some circumstances?
                    # are there any non-empty owner tables here?
                    # If user explicitly asks to see the 'owner detail' page,
                    #  then they must be interested in which code is written by
                    #   each author - so we should not truncate the list
                    my ($ownerList, $truncated) =
                        $primaryCb->findOwnerList($callback_type, 0, $all);
                    die("unexpected truncate count") unless $truncated == 0;
                    push(@secondaryRows, @$ownerList)
                        if defined($ownerList);
                }

                if ($showBinDetail eq 'date') {
                    for (my $bin = 0;
                         $bin <= $#SummaryInfo::ageGroupHeader;
                         ++$bin) {
                        my $ageval = $source->age_sample($bin);
                        # same {covType => [missed, total, callback]} shape as
                        #   'findOwnerList' and 'findFileList' produce
                        my %covBin =
                            SummaryInfo::binCovData(sub {
                            return $primaryCb->dateDetailCallback($ageval,
                                                                  shift);
                            });
                        next
                            unless grep({ 0 != $covBin{$_}->[1] }
                                        @SummaryInfo::covTypes);
                        push(@secondaryRows,
                             [$SummaryInfo::ageGroupHeader[$bin], \%covBin]);
                    }
                }
            }
        }    # if showBinDetail
        elsif ($primary_key ne 'name') {
            ($skippedSecondaryRows, @secondaryRows) =
                @{$primaryCb->findFileList($all)};
        }

        # one (found, hit) pair per @SummaryInfo::covTypes, in that order
        my ($found, $hit, $fn_found,
            $fn_hit, $callgraph_found, $callgraph_hit,
            $br_found, $br_hit, $mcdc_found,
            $mcdc_hit, $page_link, $fileSummary,
            $fileDetails) = $primaryCb->data();
        # a bit of a hack: if this is top-level page (such that the links
        #   are to directory pages rather than to source code detail pages)
        #   and this is the 'owner bin detail' (or the 'date bin detail') view,
        #   then link to the same 'bin detail' view of the directory page
        # This enables the user who is tracking down code written by a
        #   particular user (or on a particular date) to go link-to-link
        #   without having to select the 'bin' link in the destination header.
        if ($fileview == 0 &&
            $bin_type ne "") {
            $page_link =~ s/index.$html_ext$/index$bin_type.$html_ext/;
        }

        my @columns;

        my @tableCallbackData = ($primaryCb->name(), $primaryCb->summary(),
                                 $fileDetails, $page_link);
        my $showLineGraph = 1;
        # Line coverage
        push(@columns,
             [$found, $hit, $med_limit, $hi_limit, $showLineGraph,
              $primaryCb->totalCallback(SummaryInfo::LINE_DATA),
              SummaryInfo::LINE_DATA
             ]);
        # MC/DC coverage
        if ($hasMcdcData) {
            push(@columns,
                 [$mcdc_found,
                  $mcdc_hit,
                  $mcdc_med_limit,
                  $mcdc_hi_limit,
                  0,
                  $primaryCb->totalCallback(SummaryInfo::MCDC_DATA),
                  SummaryInfo::MCDC_DATA
                 ]);
        }
        # Branch coverage
        if ($hasBranchData) {
            push(@columns,
                 [$br_found,
                  $br_hit,
                  $br_med_limit,
                  $br_hi_limit,
                  0,
                  $primaryCb->totalCallback(SummaryInfo::BRANCH_DATA),
                  SummaryInfo::BRANCH_DATA
                 ]);
        }
        # Function coverage
        if ($includeFunctionColumns) {
            # no 'owner' callbacks for function...
            my $cbStruct =
                $primaryCb->totalCallback(SummaryInfo::FUNCTION_DATA);

            push(@columns,
                 [$fn_found, $fn_hit, $fn_med_limit, $fn_hi_limit, 0,
                  $cbStruct, SummaryInfo::FUNCTION_DATA
                 ]);
        }
        # Callgraph coverage
        if ($hasCallgraphData) {
            push(@columns,
                 [$callgraph_found,
                  $callgraph_hit,
                  $callgraph_med_limit,
                  $callgraph_hi_limit,
                  0,
                  $primaryCb->totalCallback(SummaryInfo::CALLGRAPH_DATA),
                  SummaryInfo::CALLGRAPH_DATA
                 ]);
        }
        my $elide_secondary_header = $compactSummaryTables &&
            (scalar(@secondaryRows) == 1 && $skippedSecondaryRows == 0);
        $suppressedSecondaryHeader ||= $elide_secondary_header;
        if (!$elide_secondary_header) {
            # pass 'dirSummary' to print method:  we omit the 'owner' column if
            #  none of the files in this directory have any owner information
            #  (i.e., none of them are found in the repo)
            my $numRows = (1 + scalar(@secondaryRows));
            my $asterisk;
            if ($elideEmptyRows && (1 == $numRows || $skippedSecondaryRows)) {
                $asterisk           = '&lowast;';
                $suppressedEmptyRow = 1;
            }
            @columns = _inColumnOrder($rank, 6, @columns);
            write_file_table_entry(*HTML_HANDLE,
                                   $base_dir,
                                   [$primaryCb->name(), \@tableCallbackData,
                                    $activeTlaCols, $numRows,
                                    $primary_key, 0,
                                    $fileview, "fileOrDir",
                                    $page_link, $dirSummary,
                                    $showBinDetail, $asterisk
                                   ],
                                   @columns);
        }

        # sort secondary rows...
        if ($sort_type == $SORT_FILE) {
            # alphabetic
            @secondaryRows = sort({ $a->[0] cmp $b->[0] } @secondaryRows);
        } else {
            # the secondary row bins are keyed by coverage type, so the sort key
            #   is the type itself rather than a position in the row
            my %sortKey = ($SORT_LINE      => SummaryInfo::LINE_DATA,
                           $SORT_FUNC      => SummaryInfo::FUNCTION_DATA,
                           $SORT_CALLGRAPH => SummaryInfo::CALLGRAPH_DATA,
                           $SORT_BRANCH    => SummaryInfo::BRANCH_DATA,
                           $SORT_MCDC      => SummaryInfo::MCDC_DATA);
            my $sortElem = $sortKey{$sort_type};
            @secondaryRows =
                sort({
                         my $ca = $a->[1]->{$sortElem};
                         my $cb = $b->[1]->{$sortElem};
                         # sort based on 'missed' - then by name, so a tie
                         #   is in the same order in every run
                         $cb->[0]    <=> $ca->[0] or
                             $a->[0] cmp $b->[0];
                } @secondaryRows)
                if defined($sortElem);
        }
        foreach my $secondary (@secondaryRows) {
            my ($name, $covBin) = @$secondary;
            my ($lineMissed, $lineTotal, $lineCb) =
                @{$covBin->{(SummaryInfo::LINE_DATA)}};
            my $lineHit = $lineTotal - $lineMissed;

            my $fileInfo = $primaryCb->secondaryElementFileData($name);

            my $entry_type = $lineCb->cb_type();

            my @ownerColData;
            push(@ownerColData,
                 [$lineTotal, $lineHit, $med_limit,
                  $hi_limit, $showLineGraph, $lineCb,
                  SummaryInfo::LINE_DATA
                 ]);
            foreach my $d ([$hasMcdcData, SummaryInfo::MCDC_DATA],
                           [$hasBranchData, SummaryInfo::BRANCH_DATA],
                           [$includeFunctionColumns,
                            SummaryInfo::FUNCTION_DATA
                           ],
                           [$hasCallgraphData, SummaryInfo::CALLGRAPH_DATA]
            ) {
                my ($include, $covType) = @$d;
                next unless $include;
                my ($missed, $total, $callback) = @{$covBin->{$covType}};
                # need to compute the totals...
                my ($lim_med, $lim_high) = covLimits($covType);
                push(@ownerColData,
                     [$total, $total - $missed, $lim_med, $lim_high,
                      0, $callback, $covType
                     ]);
            }
            if ($dirSummary->type() eq 'directory') {
                # use the basename (not the path or full path) in the
                #  secondary key list:
                #  - these are files in the current directory, so we lose
                #    no information by eliding the directory part
                $name = File::Basename::basename($name);
            }
            $name         = apply_prefix($name, @dir_prefix);
            @ownerColData = _inColumnOrder($rank, 6, @ownerColData);
            write_file_table_entry(*HTML_HANDLE, $base_dir,
                                   # 'owner' page type - no span, no page link
                                   [$name,
                                    $fileInfo,
                                    $activeTlaCols,
                                    1,
                                    $primary_key,
                                    1 + $elide_secondary_header,
                                    $fileview,
                                    $entry_type,
                                   ],
                                   @ownerColData);
        }

        next
            unless ($show_details &&
                    defined($perTestcaseData) &&
                    $primary_key eq "name");

        # we know that the top-level callback item must hold a file.
        my $filename = $primaryCb->name();

        my ($testhash, $testfnchash, $testbrhash, $testcase_mcdc) =
            @$perTestcaseData;

        my $testdata = $testhash->{$filename};

        # Check whether we should write test specific coverage as well
        next if (!defined($testdata));

        my $testfncdata = $testfnchash->{$filename};
        my $testbrdata  = $testbrhash->{$filename};
        my $test_mcdc   = $testcase_mcdc->{$filename};

        # Filter out those tests that actually affect this file
        my $affecting_tests =
            get_affecting_tests($testdata, $testfncdata,
                                $testbrdata, $test_mcdc);

        # Does any of the tests affect this file at all?
        if (!%$affecting_tests) { next; }

        while (my ($testname, $data) = each(%$affecting_tests)) {
            ($found, $hit, $fn_found, $fn_hit, $br_found, $br_hit, $mcdc_found,
             $mcdc_hit) = @$data;

            my $showgraph = 0;
            my @results;
            push(@results,
                 [$found, $hit,
                  SummaryInfo::LINE_DATA,
                  TestcaseTlaCount->new($testdata->value($testname),
                                        $fileDetails,
                                        SummaryInfo::LINE_DATA)
                 ]);
            # there might not be optional test data for some tests - that type was
            #  not enabled
            push(@results,
                 [$mcdc_found,
                  $mcdc_hit,
                  SummaryInfo::MCDC_DATA,
                  TestcaseTlaCount->new($test_mcdc->value($testname),
                                        $fileDetails,
                                        SummaryInfo::MCDC_DATA)
                 ])
                if ($hasMcdcData &&
                    defined($test_mcdc->value($testname)));

            push(@results,
                 [$br_found,
                  $br_hit,
                  SummaryInfo::BRANCH_DATA,
                  TestcaseTlaCount->new($testbrdata->value($testname),
                                        $fileDetails,
                                        SummaryInfo::BRANCH_DATA)
                 ])
                if ($hasBranchData &&
                    defined($testbrdata->value($testname)));

            push(@results,
                 [$fn_found,
                  $fn_hit,
                  SummaryInfo::FUNCTION_DATA,
                  TestcaseTlaCount->new($testfncdata->value($testname),
                                        $fileDetails,
                                        SummaryInfo::FUNCTION_DATA)
                 ])
                if ($includeFunctionColumns &&
                    defined($testfncdata->value($testname)));

            my $href = $testname;
            # Insert link to description of available
            if ($test_description{$testname}) {
                $href =
                    "<a href=\"$base_dir" .
                    "descriptions.$html_ext#T" .
                    escape_id($testname) . "\">" .
                    "$testname</a>";
            }
            # ..and a column group the test has no data for is empty, so that
            #   the groups after it line up with their headings
            my %present = map({ ($_->[2] => 1) } @results);
            foreach my $d ([$hasMcdcData, SummaryInfo::MCDC_DATA],
                           [$hasBranchData, SummaryInfo::BRANCH_DATA],
                           [$includeFunctionColumns,
                            SummaryInfo::FUNCTION_DATA
                           ],
                           [$hasCallgraphData, SummaryInfo::CALLGRAPH_DATA]
            ) {
                my ($include, $covType) = @$d;
                push(@results, [undef, undef, $covType])
                    if $include && !exists($present{$covType});
            }
            @results = _inColumnOrder($rank, 2, @results);
            pop(@results) while !defined($results[-1]->[0]);
            write_file_table_detail_entry(*HTML_HANDLE, $base_dir,
                               $href, $showBinDetail, $activeTlaCols, @results);
        }
    }
    foreach my $note (
        [   $suppressedEmptyRow,
            "<sup>&lowast;</sup> 'Detail' entries with no 'missed' coverpoints are elided.  Use the '--show-owners all' flag to retain them."
        ],
        [   $suppressedSecondaryHeader,
            '<sup>&lowast;&lowast;</sup> Bin \'Total\' header elided when bin contains only one entry.'
        ],
        [   $elidedFunctionColumnsForOwner,
            "Note:  'Function Coverage' columns elided as function owner is not identified."
        ]
    ) {
        next unless $note->[0];
        write_html(*HTML_HANDLE, <<END_OF_HTML);
        <tr>
          <td class="footnote" colspan=$num_columns>$note->[1]</td>
         </tr>
END_OF_HTML

    }

    write_file_table_epilog(*HTML_HANDLE);
}

#
# get_affecting_tests(testdata, testfncdata, testbrdata, pertest_mcdc)
#
# HASHREF contains a mapping filename -> (linenumber -> exec count). Return
# a hash containing mapping filename -> "lines found, lines hit" for each
# filename which has a nonzero hit count.
#

sub get_affecting_tests($$$$)
{
    my ($testdata, $testfncdata, $testbrdata, $testmcdcdata) = @_;
    my %result;

    foreach my $testname ($testdata->keylist()) {
        # Get (line number -> count) hash for this test case
        my $testcount = $testdata->value($testname);
        my ($found, $hit) = $testcount->get_found_and_hit();
        # no other coverpoints are hit, if the line isn't hit
        next if $hit == 0;

        # Calculate sum
        my $testfnccount  = $testfncdata->value($testname);
        my $testbrcount   = $testbrdata->value($testname);
        my $testmcdccount = $testmcdcdata->value($testname);
        # might be no data for this testcase
        my ($fn_found, $fn_hit) =
            defined($testfnccount) ? $testfnccount->get_found_and_hit() :
            (0, 0);
        my ($br_found, $br_hit) =
            defined($testbrcount) ? $testbrcount->get_found_and_hit() : (0, 0);
        my ($mcdc_found, $mcdc_hit) =
            defined($testmcdccount) ? $testmcdccount->get_found_and_hit() :
            (0, 0);
        $result{$testname} = [$found, $hit, $fn_found, $fn_hit,
                              $br_found, $br_hit, $mcdc_found, $mcdc_hit
        ];
    }
    return \%result;
}

#
# write_source(filehandle, source_filename, count_data, checksum_data,
#              converted_data, func_data, sumbrcount, mcdc_summary, base_dir)
#
# Write an HTML view of a source code file. Returns a list containing
# data as needed by gen_png().
#
# Die on error.
#

sub write_source($$$$$$$$$)
{
    local *HTML_HANDLE = shift;
    my ($srcfile, $count_data, $checkdata, $fileCovInfo,
        $funcdata, $sumbrcount, $mcdc_summary, $base_dir) = @_;
    my @result;

    # The @result list is only consumed to build the PNG overview / frameset,
    # i.e. when --frames is in effect.  When frames are off (the common case)
    # accumulating it -- one push per source line, each string retained until
    # the whole file is rendered -- is pure time and memory overhead, so skip
    # the pushes entirely.
    my $collect = $frames;

    # suppress branch and MCDC columns if there is no data in the file
    my $showBranches = $lcovutil::br_coverage   && 0 != $sumbrcount->found();
    my $showMcdc     = $lcovutil::mcdc_coverage && 0 != $mcdc_summary->found();

    write_source_prolog(*HTML_HANDLE, $srcfile->isProjectFile(),
                        $showBranches, $showMcdc);
    my $line_number = 0;
    # the call sites of this file, and the page whose table shows them:  the
    #   callees page, since a site in the source is one of the calls made by the
    #   function which contains it.  Both are in the same directory as this page,
    #   so a bare file name links there.  The order is the one a reader who
    #   followed a link wants, which is by name - see callgraphPageName
    my ($callSites, $callgraphPage);
    if ($lcovutil::callgraph_coverage && defined($funcdata)) {
        # ..and the calls this file's text makes on behalf of a function of some
        #   other file, whose table is on that other file's page - see
        #   %callgraphForeignSites.  The page is resolved here rather than in
        #   the parent which collected them, because it is relative to this page
        my @foreign;
        my $foreignSites = $main::callgraphForeignSites{$srcfile->path()};
        foreach my $group (@{$foreignSites || []}) {
            my $owner = filePageBase($group->[4], $base_dir);
            next unless defined($owner);
            push(@foreign,
                 [@$group[0 .. 3],
                  $owner . '.' .
                      $callgraphView[CALLGRAPH_VIEW_CALLEES]->{name} .
                      ".$html_ext"
                 ]);
        }
        $callSites = callgraphSourceGroups($funcdata, \@foreign);
        $callgraphPage =
            callgraphPageName(File::Basename::basename($srcfile->path()),
                              CALLGRAPH_VIEW_CALLEES);
    }
    my $cbdata =
        PrintCallback->new($srcfile, $fileCovInfo, $callSites, $callgraphPage);
    $cbdata->locate(0, $sumbrcount) if $showBranches;
    $cbdata->locate(1, $mcdc_summary) if $showMcdc;

    my ($region, $empty);
    if ($SummaryInfo::selectCallback) {
        $region = InInterestingRegion->new($srcfile, $fileCovInfo->lineMap());
        $empty  = '';
        if ($srcfile->isProjectFile()) {
            $empty .= ' ' x $main::age_field_width;
            $empty .= ' ' x $main::owner_field_width;
        }
        # using 8 characters for line number field, with different
        # foreground/background - to make distinctive
        $empty .=
            '  <span class="lineNumWithDelete">' .
            (' ' x (8 - 3)) .
            '...</span>';
        $empty .= ' ' x $main::br_field_width if $showBranches;
        $empty .= ' ' x $main::mcdc_field_width if $showMcdc;
        $empty .= ' ' x $main::tla_field_width;
        $empty .= ' ' x ($line_field_width - 1);
        $empty .=
            '<span class="elidedSource">     (elided NUM_LINES ignored lines)</span>';
    }

    my $prevLine = 0;
    foreach my $srcline (@{$srcfile->lines()}) {
        $line_number++;
        $cbdata->lineNo($line_number);
        if (defined($region) && !$region->interesting($line_number)) {
            lcovutil::info(1, "skip line $line_number\n");
            next;
        }
        $main::pageShown->{gcov}->{$line_number} = 1
            if defined($main::pageShown);
        if ($prevLine != $line_number - 1) {
            $cbdata->age(-1, $line_number);
            $cbdata->owner(undef, $line_number);
            $cbdata->tla(undef, $line_number);

            lcovutil::info(1, "continuation_line $line_number\n");
            my $l = $empty;
            my $c = $line_number - ($prevLine + 1);
            $l =~ s/NUM_LINES/$c/;
            $l =~ s/lines/line/ if $c == 1;
            push(@result, $l) if $collect;
            write_html(*HTML_HANDLE, $l . "\n");
        }
        $prevLine = $line_number;

        # Source code matches coverage data?
        lcovutil::ignorable_error($lcovutil::ERROR_MISMATCH,
                 "checksum mismatch at " . $srcfile->path() . ":$line_number\n")
            if (
               defined($checkdata->value($line_number)) &&
               ($checkdata->value($line_number) ne md5_base64($srcline->text()))
            );
        my $rendered =
            write_source_line(HTML_HANDLE, $srcline,
                              $count_data->value($line_number), $showBranches,
                              $sumbrcount->value($line_number), $showMcdc,
                              $mcdc_summary->value($line_number), $cbdata);
        push(@result, $rendered) if $collect;
    }
    if ($prevLine != $line_number) {
        # need another blank line at the bottom...
        my $l = $empty;
        my $c = $line_number - $prevLine;
        $l =~ s/NUM_LINES/$c/;
        push(@result, $l) if $collect;
        write_html(*HTML_HANDLE, $l . "\n");
    }

    write_source_epilog(*HTML_HANDLE);
    return (@result);
}

sub funcview_get_label($$$$)
{
    my ($name, $base, $col, $sort_type) = @_;
    my $link;

    if (!defined($col)) {
        if ($sort_tables && $sort_type != $SORT_FILE) {
            $link = "$name.func.$html_ext";
        }
        return "Function Name" . get_sort_code($link, "function name", $base);
    } elsif ($col eq 'hit') {
        if ($sort_tables && $sort_type != $SORT_LINE) {
            $link = "$name.func-c.$html_ext";
        }
        return "Hit count" . get_sort_code($link, "function hit count", $base);
    } elsif ($col eq 'missed_line') {
        if ($sort_tables && $sort_type != $SORT_MISSING_LINE) {
            $link = "$name.func-l.$html_ext";
        }
        return "Lines" .
            get_sort_code($link, "unexercised lines in function", $base);
    } elsif ($col eq 'missed_mcdc') {
        if ($sort_tables && $sort_type != $SORT_MISSING_MCDC) {
            $link = "$name.func-m.$html_ext";
        }
        return "MC/DC"
            .
            get_sort_code($link, "unexercised MC/DC expressions in function",
                          $base);
    } elsif ($col eq 'missed_callgraph') {
        if ($sort_tables && $sort_type != $SORT_MISSING_CALLGRAPH) {
            $link = "$name.func-x.$html_ext";
        }
        return "Callgraph" .
            get_sort_code($link, "unexercised call sites in function", $base);
    } elsif ($col eq 'callers') {
        if ($sort_tables && $sort_type != $SORT_MISSING_CALLERS) {
            $link = "$name.func-r.$html_ext";
        }
        return ucfirst($callgraphView[CALLGRAPH_VIEW_CALLERS]->{title})
            .
            get_sort_code($link,
                          $callgraphView[CALLGRAPH_VIEW_CALLERS]->{hitAlt},
                          $base);
    } else {
        die("unexpected sort $col") unless ($col eq 'missed_branch');
        if ($sort_tables && $sort_type != $SORT_MISSING_BRANCH) {
            $link = "$name.func-b.$html_ext";
        }
        return "Branches" .
            get_sort_code($link, "unexercised branches in function", $base);
    }
}

sub callgraphview_get_label($$$$$)
{
    # The headings of a call site page which are also its orders:  the name of
    #   the function, which is how a reader looks one up;  how much of that
    #   function's own side of the callgraph was exercised, which is what the
    #   reader who is not looking for a particular function came for;  how much
    #   of the other side was;  and who last changed the function, and when.
    # The sort widget of the order the page is already in has no link, exactly as
    #   in the function table:  the reader is looking at that order
    my ($name, $base, $col, $view, $sort_type) = @_;
    my $page = $callgraphView[$view];
    my ($order, $label, $alt);
    if (!defined($col)) {
        ($order, $label, $alt) = ($SORT_FILE, 'Function Name', 'function name');
    } elsif ($col eq 'hit') {
        ($order, $label, $alt) =
            ($SORT_MISSING_CALLGRAPH, 'Rate', $page->{hitAlt});
    } elsif ($col eq 'xref') {
        # ..the way to the other direction, which is that direction's proportion
        my $other = $callgraphView[1 - $view];
        ($order, $label, $alt) =
            ($SORT_XREF, $other->{column}, $other->{hitAlt});
    } elsif ($col eq 'owner') {
        ($order, $label, $alt) = ($SORT_OWNER, 'Owner', 'owner');
    } else {
        die("unexpected sort $col") unless $col eq 'age';
        ($order, $label, $alt) = ($SORT_AGE, 'Age', 'age');
    }
    my $link;
    $link = callgraphPageName($name, $view, $order)
        if $sort_tables && $sort_type != $order;
    return $label . get_sort_code($link, $alt, $base);
}

#
# funcview_get_sorted(funcdata, sort_type, mergedView)
#
# Depending on the value of sort_type, return a list of functions sorted
# by name (type 0), by the associated call count (type 1) or by the
# proportion of one of the columns of the function table.
#

sub funcview_get_sorted($$$)
{
    my ($funcData, $type, $merged) = @_;

    my ($differential_func, $lineFuncData, $branchFuncData, $mcdcFuncData,
        $calleeFuncData, undef, $callgraphXref) = @$funcData;
    my @rtn = keys(%$differential_func);

    if ($type == $SORT_LINE) {
        @rtn = sort({
                        my $da = $differential_func->{$a}->hit();
                        my $db = $differential_func->{$b}->hit();
                        $da->[0] <=> $db->[0] or
                            # sort by function name if count matches
                            $a cmp $b
        } @rtn);
    } elsif ($type != $SORT_FILE) {
        # lowest to highest exercised proportion of the column the table is
        #   sorted by - see '_rateOrder' - then by function name.  The calls
        #   which reach a function are none at all for one which is not on the
        #   callers page
        my $map;
        if ($type == $SORT_MISSING_CALLERS) {
            $map = {
                  map({ ($_ => $callgraphXref->{$_}->[CALLGRAPH_VIEW_CALLERS]) }
                      keys(%$callgraphXref))
            };
        } else {
            my %column = ($SORT_MISSING_LINE      => $lineFuncData,
                          $SORT_MISSING_BRANCH    => $branchFuncData,
                          $SORT_MISSING_MCDC      => $mcdcFuncData,
                          $SORT_MISSING_CALLGRAPH => $calleeFuncData,);
            die("unexpected sort $type") unless exists($column{$type});
            $map = $column{$type};
        }
        @rtn = sort({ _rateOrder($map->{$a}, $map->{$b}) or $a cmp $b } @rtn);
    } elsif (!defined($main::no_sort)) {
        # sort alphabetically by function name
        @rtn = sort(@rtn);
    }
    return @rtn;
}

# Where each function of the report is defined, keyed by symbol, as
#   [file, line, leader name].  The callee cell of a call site row leads to that
#   callee's own callers page, and all the site record holds is a bare symbol:
#   the file says which page, and the leader name says which row of it - the
#   function table and both call site pages know a function by its leader, which
#   for an alias is some other symbol entirely.  A symbol which
#   more than one file defines - a 'static', usually - goes into the second hash
#   instead, keyed by file as well, exactly as 'TraceFile::resolveCallSites'
#   indexes it, so that the two views agree about which sites have a callee
# (These declarations follow the 'exit' of the main program, so they never
#   execute - 'our' does its work at compile time.)
# LCOV_UNREACHABLE_START
our %calleeLocation;
our %calleeLocationDuplicated;
# ..and the names a symbol represents, where any were merged into it (see
#   FunctionAlias::merged), keyed by "<file>\0<symbol>":  what the callee cell of a row
#   marks the symbol with - see _mergedNameNote.
our %calleeMergedNames;
# ..and the symbols which are alias groups listed without a summary block,
#   keyed the same way:  a call of one leads to the rows of its group
#   (...because the is no row for the function as a whole) - see
#   'show_callgraph_summary' in man lcovrc(5)
our %calleeGroupShown;
# LCOV_UNREACHABLE_STOP

sub build_callee_location_index($)
{
    my $traceFile = shift;
    my %definedIn;
    foreach my $filename ($traceFile->files()) {
        my $functionMap = $traceFile->data($filename)->func();
        my $measured    = !$main::show_callgraph_summary &&
            $functionMap->hasCallgraphData($callgraphCalledSymbols);
        foreach my $key ($functionMap->keylist()) {
            my $entry   = $functionMap->findKey($key);
            my $where   = [$filename, $entry->line(), $entry->name()];
            my $grouped = $measured && _showAliasGroups($entry, $measured);
            foreach my $name ($entry->aliasNames()) {
                my $merged = $entry->alias($name)->merged();
                $calleeMergedNames{"$filename\0$name"} = $merged
                    if defined($merged);
                $calleeGroupShown{"$filename\0$name"} = 1 if $grouped;
                if (exists($calleeLocationDuplicated{$name})) {
                    $calleeLocationDuplicated{$name}->{$filename} = $where;
                } elsif (exists($calleeLocation{$name})) {
                    $calleeLocationDuplicated{$name} = {
                                    $definedIn{$name} => $calleeLocation{$name},
                                    $filename         => $where
                    };
                    delete($calleeLocation{$name});
                    delete($definedIn{$name});
                } else {
                    $calleeLocation{$name} = $where;
                    $definedIn{$name}      = $filename;
                }
            }
        }
    }
}

# The call-site groups written in each file which belong to a function of some
#   other file, keyed by the file they are written in and carrying that other
#   file as a fifth element.  The source view of a file decorates the calls its
#   own text makes, and a call in an '#include'd fragment is in the text of the
#   fragment while its data is on a function of the file which includes it - see
#   'FNC:' in geninfo(1).  Built in the parent, for the same reason
#   %calleeLocation is:  the file whose text holds the call cannot find these
#   sites in its own data, and a forked child holds only its own segment
our %callgraphForeignSites;    # LCOV_UNREACHABLE_LINE - follows main's 'exit'

sub build_callgraph_foreign_index($)
{
    my $traceFile = shift;
    foreach my $filename ($traceFile->files()) {
        my $functionMap = $traceFile->data($filename)->func();
        foreach my $key ($functionMap->keylist()) {
            my $entry = $functionMap->findKey($key);
            next if 0 == $entry->numCallSites();
            foreach my $group (callSiteGroups($entry, $filename)) {
                next unless defined($group->[3]);
                push(@$group, $filename);
                push(@{$callgraphForeignSites{$group->[3]}}, $group);
            }
        }
    }
}

# What the pages of the file being written show, where '--select-script' leaves
#   out parts - undef where nothing is removed - i.e., when every page shows
#   everything.
# A hash holding
#     file      the file
#     gcov      the lines its source view shows, as a set
#     callers   the anchors its callers page has, likewise
#     callees   the same for its callees page
# A link to a line, a site or a function the filter removed goes nowhere
#   (would be a dangling reference) and so is suppressed:  see _pageShows.
# Held for an individula file - because the child only knows about this file.
#   The parts of some other file is decided in that file's own child
our $pageShown;    # LCOV_UNREACHABLE_LINE - follows main's 'exit'

sub callgraphShownAnchors($$)
{
    # the start of '$pageShown' for one file, from the entries its call site
    #   pages list - see callgraphDetailEntries.  Every entry on a page is named
    #   by the anchor of its name cell, and every site group of the callees page,
    #   and every row of one, by its own
    my ($filename, $entries) = @_;
    my %shown = (file => $filename,
                 gcov => {});
    foreach my $view (0 .. CALLGRAPH_VIEW_COUNT - 1) {
        my %anchors;
        foreach my $entry (@$entries) {
            next unless $entry->{has}->[$view];
            $anchors{_calleeFuncAnchor($entry->{name})} = 1;
            if (defined($entry->{groupMetric}) && !$main::suppress_alias_groups)
            {
                while (my ($alias, $metric) = each(%{$entry->{groupMetric}})) {
                    $anchors{_aliasGroupAnchor($alias)} = 1
                        if defined($metric->[$view]);
                }
            }
            next unless $view == CALLGRAPH_VIEW_CALLEES;
            foreach my $group (@{$entry->{groups}}) {
                my ($line, $column, $rows, $siteFile) = @$group;
                $anchors{_callSiteAnchor($line, $column, undef, $siteFile)} = 1;
                foreach my $position (1 .. scalar(@$rows)) {
                    $anchors{_callSiteAnchor($line, $column, $position,
                                             $siteFile)} = 1;
                }
            }
        }
        $shown{$callgraphView[$view]->{name}} = \%anchors;
    }
    return \%shown;
}

sub _pageShows($$$)
{
    # whether the '$page' page of '$filename' - 'gcov' for the source view, or the
    #   name of a call site page - has '$anchor', which for the source view is a
    #   line number.  Which is to say:  whether a link to it can be written
    my ($filename, $page, $anchor) = @_;
    return 1 unless defined($pageShown);
    return 0 unless $filename eq $pageShown->{file};
    return exists($pageShown->{$page}->{$anchor});
}

sub _shownSourceLine($$)
{
    # the line a link to a function's source leads to:  '$line', a couple of
    #   lines above '$defined' so that the definition is not the top line of the
    #   window - or, where the filter left those out, the first line from there
    #   which is shown.  The definition itself is:  the function would not be
    #   listed otherwise
    my ($line, $defined) = @_;
    return $line unless defined($pageShown);
    while ($line < $defined && !exists($pageShown->{gcov}->{$line})) {
        ++$line;
    }
    return $line;
}

sub categorize_all_call_sites($$$)
{
    # Categorize the call sites of every file, in the parent, before any page is
    #   written.  The result is thrown away:  what is wanted is the side effect of
    #   'FileCoverageInfo::categorizeCallSites' - each site's category stored on
    #   the FunctionEntry which contains it.
    #
    # A file's own sites are categorized again when its page is built, which is
    #   where they are attached to their lines.  This pass exists because the
    #   'callers of this function' table shows the category of a site in some
    #   *other* file, and that file may not have been processed yet - or may be
    #   processed in a different child, whose memory the page writer never sees.
    #   Doing it here is the same answer for every reader, whatever the file order
    #   and whatever '--parallel' does.
    my ($currentTrace, $baseTrace, $diffMap) = @_;

    foreach my $filename ($currentTrace->files()) {
        my $base;
        if (defined($baseTrace)) {
            # The baseline is looked up exactly as the per-file pass looks it up
            #   (see 'process_file'):  through the diff's name mapping, with the
            #   basename fallback, and answering an *empty* map rather than undef
            #   when the baseline has no entry for the file.  Those two are
            #   different answers - undef means "this report has no baseline",
            #   which categorizes every site as new code - and the two passes
            #   disagreeing shows up as a 'callers of this function' table whose
            #   category differs from the one the caller's own page displays
            $base =
                $baseTrace->data($diffMap->baseline_file_name($filename), 1);
        }
        my $current = $currentTrace->data($filename);
        FileCoverageInfo::categorizeCallSites(
                                        $filename,
                                        defined($base) ? $base->func() : undef,
                                        $current->func(),
                                        $diffMap,
                                        FileCoverageInfo::changedStatementLines(
                                            $filename, $base, $current, $diffMap
                                        ));
    }
}

sub calleeLocation($$)
{
    # where the named callee is defined, as [file, line], or undef when it is
    #   external to the report or is one of several same-named local functions and
    #   not the one this caller's file defines.  Those two answers are the same
    #   answer - the site is counted where it is and has no callee-side row -
    #   which is the treatment 'printf' gets
    my ($callee, $callerFile) = @_;
    return $calleeLocationDuplicated{$callee}->{$callerFile}
        if exists($calleeLocationDuplicated{$callee});
    return exists($calleeLocation{$callee}) ? $calleeLocation{$callee} : undef;
}

sub filePageBase($$)
{
    # the report pages of the named file, as a path relative to the page being
    #   written, or undef when the report has no page for that file.  '$base_dir'
    #   is the writing page's own '../..' prefix
    my ($filename, $base_dir) = @_;
    return undef unless exists($filePageDir{$filename});
    my $rel = File::Spec->catfile($filePageDir{$filename},
                                  File::Basename::basename($filename));
    # 'html_create' lower-cases the whole report-relative path, so the file on
    #   disk is spelled that way and the link has to be too
    return $base_dir . ($lcovutil::case_insensitive ? lc($rel) : $rel);
}

sub pageName($$)
{
    # one page of a file, named the way 'html_create' writes it:  '<base>.gcov',
    #   '<base>.func', '<base>.callee'.  '$base' is a file name and not a path,
    #   so this is a link from another page of the same file
    my ($base, $kind) = @_;
    $base = lc($base) if $lcovutil::case_insensitive;
    return "$base.$kind.$html_ext";
}

sub callgraphPageName($$;$)
{
    # one call site page of a file, in one order.  '$sort_type' is the order the
    #   link should lead to and is omitted by a link from anywhere but a call
    #   site page:  a reader who followed such a link is looking for a particular
    #   function, which is what the name order is for.  A reader who is already
    #   on one of these pages chose an order, so a link from there keeps it
    my ($base, $view, $sort_type) = @_;
    my $kind = $callgraphView[$view]->{name};
    $kind .= _callgraphPageSuffix($sort_type) if defined($sort_type);
    return pageName($base, $kind);
}

sub _callgraphPageSuffix($)
{
    # what tells the orders of one call site page apart in its name:  nothing for
    #   the name order, which is the page a link from anywhere else leads to
    my $sort_type = shift;
    return '' if $sort_type == $SORT_FILE;
    return '-c' if $sort_type == $SORT_MISSING_CALLGRAPH;
    return '-x' if $sort_type == $SORT_XREF;
    return '-o' if $sort_type == $SORT_OWNER;
    die("unexpected sort $sort_type") unless $sort_type == $SORT_AGE;
    return '-a';
}

sub callgraphPageSorts($$)
{
    # The orders one call site page of a file is written in, given the functions
    #   of the file - see 'callgraphDetailEntries' - or 0 where the file has no
    #   such page.  An order is there only where the page has the column which
    #   leads to it:  the way to the other direction where the file has that page,
    #   and the Age and Owner columns where the annotation callback answered for
    #   one of the functions this page shows.  A page in an order no column of it
    #   offers is a page nothing leads to
    my ($entries, $view) = @_;
    my @shown = grep({ $_->{has}->[$view] } @$entries);
    return 0 unless @shown;
    my $other = grep({ $_->{has}->[1 - $view] } @$entries);
    my $annot = grep({ defined($_->{annot}) } @shown);
    return [
            grep({ ($_ != $SORT_XREF || $other) &&
                         (($_ != $SORT_OWNER && $_ != $SORT_AGE) || $annot) }
                 @callgraphview_sortlist)
    ];
}

sub callgraphLinkSort($$$)
{
    # the order a link from one call site page of a file to the other leads to:
    #   the order the reader is already in, where that page is written in it -
    #   and its name order where it is not, which is the page a reader who
    #   arrived from anywhere else would see.  '$pages' is the orders of both
    #   pages, as 'callgraphPageSorts' returns them
    my ($pages, $view, $sort_type) = @_;
    return $sort_type if grep({ $_ == $sort_type } @{$pages->[$view]});
    # Not seen in practice:  the way to the other direction is on both pages
    #   when it is on either, and the annotation callback answers for every line
    #   of a file or for none - so the two pages of a file are in the same orders
    # LCOV_UNREACHABLE_START
    return $SORT_FILE;
    # LCOV_UNREACHABLE_STOP
}

sub _headerTitle($$)
{
    # the label of one table of the page header, carrying '$title' as its tooltip
    #   where there is one
    my ($label, $title) = @_;
    return $label unless defined($title);
    return "<span title=\"$title\">$label</span>";
}

sub isCallgraphHeader($)
{
    # is this the header of a call site page?  The two of them are detail pages
    #   of one file exactly as the function table is, so nearly everything the
    #   header does for one it does for the other - see write_header
    my $type = shift;
    return $type == $HDR_CALLERS || $type == $HDR_CALLEES;
}

sub _mergeSiteRow($$$)
{
    # fold one more record into an existing display row:  add the count, name the
    #   callee if it is a symbol the row does not already name, and keep the
    #   higher-priority of the two categories.  Two records reach one row only
    #   when they lead to the same place (see 'callSiteGroups'), which normally
    #   means one category as well - the exception is two identically-located
    #   calls of which the edit changed only one
    my ($row, $callee, $site) = @_;
    my ($count, $tla) = @$site;
    $row->[2] = _foldedRowTla($row->[2], $row->[1], $tla, $count);
    $row->[1] = lcovutil::add_site_count($row->[1], $count);
    push(@{$row->[0]}, $callee)
        unless grep({ $_ eq $callee } @{$row->[0]});
}

sub _foldedRowTla($$$$)
{
    # The category of a row once one more record is folded into it:  the
    #   higher-priority of the two - except that the category has to agree with
    #   the count.  A row which any of its records took is hit, so only the
    #   categories of the records which were taken compete for it;  else a row
    #   which was taken could be called 'UIC'
    my ($rowTla, $rowCount, $tla, $count) = @_;
    return $rowTla unless defined($tla);
    return $tla    unless defined($rowTla);
    my $wasHit = lcovutil::site_count_hit($rowCount);
    my $isHit  = lcovutil::site_count_hit($count);
    return $tla if $isHit     && !$wasHit;
    return $rowTla if $wasHit && !$isHit;
    return $SummaryInfo::tlaRank{$tla} < $SummaryInfo::tlaRank{$rowTla} ?
        $tla :
        $rowTla;
}

sub _callSiteGroupMap($$;$)
{
    # 'callSiteGroups' without the ordering:  the same groups keyed by the
    #   location they are at, as "<file the call is written in>:<line>:<column>".
    #   Separate from the sort because the caller-side position index is a lookup
    #   table and has no order to pay for - see '_callSitePositions' - and
    #   sorting the site keys of a function which contains thousands of calls is
    #   the expensive half of building them
    # The key names the file even for the ordinary same-file site, where the
    #   group itself carries undef:  'FunctionEntry::addCallSite' normalizes the
    #   site's own file away when it is the function's, so the two spellings
    #   cannot both occur and one key is unambiguous
    # '$union' asks for the categories of the sites each row counts as well -
    #   see 'callSiteGroups'
    my ($entry, $callerFile, $union) = @_;
    my %groupAt;    # "file:line:column" -> the group being built
    my %rowAt;      # "file:line:column" -> destination -> row
        # in whatever order the sites come out:  a group is identified by its
     #   location and a row within it by its destination, so nothing here depends
     #   on the order and the two sorts below put the result in the displayed one
    foreach my $siteKey ($entry->callSiteKeys()) {
        my ($line, $column, $ordinal, $count, $callee, $siteFile, $set) =
            $entry->callSiteData($siteKey);
        my $at =
            (defined($siteFile) ? $siteFile : $callerFile) . ":$line:$column";
        # ..and which definition the callee resolves to is decided by the
        #   translation unit, which is where the *caller* is defined - not by the
        #   file the call is written in, which a header included by two units does
        #   not answer.  Same rule as TraceFile::resolveCallSites
        my $where = calleeLocation($callee, $callerFile);
        $groupAt{$at} = [$line, $column, [], $siteFile]
            unless exists($groupAt{$at});
        # the destination:  where the callee is defined when the report has it,
        #   and the symbol itself when it does not.  That is what the row links
        #   to, and so what identifies it.  The prefix keeps a symbol which
        #   happens to look like 'file:line' out of the other namespace
        my $destination =
            defined($where) ? "@" . $where->[0] . ':' . $where->[1] :
            '=' . $callee;
        my $tla = $entry->callSiteTla($line, $column, $ordinal, $siteFile);
        my $row = $rowAt{$at}->{$destination};
        if (defined($row)) {
            _mergeSiteRow($row, $callee, [$count, $tla]);
        } else {
            $row = [[$callee], $count, $tla, $where, {}];
            $rowAt{$at}->{$destination} = $row;
            push(@{$groupAt{$at}->[2]}, $row);
        }
        $row->[6]->{$tla} = 1 if $union && defined($tla);
        # ..and which aliases made the calls the row counts, with the count of
        #   each alias set:  the empty set is every alias.  What an alias group
        #   of the function shows of the row - see '_aliasGroupSites'
        my $bySet = $row->[4];
        $set //= '';
        $bySet->{$set} = lcovutil::add_site_count($bySet->{$set}, $count);
    }
    # ..in symbol order within a group.  Not ordinal order, which is the
    #   producer's business, and not count order, which would reshuffle the table
    #   between two runs of the same report.  It is the row's position in this
    #   order that the two sides of the table both name, so it is part of building
    #   a group and not of displaying one
    # ..the row's own symbols first, so that the name a row is ordered by is the
    #   one it displays first.  A row is named by every symbol which leads to its
    #   destination and no symbol leads to two destinations, so the lowest of them
    #   is unique within the group and this is a total order however the sites
    #   happened to come out of the container
    foreach my $group (values(%groupAt)) {
        foreach my $row (@{$group->[2]}) {
            @{$row->[0]} = sort(@{$row->[0]});
        }
        @{$group->[2]} = sort({ $a->[0]->[0] cmp $b->[0]->[0] } @{$group->[2]});
    }
    return \%groupAt;
}

sub callSiteGroups($$;$)
{
    # The 'calls made by this function' view:  the sites contained in one
    #   FunctionEntry, as a list of location groups
    #     [line, column, [row, ..], file the call is written in or undef]
    #   in (file, line, column) order, each row being
    #     [[callee, ..], count, tla or undef, [file, line] of the callee or undef,
    #      {alias set or '' => count}]
    #   in callee-symbol order - and, where '$union' is set, a 7th element:
    #   the categories of the sites the row counts, as {tla => 1} - see
    #   _unionSiteTla.
    # The group's file is undef for a call written in the file which defines the
    #   function - the ordinary case - and the name of the other file otherwise,
    #   which is what a call in an '#include'd fragment looks like.  It is part of
    #   the location, so two files with a call at one line and column are two
    #   groups.
    # One row per distinct hyperlink destination, not one per record.  The
    #   ordinal is a storage key - it exists so that two inputs describing the
    #   same location merge deterministically - and it is neither displayed nor
    #   navigable, so two records at one location which lead to the same place are
    #   one row with their counts added.  That covers two different symbols which
    #   share a definition location, which is what identical code folding and two
    #   instantiation aliases of one FunctionEntry produce
    my ($entry, $callerFile, $union) = @_;
    # a total order, the groups being one per location:  the same table every run
    return
        sort({ (defined($a->[3]) ? $a->[3] : '') cmp
                     (defined($b->[3]) ? $b->[3] : '') or
                     $a->[0] <=> $b->[0] or
                     $a->[1] <=> $b->[1] }
             values(%{_callSiteGroupMap($entry, $callerFile, $union)}));
}

# How much of the numbering '%callSitePositions' holds is worth keeping.  It is
#   not kept per page:  a function which calls many things is a caller on the page
#   of every file it calls into, and re-indexing it for each of them is most of
#   the work the index saved.  It is not unbounded either, since the callers of a
#   whole report are eventually every function in it - so it is emptied once the
#   answers in it cover this many sites, a few tens of MB, and the hub which is
#   asked about constantly is simply indexed again.
# A test lowers it, so that a fixture of a handful of sites reaches the emptying
#   and can show that the numbering does not depend on what is kept - the same
#   thing LCOV_FORCE_PARALLEL does for the fork paths.  Read at compile time
#   because that is when a constant is made, which is early enough
use constant CALLSITE_INDEX_LIMIT => exists($ENV{LCOV_CALLSITE_INDEX_LIMIT}) ?
    $ENV{LCOV_CALLSITE_INDEX_LIMIT} :
    200000;

sub _callSitePositions($$)
{
    # where in its group the row for one callee is, for every site of one caller.
    # Every callee of a file asks this of every function which calls it, and a
    #   function which calls thousands of things answers it thousands of times
    #   with the same answer, so it is computed once per caller rather than once
    #   per row:  recomputing it per row is the product of the two and is what
    #   made the page of a file called from one large function quadratic.
    # Still computed from the caller's own sites and not stored beside them, so
    #   that the two sides of the table cannot disagree about the numbering
    my ($entry, $callerFile) = @_;
    # ..identified by what a FunctionEntry is identified by everywhere else.  Not
    #   by reference: the same C++ object reached twice through the XS layer is
    #   not necessarily the same Perl scalar
    my $key =
        join("\0", $entry->file(), $entry->line(), $entry->name(), $callerFile);
    return $callSitePositions{$key} if exists($callSitePositions{$key});
    my %positions;
    my $groups = _callSiteGroupMap($entry, $callerFile);
    foreach my $at (keys(%$groups)) {
        my $n = 0;
        foreach my $row (@{$groups->{$at}->[2]}) {
            ++$n;
            # a symbol resolves to one destination and so names one row of its
            #   group;  the check is what keeps a malformed one from renumbering
            foreach my $callee (@{$row->[0]}) {
                $positions{$at}->{$callee} = $n
                    unless exists($positions{$at}->{$callee});
            }
        }
    }
    if ($callSitePositionSites > CALLSITE_INDEX_LIMIT) {
        %callSitePositions     = ();
        $callSitePositionSites = 0;
    }
    $callSitePositions{$key} = \%positions;
    $callSitePositionSites += $entry->numCallSites();
    return \%positions;
}

sub callgraphSourceGroups($;$)
{
    # every call-site group written in one file, keyed by the source line it is on
    #   and in column order within the line.  One line can carry the sites of more
    #   than one function - a macro expansion, or a lambda body - so this is not
    #   simply one function's groups
    # '$foreign' is the sites which are written in this file and belong to a
    #   function of some other one, which is what a call in an '#include'd
    #   fragment is:  the file's own FunctionMap does not have them, so the parent
    #   collects them for every file before the pages are written - see
    #   'build_callgraph_foreign_index'.  By the same token a site of *this*
    #   file's functions which is written in another file is not here;  it is on
    #   that file's page
    my ($functionMap, $foreign) = @_;
    my %byLine;
    foreach my $key ($functionMap->keylist()) {
        my $entry = $functionMap->findKey($key);
        next if 0 == $entry->numCallSites();
        foreach my $group (callSiteGroups($entry, $entry->file())) {
            next if defined($group->[3]);
            push(@{$byLine{$group->[0]}}, $group);
        }
    }
    foreach my $group (@{$foreign || []}) {
        push(@{$byLine{$group->[0]}}, $group);
    }
    foreach my $line (keys(%byLine)) {
        @{$byLine{$line}} =
            sort({ $a->[1] <=> $b->[1] } @{$byLine{$line}});
    }
    return \%byLine;
}

sub _calleeSimpleName($)
{
    # the identifier a reader sees at a call site:  no parameter list, no
    #   template arguments, no qualification.  'a::b<int>::f(int) const' -> 'f'.
    #   Used only to compare the source text against the site's targets, so it
    #   does not have to be reversible - just consistent between the two
    my $name = shift;
    $name =~ s/\s*\(.*$//s;              # parameter list, and const/noexcept
    1 while ($name =~ s/<[^<>]*>//g);    # template arguments, innermost first
    $name =~ s/^.*:://s;                 # qualification
    return $name;
}

sub _calleeIdentifierAt($$)
{
    # the identifier which starts at 1-based column '$column' of '$text', as
    #   (offset, length), or the empty list when there is none there.  Read
    #   rightward over the characters a qualified C++ name can contain, taking a
    #   balanced '<...>' - which nests - as part of the name.  Whitespace ends
    #   the name, which is what keeps 'a < b' from being read as a template
    my ($text, $column) = @_;
    return () if ($column < 1 || $column > length($text));
    my $start = $column - 1;
    return () unless substr($text, $start, 1) =~ /[A-Za-z_~]/;
    my $end = $start;
    while ($end < length($text)) {
        my $c = substr($text, $end, 1);
        if ($c =~ /[A-Za-z0-9_:~]/) {
            ++$end;
        } elsif ($c eq '<') {
            my $depth = 0;
            my $p     = $end;
            while ($p < length($text)) {
                my $d = substr($text, $p, 1);
                ++$depth if $d eq '<';
                --$depth if $d eq '>';
                ++$p;
                last if 0 == $depth;
            }
            return () if 0 != $depth;    # unbalanced - not an argument list
            $end = $p;
        } else {
            last;
        }
    }
    return ($start, $end - $start);
}

sub _calleeIdentifierEndingAt($$)
{
    # the identifier which ends just left of 1-based column '$column' of
    #   '$text', as (offset, length), or the empty list when there is none
    #   there.  This is where GCC's C++ front end points a call:  the column of
    #   an edge in the callgraph info is the call's opening parenthesis, so the
    #   name the reader sees ends at the column before it.  (Its C front end
    #   points at the name itself, which is what '_calleeIdentifierAt' reads -
    #   measured on both, and the difference is why this has to try twice)
    # A template argument list belongs to the name and is taken with it, and
    #   whitespace between the name and the parenthesis is skipped
    my ($text, $column) = @_;
    my $end = $column - 1;     # one past the last character of the name
    return () if ($end < 1 || $end > length($text));
    --$end while ($end > 0 && substr($text, $end - 1, 1) =~ /\s/);
    return () if 0 == $end;    # nothing but whitespace to the left
    my $nameEnd = $end;
    if ('>' eq substr($text, $nameEnd - 1, 1)) {
        my $depth = 0;
        while ($nameEnd > 0) {
            my $c = substr($text, $nameEnd - 1, 1);
            ++$depth if $c eq '>';
            --$depth if $c eq '<';
            --$nameEnd;
            last if 0 == $depth;
        }
        return () if 0 != $depth;    # unbalanced - not an argument list
    }
    my $start = $nameEnd;
    --$start
        while ($start > 0 && substr($text, $start - 1, 1) =~ /[A-Za-z0-9_~]/);
    return () if $start == $nameEnd;
    return () unless substr($text, $start, 1) =~ /[A-Za-z_~]/;
    return ($start, $end - $start);
}

sub _calleeSpanIsTarget($$$$$)
{
    # do '$length' characters of '$text' at '$start' name one of the callees of
    #   '$group', without overlapping the text already spliced ('$consumed')?
    my ($text, $start, $length, $consumed, $group) = @_;
    return 0 unless defined($start) && $start >= $consumed;
    my $name = _calleeSimpleName(substr($text, $start, $length));
    return
        scalar(
         grep({ _calleeSimpleName($_) eq $name } _callgraphGroupTargets($group))
        );
}

our %CALLEE_KEYWORDS;    # see _calleeIsKeyword

BEGIN {
    # The words the relaxed read below must not underline.  Not a complete
    #   keyword list of any language - only the ones which turn up immediately
    #   left of a call in real code, which is what that read looks at.  Measured
    #   on this project's own C++: of 134 spans the relaxed read added, 8 were
    #   one of these ('return' six times, 'true' twice) and the rest named the
    #   operand an operator call is written on
    my @keywords = qw(return new delete throw sizeof this nullptr
                      true false if else while for do switch case
                      default break continue goto and or not
                      const static struct class union enum typedef
                      void auto operator co_await co_return co_yield);
    %CALLEE_KEYWORDS = map({ ($_ => 1) } @keywords);
}

sub _calleeIsKeyword($)
{
    # is this span of source text a keyword rather than a name?  A call is
    #   frequently written just right of one - 'return f()' - so the relaxed read
    #   would otherwise underline the keyword and link it to the callee, which
    #   reads as nonsense.  The verified reads above need no such guard:  a
    #   keyword does not name a callee
    my $text = shift;
    return exists($CALLEE_KEYWORDS{$text}) ? 1 : 0;
}

sub _calleeRelaxedSpan($$$)
{
    # Where the link for one site group belongs when no text on the line names
    #   any of its callees:  the identifier the column points at, taken on trust.
    # The name a call is written with is not always the callee's name - an
    #   operator call is written as its operands, a call through a pointer or a
    #   virtual call is written as the expression which produces the target, and
    #   a call whose column GCC folded onto an enclosing one points at that one -
    #   and in every one of those cases the site's own '.func' entry is still what
    #   the reader wants to reach from the place the call is written.  So the
    #   compiler's column is believed rather than second-guessed:  the alternative
    #   is the trailing comment, which for a C++ report is most of the sites.
    # The C++ convention is tried first (the identifier ending just left of the
    #   column, which is where an operand ends) because it is the one which
    #   applies when a verified read has already failed
    my ($text, $group, $consumed) = @_;
    foreach my $read (\&_calleeIdentifierEndingAt, \&_calleeIdentifierAt) {
        my ($start, $length) = $read->($text, $group->[1]);
        next unless defined($start) && $start >= $consumed;
        next if _calleeIsKeyword(substr($text, $start, $length));
        return ($start, $length);
    }
    return ();
}

sub _calleeSpliceSpan($$$)
{
    # Where on '$text' the link for one site group belongs, as (offset, length),
    #   or the empty list when the line has no text the link can go on - in which
    #   case the site goes in the trailing comment.
    # The column is either the first column of the name or the column of the
    #   call's opening parenthesis, depending on the compiler's front end, so
    #   both are tried.  GCC also folds a nested call's column onto the enclosing
    #   call, so the identifier found may name a different function - hence the
    #   check that it is really one of the callees, which is what makes these two
    #   reads the trustworthy ones.
    # When neither of them matches, the fallback is 'strict_callee_match':  set,
    #   the site goes to the comment;  clear (the default), the column is
    #   believed anyway - see _calleeRelaxedSpan for why that is the better
    #   answer for the many C++ calls whose source text is not the callee's name
    my ($text, $group, $consumed) = @_;
    my ($start, $length) = _calleeIdentifierAt($text, $group->[1]);
    return ($start, $length)
        if _calleeSpanIsTarget($text, $start, $length, $consumed, $group);
    ($start, $length) = _calleeIdentifierEndingAt($text, $group->[1]);
    return ($start, $length)
        if _calleeSpanIsTarget($text, $start, $length, $consumed, $group);
    return () if $lcovutil::strict_callee_match;
    return _calleeRelaxedSpan($text, $group, $consumed);
}

sub _callgraphCountUnknown($)
{
    # is this the unknown call-site count (see FunctionEntry::SITE_COUNT)?
    # Spelled out rather than written as '$count eq "-"' at each of the places
    #   which ask, because the answer for an absent count is 'no' and a bare
    #   'eq' against undef is a warning
    my $count = shift;
    return defined($count) && $count eq '-';
}

sub _callgraphCellStyle($)
{
    # how a call-site cell is coloured by its count alone:  taken, not taken, or
    #   - for the unknown count - neither of the two, since colouring it as not
    #   taken would make a claim about the tests which the capture never made
    my $count = shift;
    return 'coverCallgraphUnknown' if _callgraphCountUnknown($count);
    return lcovutil::site_count_hit($count) ? 'coverCallgraphHi' :
        'coverCallgraphLo';
}

sub _callgraphCountCell($$$$)
{
    # the count cell of either call-site table.  '-' is rendered as itself, the
    #   way the unknown 'taken' of a 'BRDA:' record is rendered in the source
    #   view, and with a tooltip saying what it means:  a '-' in a column of
    #   numbers is a question.  It is coloured and toured as a zero, though:  no
    #   test is known to have made the call - see _callgraphRowStyle
    # In a report whose only categories are 'hit' and 'missed' this cell is also
    #   the answer to that question - it is coloured by the category already, and
    #   the category is exactly whether the number beside it is zero - so the
    #   category column is left out and the word it carried comes here, into the
    #   tooltip.  See the '$foldTlas' of 'write_callgraph_page'
    # '$tla' is the category this cell has taken over, and is passed only where
    #   there is no column for it.  '$href' is where the count leads:  past the
    #   run of calls it is in to the next one which went the same way - the next
    #   taken call after a run of taken ones, the next missed one after a run of
    #   missed ones.  See _callgraphHitKey
    my ($count, $style, $tla, $href) = @_;
    my $unknown = _callgraphCountUnknown($count);
    my $text    = $unknown ? '-' : $count;
    my $label   = _callgraphTlaLabel($tla);
    my $title   = $label;
    $title =
        'the compiler recorded this call and the coverage data carries no ' .
        'count for it' .
        (defined($label) ? " - $label" : '')
        if $unknown;
    # the tooltip goes on the link:  one under the other is one the reader
    #   cannot reach.  Every count is on one of the two tours, so every count
    #   cell has a link
    my $class = defined($tla) ? " class=\"tlaBg$tla\"" : '';
    my $next  = 'click for the next ' . _callgraphCountKey($count) . ' call';
    $next = "$title - $next" if defined($title);
    return "<td class=\"$style\"><a$class href=\"$href\"" .
        " title=\"$next\">$text</a></td>";
}

sub _callgraphExternalCountCell($$)
{
    # the count cell of an '<external callers>' row:  'E (R)', where E is the
    #   number of calls the flagged sites outside the callgraph boundary made
    #   and R the number deduced from the entry count, joined by a space which
    #   does not break.  Either is left out where that fact does not hold - so
    #   '(R)' alone is a function with no flag, and '0' one whose flagged sites
    #   made no call.  E is '-' where it is not known, and R is never known
    #   then.  Coloured like any other
    #   call count, by E + R - a flagged symbol which was never entered has a
    #   known number of external calls, and that number is zero - but never a
    #   link, since the origin of those calls is not on any page.  On a page
    #   whose counts are coloured by category the row has none, and
    #   'callgraphTlaCount' gives the cell the look of the category cells above
    #   it rather than that of the call site cells beside it
    my ($counts, $hasTlas) = @_;
    my ($flagged, $external, $residual) = @$counts;
    my $class;
    my $text;
    my $title;
    if ($flagged && !defined($external)) {
        ($class, $text, $title) =
            ('coverCallgraphUnknown', '-', $EXTERNAL_COUNT_TITLE);
    } elsif (!defined($residual)) {
        ($class, $text, $title) = (_callgraphCellStyle($external),
                                   $external,
                                   "$external calls from call sites outside" .
                                       ' the callgraph boundary');
    } elsif (!$flagged) {
        ($class, $text, $title) = (_callgraphCellStyle($residual),
                                   "($residual)",
                                   "($residual) calls deduced from the" .
                                       ' number of times the function was' .
                                       ' entered');
    } else {
        my $total = lcovutil::add_count($external, $residual);
        ($class, $text, $title) = (_callgraphCellStyle($total),
                                   "$external&nbsp;($residual)",
                                   "$total calls:  $external from call sites" .
                                       ' outside the callgraph boundary and' .
                                       " ($residual) deduced from the number" .
                                       ' of times the function was entered');
    }
    $class .= ' callgraphTlaCount' if $hasTlas;
    return "<td class=\"$class\" title=\"$title\">$text</td>";
}

sub _callgraphGroupCount($)
{
    # the one count which stands for a whole group of destinations at one call
    #   location:  their sum, except that an unknown among destinations which
    #   were all not taken leaves the group unknown rather than not taken.
    #   "some call here was taken" is answerable from any one destination;  "no
    #   call here was taken" needs a count for every one of them
    my $rows = shift;
    my $total;
    my $unknown = 0;
    foreach my $row (@$rows) {
        $unknown = 1 if _callgraphCountUnknown($row->[1]);
        $total   = lcovutil::add_site_count($total, $row->[1]);
    }
    return '-' if $unknown && !lcovutil::site_count_hit($total);
    return $total;
}

sub _callgraphGroupTargets($)
{
    # every symbol the group leads to, in display order:  the tooltip text, and
    #   what the source identifier is checked against
    my $group = shift;
    my @names;
    foreach my $row (@{$group->[2]}) {
        push(@names, @{$row->[0]});
    }
    return @names;
}

sub _callSiteClass($)
{
    # how the identifier at a call site - or the site's name in the trailing
    #   comment - is marked:  taken, not taken, or not measured
    my $count = shift;
    return 'callSiteUnknown' if _callgraphCountUnknown($count);
    return lcovutil::site_count_hit($count) ? 'callSite' : 'callSiteLo';
}

sub _callgraphGroupNames($)
{
    # the escaped, simplified names a site group leads to, as one string
    my $group = shift;
    return
        escape_html(join(', ',
              map({ simplify_function_name($_) } _callgraphGroupTargets($group))
        ));
}

sub _callgraphGroupCalls($)
{
    # the escaped hover list of a site group:  one line per destination -
    #   'count: names', the counts right-aligned so that the names start in one
    #   column - joined by an encoded newline.  An attribute value, which CSS
    #   draws on hover:  text in the line would come back from 'html2lcov' as
    #   source, and a 'title' is one line of plain text, which can neither align
    #   the names nor tell one line from the next
    my $group = shift;
    my @lines = map(
          { [$_->[1], join(', ', map({ simplify_function_name($_) } @{$_->[0]}))
          ] } @{$group->[2]});
    my $width = 0;
    foreach my $l (@lines) {
        $width = length($l->[0]) if length($l->[0]) > $width;
    }
    return
        join('&#10;',
             map({ escape_html(sprintf('%*s: %s', $width, @$_)) } @lines));
}

sub _callgraphGroupPage($$)
{
    # which page's call-site table one group of the source view leads to:  this
    #   file's own, except for a call which belongs to a function of another file,
    #   whose page 'write_source' resolved when it collected the group
    my ($page, $group) = @_;
    return defined($group->[3]) ? $group->[4] : $page;
}

sub _callgraphGroupHrefAttr($$)
{
    # the 'href' attribute of a source view link to one group's row of the call
    #   site table, or '' where that table does not have it:  the link is still
    #   written, because its hover list and its colour are about the call and not
    #   about where it leads.  A group of a function of another file is on that
    #   file's page, which - where the filter leaves part of a file out -
    #   this file cannot know what was and was not removed.
    my ($page, $group) = @_;
    my $anchor = _callSiteAnchor($group->[0], $group->[1], undef, $group->[3]);
    if (defined($pageShown)) {
        return ''
            if defined($group->[3]) ||
            !_pageShows($pageShown->{file}, 'callees', $anchor);
    }
    return ' href="' . _callgraphGroupPage($page, $group) . "#$anchor\"";
}

sub _callgraphAnnotateSource($$)
{
    # The sites on a line whose column holds no identifier to link - the
    #   implicit destructor call at a closing brace, a nested call whose column
    #   GCC folded onto the enclosing one - as a comment appended to the line,
    #   one link per site.  '' when there are none.
    # Every character the reader sees here is generated by CSS out of the
    #   attributes:  'html2lcov' strips tags but keeps their text, and a comment
    #   written as text would come back as part of the source line - which it is
    #   not
    my ($page, $groups) = @_;
    return '' unless @$groups;
    my $html = '<span class="callgraphAnnot">';
    foreach my $group (@$groups) {
        $html .=
            '<a class="' .
            _callSiteClass(_callgraphGroupCount($group->[2])) .
            ' callgraphAnnot"' .
            _callgraphGroupHrefAttr($page, $group) .
            ' title="call recorded at column ' .
            $group->[1] .
            '" data-callee="' .
            _callgraphGroupNames($group) .
            '"></a>';
    }
    return $html . '</span>';
}

sub callgraphDecorateSource($$$)
{
    # Decorate one source line with its call sites:  the identifier at each
    #   verified site column wrapped in a link to that site's group in the 'calls
    #   made by this function' table, and the sites which did not verify appended
    #   as a comment.  undef when the line has no site.
    # The splice happens before escaping, not after:  columns index the raw line
    #   and 'escape_html' changes its byte offsets, so each piece is escaped
    #   independently and the anchor is put between them
    my ($text, $cbdata, $line) = @_;
    my $groups = $cbdata->callSites()->{$line};
    return undef unless defined($groups) && @$groups;
    my $page = $cbdata->callgraphPage();
    my @spliced;       # [offset, length, group], left to right
    my @unverified;    # the sites with no identifier at their column
    my $consumed = 0;

    foreach my $group (@$groups) {
        my ($start, $length) = _calleeSpliceSpan($text, $group, $consumed);
        if (defined($start)) {
            push(@spliced, [$start, $length, $group]);
            $consumed = $start + $length;
        } else {
            push(@unverified, $group);
        }
    }
    my $annotation = _callgraphAnnotateSource($page, \@unverified);
    my $html       = '';
    my $pos        = 0;
    foreach my $s (@spliced) {
        my ($start, $length, $group) = @$s;
        my $rows = $group->[2];
        # hovering answers "which ones, how often" with no navigation and no
        #   second copy of the data.  Every attribute value spliced into a source
        #   line is escaped:  a bare '>' in a template argument would end the tag
        #   early, and 'html2lcov' recovers the source by stripping tags
        my $calls = _callgraphGroupCalls($group);
        my $class = _callSiteClass(_callgraphGroupCount($rows));
        $html .= escape_html(substr($text, $pos, $start - $pos));
        $html .=
            '<a class="' .
            $class . '"' .
            _callgraphGroupHrefAttr($page, $group) .
            " data-calls=\"$calls\">" .
            escape_html(substr($text, $start, $length)) . '</a>';
        # a site with more than one destination is marked with how many, so that
        #   the reader knows before clicking that there is a set to look at.
        #   The digit is rendered by CSS from 'data-n' rather than written as
        #   text:  'html2lcov' strips tags but keeps their content, and a text
        #   digit spliced into the source would come back as source
        $html .=
            '<span class="calleeMulti" data-n="' . scalar(@$rows) . '"></span>'
            if 1 < scalar(@$rows);
        $pos = $start + $length;
    }
    $html .= escape_html(substr($text, $pos));
    $html .= $annotation;
    return $html;
}

sub _foldCallerRow($$$)
{
    # another call from the location of a caller row:  the row counts both, and
    #   takes the more significant of the two categories - see _foldedRowTla
    my ($row, $count, $tla) = @_;
    $row->[5] = _foldedRowTla($row->[5], $row->[4], $tla, $count);
    $row->[4] = lcovutil::add_site_count($row->[4], $count);
}

sub _mergeCallerLists(@)
{
    # The caller lists of the aliases of one function as a single list - shown
    #   by the page under '--filter function', where the function table
    #   lists the function under one name.  A location which called two of the
    #   aliases is one row, with the sum of the counts, as two calls of one alias
    #   from one location are (see callgraphCallerRows);  its link goes to the
    #   first of the caller's rows there.  The classes combine as the note beside
    #   the name combines them (see _callgraphCallerNote), and the counts of the
    #   calls from elsewhere add up - unknown if any of them is
    my @lists = @_;
    my ($class, $external, $deduced, $flagged) =
        (lcovutil::CALLERS_NONE, 0, 0, 0);
    my (@rows, %rowAt);
    foreach my $list (@lists) {
        my ($aliasClass, $calls, $aliasRows) = @{$list}[2 .. 4];
        $class |= $aliasClass;
        $external =
            (defined($external) && defined($calls->[0])) ?
            $external + $calls->[0] :
            undef;
        $deduced =
            (defined($deduced) && defined($calls->[1])) ?
            $deduced + $calls->[1] :
            undef;
        $flagged ||= $calls->[2];
        foreach my $row (@$aliasRows) {
            my $at = join(':', @{$row}[0 .. 2]);
            if (exists($rowAt{$at})) {
                my $here = $rowAt{$at};
                _foldCallerRow($here, $row->[4], $row->[5]);
                $here->[6] = $row->[6]
                    if defined($row->[6]) &&
                    (!defined($here->[6]) || $row->[6] < $here->[6]);
                @{$here->[9]}{keys(%{$row->[9]})} = ()
                    if defined($row->[9]);
                next;
            }
            $rowAt{$at} = [@$row];
            # ..its own copy of the categories, which the folding above adds to
            $rowAt{$at}->[9] = {%{$row->[9]}} if defined($row->[9]);
            push(@rows, $rowAt{$at});
        }
    }
    return [undef, undef, $class,
            [$external, $deduced, $flagged],
            [
             sort({ $a->[0] cmp $b->[0] or
                          $a->[1] <=> $b->[1] or
                          $a->[2] <=> $b->[2] } @rows)
            ]
    ];
}

sub _unionSiteTla($$)
{
    # The category of one unique call site of a function shown as alias groups
    #   - see _showAliasGroups - the category its sites would have as one site:
    #   the sum of their counts, '$count', vs the sum of their baseline counts.
    #   Computed from '$tlas', the categories the sites have
    #   ({tla => 1}), rather than from the counts, because the category says
    #   what 'FileCoverageInfo::_categorize' asks - whether each is 0.
    #   So the baseline sum is non-zero where a site is LBC or CBC, and there is
    #   a baseline site at all where one is UBC, GBC, LBC or CBC.
    #   The sites are located in the new code (or in a changed statement) for
    #   all the sites or none of the sites:  where one is GNC or UNC, so is
    #   the union.  undef where no site has a category
    my ($tlas, $count) = @_;
    return undef unless %$tlas;
    my $hit = lcovutil::site_count_hit($count) ? 1 : 0;
    return ($hit ? 'GNC' : 'UNC')
        if exists($tlas->{GNC}) || exists($tlas->{UNC});
    return
        FileCoverageInfo::_categorize((exists($tlas->{LBC}) ||
                                           exists($tlas->{CBC})) ? 1 : 0,
                                      $hit
        ) if grep({ exists($tlas->{$_}) } ('UBC', 'GBC', 'LBC', 'CBC'));
    return $hit ? 'GIC' : 'UIC';
}

sub _summaryRowCmp($$)
{
    # The order of the summary rows of a function shown as alias groups:  the
    #   most significant category first, in @SummaryInfo::tlaPriorityOrder
    #   order (a row with none last), tie break to lowest count (the least
    #   exercised, unknown count being 0), tie break to the name shown
    #   in the table element (file, line, ordinal).
    #   Each of the two is [tla or undef, count, file, line, column, name]
    my ($x, $y) = @_;
    my ($rx, $ry) =
        map({ defined($_->[0]) ?
                    $SummaryInfo::tlaRank{$_->[0]} :
                    scalar(@SummaryInfo::allTla) } ($x, $y));
    return $rx <=> $ry ||
        lcovutil::site_count_value($x->[1])
        <=> lcovutil::site_count_value($y->[1]) ||
        $x->[2] cmp $y->[2] ||
        $x->[3] <=> $y->[3] ||
        $x->[4] <=> $y->[4] ||
        $x->[5] cmp $y->[5];
}

sub _callerSummary($)
{
    # The summary block of the callers page for a function shown with its alias
    #   groups:  the caller lists '$callers' of its groups as one list, as
    #   _mergeCallerLists makes it - a row per unique call site, with the
    #   sum of the counts there, and the calls from outside the callgraph
    #   boundary combined - each row in the category of that sum
    #   (see _unionSiteTla), in _summaryRowCmp order
    my $callers = shift;
    my $summary = _mergeCallerLists(@$callers);
    my $rows    = $summary->[4];
    $_->[5] = _unionSiteTla($_->[9], $_->[4]) foreach (@$rows);
    @$rows =
        map({ $_->[1] }
            sort({ _summaryRowCmp($a->[0], $b->[0]) }
                 map({ [[@{$_}[5, 4, 0 .. 2], ''], $_] } @$rows)));
    return $summary;
}

sub _calleeSummary($)
{
    # ..and of its callees page:  the call site groups '$groups' of the
    #   function - see callSiteGroups - a row per unique call site, and
    #   the callee the row leads to, with the count of every call there.
    #   Each row is a group of its own, in the category of its count
    #   (see _unionSiteTla) and keeping the position it has among the
    #   function's rows - in _summaryRowCmp order.
    my $groups = shift;
    my @rows;
    foreach my $group (@$groups) {
        my ($line, $column, $sites, $siteFile) = @$group;
        my $position = 0;
        foreach my $row (@$sites) {
            ++$position;
            my $tla = _unionSiteTla($row->[6] // {}, $row->[1]);
            push(@rows,
                 [
                  [$tla, $row->[1], $siteFile // '',
                   $line, $column, $row->[0]->[0]
                  ],
                  [$line, $column,
                   [[$row->[0], $row->[1], $tla, $row->[3], undef, $position]],
                   $siteFile
                  ]
                 ]);
        }
    }
    return [map({ $_->[1] } sort({ _summaryRowCmp($a->[0], $b->[0]) } @rows))];
}

sub callgraphCallerRows($;$)
{
    # The 'callers of this function' view:  the sites which target one
    #   FunctionAlias, as a list of
    #     [site file, line, column, caller symbol, count, tla or undef, group,
    #      caller's own file, the names the caller symbol represents or undef]
    #   in (file, line, column) order - and, where '$union' is set, a 10th
    #   element:  the categories of the sites the row counts, as {tla => 1} -
    #   see _unionSiteTla.  'group' is the 1-based position of this
    #   destination in the caller's own site group - the anchor to link back
    #   to.  One row per call location, for the same reason as the other table:
    #   every ordinal at one location in one caller links to the same anchor
    # The first element is where the call is *written* and the last is where the
    #   function which makes it is defined.  Those are two different files for a
    #   call in an '#include'd fragment, and the row needs both:  the location
    #   leads to the source line and the caller's name to the table of everything
    #   called at that site, which is on the page of the file which contains it
    my ($alias, $union) = @_;
    my @rows;
    my %rowAt;
    foreach my $caller ($alias->callers()) {
        my ($entry, $line, $column, $ordinal, $count, $siteFile) = @$caller;
        my $owner = $entry->file();
        my $file  = defined($siteFile) ? $siteFile : $owner;
        my $at    = "$file:$line:$column";
        my $tla   = $entry->callSiteTla($line, $column, $ordinal, $siteFile);
        if (exists($rowAt{$at})) {
            _foldCallerRow($rowAt{$at}, $count, $tla);
            $rowAt{$at}->[9]->{$tla} = 1 if $union && defined($tla);
            next;
        }
        # which row of the caller's group this is.  Read out of the caller's own
        #   numbering rather than stored, so that the two sides cannot disagree
        my $numbering =
            _callSitePositions($entry, $owner)->{"$file:$line:$column"};
        my $position =
            defined($numbering) ? $numbering->{$alias->name()} : undef;
        my $row = [$file, $line, $column, $entry->name(),
                   $count, $tla, $position, $owner,
                   _aliasMerged($entry, $entry->name())
        ];
        $row->[9] = defined($tla) ? {$tla => 1} : {} if $union;
        $rowAt{$at} = $row;
        push(@rows, $row);
    }
    return
        sort({ $a->[0] cmp $b->[0] or
                     $a->[1] <=> $b->[1] or
                     $a->[2] <=> $b->[2] } @rows);
}

sub _callgraphRowStyle($$)
{
    # how one call-site row is coloured:  by its differential category when there
    #   is one - the same per-TLA CSS the line and function tables use - and by
    #   taken/not-taken otherwise.  The unknown count is binned as not taken (see
    #   'categorizeCallSites') and is coloured that way too:  no test is known to
    #   have made the call.  The row of a call which came from outside the
    #   boundary of the report is not a call site and is not coloured here - see
    #   _callgraphCallerCells
    my ($count, $tla) = @_;
    return "tla$tla" if defined($tla);
    return 'coverCallgraphLo' if _callgraphCountUnknown($count);
    return _callgraphCellStyle($count);
}

sub _callgraphTlaLabel($)
{
    # what one category is called on these pages:  its TLA, or the word a report
    #   with no baseline calls it - where the only two categories are 'hit' and
    #   'missed', 'GNC' and 'UNC' are differential jargon for a reader who asked
    #   for no differential
    my $tla = shift;
    return undef unless defined($tla);
    return $main::use_legacyLabels ? $SummaryInfo::tlaToLegacy{$tla} : $tla;
}

sub _callgraphTlaCell($$$$)
{
    # The category cell of one row, or '' in a report which has no categories.  An
    #   empty cell rather than no cell when the row itself has no category, which
    #   is a site the categorizer never saw.
    # The cell leads to the start of the next group of its own category, which is
    #   what the same cell of the source view leads to:  a reader who is following
    #   one category wants the next place it appears, not the next row.
    # '$span' is how many rows the cell covers - see _callgraphRowRuns - and is 0
    #   on a row whose cell some row above it wrote, which then writes none
    my ($showTlas, $tla, $href, $span) = @_;
    return ''                                 unless $showTlas;
    return '<td class="coverCallgraph"></td>' unless defined($tla);
    return ''                                 unless $span;
    my $label = _callgraphTlaLabel($tla);
    my $cell  = $label;
    $cell =
        "<a class=\"tlaBg$tla\" href=\"$href\" title=\"Next $label group\">" .
        "$label</a>"
        if defined($href);
    # ..and the cell says which category it is, where the reader points at the
    #   cell rather than at its link
    return "<td class=\"tla$tla\" title=\"$label\">$cell</td>" if 1 == $span;
    return "<td class=\"tla$tla callgraphSpan\" rowspan=\"$span\"" .
        " title=\"$label\">$cell</td>";
}

sub _callgraphTlaHead($)
{
    # 'TLA' unconditionally:  the caller writes this column only where the
    #   categories are TLAs, a report whose two categories are 'hit' and 'missed'
    #   having folded the word onto the count instead.  See '_callgraphCountCell'
    my $showTlas = shift;
    return '' unless $showTlas;
    return '<td class="tableHead">TLA</td>';
}

sub _nextGroupIndex($$)
{
    # Where the group link of row '$i' leads:  past the whole contiguous run of
    #   rows which share its key, to the next row which has that key again - which
    #   is what makes these links a tour of one category, one author or one date
    #   bin rather than a walk down the table.  undef when there is no later one.
    # This is 'SourceFile::nextTlaGroup' asked of the rows of a table instead of
    #   the lines of a file, and it treats a row with no key the way that does a
    #   line with no category:  such a row neither continues a run nor breaks one,
    #   so a caption in the middle of a run does not turn it into two groups
    my ($keys, $i) = @_;
    my $key = $keys->[$i];
    return undef unless defined($key);
    my $last = scalar(@$keys);
    my $next = $i + 1;
    while ($next < $last) {
        last if defined($keys->[$next]) && $keys->[$next] ne $key;
        ++$next;
    }
    while ($next < $last) {
        return $next if defined($keys->[$next]) && $keys->[$next] eq $key;
        ++$next;
    }
    return undef;
}

sub _callgraphGroupHref($$$)
{
    # ..and what that link says, or undef for a row which has no key and so no
    #   group to follow.  The last group of a key leads to the top of the page,
    #   exactly as the category and annotation links of the source view do
    my ($keys, $i, $anchors) = @_;
    return undef unless defined($keys->[$i]);
    my $next = _nextGroupIndex($keys, $i);
    return '#' . (defined($next) ? $anchors->[$next] : 'top');
}

sub _callgraphHitKey($)
{
    # Which of the two tours of the count column one row is on:  'hit' where the
    #   call was taken, 'missed' where it was not - or is not known to have been
    #   taken, which is the unknown count.  undef for a row which has no count of
    #   its own:  it is on neither tour, and so does not break a run of the rows
    #   around it either, for the reason a row with no category does not break a
    #   run of categories (see _nextGroupIndex)
    my $row = shift;
    return undef unless exists($row->{count});
    return _callgraphCountKey($row->{count});
}

sub _callgraphCountKey($)
{
    # ..which is a question about the count alone
    my $count = shift;
    return 'missed' if _callgraphCountUnknown($count);
    return $count > 0 ? 'hit' : 'missed';
}

sub _callgraphUnhitTla($)
{
    # The colour of one function's date and owner cells:  the category of its
    #   calls on this page which were not taken - the first of them in category
    #   order where there are several, which is the order the rest of the report
    #   ranks them in - and undef where every call of it was taken.  Same rule as
    #   the source view, which colours those two columns of a line only where the
    #   line was not exercised:  the colour is there to be scanned for, so it is
    #   worth nothing if every row carries it.  A count which is not known counts
    #   as a call which was not taken, as it does everywhere on these pages
    my $rows = shift;
    my $first;
    foreach my $row (@$rows) {
        my $tla = $row->{tla};
        next
            unless defined($tla) &&
            'missed' eq (_callgraphHitKey($row) || '');
        $first = $tla
            if !defined($first) ||
            $SummaryInfo::tlaRank{$tla} < $SummaryInfo::tlaRank{$first};
    }
    return $first;
}

sub _callgraphMergedRuns($$)
{
    # The cells of one of the function columns - the date or the owner - once
    #   contiguous functions which share a key have been merged:  a run of them is
    #   one cell, written by its first function and spanning the rows of all of
    #   them.  Returns two lists indexed by function
    #     - how many rows its cell spans, or 0 where a function above it wrote
    #       the cell, and
    #     - the function whose cell the cell of a run leads to:  the first of the
    #       next run with the same key, or undef where there is none, and
    #     - whether the cell of a run is the shaded one of the two a column
    #       alternates between.  Counted by cell rather than by function, as the
    #       name column is:  a merged cell is one cell, and two neighbours with
    #       the same shade would read as one run where they are two
    #   A function with no key is a cell of its own which merges with nothing -
    #   it is an empty cell, and two empty cells are two functions nothing is
    #   known about rather than one thing known about both - and it ends the run
    #   above it, which is what makes the next run with that key a separate one
    my ($keys, $heights) = @_;
    my (@spans, @starts);
    for (my $i = 0; $i < scalar(@$keys); ++$i) {
        my $key = $keys->[$i];
        if (@starts &&
            defined($key) &&
            defined($keys->[$i - 1]) &&
            $key eq $keys->[$i - 1]) {
            $spans[$starts[-1]] += $heights->[$i];
            push(@spans, 0);
            next;
        }
        push(@starts, $i);
        push(@spans, $heights->[$i]);
    }
    my (@next, %later, @shaded);
    $shaded[$starts[$_]] = $_ % 2 foreach (0 .. $#starts);
    foreach my $start (reverse(@starts)) {
        my $key = $keys->[$start];
        next unless defined($key);
        $next[$start] = $later{$key};
        $later{$key} = $start;
    }
    return (\@spans, \@next, \@shaded);
}

sub _callgraphRowRuns($)
{
    # ..and the same for the category column, which is a column of rows rather
    #   than of functions:  how many rows the category cell of each row spans, 0
    #   where a row above it wrote the cell.  A row with no category ends a run,
    #   because the cell it writes is in the way of the span - a caption spans
    #   the column, and a call with no category has an empty cell of its own -
    #   although it does not end the tour of the category, which is where the
    #   cell leads (see _nextGroupIndex)
    my $keys = shift;
    my @spans;
    my $start;
    for (my $i = 0; $i < scalar(@$keys); ++$i) {
        my $key = $keys->[$i];
        if (defined($key) &&
            defined($start) &&
            $key eq $keys->[$start]) {
            ++$spans[$start];
            push(@spans, 0);
            next;
        }
        $start = defined($key) ? $i : undef;
        push(@spans, 1);
    }
    return \@spans;
}

sub _callgraphTotals(@)
{
    # found/hit over the counts of the rows one function has on one page:  how
    #   much of that function's own direction of the callgraph the tests
    #   exercised, which is the number the page's second order sorts by.
    # A row whose count is not known is found and not hit, as
    #   'FunctionEntry::numCallSitesHit' counts one and as its category says:  the
    #   row is binned and toured as not hit, and a proportion which left it out
    #   would call the function fully exercised beside a row the same page
    #   categorizes as missed.  The row is a ceiling no additional test can lift,
    #   which is what '--filter unknown_callee_count' is for.
    # Only rows which carry a count are passed:  the row which says that a call
    #   crossed the boundary of the report is in neither total
    my $found = scalar(@_);
    my $hit   = scalar(grep({ lcovutil::site_count_hit($_) } @_));
    return [$found, $hit];
}

sub _rateOrder($$)
{
    # The order of two proportions, '[found, hit]' each, in every table which is
    #   sorted by one:  the lowest first, which is where the reader who did not
    #   come for a particular row should start - and of two equal proportions the
    #   one with the larger denominator, which is more coverpoints left at that
    #   rate.  Nothing to divide - no proportion at all, or a zero denominator -
    #   is last:  'nothing is known here' is not the same claim as 'nothing here
    #   was exercised', and such a row has no proportion to show.
    # 0 where the two are the same, so that the caller can break the tie
    my ($x, $y) = @_;
    my $empty_X = (!defined($x) || 0 == $x->[0]) ? 1 : 0;
    my $empty_Y = (!defined($y) || 0 == $y->[0]) ? 1 : 0;
    return $empty_X <=> $empty_Y if $empty_X || $empty_Y;
    # compared without dividing, so that two equal proportions are equal
    return ($x->[1] * $y->[0] <=> $y->[1] * $x->[0]) ||
        ($y->[0] <=> $x->[0]);
}

sub _callgraphHitCell($$)
{
    # How much of this function's own direction of the callgraph the tests
    #   exercised, beside its name and spanning its rows:  the proportion the page
    #   is ordered by, so that the reader who did not come looking for a
    #   particular function can start with the least exercised one.
    # Written as the proportions of the function table are written, and coloured
    #   by the same thresholds:  it is the same question asked of a different set
    #   of coverpoints, and a reader should not have to learn a second spelling.
    #   Except that an empty denominator is written as the unknown count of a
    #   single call site is - '-', and nothing else:  '0 / 0' invites the reader
    #   to divide two numbers which are not a proportion
    my ($metric, $height) = @_;
    my ($found, $hit)     = @$metric;
    my $style = $rate_name[classify_rate($found, $hit, $callgraph_med_limit,
                                         $callgraph_hi_limit)];
    my $rate = rate($hit, $found, '&nbsp;%');
    $rate .= " ($hit / $found)" if 0 != $found;
    return '              ' .
        "<td class=coverPer$style" .
        ($height > 1 ? " rowspan=\"$height\"" : '') .
        ">$rate</td>\n";
}

sub _callgraphXrefTitle($)
{
    # ..and what that cell says when the reader stops on it:  which list is one
    #   click away
    my $other = shift;
    return 'Click to go to list of ' . $other->{title};
}

sub _callSiteAnchor($$;$$)
{
    # the fragment identifying one call-site group, or one row within it.  Shared
    #   by the source view, the group's own cell and the back-link from a
    #   callee's 'called from' row, so that all three spell it the same way
    # '$file' is the file the call is written in, and is undef - which is the
    #   ordinary case - when that is the file whose function contains it.  Two
    #   files can have a call at one line and column and both groups are on the
    #   one page, so the file has to be part of the fragment when there is one.
    #   Not reversible and not meant to be read;  what it has to be is the same
    #   string every run, which is why it is the whole path
    my ($line, $column, $position, $file) = @_;
    my $anchor = 'site';
    if (defined($file)) {
        my $tag = $file;
        $tag =~ s/[^A-Za-z0-9]/_/g;
        $anchor .= "_$tag";
    }
    $anchor .= "_${line}_$column";
    $anchor .= "_$position" if defined($position);
    return $anchor;
}

sub _calleeFuncAnchor($)
{
    # the fragment identifying one function on either call site page:  the leader
    #   name, which is the name both pages list it under, so that the source view,
    #   the function table and the other direction can all lead to it without
    #   knowing which page they are leading to
    my $func = shift;
    return 'func_' . escape_id($func);
}

sub _callerRowAnchor($$)
{
    # the fragment identifying one caller row of one function.  Nothing outside
    #   the callers page leads to a row of it - a link into that page names either
    #   a function or the whole page - so this exists for the category links,
    #   which need somewhere within the table to land
    my ($func, $index) = @_;
    return 'caller_' . escape_id($func) . "_$index";
}

sub _showAliasGroups($$)
{
    # Are the aliases of FunctionEntry '$entry' shown as the groups which
    #   TraceFile::_collapseCallgraphAliases left - each surviving alias the
    #   group of the names merged into it, with a row of its own under the
    #   function in the function table and on both call site pages?  Only where
    #   that collapse ran and found something to distinguish the aliases:  the
    #   callgraph is measured for the file - '$measured', see
    #   FunctionMap::hasCallgraphData - and more than one of its aliases
    #   survived.  Anywhere else the aliases are names of one function, and
    #   are shown as such
    my ($entry, $measured) = @_;
    return $lcovutil::callgraph_coverage    &&
        $lcovutil::collapse_callgraph_alias &&
        $measured                           &&
        !$main::suppress_function_aliases   &&
        $entry->numAliases() > 1;
}

sub _aliasGroupAnchor($)
{
    # the fragment identifying the rows of one alias group on either call site
    #   page - see '_showAliasGroups' - and so what its cells in the function
    #   table lead to.  Not the function's own anchor, although the function is
    #   listed under the name of one of its groups
    my $alias = shift;
    return 'group_' . escape_id($alias);
}

sub _aliasGroupSites($$)
{
    # the call site groups '$groups' of one function - see 'callSiteGroups' - as
    #   alias group '$alias' made them:  each row which counts a call it made,
    #   with the count of its calls alone, and the position the row has among
    #   all of the function's rows - used in the hyperlink from the other side
    #   of the table.  A call with no alias set is every alias's
    my ($groups, $alias) = @_;
    my @mine;
    my %names;
    foreach my $group (@$groups) {
        my ($line, $column, $rows, $siteFile) = @$group;
        my @rows;
        my $position = 0;
        foreach my $row (@$rows) {
            ++$position;
            my $count;
            my $made = 0;
            while (my ($set, $c) = each(%{$row->[4]})) {
                next
                    unless '' eq $set ||
                    exists(
                      ($names{$set} //= {
                           map({ ($_ => 1) } FunctionEntry::aliasSetNames($set))
                       })->{$alias});
                $count = lcovutil::add_site_count($count, $c);
                $made  = 1;
            }
            push(@rows, [@{$row}[0], $count, @{$row}[2, 3], undef, $position])
                if $made;
        }
        push(@mine, [$line, $column, \@rows, $siteFile]) if @rows;
    }
    return \@mine;
}

sub _aliasGroupMetrics($$$)
{
    # [found, hit] of each direction of the callgraph, as the function table
    #   counts them, for each alias group of FunctionEntry '$entry' - see
    #   '_showAliasGroups':  the calls into the group (the caller rows
    #   '$callers' lists for it) and the call sites the group made, each site
    #   once.  undef if the group has no sites in that direction (no callers
    #   or no callees).
    my ($entry, $callers, $groups) = @_;
    my %metric;
    foreach my $caller (@$callers) {
        my $alias = $caller->[5];
        next unless defined($alias);
        my $m = _callgraphTotals(map({ $_->[4] } @{$caller->[4]}));
        $metric{$alias}->[CALLGRAPH_VIEW_CALLERS] = $m if 0 != $m->[0];
    }
    foreach my $alias ($entry->aliasNames()) {
        my ($found, $hit) = (0, 0);
        foreach my $group (@{_aliasGroupSites($groups, $alias)}) {
            foreach my $row (@{$group->[2]}) {
                ++$found;
                ++$hit if lcovutil::site_count_hit($row->[1]);
            }
        }
        $metric{$alias}->[CALLGRAPH_VIEW_CALLEES] = [$found, $hit]
            if $found;
    }
    return \%metric;
}

sub _aliasGroupsInOrder($$$@)
{
    # The alias groups '@groups' of function '$entry' - each an array whose
    #   element '$at' is the alias - in the order the page of direction
    #   '$view' lists them where there is no summary block above them (see
    #   'show_callgraph_summary' in lcovrc(5)):  the least exercised first,
    #   which is the one the reader is most likely to care about - by rate,
    #   then by the larger denominator (see _rateOrder), then by name
    my ($entry, $view, $at, @groups) = @_;
    my $metric = $entry->{groupMetric};
    return
        sort({
                 my ($x, $y) = map({ $metric->{$_->[$at]} } ($a, $b));
                 _rateOrder(defined($x) ? $x->[$view] : undef,
                            defined($y) ? $y->[$view] : undef) or
                     $a->[$at] cmp $b->[$at]
        } @groups);
}

sub _countedCallSites($$)
{
    # The call sites of function '$entry' - see callgraphDetailEntries - which
    #   the callgraph numbers of the report count, as [category, {age, owner}
    #   or undef] each:  the rows its callees page shows, and of a function
    #   shown as alias groups, the rows of its summary block, or where there is
    #   none, the rows of every group (see 'show_callgraph_summary' in
    #   lcovrc(5)).  A site several groups share is then counted by each of
    #   them, as the page lists it in each.  Every row has a category:  genhtml
    #   categorizes every site, differential report or not
    # The date and owner are those of the line of '$srcfile' which the site
    #   is counted on - see SourceFile::_countCallgraphTlaData - which for a
    #   site written in another file is the line its function starts on
    my ($entry, $srcfile) = @_;
    my @groups =
        defined($entry->{summarySites}) ? @{$entry->{summarySites}} :
        defined($entry->{aliasGroups}) ?
        map({ @{$_->[1]} } @{$entry->{aliasGroups}}) :
        @{$entry->{groups}};
    my $annotate = @SourceFile::annotateScript;
    my @sites;
    foreach my $group (@groups) {
        my ($line, undef, $rows, $siteFile) = @$group;
        $line = $entry->{entry}->line() if defined($siteFile);
        my $annot;
        my $who =
            ($annotate && $line > 0 && $line <= $srcfile->num_lines()) ?
            $srcfile->attribution($line) :
            undef;
        $annot = {
                  age   => $who->age(),
                  owner => $who->owner()
            }
            if defined($who) && defined($who->age());
        push(@sites, map({ [$_->[2], $annot] } @$rows));
    }
    return @sites;
}

sub _aliasGroupLeadCells($$$$$$$)
{
    # The cells which introduce one alias group's rows on a call site page - see
    #   '_showAliasGroups' - laid out in a row in the same way as the
    #   function detail table:  the proportion of the other direction its
    #   rows there hold, its name, indented under the function's and
    #   hyperlinked to the function definition, with the aliases that merged
    #   into it in the tooltip of its superscript, and the proportion of this
    #   page's direction its rows hold.
    #   Each spans the rows of the group.  '$group' is
    #   [alias, the aliases merged into it, its number of rows], and '$xref'
    #   is [the other direction, its page] if the page has that column, and
    #   page is undef if the function does not appear on that page (e.g.,
    #   has no caller or callee sites).
    #   Not its category, which is that of a function:  the category column of
    #   the page is that of a call.
    # Where there is no summary block - see 'show_callgraph_summary' in
    #   lcovrc(5) - '$alternate' is the colour of the function in the
    #   alternation of the page (see _calleeFuncCell), and the groups are
    #   written as the function itself would be:  not indented, in that colour,
    #   and on the callers page with the note beside the name of each.  The
    #   first of them, '$first', holds the anchor of the function, so that a
    #   link to the function leads to it.  '$alternate' is undef where the
    #   groups are below a summary block
    my ($entry, $group, $view, $xref, $source, $alternate, $first) = @_;
    my ($alias, $merged, $height, $caller) = @$group;
    my $plain  = defined($alternate);
    my $metric = $entry->{groupMetric}->{$alias};
    my $anchor = _aliasGroupAnchor($alias);
    my $html   = '';
    if (defined($xref)) {
        my ($other, $page) = @$xref;
        my $m = defined($metric) ? $metric->[1 - $view] : undef;
        $html .=
            _calleeXrefCell((defined($m) && defined($page)) ? "$page#$anchor" :
                                        undef,
                            $other, $m // [0, 0],
                            $height, $plain && $alternate);
    }
    my $line =
        _shownSourceLine($entry->{startline},
                         $entry->{startline} + $func_offset);
    my $class =
        !$plain ? 'calleeFnAlias' :
        $alternate ? 'calleeFnAlt' :
        'calleeFn';
    my $funcSpan =
        ($plain && $first) ?
        '<span id="' . _calleeFuncAnchor($entry->{name}) . '"></span>' :
        '';
    $html .=
        "              <td class=\"$class\"" .
        ($height > 1 ? " rowspan=\"$height\"" : '') .
        " id=\"$anchor\">$funcSpan" .
        "<a href=\"$source#L$line\" title=\"" .
        $ALIAS_GROUP_TITLE . '">' .
        escape_html(simplify_function_name($alias)) . '</a>' .
        _mergedNameNote($alias, $merged);
    # ..and the note on the callers of the group, which is the function's
    #   note where the summary block has it
    my $note =
        ($plain && defined($caller)) ? _callgraphCallerNote([$caller]) : undef;
    $html .=
        '<br><span class="calleeFnNote" title="' .
        escape_html($note->[1]) . '">' .
        escape_html($note->[0]) .
        '</span>'
        if defined($note);
    $html .= "</td>\n";
    my $rate =
        (defined($metric) && defined($metric->[$view])) ? $metric->[$view] :
        [0, 0];
    return $html . _callgraphHitCell($rate, $height);
}

sub _callgraphCaptionCell($$)
{
    # which alias' callers the rows below belong to, for a function which has
    # more than one:  a row of its own, because the heading of a column cannot
    # say it and none of the columns is for it
    my ($caption, $span) = @_;
    return '              <td class="callgraphNote" colspan="' .
        $span .
        '"><span class="callgraphCaption" title="' .
        $ALIAS_CAPTION_TITLE . '">' .
        $caption .
        "</span></td>\n";
}

sub _callgraphCallerNote($)
{
    # Which side of the boundary of the report this function's callers are on,
    #   said beside its name rather than left to be counted out of its rows:
    #   which of internal, external or both is the question the whole metric is
    #   asked for an application whose testcases are elsewhere.
    # A call from outside the report is either asserted by the 'x' flag or
    #   inferred from the callee being entered more often than the sites here
    #   account for.  The aliases of a function are one function, so their
    #   classes combine - which the numbering of the classes does directly.
    # 'Internal' here is a call site of this report which names the function, and
    #   not the CALLERS_INTERNAL class:  that class is arithmetic on counts, so a
    #   site whose count is unknown is not in it, and a note reading 'external
    #   only' beside a row which does name a caller would contradict the rows the
    #   reader can see.
    # Nothing is said when every caller is a site in this report:  the rows say
    #   that already.  See lcovutil::classify_callers
    my $callers  = shift;
    my $mask     = lcovutil::CALLERS_NONE;
    my $internal = 0;
    foreach my $caller (@$callers) {
        $mask |= $caller->[2];
        $internal = 1 if @{$caller->[4]};
    }
    if ($mask & lcovutil::CALLERS_EXTERNAL) {
        return $internal ? [$CALLERS_BOTH_NOTE, $CALLERS_BOTH_TITLE] :
            [$CALLERS_EXTERNAL_NOTE, $CALLERS_EXTERNAL_TITLE];
    }
    return [$CALLERS_UNKNOWN_NOTE, $CALLERS_UNKNOWN_TITLE]
        if $mask & lcovutil::CALLERS_INDETERMINATE;
    return undef;
}

sub _aliasMerged($$)
{
    # the names merged into the alias '$name' of '$entry' - undef if none, or if
    #   the entry has no alias of that name
    my ($entry, $name) = @_;
    my $alias = $entry->alias($name);
    return defined($alias) ? $alias->merged() : undef;
}

sub _mergedNameNote($$)
{
    # The mark beside a name which other names were merged into (see
    #   TraceFile::_collapseCallgraphAliases):  how many names it represents -
    #   itself and '$merged', the others (see FunctionAlias::merged) - with the
    #   names and hit count of each in the tooltip.  Wherever the name is
    #   shown, so that the reader who sees 'f<int>' calling 'g' is told that
    #   the line is about 'f<char>' too.  Empty where nothing was merged into it
    # The tooltip is a list in the page, shown on hover by CSS, rather than a
    #   'title':  a browser's own tooltip is one line of plain text, which
    #   can't align the names nor use background color to distinguish them.
    #.  One row per name - 'count: name', the counts right-aligned so that
    #    the names start in the same place - in alternating colors
    my ($name, $merged) = @_;
    return '' unless defined($merged);
    my @names = sort(keys(%$merged));
    my $total = scalar(@names) + 1;
    return "<sup class=\"mergedNames\">$total</sup>"
        if 1 == $alias_list_length;
    my @shown =
        map({ [$merged->{$_}, simplify_function_name($_)] }
            $alias_list_length ?
                splice(@names, 0, $alias_list_length - 1) :
                splice(@names));
    push(@shown, ['', '...']) if @names;
    my $alt = 0;
    my $rows = join('',
                    map({ '<span class="mergedNamesRow' .
                                ($alt++ % 2 ? 'Alt' : '') .
                                '"><span class="mergedNamesCount">' .
                                ('' eq $_->[0] ? '' : $_->[0] . ':') .
                                '</span><span class="mergedNamesName">' .
                                escape_html($_->[1]) .
                                '</span></span>' } @shown));
    return
        "<sup class=\"mergedNames\">$total<span class=\"mergedNamesList\">" .
        '<span class="mergedNamesHead">' .
        escape_html(simplify_function_name($name) .
                    " stands for $total names - merged into it:") .
        "</span>$rows</span></sup>";
}

sub _calleeFuncCell($$$$$)
{
    # The name cell of a function:  its name, linked to its definition - which is
    #   the same pair of jobs the function table gives that column - and the
    #   anchor every link to this function on this page leads to.
    # It spans every row the function has, so that the extent of one function is
    #   readable where its rows run on, and its colour alternates from function to
    #   function for the same reason.
    my ($entry, $source, $view, $height, $alternate) = @_;
    my $name = escape_html(simplify_function_name($entry->{name}));
    # ..and the names merged into it, unless its aliases are shown as groups:
    #   then they are on the row of the group they are in - or, where the
    #   groups are not shown, here:  every name of every group
    my $merged;
    if (!defined($entry->{aliasGroups})) {
        $merged = _aliasMerged($entry->{entry}, $entry->{name});
    } elsif ($main::suppress_alias_groups) {
        $merged = {};
        foreach my $group (@{$entry->{aliasGroups}}) {
            my ($alias, undef, $names) = @$group;
            $merged->{$alias} = $entry->{entry}->alias($alias)->count();
            @{$merged}{keys(%$names)} = values(%$names) if defined($names);
        }
        delete($merged->{$entry->{name}});
    }
    my $mark = _mergedNameNote($entry->{name}, $merged);
    my $line =
        _shownSourceLine($entry->{startline},
                         $entry->{startline} + $func_offset);
    my $cell =
        '              <td class="' .
        ($alternate ? 'calleeFnAlt' : 'calleeFn') . '"' .
        ($height > 1 ? " rowspan=\"$height\"" : '') . ' id="' .
        _calleeFuncAnchor($entry->{name}) .
        "\"><a href=\"$source#L$line\">$name</a>$mark";
    # the note is about the callers of the function, so it belongs beside them
    my $note =
        $view == CALLGRAPH_VIEW_CALLERS ?
        _callgraphCallerNote($entry->{callers}) :
        undef;
    $cell .=
        '<br><span class="calleeFnNote" title="' .
        escape_html($note->[1]) . '">' .
        escape_html($note->[0]) .
        '</span>'
        if defined($note);
    return $cell . "</td>\n";
}

sub _calleeXrefCell($$$$$)
{
    # The other direction of the callgraph for one function, in a column of its
    #   own:  the two pages are one question asked twice, and a reader looking at
    #   the callers of a function is one click from what it calls.  A column
    #   rather than a note under the name, so that the reader who wants the other
    #   question always finds the answer in the same place.
    # The cell is the proportion of that other direction the tests exercised -
    #   '$metric' - written and coloured as the 'Hit' column beside it is, and
    #   linked to '$href', this function's rows on the page of the other
    #   direction.  Empty where there is no such row, or no denominator:  a link
    #   which lands on a page the function is not listed on leads nowhere, and
    #   there is no honest percentage of nothing
    my ($href, $other, $metric, $height, $alternate) = @_;
    my ($found, $hit) = @$metric;
    my $span = $height > 1 ? " rowspan=\"$height\"" : '';
    return '              <td class="' .
        ($alternate ? 'calleeXrefAlt' : 'calleeXref') .
        "\"$span></td>\n"
        if !defined($href) || 0 == $found;
    my $style = $rate_name[classify_rate($found, $hit, $callgraph_med_limit,
                                         $callgraph_hi_limit)];
    return '              ' .
        "<td class=coverPer$style$span><a href=\"$href\" title=\"" .
        _callgraphXrefTitle($other) . '">' .
        rate($hit, $found, '&nbsp;%') .
        " ($hit / $found)</a></td>\n";
}

sub _callgraphAnnotCells($$$$$)
{
    # Who last changed a function and how long ago, in the two columns the source
    #   view has at the left of every line:  the same two questions asked of the
    #   function, which is to say of the line its definition starts on.  The age
    #   is the number of days the source view shows, so that the two views are
    #   read the same way;  the owner is the author's full name rather than the
    #   truncated login, a table cell having room for it.
    # A cell is a run of contiguous functions rather than one of them:  those
    #   which share the author, or the date bin, and the colour are one cell,
    #   written by the first of them and spanning the rows of all of them - see
    #   _callgraphMergedRuns, whose three lists per column '$columns' holds.  The
    #   age a merged cell shows is the most recent of the ages in it, which is
    #   the answer to "how long since any of these was changed".
    # Each cell leads to the next cell of its own group, exactly as the same two
    #   columns of the source view lead to the next line of one - past the run it
    #   is, to the next run of that date bin or that author in that colour.  The
    #   colour is that of the calls of the function this page shows which were
    #   not taken, and there is none where every one of them was (see
    #   _callgraphUnhitTla):  a fully exercised function is not what a reader
    #   following an author through the report is looking for
    my ($entries, $block, $colour, $columns, $anchors) = @_;
    my $html  = '';
    my $label = _callgraphTlaLabel($colour);
    my $color = defined($colour) ? " class=\"tlaBg$colour\"" : '';
    for (my $col = 0; $col < 2; ++$col) {
        my ($spans, $next, $shaded) = @{$columns->[$col]};
        my $height = $spans->[$block];
        next unless $height;
        my $span  = $height > 1 ? " rowspan=\"$height\"" : '';
        my $class = 'calleeAnnot' . ($shaded->[$block] ? 'Alt' : '');
        my $annot = $entries->[$block]->{annot};
        # ..and nothing at all for a function the annotation callback had no
        #   answer for, which is one row of a file whose other rows it did
        #   answer for.  Not seen in practice:  every line of an annotated file
        #   has an answer, including the lines '_synthesize' makes up to reach
        #   the last function - and callgraph coverage requires function
        #   coverage, so every function is reached
        if (!defined($annot)) {
            # LCOV_UNREACHABLE_START
            $html .= "              <td class=\"$class\"$span></td>\n";
            next;
            # LCOV_UNREACHABLE_STOP
        }
        # ..and the cell itself says what it stands for, where the reader points
        #   at the cell rather than at its link:  the date the age is counted
        #   from, and the author's full name
        my ($text, $group, $what);
        if (0 == $col) {
            my $recent = $annot;
            my $end    = $block + 1;
            while ($end < scalar(@$entries) && 0 == $spans->[$end]) {
                my $a = $entries->[$end++]->{annot};
                $recent = $a if $a->{age} < $recent->{age};
            }
            $text = $recent->{age};
            $what = $recent->{date};
            $group =
                '&ldquo;' .
                $SummaryInfo::ageGroupHeader[$annot->{bin}] .
                '&rdquo; bin';
        } else {
            $text  = $annot->{name};
            $what  = $annot->{name};
            $group = escape_html($annot->{owner});
        }
        my $tip = defined($what) ? ' title="' . escape_html($what) . '"' : '';
        $text = escape_html($text);
        my $target = $next->[$block];
        my $href   = '#' . (defined($target) ? $anchors->[$target] : 'top');
        my $title =
            'next ' . (defined($label) ? $label : 'group') . " by $group";
        $html .= "              <td class=\"$class\"$span$tip>" .
            "<a$color href=\"$href\" title=\"$title\">$text</a></td>\n";
    }
    return $html;
}

sub callgraphDetailEntries($$$)
{
    # The functions of one file which have something to say about calls:  it makes
    #   some, or something called it.  Each entry is a hash carrying
    #     name       the leader symbol, which is what both pages list it under
    #     entry      its FunctionEntry, for the calls it makes
    #     callers    one element per alias which has callers, each of them
    #                  [caption or undef, FunctionAlias, class,
    #                   [external calls, deduced calls, 'x' flag],
    #                   [caller row, ..]] -
    #                  see lcovutil::classify_callers.  Under '--filter
    #                  function', one element for all of them, with no caption
    #                  and no FunctionAlias - see _mergeCallerLists.  Where its
    #                  aliases are shown as groups - see _showAliasGroups - no
    #                  caption either, and a 6th element:  the alias
    #     aliasGroups  where its aliases are shown as groups, one element per
    #                  group, in name order:  [alias, its call site groups -
    #                  see _aliasGroupSites, the names merged into it]
    #     groupMetric  ..and [found, hit] per direction of each of them, by
    #                  alias - see _aliasGroupMetrics
    #     summaryCallers  ..and the rows of its summary on the callers page,
    #                  as one element of 'callers' - see _callerSummary.  Undef
    #                  if the function does not have a summary block
    #     summarySites ..and on the callees page, as call site groups - see
    #                  _calleeSummary.  Undef where 'summaryCallers' is
    #     groups     the call site groups of its body - see callSiteGroups
    #     startline  the line its definition starts on
    #     tla        its differential category
    #     annot      who last changed it and when, or undef
    #     destAnnot  the same, wherever the header bins calls into it
    #     siteAnnot  the same for the line of each of its call sites, by line
    #     metric     [found, hit] per direction, indexed by CALLGRAPH_VIEW_:
    #                  of the rows the page counts - see _countedCallSites
    #     has        whether it has anything to say in each direction, likewise
    # The rows of both pages are built here and not where they are written,
    #   because the proportion each page shows has to be the proportion of
    #   exactly the rows that page displays:  computing it anywhere else would let
    #   the two disagree.  One list, used both to decide which pages this file has
    #   and to write them, so a link cannot name a page which does not exist
    my ($funcdata, $differentialMap, $srcfile) = @_;
    # ..and the annotation columns, which exist where the callback answered for
    #   this file.  Same guard as the source view's own two columns
    my $annotate = $main::show_dateBins && $srcfile->isProjectFile();
    # ..and the same two questions asked of the line each call site is on, which
    #   is what the date and owner bins of the page header count and so what a
    #   link from one of them has to find - see CallgraphPageIndex.  Asked
    #   wherever the header has either of those tables
    my $annotateSites =
        ($main::show_dateBins || defined($main::show_ownerBins)) &&
        $srcfile->isProjectFile();
    # ..and whether this file's calls were measured at all, which decides how
    #   much of what its functions received can be attributed to anyone - see
    #   lcovutil::classify_callers.  Where they were not, a function which
    #   nothing here calls has nothing to say on either page, so the file has
    #   neither of them
    my $measured = $funcdata->hasCallgraphData($callgraphCalledSymbols);
    my @entries;
    foreach my $func (keys(%$differentialMap)) {
        my $funcEntry = $differentialMap->{$func};
        # a function which is not in the current source has no row in the
        #   function table either
        next if exists($SummaryInfo::deletedTla{$funcEntry->hit()->[1]});
        # 'CALLS' is not copied into the categorized entry and 'CALLERS' is
        #   derived data which is never copied anywhere, so both are read from
        #   the real FunctionEntry
        my $realEntry = $funcdata->findName($func);
        next unless defined($realEntry);
        my @callers;
        # the count of each call site which calls the function, by location:
        #   a site which calls more than one of its aliases is one unique site,
        #   and is hit if any of those calls was taken
        my %callerSites;
        my @aliasNames = sort($realEntry->aliasNames());
        my $grouped    = _showAliasGroups($realEntry, $measured);
        foreach my $aliasName (@aliasNames) {
            my $aliasData = $realEntry->alias($aliasName);
            # How this symbol's callers relate to the calls it received.  Shown
            #   even when no site in the report calls it, as long as something
            #   did:  "entered, and by nothing here" is a fact about the callee,
            #   and the usual reason for it - 'main', a function pointer, an
            #   uncaptured unit - is exactly what the reader is looking for.
            #   A symbol which was never entered and has no site has nothing to
            #   say, and so does one whose own unit's calls were never measured:
            #   there the caller is as likely to be its neighbour as to be
            #   anywhere else (lcovutil::classify_callers)
            my ($class, undef, $external, $deduced) =
                lcovutil::classify_callers($aliasData, $measured);
            next
                if 0 == $aliasData->numCallers() &&
                lcovutil::CALLERS_NONE == $class;
            # the column heading says what the list is, so a caption is written
            #   only when it says something the heading cannot - which of the
            #   aliases this list belongs to.  It says 'alias' outright, because
            #   an alias name is not in the first column of the page and need not
            #   be anywhere in the sources either:  a name the reader cannot find
            #   reads as a stray row rather than as this function under another
            #   symbol
            my $caption =
                (1 == scalar(@aliasNames) || $grouped) ?
                undef :
                'Callers of alias ' .
                escape_html(simplify_function_name($aliasName)) .
                _mergedNameNote($aliasName, $aliasData->merged());
            my @rows = callgraphCallerRows($aliasData, $grouped);
            foreach my $row (@rows) {
                my $site = join("\0", @{$row}[0 .. 2]);
                $callerSites{$site} =
                    lcovutil::add_site_count($callerSites{$site}, $row->[4]);
            }
            push(@callers,
                 [$caption,
                  $aliasData,
                  $class,
                  [$external, $deduced, $aliasData->has_external_callers()],
                  \@rows,
                  $grouped ? $aliasName : undef
                 ]);
        }
        # ..as one list, where the function table lists the function under one
        # name - with no caption even when only one alias had callers.
        # Used only when alias groups are not shown - if they are, then this
        # table has a row for each of group (just like the function detail
        # table does).
        @callers = (_mergeCallerLists(@callers))
            if $main::merge_function_aliases && @callers && !$grouped;
        # the caller side is held per alias and the call sites per entry, so a
        #   function with neither has no row on either page - unless it called out
        #   of the boundary of the report, which is a call with no site of its own
        #   (see FunctionEntry::has_external_callees)
        my $external = $realEntry->has_external_callees();
        my @groups   = callSiteGroups($realEntry, $realEntry->file(), $grouped);
        next unless @callers || @groups || $external;
        my $startline = $funcEntry->line() - $func_offset;
        $startline = 1 if $startline < 1;
        my ($aliasGroups, $groupMetric, $summaryCallers, $summarySites);
        if ($grouped) {
            # ..unless there is no summary block - see 'show_callgraph_summary'
            #   in lcovrc(5)
            if ($main::show_callgraph_summary) {
                $summaryCallers = _callerSummary(\@callers) if @callers;
                $summarySites   = _calleeSummary(\@groups);
            }
            $aliasGroups = [
                            map({ [$_,
                                   _aliasGroupSites(\@groups, $_),
                                   $realEntry->alias($_)->merged()
                            ] } @aliasNames)
            ];
            $groupMetric = _aliasGroupMetrics($realEntry, \@callers, \@groups);
        }
        my @siteCounts;
        my %siteAnnot;
        # ..and the same two questions asked of the line the function starts on,
        #   which is what the header of the callers page bins a call into it by
        my $destAnnot =
            $annotateSites ?
            _callgraphAnnotation($srcfile, $funcEntry->line()) :
            undef;

        foreach my $group (@groups) {
            push(@siteCounts, map({ $_->[1] } @{$group->[2]}));
            # a site written in another file is on a line of that file, whose
            #   annotation this file's header does not count
            my $line = $group->[0];
            $siteAnnot{$line} = _callgraphAnnotation($srcfile, $line)
                if $annotateSites &&
                !defined($group->[3]) &&
                !exists($siteAnnot{$line});
        }
        # the rows which represent a call - which is every row of a page
        #   except the one which says that a call crossed the callgraph
        #   boundary of the report.
        #   What we know about external calls is that there is at least one
        #   of them - but we know nothing about proportions.
        #   Each call site shown once, where the rows of alias groups list a
        #   site in more than one of them - and where there is no summary block,
        #   the rows of every group, which is what the page shows
        my $metric = [_callgraphTotals(values(%callerSites)),
                      _callgraphTotals(@siteCounts)
        ];
        if ($grouped && !$main::show_callgraph_summary) {
            foreach my $view (0 .. CALLGRAPH_VIEW_COUNT - 1) {
                my ($found, $hit) = (0, 0);
                foreach my $m (values(%$groupMetric)) {
                    next unless defined($m->[$view]);
                    $found += $m->[$view]->[0];
                    $hit   += $m->[$view]->[1];
                }
                $metric->[$view] = [$found, $hit];
            }
        }
        push(@entries,
             {
              name           => $func,
              entry          => $realEntry,
              callers        => \@callers,
              groups         => \@groups,
              aliasGroups    => $aliasGroups,
              groupMetric    => $groupMetric,
              summaryCallers => $summaryCallers,
              summarySites   => $summarySites,
              startline      => $startline,
              tla            => $funcEntry->hit()->[1],
              annot          => $annotate ? $destAnnot : undef,
              destAnnot      => $destAnnot,
              siteAnnot      => \%siteAnnot,
              metric         => $metric,
              has => [scalar(@callers) ? 1 : 0, (@groups || $external) ? 1 : 0],
             });
    }
    return @entries;
}

sub _callgraphAnnotation($$)
{
    # who last changed the line a function starts on, and how long ago, as the two
    #   cells of that function want it:  the age in days the source view shows,
    #   the author's full name, and the date bin and login the source view groups
    #   by.  undef where the callback had no answer for that line, which is the
    #   answer for a line outside the file it was asked about
    my ($srcfile, $line) = @_;
    return undef if $line < 1 || $line > $srcfile->num_lines();
    my $srcline = $srcfile->line($line);
    return undef unless defined($srcline);
    my ($owner, $age) = ($srcline->owner(), $srcline->age());
    return undef unless defined($owner) && defined($age);
    my $name = $srcline->full_name();
    # ..and the date itself, for the tooltip of the age cell:  the day, which is
    #   what the age counts in
    my $date = $srcline->date();
    $date =~ s/T.*$// if defined($date);
    return {
            age   => $age,
            date  => $date,
            name  => defined($name) ? $name : $owner,
            owner => $owner,
            bin   => SummaryInfo::findAgeBin($age),
    };
}

sub callgraphViewEntries($$$)
{
    # The functions one page shows, in that page's order.  A function is on the
    #   page of a direction only when it has something to say in that direction,
    #   which is not the same question for the two of them:  a leaf function has
    #   callers and no callees, 'main' the other way about, and a row which says
    #   nothing is a row the reader has to read before finding that out.
    # Every order is total, so that two runs of the same report give the same
    #   page:  the name breaks any tie before it, and the declaration line breaks
    #   a tie in the name - which only two identical names can produce.  A
    #   function's rows are one block in each of them, so that the Age and Owner
    #   cells merge the functions which end up next to each other
    my ($entries, $view, $sort_type) = @_;
    my @selected = grep({ $_->{has}->[$view] } @$entries);
    # the proportion the 'Rate' column of the page shows, least exercised
    #   first:  not the count of unexercised rows behind it - a function with two
    #   of ten calls left is not the one to start with when another has its only
    #   call left
    my $rate = sub {
        return _rateOrder($_[0]->{metric}->[$view], $_[1]->{metric}->[$view]);
    };
    my $key;
    if ($sort_type == $SORT_XREF) {
        # ..the proportion the column which leads to the other direction shows,
        #   which is empty where the function is not on that page
        $key = sub {
            my ($x, $y) =
                map({ $_->{has}->[1 - $view] ?
                            $_->{metric}->[1 - $view] :
                            undef } @_);
            return _rateOrder($x, $y);
        };
    } elsif ($sort_type == $SORT_OWNER || $sort_type == $SORT_AGE) {
        # ..the author the Owner column shows, alphabetically, or the age the
        #   Age column shows, the most recently changed first - and of the
        #   functions which share it, the least exercised first.  A function the
        #   annotation callback had no answer for has an empty cell, and is last
        my $owner = $sort_type == $SORT_OWNER;
        $key = sub {
            my ($x, $y) = map({ $_->{annot} } @_);
            return (defined($y) <=> defined($x))
                if !defined($x) ||
                !defined($y);
            return ($owner ? ($x->{name} cmp $y->{name}) :
                        ($x->{age} <=> $y->{age})) ||
                &$rate(@_);
        };
    } elsif ($sort_type == $SORT_MISSING_CALLGRAPH) {
        $key = $rate;
    } else {
        die("unexpected sort $sort_type") unless $sort_type == $SORT_FILE;
        $key = sub { return 0; };
    }
    return
        sort({ &$key($a, $b) or
                     $a->{name}      cmp $b->{name} or
                     $a->{startline} <=> $b->{startline} } @selected);
}

sub _callSiteGroupCells($$$$$$)
{
    # the rows of '_callSiteCells' for the call site groups '$groups' of
    #   function '$entry':  the location cell of each group spans its rows.  A
    #   group or row whose anchor is in '$seen' was written already, and is
    #   written again without it
    my ($entry, $groups, $source, $base_dir, $sort_type, $seen) = @_;
    my @cells;
    foreach my $group (@$groups) {
        my ($line, $column, $rows, $siteFile) = @$group;
        my $anchor = _callSiteAnchor($line, $column, undef, $siteFile);
        my $first  = !$seen->{$anchor}++;
        # the location cell is 'taken' if any destination of it was
        my $groupCount = _callgraphGroupCount($rows);
        # ..and a call written in another file is named with that file, and links
        #   to its page rather than to this one - see 'FNC:' in geninfo(1)
        my $location = "$line:$column";
        my $sitePage = $source;
        my $lineFile = $entry->{entry}->file();
        if (defined($siteFile)) {
            $lineFile = $siteFile;
            $location =
                escape_html(File::Basename::basename($siteFile)) . ":$location";
            $sitePage = filePageBase($siteFile, $base_dir);
            $sitePage = "$sitePage.gcov.$html_ext" if defined($sitePage);
        }
        $location =
            "<a href=\"$sitePage#L$line\" title=\"" .
            $callgraphView[CALLGRAPH_VIEW_CALLEES]->{siteTitle} .
            "\">$location</a>"
            if defined($sitePage) && _pageShows($lineFile, 'gcov', $line);
        my $rowspan =
            scalar(@$rows) > 1 ? ' rowspan="' . scalar(@$rows) . '"' : '';
        my $locationCell =
            '              <td class="' .
            _callgraphRowStyle($groupCount, undef) .
            "\"$rowspan" .
            ($first ? " id=\"$anchor\"" : '') .
            ">$location</td>\n";
        my $position = 0;
        foreach my $row (@$rows) {
            my ($callees, $count, $tla, $where, undef, $at) = @$row;
            ++$position;
            # ..which, in the list of one alias group, is the position the row
            #   has among all of the function's rows
            $at //= $position;
            my $id = _callSiteAnchor($line, $column, $at, $siteFile);
            $id = undef if $seen->{$id}++;
            # every symbol which leads to this one place, named in the one cell
            my $name =
                join(', ',
                     map({ escape_html(simplify_function_name($_))
                                 .
                                 (defined($where) ?
                                      _mergedNameNote($_,
                                       $calleeMergedNames{$where->[0] . "\0$_"})
                                  :
                                      '') } @$callees));
            # ..and leading to the callers of the callee, which is the list this
            #   reader is one step away from wanting:  "who else calls what I
            #   call" is the question this cell is the start of.  Not a link when
            #   the report has no page for the callee, which is a call which left
            #   the boundary, or when the page does not list it (because it was
            #   removed by a 'select' callback)
            if (defined($where)) {
                my $page =
                    _callgraphForeignPage($where->[0], $base_dir,
                                          CALLGRAPH_VIEW_CALLERS, $sort_type);
                my $shown = $where->[0] . "\0$callees->[0]";
                my $anchor =
                    exists($calleeGroupShown{$shown}) ?
                    _aliasGroupAnchor($callees->[0]) :
                    _calleeFuncAnchor($where->[2]);
                $name =
                    "<a href=\"$page#$anchor" .
                    '" title="Click to go to the callers of ' .
                    escape_html($callees->[0]) .
                    "\">$name</a>"
                    if defined($page) &&
                    _pageShows($where->[0], 'callers', $anchor);
            }
            push(@cells,
                 {
                  id   => $id,
                  tla  => $tla,
                  site => defined($siteFile) ?
                      undef :
                      $entry->{siteAnnot}->{$line},
                  head => $locationCell .
                      '              ' .
                      "<td class=\"coverCallgraph\">$name</td>\n",
                  count => $count,
                 });
            $locationCell = '';    # spanned by the first row of the group
        }
    }
    return @cells;
}

sub _callSiteCells($$$$$)
{
    # 'Calls made by this function' - the rows of the callees page for one
    #   function.  These are the calls the file's own FNCF/FNCH are computed
    #   from:  a location with several destinations needs: a virtual call,
    #   a call through a function pointer, a call in a template body - is one
    #   group of rows sharing a location cell, each destination with a count
    #   of its own.
    # Each row is a hash carrying
    #     id     the anchor the source view and a caller's name cell lead to,
    #              which is on the row because the row is what they mean
    #     tla    its category, for the column and for the category links
    #     site   who last changed the line the call is on and when, or undef -
    #              see CallgraphPageIndex
    #     head   the cells before the category column, and 'tail' those after
    #   - or 'note', a row which spans the columns instead of filling them.
    #     group  on the first row of an alias group, [alias, the names merged
    #              into it, its number of rows] - see _aliasGroupLeadCells
    #     summary  on a row of the summary block of a function shown as alias
    #              groups
    # Where the aliases of the function are shown as groups - see
    #   _showAliasGroups - the function's rows are a summary block, a row per
    #   unique call site (see _calleeSummary), and then each group, the calls
    #   that group made:  a site more than one of them made is in the list of
    #   each.  The summary has the anchors, being the first.  Unless the
    #   groups are suppressed - see 'suppress_alias_groups' in lcovrc(5) -
    #   or there is no summary block, and the groups are the function's rows,
    #   least exercised first - see 'show_callgraph_summary' in lcovrc(5)
    my ($entry, $source, $base_dir, $span, $sort_type) = @_;
    my @cells;
    my %seen;
    my $summary = $entry->{summarySites};
    my @aliasGroups;
    if (defined($summary)) {
        @cells =
            _callSiteGroupCells($entry, $summary, $source,
                                $base_dir, $sort_type, \%seen);
        push(@cells, _externalCalleeRow($entry));
        $_->{summary} = 1 foreach (@cells);
        @aliasGroups = @{$entry->{aliasGroups}}
            unless $main::suppress_alias_groups;
    } elsif (defined($entry->{aliasGroups})) {
        @aliasGroups =
            _aliasGroupsInOrder($entry, CALLGRAPH_VIEW_CALLEES,
                                0, @{$entry->{aliasGroups}});
    } else {
        @aliasGroups = ([undef, $entry->{groups}]);
    }
    # ..and the calls out of the report are the function's, not a group's:
    #   where there is no summary block, they are the last row of the first
    #   group which is written - or of the first group, where none made a call
    my @external = defined($summary) ? () : _externalCalleeRow($entry);
    my ($home) = grep({ @{$_->[1]} } @aliasGroups);
    $home //= $aliasGroups[0];
    foreach my $aliasGroup (@aliasGroups) {
        my ($alias, $groups, $merged) = @$aliasGroup;
        my @rows =
            _callSiteGroupCells($entry, $groups, $source,
                                $base_dir, $sort_type, \%seen);
        push(@rows, @external) if $aliasGroup == $home;
        # the first row of a group carries the cells of the group
        $rows[0]->{group} = [$alias, $merged, scalar(@rows)]
            if defined($alias) && @rows;
        push(@cells, @rows);
    }
    return @cells;
}

sub _externalCalleeRow($)
{
    # The last row of the callees of function '$entry', or of its summary
    #   block:  the calls which went out of the boundary of the report.  The
    #   callee is deliberately not part of it, so there is nothing to name and
    #   nothing to link to, and the site the call was recorded at went with it.
    #   Hence a row with neither a location, a category nor a count:  what is
    #   left of such a call is that the edge is there.  None where there is no
    #   such call
    my $entry = shift;
    return () unless $entry->{entry}->has_external_callees();
    return ({
             id   => undef,
             tla  => undef,
             head => '              <td class="coverCallgraph"></td>' . "\n" .
                 '              <td class="coverCallgraph" title="' .
                 "$EXTERNAL_CALLEE_TITLE\">$EXTERNAL_CALLEE_ROW</td>\n",
             tail => '              <td class="coverCallgraph"></td>' . "\n",
    });
}

sub _callgraphCellLine($)
{
    # one cell of a call-site row on its own line of the page, or nothing at all
    #   when the report has no category column - see _callgraphTlaCell
    my $cell = shift;
    return '' if $cell eq '';
    return '              ' . $cell . "\n";
}

sub _callgraphForeignPage($$$$)
{
    # one call site page of another file, as a link from this one:  which page is
    #   named by the file the call leads to, and which of its orders by the order
    #   the reader is already in - following a call across files should not
    #   silently change the order of the next table.  undef when the report has no
    #   page for that file, which is a call which left the callgraph boundary
    # The order is kept where every call site page is written in it, and is the
    #   name order otherwise:  which of the others that file's page has depends
    #   on columns of it this page cannot see
    my ($filename, $base_dir, $view, $sort_type) = @_;
    my $base = filePageBase($filename, $base_dir);
    return undef unless defined($base);
    my $kind = $callgraphView[$view]->{name};
    $kind .= _callgraphPageSuffix($SORT_MISSING_CALLGRAPH)
        if $sort_type == $SORT_MISSING_CALLGRAPH;
    return "$base.$kind.$html_ext";
}

sub _callgraphCallerCells($$$$)
{
    # 'Callers of this function' - the rows of the callers page for one function,
    #   which are cross-file by nature:  the location cell leads to the caller's
    #   source line and the caller's name to that caller's own site group, so that
    #   the two cells answer the two different questions a reader has here ("show
    #   me the code" and "show me everything called there").
    # One list for every alias of the function, each alias' rows introduced by a
    #   caption row where there is more than one alias - or each one a group of
    #   its own, where the groups are shown - below a summary block of them all,
    #   see _callerSummary, and unless they are suppressed (see
    #   'suppress_alias_groups' in lcovrc(5)).  The rows are the shape
    #   '_callSiteCells' returns
    # Where there is no summary block, the groups are the function's rows,
    #   least exercised first - see 'show_callgraph_summary' in lcovrc(5)
    my ($entry, $base_dir, $span, $sort_type) = @_;
    my @cells;
    my $index   = 0;
    my $summary = $entry->{summaryCallers};
    my @callers = @{$entry->{callers}};
    if (defined($summary)) {
        @cells =
            _callerListCells($entry, $summary, $base_dir, $sort_type, \$index);
        $_->{summary} = 1 foreach (@cells);
        @callers = () if $main::suppress_alias_groups;
    } elsif (defined($entry->{aliasGroups})) {
        @callers =
            _aliasGroupsInOrder($entry, CALLGRAPH_VIEW_CALLERS, 5, @callers);
    }
    foreach my $caller (@callers) {
        push(@cells,
             {
              id   => undef,
              tla  => undef,
              note => _callgraphCaptionCell($caller->[0], $span)
             }) if defined($caller->[0]);
        my $first = scalar(@cells);
        push(@cells,
             _callerListCells($entry, $caller, $base_dir, $sort_type, \$index));
        # ..and the first row of a group carries the cells of the group
        my $alias = $caller->[5];
        $cells[$first]->{group} =
            [$alias, $caller->[1]->merged(), scalar(@cells) - $first, $caller]
            if defined($alias) && $first < scalar(@cells);
    }
    return @cells;
}

sub _callerListCells($$$$$)
{
    # the rows of '_callgraphCallerCells' for the caller list '$caller' of
    #   function '$entry' - see callgraphDetailEntries.  '$index' counts the
    #   rows of the function, which is used to number their anchors
    my ($entry, $caller, $base_dir, $sort_type, $index) = @_;
    my ($calls, $rows) = @{$caller}[3, 4];
    my @cells;
    foreach my $row (@$rows) {
        my ($file, $line, $column, $callerName, $count,
            $tla, $position, $owner, $merged) = @$row;
        my $page = filePageBase($file, $base_dir);
        my $location =
            escape_html(File::Basename::basename($file)) . ":$line:$column";
        $location =
            "<a href=\"$page.gcov.$html_ext#L$line\" title=\"" .
            $callgraphView[CALLGRAPH_VIEW_CALLERS]->{siteTitle} .
            "\">$location</a>"
            if defined($page) && _pageShows($file, 'gcov', $line);
        # ..and the caller's name leads to the calls that caller makes, at the
        #   site corresponding to this row:  that is the list which holds
        #   this call, and it is on the page of the file which defines the
        #   caller (not this page), and not the file the call is written in
        my $callees =
            _callgraphForeignPage($owner, $base_dir,
                                  CALLGRAPH_VIEW_CALLEES, $sort_type);
        my $name = escape_html(simplify_function_name($callerName));
        if (defined($callees) && defined($position)) {
            my $anchor =
                _callSiteAnchor($line, $column, $position,
                                $owner eq $file ? undef : $file);
            $name =
                "<a href=\"$callees#$anchor" .
                '" title="Click to go to list of functions called from this site">'
                . "$name</a>"
                if _pageShows($owner, 'callees', $anchor);
        }
        $name .= _mergedNameNote($callerName, $merged);
        push(@cells,
             {
              id   => _callerRowAnchor($entry->{name}, $$index++),
              tla  => $tla,
              head =>
                  "              <td class=\"coverCallgraph\">$name</td>\n" .
                  '              <td class="coverCallgraph">' .
                  "$location</td>\n",
              count => $count,
             });
    }
    # ..and, last, the calls which came from somewhere this report doesn't
    #   know about (external callers)
    # Two different facts can indicate that external callers exist any;
    #   we name the row for which of them is true:
    #   the flag is evidence that a call site outside the callgraph boundary
    #   calls this function - the caller is outside it, exactly as the callee
    #   of an '<external callee>' row - and the arithmetic deduces that an
    #   external caller exists because the symbol was executed more often
    #   than its call sites above account for (see
    #   lcovutil::deduced_external_calls).
    # Either, both or neither can be true.  Where a '-' site above leaves
    #   the arithmetic undecided and there is no flag, neither is known, and
    #   the note beside the name says so instead of a row.
    # The origin is not known either way, so the row never has a link.  Its
    #   count cell says which of the two facts hold - see
    #   _callgraphExternalCountCell - and so does its label:  the same thing
    #   twice, but the label is what a reader going down the table reads
    my ($external, $residual, $flagged) = @$calls;
    my $deduced = defined($residual) && $residual > 0;
    if ($flagged || $deduced) {
        my ($label, $title) =
            !$deduced ? ($EXTERNAL_CALLER_ROW, $EXTERNAL_CALLER_TITLE) :
            !$flagged ? ($DEDUCED_CALLER_ROW, $DEDUCED_CALLER_TITLE) :
            ($DEDUCED_AND_EXTERNAL_CALLER_ROW,
             "$EXTERNAL_CALLER_TITLE.  In addition, $DEDUCED_CALLER_TITLE");
        push(@cells,
             {
              id   => undef,
              tla  => undef,
              head => '              <td class="coverCallgraph" title="' .
                  "$title\">$label</td>\n" .
                  $CALLGRAPH_EMPTY_CELL,
              external => [$flagged, $external, $deduced ? $residual : undef],
             });
    }
    return @cells;
}

sub _functionSourceHref($$)
{
    # Where a proportion of the function table leads:  the first coverpoint of
    #   that kind in the source view, a couple of lines above it so that it is not
    #   the top line of the window - the same courtesy the name column does.
    #   There is nowhere to go where the kind has no coverpoint with a line of its
    #   own
    my ($source, $line) = @_;
    return undef unless defined($line);
    my $start = $line - $func_offset;
    $start = 1 if $start < 1;
    return "$source#L" . _shownSourceLine($start, $line);
}

sub _functionProportionCell($$$$$)
{
    # One of the proportions of the function table:  how much of one kind of
    #   coverpoint of this function the tests exercised, coloured by it and
    #   carrying the counts it came from.  '$href' is what the cell leads to and
    #   is undef where there is nowhere to go
    my ($metric, $medLimit, $hiLimit, $href, $title) = @_;
    my ($found, $hit) = @$metric;
    # colorize based on hit proportion
    my $style = $rate_name[classify_rate($found, $hit, $medLimit, $hiLimit)];
    my $text  = rate($hit, $found, '&nbsp;%') . " ($hit / $found)";
    $text = '<a href="' . $href . '" title="' . $title . '">' . $text . '</a>'
        if defined($href);
    return "<td class=coverPer$style>$text</td>";
}

#
# write_function_table(filehandle, funcData, source_file, sumcount, funcdata,
#                      testfncdata, sumbrcount, testbrdata, mcdc_summary, testcase_mcdc,
#                      base_name, base_dir, sort_type)
#
# Write an HTML table listing all functions in a source file, including
# also function call counts and line coverages inside of each function.
#
# Die on error.
#

sub write_function_table(*$$$$$$$$$$$$)
{
    local *HTML_HANDLE = shift;
    my ($funcData, $source, $sumcount, $funcdata,
        $testfncdata, $sumbrcount, $testbrdata, $mcdc_summary,
        $testcase_mcdc, $name, $base, $type) = @_;
    my ($differentialMap, $funcLineCovMap, $funcBranchCovMap,
        $funcMcdcCovMap, $funcCallgraphCovMap, $callgraphPages,
        $callgraphXref) = @$funcData;
    # The two directions of the callgraph, as a column each at the right of the
    #   table:  they are proportions of this function like the columns to their
    #   left, so they belong with them and not between the reader and the name.
    #   A direction the file has no page for has no column here - see
    #   callgraphDetailEntries - and a function with nothing to say in a
    #   direction the file does have gets an empty cell
    my @callgraphPageName = map(
                         { (defined($callgraphPages) && $callgraphPages->[$_]) ?
                                 callgraphPageName($name, $_) :
                                 undef } 0 .. CALLGRAPH_VIEW_COUNT - 1);
    my $callerPage = $callgraphPageName[CALLGRAPH_VIEW_CALLERS];
    my $calleePage = $callgraphPageName[CALLGRAPH_VIEW_CALLEES];
    # ..and whether this file's calls were measured, which determines whether
    # the aliases of a function are shown as its groups - see _showAliasGroups
    my $measured = $lcovutil::callgraph_coverage &&
        $funcdata->hasCallgraphData($callgraphCalledSymbols);
    # Get HTML code for headings
    my $func_code   = funcview_get_label($name, $base, undef, $type);
    my $count_code  = funcview_get_label($name, $base, 'hit', $type);
    my $line_code   = funcview_get_label($name, $base, 'missed_line', $type);
    my $branch_code = funcview_get_label($name, $base, 'missed_branch', $type);
    my $mcdc_code   = funcview_get_label($name, $base, 'missed_mcdc', $type);
    my $callgraph_code =
        funcview_get_label($name, $base, 'missed_callgraph', $type);
    my $showTlas = $main::show_tla && 0 != scalar(keys %$differentialMap);
    my $tlaRow   = "";
    my $lineProportionRow      = '';
    my $branchProportionRow    = '';
    my $mcdcProportionRow      = '';
    my $callerProportionRow    = '';
    my $callgraphProportionRow = '';

    if ($showTlas) {
        # no width of its own:  this column holds a TLA or one short word, and a
        #   tenth of the table was an order of magnitude more room than that - the
        #   space it was given came out of the columns which have something long
        #   to show, the function name first among them
        my $label = $main::use_legacyLabels ? 'Hit?' : 'TLA';
        $tlaRow = "<td class=\"tableHead\">$label</td>";
    }
    if ($main::show_functionProportions) {
        $lineProportionRow = "<td class=\"tableHead\">$line_code</td>"
            if (%$funcLineCovMap);
        $branchProportionRow = "<td class=\"tableHead\">$branch_code</td>"
            if $lcovutil::br_coverage && %$funcBranchCovMap;
        $mcdcProportionRow = "<td class=\"tableHead\">$mcdc_code</td>"
            if $lcovutil::mcdc_coverage && %$funcMcdcCovMap;
        # the calls which reach this function..
        $callerProportionRow =
            '<td class="tableHead">' .
            funcview_get_label($name, $base, 'callers', $type) . '</td>'
            if $lcovutil::callgraph_coverage && defined($callerPage);
        # ..and the sites this function contains, which is the 'per file' view of
        #   the metric - not the sites which target it, which is the other table
        #   on the call site page
        $callgraphProportionRow = "<td class=\"tableHead\">$callgraph_code</td>"
            if $lcovutil::callgraph_coverage && %$funcCallgraphCovMap;
    }

    # ..which are written in the order of the table's columns - see
    #   functionTableColumns
    my @columnOrder     = functionTableColumns($type);
    my $proportionCells = sub {
        my %cell = @_;
        return join("\n", map({ '              ' . $cell{$_} } @columnOrder));
    };

    die("no functions in file") unless (%$differentialMap);
    my $cells = $proportionCells->(line      => $lineProportionRow,
                                   branch    => $branchProportionRow,
                                   mcdc      => $mcdcProportionRow,
                                   callers   => $callerProportionRow,
                                   callgraph => $callgraphProportionRow);
    write_html(*HTML_HANDLE, <<END_OF_HTML);
          <center>
          <table cellpadding=1 cellspacing=1 border=0>
            <tr><td><br></td></tr>
            <tr>
              <td class="tableHead">$func_code</td>
              $tlaRow
              <td class="tableHead">$count_code</td>
$cells
            </tr>
END_OF_HTML

    foreach my $func (
         funcview_get_sorted($funcData, $type, $main::merge_function_aliases)) {
        my $funcEntry = $differentialMap->{$func};
        my ($count, $tla) = @{$funcEntry->hit()};
        # don't display deleted functions
        next if exists($SummaryInfo::deletedTla{$tla});
        my $startline = $funcEntry->line() - $func_offset;
        my $name      = simplify_function_name($func);
        my $countstyle;

        # Escape special characters
        $name = escape_html($name);
        # ..and where the aliases are shown as groups, the group of the name the
        # function is listed under is a row of its own below, with its mark
        my $realEntry = $measured ? $funcdata->findName($func) : undef;
        my $grouped   = defined($realEntry) &&
            _showAliasGroups($realEntry, $measured);
        my $mark =
            $grouped ? '' :
            _mergedNameNote($func, _aliasMerged($funcEntry, $func));
        if ($startline < 1) {
            $startline = 1;
        }
        $startline = _shownSourceLine($startline, $funcEntry->line());
        if ($count == 0) {
            $countstyle = "coverFnLo";
        } else {
            $countstyle = "coverFnHi";
        }
        my $tlaRow                 = "";
        my $lineProportionRow      = '';
        my $branchProportionRow    = '';
        my $mcdcProportionRow      = '';
        my $callerProportionRow    = '';
        my $callgraphProportionRow = '';
        if ($showTlas) {
            my $label =
                $main::use_legacyLabels ? $SummaryInfo::tlaToLegacy{$tla} :
                $tla;
            $tlaRow = "<td class=\"tla$tla\">$label</td>";
        }
        if ($main::show_functionProportions) {
            # Each proportion leads to the coverpoints it counts:  a reader who
            #   sees that something in this function was never exercised wants the
            #   code, and the top of the function is not it where the function is
            #   longer than the screen
            if (exists($funcLineCovMap->{$func})) {
                $lineProportionRow =
                    _functionProportionCell(
                                $funcLineCovMap->{$func},
                                $ln_med_limit,
                                $ln_hi_limit,
                                _functionSourceHref(
                                          $source, $funcLineCovMap->{$func}->[2]
                                ),
                                'Click to go to the first line of this function'
                    );
            } else {
                $lineProportionRow = "<td class=\"coverFn\"></td>"
                    if %$funcLineCovMap;
            }
            if ($lcovutil::br_coverage && %$funcBranchCovMap) {
                $branchProportionRow =
                    exists($funcBranchCovMap->{$func}) ?
                    _functionProportionCell(
                              $funcBranchCovMap->{$func},
                              $br_med_limit,
                              $br_hi_limit,
                              _functionSourceHref(
                                        $source, $funcBranchCovMap->{$func}->[2]
                              ),
                              'Click to go to the first branch of this function'
                    ) :
                    "<td class=\"coverFn\"></td>";
            }
            if ($lcovutil::mcdc_coverage && %$funcMcdcCovMap) {
                $mcdcProportionRow =
                    exists($funcMcdcCovMap->{$func}) ?
                    _functionProportionCell(
                    $funcMcdcCovMap->{$func},
                    $mcdc_med_limit,
                    $mcdc_hi_limit,
                    _functionSourceHref($source, $funcMcdcCovMap->{$func}->[2]),
                    'Click to go to the first MC/DC expression of this function'
                    ) :
                    "<td class=\"coverFn\"></td>";
            }
            # ..and the two directions of the callgraph, which lead to this
            #   function's own entry on the page that direction is listed on
            #   rather than into the source:  the calls which reach a function are
            #   not in it, and the calls it makes are a table of their own
            if ($lcovutil::callgraph_coverage && defined($callerPage)) {
                my $metric =
                    defined($callgraphXref) &&
                    exists($callgraphXref->{$func}) ?
                    $callgraphXref->{$func}->[CALLGRAPH_VIEW_CALLERS] :
                    undef;
                # An empty cell where there is nothing to say:  a function whose
                #   callers are all outside the report is not on that page at all,
                #   and one none of whose rows there carries a known count has no
                #   proportion - a column of proportions is no place to write that
                #   the denominator is zero
                $callerProportionRow =
                    (defined($metric) && 0 != $metric->[0]) ?
                    _functionProportionCell(
                                   $metric,
                                   $callgraph_med_limit,
                                   $callgraph_hi_limit,
                                   $callerPage . '#' . _calleeFuncAnchor($func),
                                   'Click to go to the callers of this function'
                    ) :
                    "<td class=\"coverFn\"></td>";
            }
            if ($lcovutil::callgraph_coverage && %$funcCallgraphCovMap) {
                # every function counted here has call sites, so it has an entry
                #   on that page to lead to
                $callgraphProportionRow =
                    exists($funcCallgraphCovMap->{$func}) ?
                    _functionProportionCell(
                                $funcCallgraphCovMap->{$func},
                                $callgraph_med_limit,
                                $callgraph_hi_limit,
                                defined($calleePage) ?
                                    $calleePage . '#' .
                                    _calleeFuncAnchor($func) :
                                    undef,
                                'Click to go to the call sites of this function'
                    ) :
                    "<td class=\"coverFn\"></td>";
            }
        }

        my $cells = $proportionCells->(line      => $lineProportionRow,
                                       branch    => $branchProportionRow,
                                       mcdc      => $mcdcProportionRow,
                                       callers   => $callerProportionRow,
                                       callgraph => $callgraphProportionRow);
        write_html(*HTML_HANDLE, <<END_OF_HTML);
            <tr>
              <td class="coverFn"><a href="$source#L$startline">$name</a>$mark</td>
              $tlaRow
              <td class="$countstyle">$count</td>
$cells
            </tr>
END_OF_HTML

        if ((!defined($main::suppress_function_aliases) ||
             0 == $main::suppress_function_aliases) &&
            $funcEntry->numAliases() > 1
        ) {
            my @aliasList = $funcEntry->aliasNames();
            if ($main::show_functionProportions) {
                $lineProportionRow = "<td class=\"coverFn\"></td>"
                    if %$funcLineCovMap;
                $branchProportionRow = $lineProportionRow
                    if $lcovutil::br_coverage && %$funcBranchCovMap;
                $mcdcProportionRow = $lineProportionRow
                    if $lcovutil::mcdc_coverage && %$funcMcdcCovMap;
                # the callgraph pages list a function under its leader symbol,
                #   which is the row above:  an alias has no entry of its own to
                #   lead to
                $callerProportionRow = "<td class=\"coverFn\"></td>"
                    if $lcovutil::callgraph_coverage && defined($callerPage);
                $callgraphProportionRow = "<td class=\"coverFn\"></td>"
                    if $lcovutil::callgraph_coverage && %$funcCallgraphCovMap;
            }
            if (0 != $type) {
                @aliasList =
                    sort({ $funcEntry->alias($a)->count()
                                 <=> $funcEntry->alias($b)->count() or
                                 $a cmp $b } @aliasList);
            } else {
                @aliasList = sort(@aliasList);
            }
            # the rows of a group are set off by subdued colours
            my $rowClass = $grouped ? ' class="fnGroupRow"' : '';
            my $groupMetric =
                ($grouped && exists($callgraphXref->{$func})) ?
                $callgraphXref->{$func}->[CALLGRAPH_VIEW_COUNT] :
                undef;
            foreach my $alias (@aliasList) {
                my $aliasData = $funcEntry->alias($alias);
                # ..and where the aliases are groups, the calls of each group,
                #   leading to that group's rows on the page of the direction -
                #   unless the pages do not show them (see
                #   'suppress_alias_groups' in lcovrc(5))
                if ($grouped && $main::show_functionProportions) {
                    my $metric = $groupMetric->{$alias};
                    my $anchor = _aliasGroupAnchor($alias);
                    foreach my $cell (
                           [CALLGRAPH_VIEW_CALLERS,
                            \$callerProportionRow,
                            $callerPage,
                            'Click to go to the callers of this alias group',
                            defined($callerPage)
                           ],
                           [CALLGRAPH_VIEW_CALLEES,
                            \$callgraphProportionRow,
                            $calleePage,
                            'Click to go to the call sites of this alias group',
                            0 != scalar(%$funcCallgraphCovMap)
                           ]
                    ) {
                        my ($view, $row, $page, $title, $shown) = @$cell;
                        next unless $shown;
                        my $m = defined($metric) ? $metric->[$view] : undef;
                        $$row =
                            (defined($m) && 0 != $m->[0]) ?
                            _functionProportionCell(
                             $m,
                             $callgraph_med_limit,
                             $callgraph_hi_limit,
                             (defined($page) && !$main::suppress_alias_groups) ?
                                 "$page#$anchor" :
                                 undef,
                             $title) :
                            "<td class=\"coverFn\"></td>";
                    }
                }
                my ($hit, $tla) = ($aliasData->count(), $aliasData->tla());
                # don't display deleted functions
                next if exists($SummaryInfo::deletedTla{$tla});
                my $style = "coverFnAlias" . ($hit == 0 ? "Lo" : "Hi");
                $tlaRow = "";
                if ($showTlas) {
                    my $label =
                        $main::use_legacyLabels ?
                        $SummaryInfo::tlaToLegacy{$tla} :
                        $tla;
                    $tlaRow = "<td class=\"tla$tla\">$label</td>";
                }

                # Escape special characters
                my $aliasMark = _mergedNameNote($alias, $aliasData->merged());
                $alias = escape_html(simplify_function_name($alias));

                my $cells =
                    $proportionCells->(line      => $lineProportionRow,
                                       branch    => $branchProportionRow,
                                       mcdc      => $mcdcProportionRow,
                                       callers   => $callerProportionRow,
                                       callgraph => $callgraphProportionRow);
                write_html(*HTML_HANDLE, <<END_OF_HTML);
            <tr$rowClass>
              <td class="coverFnAlias"><a href="$source#L$startline">$alias</a>$aliasMark</td>
              $tlaRow
              <td class="$style">$hit</td>
$cells
            </tr>
END_OF_HTML
            }
        }
    }
    write_html(*HTML_HANDLE, <<END_OF_HTML);
          </table>
          <br>
          </center>
END_OF_HTML
}

#
# remove_unused_descriptions()
#
# Removes all test descriptions from the global hash %test_description which
# are not present in %current_data.
#

sub remove_unused_descriptions()
{
    my $filename;     # The current filename
    my %test_list;    # Hash containing found test names
    my $test_data;    # Reference to hash test_name -> count_data
    my $before;       # Initial number of descriptions
    my $after;        # Remaining number of descriptions

    $before = scalar(keys(%test_description));

    foreach $filename ($current_data->files()) {
        ($test_data) = $current_data->data($filename)->get_info();
        foreach ($test_data->keylist()) {
            $test_list{$_} = "";
        }
    }

    # Remove descriptions for tests which are not in our list
    foreach (keys(%test_description)) {
        if (!exists($test_list{$_})) {
            delete($test_description{$_});
        }
    }

    $after = scalar(keys(%test_description));
    if ($after < $before) {
        info("Removed " .
             ($before - $after) .
             " unused descriptions, $after remaining.\n");
    }
}

#
# apply_prefix(filename, PREFIXES)
#
# If FILENAME begins with PREFIX from PREFIXES, remove PREFIX from FILENAME
# and return resulting string, otherwise return FILENAME.
#

sub apply_prefix($@)
{
    my $filename = shift;

    foreach my $prefix (@_) {
        if ($prefix eq $filename) {
            return 'root';
        }
        if ($prefix ne "" &&
            $filename =~ /^\Q$prefix$lcovutil::dirseparator\E(.*)$/) {
            return substr($filename, length($prefix) + 1);
        }
    }

    return $filename;
}

#
# get_html_prolog(FILENAME)
#
# If FILENAME is defined, return contents of file. Otherwise return default
# HTML prolog. Die on error.
#

sub get_html_prolog($)
{
    my $filename = $_[0];
    my $result   = "";

    if (defined($filename)) {
        local *HANDLE;

        open(HANDLE, "<", $filename) or
            die("cannot open html prolog $filename: $!\n");
        while (<HANDLE>) {
            $result .= $_;
        }
        close(HANDLE) or die("unable to close HTML handle: $!\n");
    } else {
        $result = <<END_OF_HTML;
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">

<html lang="en">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=$charset">
  <title>\@pagetitle\@</title>
  <link rel="stylesheet" type="text/css" href="\@basedir\@gcov.css">
</head>

<body>

END_OF_HTML
    }
    return $result;
}

#
# get_html_epilog(FILENAME)
#
# If FILENAME is defined, return contents of file. Otherwise return default
# HTML epilog. Die on error.
#
sub get_html_epilog($)
{
    my $filename = $_[0];
    my $result   = "";

    if (defined($filename)) {
        local *HANDLE;

        open(HANDLE, "<", $filename) or
            die("cannot open html epilog $filename: $!\n");
        while (<HANDLE>) {
            $result .= $_;
        }
        close(HANDLE) or die("unable to close HTML handle: $!\n");
    } else {
        $result = <<END_OF_HTML;

</body>
</html>
END_OF_HTML
    }

    return $result;
}

#
# parse_dir_prefix(@dir_prefix)
#
# Parse user input about the prefix list
#

sub parse_dir_prefix(@)
{
    my (@opt_dir_prefix) = @_;

    return if (!@opt_dir_prefix);

    # A prefix is a leading part of an output path, and it is matched against the
    #   name this platform's path modules decompose - so it is spelled the same
    #   way.  That lets '--prefix C:\proj' work on a POSIX machine reading a
    #   Windows '.info' file, which is the spelling that file suggests.
    #   See 'lcovutil::native_path'
    foreach my $item (@opt_dir_prefix) {
        if ($item =~ $lcovutil::split_pattern) {
            # Split and add comma-separated parameters
            push(@dir_prefix,
                 map { lcovutil::native_path($_) }
                     split($lcovutil::split_pattern, $item));
        } else {
            # Add single parameter
            push(@dir_prefix, lcovutil::native_path($item));
        }
    }
}

#
# simplify_function_name($name)
#
# apply @function_simplify_patterns to $name and return
#  goal is to shorten really long demangled names/template expansions
#
sub simplify_function_name($)
{
    my $name = shift;
    if ($simplifyFunctionCallback) {
        eval { $name = $simplifyFunctionCallback->simplify($name); };
        if ($@) {
            my $context = MessageContext::context();
            lcovutil::ignorable_error($lcovutil::ERROR_CALLBACK,
                                      "simplify($name) failed$context: $@");
        }
    }
    return $name;
}
