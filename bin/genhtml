          text-align: center;
          padding-bottom: 10px;
          font-family: sans-serif;
          font-size: 20pt;
          font-style: italic;
          font-weight: bold;
        }
        /* table footnote */
        td.footnote
        {
          text-align: left;
          padding-left: 100px;
          padding-right: 10px;
          background-color: #COLOR_08; /* light blue table background color */
          /* dark blue table header color
          background-color: #COLOR_03; */
          white-space: nowrap;
