    return type_count(CALLGRAPH_DATA, 'hit', @_);
}

sub selected
{
    my $rtn;
    eval { $rtn = $selectCallback->select(@_); };
    if ($@) {
        my $err = lcovutil::unreported_error($@);
        $rtn = 1;    # return everything
        lcovutil::ignorable_error($lcovutil::ERROR_CALLBACK,
                                  "select(..) failed: $err");
    }
    return $rtn;
}

sub tlaSummary
{
    my ($self, $t) = @_;
    my $type;
    if ($t eq 'line') {
        $type = LINE_DATA;
    } elsif ($t eq 'function') {
        $type = FUNCTION_DATA;
    } elsif ($t eq 'mcdc') {
        $type = MCDC_DATA;
    } elsif ($t eq 'callgraph') {
        $type = CALLGRAPH_DATA;
    } else {
        die("unknown type $t") unless 'branch' eq $t;
        $type = BRANCH_DATA;
    }
    my $d = $self->[$type]->[DATA];
    return
        join(' ',
             map({ $_ . ':' . $d->{$_} } _nonZeroKeys($d, @tlaOrderNoExclude)));
}

sub _nonZeroKeys
{
    # Those of @keys which $counts has a non-zero count for, in @keys order.
    #   A key can be missing rather than zero:  a date or owner bin holds only
    #   the TLAs 'lineCovCount' knows about - not 'ECC' or 'EUC' - and the
    #   whole-file counts hold whatever '_initCounts' put there.
    my ($counts, @keys) = @_;
    return grep({ exists($counts->{$_}) && 0 != $counts->{$_} } @keys);
}

sub _nonZeroCounts
{
    # Those of @keys with a non-zero count, as a hashref - or undef when there
    #   are none, so a caller can tell 'nothing to report' from 'reported zero'.
    my ($counts, @keys) = @_;
    my $nonZero;
    foreach my $k (_nonZeroKeys($counts, @keys)) {
        $nonZero->{$k} = $counts->{$k};
    }
    return $nonZero;
}

sub _binCounts
{
    # The non-zero counts of one age or owner bin, or undef if it has none.
    my $bin = shift;
    return _nonZeroCounts($bin, @tlaPriorityOrder, 'found', 'hit');
}

sub checkCoverageCriteria
{
    my $self = shift;
    my $type = $self->type();

    if ($type eq 'top') {
        # simplistic top-level criteria..
        CoverageCriteria::check_failUnder($main::current_data);
    }
    return
        unless ($CoverageCriteria::criteriaCallback &&
                (0 == scalar(@CoverageCriteria::criteriaCallbackLevels) ||
                 grep(/$type/, @CoverageCriteria::criteriaCallbackLevels)));

    my $start = Time::HiRes::gettimeofday();
    my %data;
    foreach my $t (@covTypes) {
        # the keys are 'hit', 'found' and the TLAs
        my $d      = $self->[$t]->[DATA];
        my $counts = _nonZeroCounts($d, keys(%$d));
        $data{type2str($t)} = $counts if $counts;
    }
    if (grep(/^date$/, @CoverageCriteria::criteriaCallbackTypes)) {
        foreach my $t (@covTypes) {
            my $key = type2str($t);

            next unless exists($self->[$t]->[AGE]);
            my $ageBins = $self->[$t]->[AGE];
            foreach my $i (0 .. $#cutpoints + 1) {
                my $counts = _binCounts($ageBins->[$i]);
                next unless $counts;
                $data{$key}->{$i} = $counts;
            }
        }
    }
    if (grep(/^owner$/, @CoverageCriteria::criteriaCallbackTypes)) {
        foreach my $t (LINE_DATA, CALLGRAPH_DATA, BRANCH_DATA, MCDC_DATA) {
            my $key = type2str($t);
            next unless exists($self->[$t]->[OWNERS]);
            my $ownerBins = $self->[$t]->[OWNERS];
            while (my ($owner, $bin) = each(%$ownerBins)) {
                # every owner appears, even with nothing to say - as before
                $data{$key}->{$owner} = _binCounts($bin) || {};
            }
        }
    }
    my $name = $self->type() eq 'top' ? 'top' : $self->name();
    my $cmd =
        join(' ', @CoverageCriteria::coverageCriteriaScript) . ' \'' .
        $name . '\' ' .
        $self->type() .
        ' \'json_encoded_data\'';
    # command:  script name (top|dir|file) jsonString args..
    lcovutil::info(1, "criteria: '$cmd'\n");
    CoverageCriteria::executeCallback($self->type(), $name, \%data);
    my $end = Time::HiRes::gettimeofday();
    $lcovutil::profileData{criteria}{$name} = $end - $start;
}

package OwnerDetailCallback;
# somewhat of a hack...I want a class which has a callback 'get'
#  that matches the SummaryInfo::get method - but returns owner-specific
#  information

use constant {
              SUMMARY => 0,
              OWNER   => 1,
              TYPE    => 2,
};

sub new
{
    my ($class, $summary, $owner, $covType) = @_;
    die("missing type") unless defined($covType);

    my $self = [$summary, $owner, $covType];
    bless $self, $class;
    return $self;
}

sub label
{
    my $self = shift;
    return $self->owner();
}

sub cb_type
{
    my $self = shift;
    return 'owner';
}

sub get
{
    my ($self, $key, $type) = @_;

    my ($summary, $owner, $covType) = @$self;

    die("unexpected type $type")
        unless !defined($type) || ($type == $covType);

    return $summary->owner_tlaCount($owner, $key, $covType);
}

sub owner
{
    my $self = shift;
    return $self->[OWNER];
}

sub covType
{
    my $self = shift;
    return $self->[TYPE];
}

package DateDetailCallback;
# as above:  callback class to return date-specific TLA counts

use constant {
              SUMMARY => 0,
              AGE     => 1,
              TYPE    => 2,
              BIN     => 3,
};

sub new
{
    my ($class, $summary, $age, $covType) = @_;
    $covType = SummaryInfo::LINE_DATA unless defined($covType);

    my $self = [$summary, $age, $covType, SummaryInfo::findAgeBin($age)];
    bless $self, $class;
    return $self;
}

sub get
{
    my ($self, $key, $type) = @_;

    my ($summary, $age, $covType) = @$self;

    die("unexpected type $type")
        unless (!defined($type) || ($type == $covType));

    my $covCount = SummaryInfo::covCountMethod($covType);
    return $summary->$covCount($key, 'age', $age);
}

sub label
{
    my $self = shift;
    return $self->age();
}

sub cb_type
{
    my $self = shift;
    return 'date';
}

sub age
{
    my $self = shift;
    return $self->[AGE];
}

sub bin
{
    my $self = shift;
    return $self->[BIN];
}

sub covType
{
    my $self = shift;
    return $self->[TYPE];
}

package FileOrDirectoryCallback;
# callback class used by 'write_file_table' to retrieve count of the
# various coverpoint categories in the file or directory (i.e., total
# number).
# Other callbacks classes are used to retrieve per-owner counts, etc.

sub new
{
    # dirSummary: SummaryInfo object
    my ($class, $path, $summary) = @_;

    my $self = [$path, $summary];

    bless $self, $class;
    return $self;
}

# page_link is HTML reference to file table page next level down -
#   for top-level page:  link to directory-level page
#   for directory-level page:  link to source file details
sub page_link
{
    my $self      = shift;
    my $data      = $self->summary();
    my $page_link = '';
    $page_link =
        ($main::flat && '.' ne $data->relativeDir()) ?
        File::Spec->catfile($data->relativeDir(), $self->name()) :
        $self->name();
    if ($data->type() eq 'file') {
        if ($main::no_sourceview) {
            return "";
        }
        $page_link .= ".gcov";
        $page_link .= ".frameset"
            if ($main::frames);
    } else {
        $page_link =~ s/^$lcovutil::dirseparator_re//;
        $page_link .= $lcovutil::dirseparator . "index";
    }
    $page_link .= '.' . $main::html_ext;
    return $lcovutil::case_insensitive ? lc($page_link) : $page_link;
}

sub data
{
    my $self = shift;
    # one (found, hit) pair per element of @SummaryInfo::covTypes, in that
    #   order, then ($page_link, $fileSummary, $fileDetails)

    my $summary = $self->summary();
    my @rtn;
    foreach my $type (@SummaryInfo::covTypes) {
        my $hash = $summary->[$type]->[SummaryInfo::DATA];
        push(@rtn, $hash->{found}, $hash->{hit});
    }
    my $link = $self->page_link();
    my $sourceFile;
    $sourceFile = $summary->fileDetails()
        if 'file' eq $summary->type();
    push(@rtn, $link, $summary, $sourceFile);
    return @rtn;
}

sub secondaryElementFileData
{
    my ($self, $name) = @_;
    my $summary = $self->summary();
    my $sourceFile;
    $sourceFile = $summary->fileDetails()
        if 'file' eq $summary->type();
    return [$summary->name(), $summary, $sourceFile, $self->page_link()];
}

sub name
{
    my $self = shift;
    return $self->[0];
}

sub summary
{
    # return undef or SummaryInfo object
    my $self = shift;
    return $self->[1];
}

sub findOwnerList
{
    my $self = shift;
    # return [ [owner, {covType => [missed, total, callback], ..}], ..] for each
    #   owner - sorted in descending order number of missed lines
    return $self->summary()->findOwnerList(@_);
}

sub dateDetailCallback
{
    # callback to compute count in particular date bin
    my ($self, $ageval, $covtype) = @_;
    grep({ $_ == $covtype } @SummaryInfo::covTypes) or
        die("'$covtype' type not supported");

    return DateDetailCallback->new($self->summary(), $ageval, $covtype);
}

sub totalCallback
{
    my ($self, $covtype) = @_;
    # callback to compute total elements of 'covtype' in each TLA
    if (SummaryInfo::LINE_DATA == $covtype) {
        return $self->summary();
    } else {
        return CovTypeSummaryCallback->new($self->summary(), $covtype);
    }
}

package FileOrDirectoryOwnerCallback;
# callback class used by 'write_file_table' to retrieve owner-
#  specific coverage numbers (for all entries in the directory)

sub new
{
    my ($class, $owner, $dirSummary) = @_;

    my $self = [$owner, $dirSummary];
    bless $self, $class;
    return $self;
}

sub name
{
    my $self = shift;
    return $self->[0];
}

sub summary
{
    my $self = shift;
    return $self->[1];
}

sub data
{
    my $self = shift;

    # one (found, hit) pair per element of @SummaryInfo::covTypes, in that
    #   order - this is the 'totals' callback for this owner, so there is no
    #   associated file or summary info to follow them.
    #   Function coverage has no owner, so its pair is 0, 0.
    my @rtn;
    foreach my $covType (@SummaryInfo::covTypes) {
        my $cb = OwnerDetailCallback->new($self->[1], $self->[0], $covType);
        push(@rtn, $cb->get('found'), $cb->get('hit'));
    }
    return @rtn;
}

sub totalCallback
{
    # callback to compute total 'covtype' elements in each TLA
    my ($self, $covtype) = @_;
    die("$covtype not supported by OwnerDetail callback")
        unless ($covtype == SummaryInfo::LINE_DATA ||
                $covtype == SummaryInfo::CALLGRAPH_DATA ||
                $covtype == SummaryInfo::BRANCH_DATA    ||
                $covtype == SummaryInfo::MCDC_DATA);

    return OwnerDetailCallback->new($self->[1], $self->name(), $covtype);
}

sub findFileList
{
    my ($self, $all) = @_;

    # return [skipped, [filename, {covType => [missed, total, callback], ..}],
    #                  ..] for each file in which this owner has at least one
    #   coverpoint - sorted in descending order number of missed lines
    my $dirSummary = $self->[1];
    my $owner      = $self->[0];
    my @files;
    my $skipped = 0;
    foreach my $file ($dirSummary->sources()) {
        my $source = $dirSummary->get_source($file);
        next unless $source->contains_owner($owner);

        my %bin =
            SummaryInfo::binCovData(sub {
            return OwnerDetailCallback->new($source, $owner, shift);
            });
        next unless grep({ 0 != $bin{$_}->[1] } @SummaryInfo::covTypes);
        if ($all || grep({ 0 != $bin{$_}->[0] } @SummaryInfo::covTypes)) {
            push(@files, [$file, \%bin]);
        } else {
            ++$skipped;
        }
    }
    return [$skipped, @files];
}

sub secondaryElementFileData
{
    my ($self, $name) = @_;
    my $dirSummary    = $self->[1];
    my $file          = File::Basename::basename($name);
    my $sourceSummary = $dirSummary->get_source($name);

    my $page_link;
    if ($sourceSummary->is_directory()) {
        $page_link =
            File::Spec->catfile($name, "index-bin_owner." . $main::html_ext);
    } elsif ($main::no_sourceview) {
        $page_link = "";
    } else {
        $name      = $file;
        $page_link = $name . ".gcov.";
        $page_link .= "frameset."
            if $main::frames;
        $page_link .= $main::html_ext;
    }
    $page_link = lc($page_link) if $lcovutil::case_insensitive;
    # pass owner in callback data
    my $sourceFile;
    $sourceFile = $sourceSummary->fileDetails()
        if 'file' eq $sourceSummary->type();
    return [$name, $sourceSummary, $sourceFile, $page_link, $self->[0]];
}

package FileOrDirectoryDateCallback;
# callback class used by 'write_file_table' to retrieve date-
#  specific coverage numbers (for all entries in the directory)

sub new
{
    my ($class, $bin, $dirSummary) = @_;

    my $self = [$bin, $dirSummary->age_sample($bin), $dirSummary];
    bless $self, $class;
    return $self;
}

sub name
{
    my $self = shift;
    return $SummaryInfo::ageGroupHeader[$self->[0]];
}

sub summary
{
    my $self = shift;
    return $self->[2];
}

sub data
{
    my $self = shift;

    my @rtn;
    foreach my $covType (@SummaryInfo::covTypes) {
        my $cb = DateDetailCallback->new($self->[2], $self->[1], $covType);
        push(@rtn, $cb->get('found'), $cb->get('hit'));
    }
    # one (found, hit) pair per element of @SummaryInfo::covTypes - this is the
    #   top-level 'total' callback, so no associated file or summary info
    return @rtn;
}

sub totalCallback
{
    # callback to compute total elements of 'covtype' in each TLA
    my ($self, $covtype) = @_;
    return DateDetailCallback->new($self->[2], $self->[1], $covtype);
}

sub findFileList
{
    my ($self, $all) = @_;

    # return [skipped, [filename, {covType => [missed, total, callback], ..}],
    #                  ..] for each file which has a coverpoint in this date bin
    #   - sorted in descending order number of missed lines
    my $dirSummary = $self->[2];
    my $ageval     = $self->[1];
    my @files;
    my $skipped = 0;
    foreach my $file ($dirSummary->sources()) {
        my $source = $dirSummary->get_source($file);

        my %bin =
            SummaryInfo::binCovData(sub {
            return DateDetailCallback->new($source, $ageval, shift);
            });
        next unless grep({ 0 != $bin{$_}->[1] } @SummaryInfo::covTypes);
        if ($all || grep({ 0 != $bin{$_}->[0] } @SummaryInfo::covTypes)) {
            push(@files, [$file, \%bin]);
        } else {
            ++$skipped;
        }
    }
    return [$skipped, @files];
}

sub secondaryElementFileData
{
    my ($self, $name) = @_;
    my $dirSummary    = $self->[2];
    my $file          = File::Basename::basename($name);
    my $sourceSummary = $dirSummary->get_source($name);

    my $page_link;
    if ($sourceSummary->is_directory()) {
        $page_link =
            File::Spec->catfile($name, "index-bin_date." . $main::html_ext);
    } elsif ($main::no_sourceview) {
        $page_link = "";
    } else {
        $name      = $file;
        $page_link = $name . ".gcov.";
        $page_link .= "frameset."
            if $main::frames;
        $page_link .= $main::html_ext;
    }
    $page_link = lc($page_link) if $lcovutil::case_insensitive;
    # pass bin index in callback data
    my $sourceFile;
    $sourceFile = $sourceSummary->fileDetails()
        if 'file' eq $sourceSummary->type();
    return [$name, $sourceSummary, $sourceFile, $page_link, $self->[0]];
}

package CovTypeSummaryCallback;
# callback class to return total branches in each TLA category
sub new
{
    my ($class, $summary, $covType) = @_;
    defined($summary) or
        die("no summary");
    die("$covType not supported yet")
        unless grep({ $_ == $covType } @SummaryInfo::covTypes);
    my $self = [$summary, $covType];
    bless $self, $class;
    return $self;
}

sub get
{
    my ($self, $key) = @_;

    return $self->[0]->get($key, $self->[1]);
}

sub owner
{
    my $self = shift;
    # a call site is one line, so it has an owner - unlike a function, which
    #   spans many lines with possibly many owners.
    die("CovTypeSummaryCallback::owner not supported for " . $self->[1])
        unless ($self->[1] == SummaryInfo::BRANCH_DATA ||
                $self->[1] == SummaryInfo::CALLGRAPH_DATA ||
                $self->[1] == SummaryInfo::MCDC_DATA);
    return $self->[0]->owner();
}

sub age
{
    my $self = shift;
    return $self->[0]->age();
}

sub bin
{
    my $self = shift;
    return $self->[0]->bin();
}

sub covType
{
    my $self = shift;
    return $self->[1];
}

package PrintCallback;
# maintain some callback data from one line to the next

use constant {
              FILE_INFO  => 0,    # SourceFile struct
              LINE_DATA  => 1,    # FileCoverageInfo struct
              TLA        => 2,
              OWNER      => 3,
              AGE        => 4,
              NEXT_OWNER => 5,
              NEXT_AGE   => 6,
              LINENO     => 7,
              # the call sites of this file, keyed by source line, and the page
              #   their groups are shown on - both undef unless '--callgraph'
              CALL_SITES     => 8,
              CALLGRAPH_PAGE => 9,
              # the branch blocks and the MC/DC groups which are written at a
              #   line other than the one which holds them - see 'locate'
              BRANCH_AT => 10,
              MCDC_AT   => 11,
};

sub new
{
    my ($class, $sourceFileStruct, $lineCovInfo, $callSites, $callgraphPage) =
        @_;
    my $self = [$sourceFileStruct,
                $lineCovInfo,
                "",       # current TLA
                "",       # owner
                "",       # age
                {},       # next header line for corresponding owner
                {},       # next header line for corresponding date bin
                undef,    # line number
                $callSites,
                $callgraphPage,
                undef,    # branch locations
                undef,    # MC/DC locations
    ];
    bless $self, $class;
    return $self;
}

sub _coverpointData
{
    # the branch data (isMcdc == false) or the MC/DC data (isMcdc == true)
    #   of line 'lineNo' shown in the source view and whether data is
    #   differential
    my ($self, $isMcdc, $summary, $lineNo) = @_;
    if (defined($main::show_tla)) {
        my $lineData = $self->lineData()->line($lineNo);
        if (defined($lineData)) {
            my $data =
                $isMcdc ? $lineData->differential_mcdc() :
                $lineData->differential_branch();
            return ($data, 1) if defined($data);
        }
    }
    return (defined($summary) ? $summary->value($lineNo) : undef, 0);
}

sub locate
{
    # Find the branch blocks (isMcdc == false) or MC/DC groups (isMcdc == true)
    #   in this file which are written at a line other than the one which
    #   holds them - see BranchBlock::locationOffset and MCDC_Block::groupKey.
    #   'summary' is the file's summary BranchData or MCDC_Data.
    my ($self, $isMcdc, $summary) = @_;
    my %lines;
    $lines{$_} = 1 foreach (defined($summary) ? $summary->keylist() : ());
    if (defined($main::show_tla)) {
        # ..and the lines whose data is only in the baseline
        my $lineMap = $self->lineData()->lineMap();
        while (my ($line, $lineData) = each(%$lineMap)) {
            next if exists($lines{$line}) || '<' eq substr($line, 0, 1);
            $lines{$line} = 1
                if defined($isMcdc ? $lineData->differential_mcdc() :
                               $lineData->differential_branch());
        }
    }
    my %at;       # written line -> [[holding line, offset], ...]
    my %holds;    # holding line -> 1 if some of its data is written elsewhere
    foreach my $line (sort({ $a <=> $b } keys(%lines))) {
        my ($data) = $self->_coverpointData($isMcdc, $summary, $line);
        next unless defined($data);
        my %offsets;
        $offsets{$_} = 1
            foreach ($isMcdc ? $data->locationOffsets() :
                     map({ $_->locationOffset() } $data->blocks()));
        delete($offsets{0});
        next unless %offsets;
        $holds{$line} = 1;
        push(@{$at{$line + $_}}, [$line, $_])
            foreach (sort({ $a <=> $b } keys(%offsets)));
    }
    $self->[$isMcdc ? MCDC_AT : BRANCH_AT] = [$summary, \%at, \%holds];
}

sub coverpointsAt
{
    # The branch (isMcdc == false) or MC/DC (isMcdc == true) data written at
    #   line 'lineNo'.
    # Returns list of [data, offset, isDifferential], whose blocks or groups at
    #   location 'offset' are shown there.  An undef offset means "all of
    #   them".  'summary' is the summary data of the line
    my ($self, $isMcdc, $lineNo, $summary) = @_;
    my $located = $self->[$isMcdc ? MCDC_AT : BRANCH_AT];
    my @result;
    my ($data, $isDiff) = $self->_coverpointData($isMcdc, undef, $lineNo);
    $data = $summary unless $isDiff;
    if (defined($data)) {
        push(@result,
             [$data,
              (defined($located) && exists($located->[2]->{$lineNo})) ? 0 :
                  undef,
              $isDiff
             ]);
    }
    if (defined($located) && exists($located->[1]->{$lineNo})) {
        foreach my $from (@{$located->[1]->{$lineNo}}) {
            my ($holder, $offset) = @$from;
            my ($d, $diff) =
                $self->_coverpointData($isMcdc, $located->[0], $holder);
            push(@result, [$d, $offset, $diff]) if defined($d);
        }
    }
    return @result;
}

sub callSites
{
    # the call-site groups of this file, keyed by source line.  An empty hash
    #   rather than undef in a report which has no call data, so that the caller
    #   can index it without checking
    my $self = shift;
    return defined($self->[CALL_SITES]) ? $self->[CALL_SITES] : {};
}

sub callgraphPage
{
    my $self = shift;
    return $self->[CALLGRAPH_PAGE];
}

sub sourceDetail
{
    my $self = shift;
    return $self->[FILE_INFO];
}

sub lineData
{
    my $self = shift;
    return $self->[LINE_DATA];
}

sub lineNo
{
    my ($self, $lineNo) = @_;
    $self->[LINENO] = $lineNo
        if defined($lineNo);
    return $self->[LINENO];
}

sub tla
{
    my ($self, $newTLA, $lineNo) = @_;
    # NOTE:  'undef' TLA means that this line is not code (it is a comment,
    #    blank line, opening brace or something).
    # We return 'same' as previous line' in that case so the category
    #   block can be larger (e.g., 1 CBC line, a 2 line comment, then 3 more
    #   lines) can get just one label (first line).
    # This reduces visual clutter.
    # Note that the 'block finding' code has to do the same thing (else the
    #   HTML links won't be generated correctly)
    if (defined($newTLA) &&
        $newTLA ne $self->[TLA]) {
        $self->[TLA] = $newTLA;
        return $newTLA;
    }
    return " " x $main::tla_field_width;    # same TLA as previous line.
}

sub age
{
    my ($self, $newval, $lineNo) = @_;
    if (defined($newval) && $newval ne $self->[AGE]) {
        $self->[AGE] = $newval;
        return $newval;
    }
    return " " x $main::age_field_width;    # same age as previous line.
}

sub owner
{
    my ($self, $newval, $lineNo) = @_;
    if (defined($newval) && $newval ne $self->[OWNER]) {
        $self->[OWNER] = $newval;
        return $newval;
    }
    return " " x $main::owner_field_width;    # same owner as previous line.
}

sub current
{
    my ($self, $key) = @_;

    if ($key eq 'tla') {
        return $self->[TLA];
    } elsif ($key eq 'owner') {
        return $self->[OWNER];
    } elsif ($key eq 'age') {
        return $self->[AGE];
    } else {
        ($key eq 'dateBucket') or
            die("unexpected key $key");
        return SummaryInfo::findAgeBin($self->[AGE]);
    }
}

sub nextOwner
{
    my ($self, $owner, $tla, $value) = @_;
    my $map = $self->[NEXT_OWNER];

    my $key = $tla . ' ' . $owner;
    if (defined($value)) {
        $map->{$key} = $value;
        return $value;
    }
    return exists($map->{$key}) ? $map->{$key} : undef;
}

sub nextDate
{
    my ($self, $date, $tla, $value) = @_;
    my $map = $self->[NEXT_AGE];
    my $key = $tla . ' ' . $date;
    if (defined($value)) {
        $map->{$key} = $value;
        return $value;
    }
    return $map->{$key};
}

package ReadBaselineSource;

use base 'ReadCurrentSource';

sub new
{
    my ($class, $diffData) = @_;

    my $self = $class->SUPER::new();
    push(@$self, $diffData);

    return $self;
}

sub isRecoveredBaselineFile
{
    my ($self, $filename) = @_;

    my $diffmap = $self->[1];
    return 0 unless defined($diffmap);
    my @diff = $diffmap->baselineSource($filename);
    return scalar(@diff);
}

sub open
{
    my ($self, $filename) = @_;
    my $diffmap = $self->[1];
    my @diff    = defined($diffmap) ? $diffmap->baselineSource($filename) : ();
    if (@diff) {
        # if there are any diffs, then need to load the current source, then
        #   walk the diff to insert and remove changed lines.
        # '$current' is the name the current text lives under and '$key' the
        #   name the diff data is filed under:  neither is necessarily the
        #   baseline's own name - see 'baselineSource'
        my ($key, $current) = @diff;
        my $currentSrc = $self->_load($current, 'baseline');
        my $src = $diffmap->recreateBaseline($filename, $currentSrc, $key);
        return $self->parseLines($filename, $src);
    }
    # else no diff data here - just read the file
    return ReadCurrentSource::open($self, $filename, 'baseline');
}

# one categorized call site - see 'FileCoverageInfo::_categorizeCallgraphCov'.
#   Unlike the other coverpoint types, there is no baseline/current/differential
#   triple:  a site's identity is (line, column, ordinal, callee) and the two
#   counts fit in the one record, so the categorized record is all there is.
package CallgraphSite;

use constant {
              LINE    => 0,
              COLUMN  => 1,
              ORDINAL => 2,
              CALLEE  => 3,
              # the function whose body contains this site.  Kept because the
              #   'calls' table of a function detail page groups by it, and
              #   because the containing function is not derivable from the line
              #   once the line has been deleted
              CALLER   => 4,
              BASELINE => 5,
              CURRENT  => 6,
              TLA      => 7,
              # the real 'current' FunctionEntry which contains this site, or
              #   undef for a site only the baseline has.  Kept so that 'set_tla'
              #   can write the category through to the site record there, which
              #   is where the 'called from' table of a function in some other
              #   file reads it from - see '_categorizeCallgraphCov'
              ENTRY => 8,
              # the baseline line this site was read from, for a site only the
              #   baseline has:  'LINE' is where it is displayed, which is the
              #   current line the diff maps it to, and that is not the line the
              #   baseline-side lookup has to be done with
              BASE_LINE => 9,
              # the file the call is *written* in, or undef when that is the file
              #   the caller is defined in - which is the ordinary case.  See
              #   'FNC:' in geninfo(1):  a call in an '#include'd fragment is
              #   written in the fragment and belongs to a function of the file
              #   which includes it, so 'LINE' is a line of *this* file and not
              #   of the file whose page displays the site
              FILE => 10,
              # ..and the line of the caller's own file this site is attached to,
              #   which is 'LINE' for an ordinary site and the line the caller is
              #   defined on for a site written in another file.  A site is
              #   counted by the file whose function contains it and is the
              #   metric counted by FNCF and FNCH, see
              #   TraceInfo::callgraph_found.  The counting walks the file's
              #   lines - so a site called from elewhere needs be registered
              #   with a line in this file.
              # A site which appears on some middle line of a multiline
              #   statement is attached to the multiline anchor.
              #   'LINE' is where the call is actually written, and is
              #   where the hyperlink leads.
              HOME_LINE => 11,
};

sub new
{
    my $class = shift;
    # (line, column, ordinal, callee, caller, base_count, curr_count, tla,
    #  entry, base_line, file, home_line)
    my @data = @_;
    my $self = \@data;
    bless $self, $class;
    return $self;
}

sub line
{
    my $self = shift;
    return $self->[LINE];
}

sub column
{
    my $self = shift;
    return $self->[COLUMN];
}

sub ordinal
{
    my $self = shift;
    return $self->[ORDINAL];
}

sub callee
{
    my $self = shift;
    return $self->[CALLEE];
}

sub caller
{
    my $self = shift;
    return $self->[CALLER];
}

sub base_line
{
    # only a baseline-only site has one - see BASE_LINE
    my $self = shift;
    return $self->[BASE_LINE];
}

sub file
{
    # undef for a site written in the file its caller is defined in - see FILE
    my $self = shift;
    return $self->[FILE];
}

sub home_line
{
    my $self = shift;
    return $self->[HOME_LINE];
}

sub base_count
{
    my $self = shift;
    return $self->[BASELINE];
}

sub set_base_count
{
    my ($self, $count) = @_;
    $self->[BASELINE] = $count;
}

sub curr_count
{
    my $self = shift;
    return $self->[CURRENT];
}

sub tla
{
    my $self = shift;
    return $self->[TLA];
}

sub set_tla
{
    my ($self, $tla) = @_;
    $self->[TLA] = $tla;
    $self->[ENTRY]
        ->setCallSiteTla($self->[LINE], $self->[COLUMN], $self->[ORDINAL],
                         $self->[FILE], $tla)
        if defined($self->[ENTRY]);
}

package LineData;

use constant {
              TYPE           => 0,
              LINENO_BASE    => 1,
              LINENO_CURRENT => 2,    # location of this line in current data
              LINE_DATA      => 3,
              BRANCH_DATA    => 4,
              MCDC_DATA      => 5,
              FUNCTION_DATA  => 6,
              # list of CallgraphSite - the call sites displayed on this line,
              #   which is not the same set as the sites of the function which
              #   starts on this line
              CALLGRAPH_DATA => 7,

              # data elements in line data
              TLA           => 0,
              LINE_BASELINE => 1,
              LINE_CURRENT  => 2,

              # data elements for branch/function data
              DATA_BASELINE     => 0,
              DATA_CURRENT      => 1,
              DATA_DIFFERENTIAL => 2,
};

sub new
{
    my ($class, $type) = @_;
    # [ type, lineNo_base, lineNo_current,
    #   bucket, base_count, curr_count    <- line coverage count data
    #   base_branch, curr_branch, differential_branch ] <- branch coverage count data
    # $type in ('insert', 'equal', 'delete')
    my $self = [$type, undef, undef,
                ['UNK', undef, undef],    # line coverage data
                [],                       # branch coverage data
                [],                       # MCDC coverage data
                [],                       # function coverage
                []
    ];    # call sites on this line
    bless $self, $class;
    return $self;
}

sub to_list
{
    # used by script-level 'select' callback
    my $self = shift;

    my @rtn = ($self->[TYPE],
               [$self->tla(),
                $self->in_curr() ? $self->curr_count() : undef,
                $self->in_base() ? $self->base_count() : undef
               ]);
    # @todo perhaps visit MC/DC here too
    my $branch = $self->differential_branch();
    if (defined($branch)) {
        my @data;
        push(@rtn, \@data);
        foreach my $block ($branch->blocks()) {
            my $elements = $block->elements();
            my @b;
            push(@data, \@b);
            foreach my $br (@$elements) {
                my $tla = $br->tla();
                my ($base_count, $curr_count) = $br->diff_count();
                push(@b, [$tla, $curr_count, $base_count]);
            }
        }
    } else {
        $branch = $self->current_branch();
        if (defined($branch)) {
            my @data;
            push(@rtn, \@data);
            foreach my $block ($branch->blocks()) {
                foreach my $br (@{$block->elements()}) {
                    push(@data, $br->count());
                }
            }
        } else {
            push(@rtn, undef);
        }
    }
    return \@rtn;
}

sub tla
{
    my ($self, $tla) = @_;
    my $linecov = $self->[LINE_DATA];
    $linecov->[TLA] = $tla
        if defined($tla);
    return $linecov->[TLA];
}

sub type
{
    my $self = shift;
    return $self->[TYPE];
}

sub lineNo
{
    my ($self, $which, $lineNo, $filename) = @_;
    my $loc;
    if ($which eq "current") {
        $loc = LINENO_CURRENT;
    } else {
        die("unknown key '$which' - should be 'base' or 'current'")
            unless $which eq "base";
        $loc = LINENO_BASE;
    }
    lcovutil::ignorable_error(
                        $lcovutil::ERROR_INCONSISTENT_DATA,
                        "\"$filename\": inconsistent '$which' line location: " .
                            $self->[$loc] .
                            " -> $lineNo")
        if (defined($lineNo) &&
            defined($self->[$loc]) &&
            $self->[$loc] != $lineNo);

    $self->[$loc] = $lineNo
        if defined($lineNo);
    return $self->[$loc];
}

sub in_base
{
    # @return true or false:  is this object present in the baseline?
    my $self = shift;
    # coverpoint is in baseline data if line coverage number is defined
    return defined($self->[LINE_DATA]->[LINE_BASELINE]);
}

sub in_curr
{
    # @return true or false:  is this object present in the current version?
    # storing negative number for 'current' location of deleted line -
    #   first location above or below the deleted region
    my $self = shift;
    # coverpoint is in current data if line coverage number is defined
    #  otherwise, the line may be present without coverage data associated
    #  with it (say, excluded now - or possibly filtered out)
    return defined($self->[LINE_DATA]->[LINE_CURRENT]);
}

sub base_count
{
    # return line hit count in baseline
    my ($self, $inc) = @_;
    die("non-zero count but not in base")
        if (defined($inc) && !defined($self->[LINENO_BASE]));
    my $linecov = $self->[LINE_DATA];
    if (defined($inc)) {
        if (defined($linecov->[LINE_BASELINE])) {
            $linecov->[LINE_BASELINE] += $inc;
        } else {
            $linecov->[LINE_BASELINE] = $inc;
        }
    }

    return $linecov->[LINE_BASELINE];
}

sub curr_count
{
    # return line hit count in current
    my ($self, $inc) = @_;
    die("non-zero count but not in current")
        if (defined($inc) &&
            (!defined($self->[LINENO_CURRENT]) || $self->[LINENO_CURRENT] < 0));
    my $linecov = $self->[LINE_DATA];
    if (defined($inc)) {
        if (defined($linecov->[LINE_CURRENT])) {
            $linecov->[LINE_CURRENT] += $inc;
        } else {
            $linecov->[LINE_CURRENT] = $inc;  # first assignment; += undef warns
        }
    }
    return $linecov->[LINE_CURRENT];
}

sub _mergeBranchData
{
    my ($self, $loc, $branchData) = @_;
    my $branch = $self->[BRANCH_DATA];
    die("unexpected $loc branch data") if defined($branch->[$loc]);
    $branch->[$loc] = Storable::dclone($branchData);
}

sub baseline_branch
{
    my ($self, $branchData) = @_;
    die("has baseline branch data but not in baseline")
        if (defined($branchData) && !defined($self->[LINENO_BASE]));
    if (defined($branchData)) {
        $self->_mergeBranchData(DATA_BASELINE, $branchData);
    }
    my $branch = $self->[BRANCH_DATA];
    return $branch->[DATA_BASELINE];
}

sub current_branch
{
    my ($self, $branchData) = @_;
    die("has current branch data but not in current")
        if (defined($branchData) &&
            (!defined($self->[LINENO_CURRENT]) || $self->[LINENO_CURRENT] < 0));
    if (defined($branchData)) {
        $self->_mergeBranchData(DATA_CURRENT, $branchData);
    }
    my $branch = $self->[BRANCH_DATA];
    return $branch->[DATA_CURRENT];
}

sub differential_branch
{
    my ($self, $differential) = @_;
    my $branch = $self->[BRANCH_DATA];
    if (defined($differential)) {
        $branch->[DATA_DIFFERENTIAL] = $differential;
    }
    return $branch->[DATA_DIFFERENTIAL];
}

sub _mergeMcdcData
{
    # this is nearly identical to 'function' implementation...maybe share
    my ($self, $loc, $mcdcData) = @_;
    my $mcdc = $self->[MCDC_DATA];
    die("unexpected $loc MC/DC data") if defined($mcdc->[$loc]);
    $mcdc->[$loc] = Storable::dclone($mcdcData);
}

sub baseline_mcdc
{
    my ($self, $mcdcData) = @_;
    die("has baseline MC/DC data but not in baseline")
        if (defined($mcdcData) && !defined($self->[LINENO_BASE]));
    if (defined($mcdcData)) {
        $self->_mergeMcdcData(DATA_BASELINE, $mcdcData);
    }
    my $mcdc = $self->[MCDC_DATA];
    return $mcdc->[DATA_BASELINE];
}

sub current_mcdc
{
    my ($self, $mcdcData) = @_;
    die("has current MC/DC data but not in current")
        if (defined($mcdcData) &&
            (!defined($self->[LINENO_CURRENT]) || $self->[LINENO_CURRENT] < 0));
    if (defined($mcdcData)) {
        $self->_mergeMcdcData(DATA_CURRENT, $mcdcData);
    }
    my $mcdc = $self->[MCDC_DATA];
    return $mcdc->[DATA_CURRENT];
}

sub differential_mcdc
{
    my ($self, $differential) = @_;
    my $mcdc = $self->[MCDC_DATA];
    if (defined($differential)) {
        $mcdc->[DATA_DIFFERENTIAL] = $differential;
    }
    return $mcdc->[DATA_DIFFERENTIAL];
}

sub _mergeFunctionData
{
    my ($self, $loc, $functionData) = @_;
    die('expected FunctionEntry found ' . ref($functionData))
        unless 'FunctionEntry' eq ref($functionData);
    my $function = $self->[FUNCTION_DATA];
    die("unexpected $loc function data") if defined($function->[$loc]);
    # also clone hit count data
    $function->[$loc] = $functionData->cloneWithEndLine(1, 1);
}

sub baseline_function
{
    my ($self, $functionData) = @_;
    die("has baseline function data but not in baseline")
        if (defined($functionData) && !defined($self->[LINENO_BASE]));
    if (defined($functionData)) {
        $self->_mergeFunctionData(DATA_BASELINE, $functionData);
    }
    my $function = $self->[FUNCTION_DATA];
    return $function->[DATA_BASELINE];
}

sub current_function
{
    my ($self, $functionData) = @_;
    die("has current function data but not in current")
        if (defined($functionData) &&
            (!defined($self->[LINENO_CURRENT]) || $self->[LINENO_CURRENT] < 0));
    if (defined($functionData)) {
        $self->_mergeFunctionData(DATA_CURRENT, $functionData);
    }
    my $function = $self->[FUNCTION_DATA];
    return $function->[DATA_CURRENT];
}

sub differential_function
{
    my ($self, $differential) = @_;
    my $function = $self->[FUNCTION_DATA];
    if (defined($differential)) {
        $function->[DATA_DIFFERENTIAL] = $differential;
    }
    return $function->[DATA_DIFFERENTIAL];
}

sub add_call_site
{
    my ($self, $site) = @_;
    die('expected CallgraphSite found ' . ref($site))
        unless 'CallgraphSite' eq ref($site);
    push(@{$self->[CALLGRAPH_DATA]}, $site);
}

sub call_sites
{
    # the categorized call sites displayed on this line, in source order.  The
    #   empty list rather than undef when there are none:  every caller of this
    #   iterates
    my $self = shift;
    return @{$self->[CALLGRAPH_DATA]};
}

sub num_call_sites
{
    my $self = shift;
    return scalar(@{$self->[CALLGRAPH_DATA]});
}

sub sort_call_sites
{
    # sort into source order:  by line, then column, then ordinal, then
    #   callee name.
    #   The line is the same for all of them unless some call is in the
    #   middle of some multiline statement. The callee breaks the
    #   tie between two baseline-only sites of different callers whose columns
    #   happen to match.
    # A site may be attached to this line without being on it (see
    #   CallgraphSite::HOME_LINE):  one written on a later line of this
    #   multiline statement sorts by its appearance line, and one written in
    #   another file sorts after the line's own sites, by file and then by
    #  its own line
    my $self = shift;
    @{$self->[CALLGRAPH_DATA]} =
        sort({
                 my $fileA = defined($a->file()) ? $a->file() : '';
                 my $fileB = defined($b->file()) ? $b->file() : '';
                 $fileA            cmp $fileB        or
                     $a->line()    <=> $b->line()    or
                     $a->column()  <=> $b->column()  or
                     $a->ordinal() <=> $b->ordinal() or
                     $a->callee()  cmp $b->callee();
        } @{$self->[CALLGRAPH_DATA]});
}

# forward-declare some types
package DiffMap;

use constant {
              EQUAL  => 0,
              INSERT => 1,
              DELETE => 2,

};

our @type2str = ('equal', 'insert', 'delete');

# structure holding coverage data for a particular file:
#  - associated with a line number:
#     - line coverage
#     - branch coverage
#  - function coverage (not directly associated with line number
package FileCoverageInfo;

use constant {
              VERSION             => 0,
              LINEMAP             => 1,
              DELETED_LINE_LEADER => 2,
              FUNCTIONMAP         => 3,
              # current line -> [first, last] line of the statement it is part
              #   of, for the lines of the multi-line statements
              STATEMENTS => 4,
};

sub new
{
    my ($class, $filename, $base_data, $current_data, $diffMap, $verbose) = @_;

    # [hash of lineNumber -> LineData struct, optional FunctionMap]
    my $self = [
             [defined($base_data) ? $base_data->version() : undef,
              $current_data->version()
             ],
             {}, # the line data map
             {}  # currentLineNo -> [deleted lines for which this is the leader]
    ];
    bless $self, $class;

    $diffMap->show_map($filename)
        if ((defined($verbose) && $verbose) ||
            (defined($lcovutil::verbose) && $lcovutil::verbose > 1));
    $self->[STATEMENTS] = _statementMap($current_data);
    _foldBaselineStatements($filename, $base_data, $current_data, $diffMap);
    # the current lines of the statements which the diff changed
    my $changed =
        changedStatementLines($filename, $base_data, $current_data, $diffMap);

    # line coverage categorization includes date- and owner- bins in
    #   the vanilla case when there is no baseline.
    my @args = ($filename, $base_data, $current_data, $diffMap, $verbose);
    $self->_categorizeLineCov(@args);
    $self->_categorizeBranchCov(@args)
        if ($lcovutil::br_coverage);
    $self->_categorizeMcdcCov(@args)
        if ($lcovutil::mcdc_coverage);
    $self->_recategorizeChangedStatements($changed, $verbose)
        if %$changed;
    $self->_categorizeFunctionCov(@args)
        if ($lcovutil::func_coverage);
    # after the function pass:  a call site is contained in a function, and the
    #   line it is on may have no coverpoint of any other kind, in which case the
    #   function pass has already given that line its category
    $self->_categorizeCallgraphCov(@args, $changed)
        if ($lcovutil::callgraph_coverage);

    return $self;
}

sub version
{
    my ($self, $which) = @_;
    return $which eq 'current' ? $self->[VERSION]->[1] : $self->[VERSION]->[0];
}

sub lineMap
{
    my $self = shift;
    return $self->[LINEMAP];
}

sub functionMap
{
    # simply a map of function leader name -> differential FunctionEntry
    my $self = shift;
    return (scalar(@$self) >= FUNCTIONMAP) ? $self->[FUNCTIONMAP] : undef;
}

sub line
{
    my ($self, $lineNo) = @_;
    my $lineMap = $self->lineMap();
    return exists($lineMap->{$lineNo}) ? $lineMap->{$lineNo} : undef;
}

sub deletedLineData
{
    my ($self, $currentLineNumber) = @_;

    my $map = $self->[DELETED_LINE_LEADER];
    return
        exists($map->{$currentLineNumber}) ? $map->{$currentLineNumber} : undef;
}

sub statement
{
    # @return (first, last) line of the multi-line statement which current line
    #   '$lineNo' is part of - or the empty list, if it is not part of one
    my ($self, $lineNo) = @_;
    my $stmt = $self->[STATEMENTS]->{$lineNo};
    return defined($stmt) ? @$stmt : ();
}

sub statements
{
    # hash of current line -> [first, last] - see 'statement'
    my $self = shift;
    return $self->[STATEMENTS];
}

sub _statementMap
{
    # line -> [first, last] for every line of every statement span of the
    #   TraceInfo:  the spans of the line coverpoints which it has
    my $traceInfo = shift;
    my %map;
    my $span = $traceInfo->span();
    return \%map unless $span->entries();
    my $lineCov = $traceInfo->sum();
    foreach my $line ($span->keylist()) {
        next unless defined($lineCov->value($line));
        my $stmt = [$line, $span->value($line)];
        $map{$_} = $stmt foreach ($line .. $stmt->[1]);
    }
    return \%map;
}

sub _foldBaselineStatements
{
    # The current data may have been captured with 'merge_continuation_lines'
    # and the baseline without:
    #   - a multi-line 'current' statement will have a single coverpoint on
    #     its first line - but the 'baseline' has a coverpoint on interior
    #     lines as well.
    #   - compared line by line, the continuation lines look deleted and the
    #     parent function looks edited - even though the source code is
    #     identical
    # View the baseline through the current statements first:
    #   - the baseline line coverpoint of an unchanged continuation line
    #     which has no coverpoint in the current data is folded into the
    #     baseline line of the statement's first line, together with its
    #     branch and MC/DC data - where the current data moved its data (see
    #     TraceFile::foldContinuationLines).
    #   - a line which starts a baseline function or a baseline statement
    #    of its own is not modified.
    # A baseline captured with the 'merge_continuation_lines' option has
    # already been folded:  its continuation lines have no coverpoints either.
    my ($filename, $base_data, $current_data, $diffMap) = @_;
    return unless defined($base_data);
    my $span = $current_data->span();
    return unless $span->entries();
    my $lineCov  = $current_data->sum();
    my $baseCov  = $base_data->sum();
    my $baseSpan = $base_data->span();
    my $baseFunc = $base_data->func();
    my $currBr   = $lcovutil::br_coverage ? $current_data->sumbr() : undef;
    my $baseBr   = $lcovutil::br_coverage ? $base_data->sumbr() : undef;
    my $currMcdc = $lcovutil::mcdc_coverage ? $current_data->mcdc() : undef;
    my $baseMcdc = $lcovutil::mcdc_coverage ? $base_data->mcdc() : undef;
    my $equal    = sub {
        $diffMap->type($filename, $diffMap->NEW, $_[0]) == DiffMap::EQUAL;
    };
    my %fold;
    foreach my $line ($span->keylist()) {
        next unless defined($lineCov->value($line)) && &$equal($line);
        my $to = $diffMap->lookup($filename, $diffMap->NEW, $line);
        foreach my $l ($line + 1 .. $span->value($line)) {
            next if defined($lineCov->value($l)) || !&$equal($l);
            my $from = $diffMap->lookup($filename, $diffMap->NEW, $l);
            next
                if ($from == $to ||
                    defined($baseSpan->value($from)) ||
                    (defined($baseFunc) && defined($baseFunc->findKey($from))));
            my $branches = defined($baseBr) &&
                defined($baseBr->value($from)) &&
                !(defined($currBr) && defined($currBr->value($l)));
            my $conditions = defined($baseMcdc) &&
                defined($baseMcdc->value($from)) &&
                !(defined($currMcdc) && defined($currMcdc->value($l)));
            next
                unless defined($baseCov->value($from)) ||
                $branches ||
                $conditions;
            $fold{$from} = [$to, $branches, $conditions];
        }
    }
    return unless %fold;
    my $one = 1 == scalar(keys(%fold));
    lcovutil::info(2,
                   "\"$filename\": baseline continuation line" .
                       ($one ? ' ' : 's ') .
                       join(',', sort({ $a <=> $b } keys(%fold))) .
                       ' folded into '
                       .
                       ($one ? 'its statement line' : 'their statement lines') .
                       "\n");
    TraceFile::foldContinuationLines($base_data, \%fold);
}

sub changedStatementLines
{
    # The current lines of the multi-line statements which the diff changed, as
    #   a hash of line -> 1.  A statement is changed if any of its current lines
    #   is inserted, or if any line of the baseline statement it maps to was
    #   deleted - a changed line is both.  Every coverpoint written on one of
    #   these lines - line, branch, MC/DC and call site - is then new code.
    # The statement is the segment the coverpoint is in:  a statement which
    #   'merge_continuation_lines' partitioned is several independent segments
    #   because it couldn't figure out how to merge them consistently.
    # If the baseline data has no span anywhere, then it was captured without
    #   continuation lines, and a baseline coverpoint represents the current
    #   statement which starts on the line it maps to - whatever the extent of
    #   that statement was in the baseline.
    # The (multi-line) statement is also marked 'changed' if a baseline line
    #   between two of its 'current' lines was deleted.
    # If the baseline has a span anywhere then it was captured with
    #   'merge_continuation_lines' - so all spans have been identified:
    #   in that case, a baseline statement without a span is a single line.
    # Without a baseline, every coverpoint is new code.
    my ($filename, $base_data, $current_data, $diffMap) = @_;
    my %changed;
    return \%changed unless defined($base_data);
    my $currSpan = $current_data->span();
    my $baseSpan = $base_data->span();
    return \%changed unless ($currSpan->entries() || $baseSpan->entries());

    my $current = _statementMap($current_data);
    # mark the current statement which line '$line' is in - or the line alone,
    #   if it is in none
    my $mark = sub {
        my $line = shift;
        my $stmt = $current->{$line};
        if (defined($stmt)) {
            $changed{$_} = 1 foreach ($stmt->[0] .. $stmt->[1]);
        } else {
            $changed{$line} = 1;
        }
    };
    my $lineCov = $current_data->sum();
    foreach my $line ($currSpan->keylist()) {
        next unless defined($lineCov->value($line));
        my $end = $currSpan->value($line);
        my $edited = grep(
             { $diffMap->type($filename, $diffMap->NEW, $_) == DiffMap::INSERT }
             ($line .. $end));
        unless ($edited || $main::baseline_has_spans) {
            my $from = $diffMap->lookup($filename, $diffMap->NEW, $line);
            my $to   = $diffMap->lookup($filename, $diffMap->NEW, $end);
            $edited = grep({ $diffMap->type($filename, $diffMap->OLD, $_) ==
                                   DiffMap::DELETE } ($from .. $to));
        }
        &$mark($line) if $edited;
    }
    my $baseCov = $base_data->sum();
    foreach my $bline ($baseSpan->keylist()) {
        next unless defined($baseCov->value($bline));
        my $deleted = 0;
        my @surviving;
        foreach my $l ($bline .. $baseSpan->value($bline)) {
            if ($diffMap->type($filename, $diffMap->OLD, $l) == DiffMap::DELETE)
            {
                $deleted = 1;
            } else {
                push(@surviving,
                     $diffMap->lookup($filename, $diffMap->OLD, $l));
            }
        }
        next unless $deleted;
        &$mark($_) foreach (@surviving);
    }
    return \%changed;
}

# the category of a coverpoint of a changed statement
our %changedStatementTla = ('UBC' => 'UNC',
                            'UIC' => 'UNC',
                            'LBC' => 'UNC',
                            'GBC' => 'GNC',
                            'CBC' => 'GNC',
                            'GIC' => 'GNC',);

sub _recategorizeChangedStatements
{
    # the line, branch and MC/DC coverpoints of the changed statements are new
    #   code - see 'changedStatementLines'.  Call sites are categorized in
    #   'categorizeCallSites'
    my ($self, $changed, $verbose) = @_;
    my $lineMap = $self->lineMap();
    foreach my $line (keys(%$changed)) {
        my $data = $lineMap->{$line};
        next unless defined($data);
        my $tla = $data->tla();
        if (exists($changedStatementTla{$tla})) {
            $data->tla($changedStatementTla{$tla});
            print("  changed statement $line $tla -> " . $data->tla() . "\n")
                if $verbose;
        }
        if ($lcovutil::br_coverage) {
            my $br = $data->differential_branch();
            if (defined($br)) {
                foreach my $block ($br->blocks()) {
                    foreach my $b (@{$block->elements()}) {
                        my $t = $b->tla();
                        $b->set_tla($changedStatementTla{$t})
                            if exists($changedStatementTla{$t});
                    }
                }
            }
        }
        if ($lcovutil::mcdc_coverage) {
            my $mcdc = $data->differential_mcdc();
            if (defined($mcdc)) {
                # groups() materializes a fresh hash on each call - see
                #   'recategorizeTlaAsBaseline'
                my $groups = $mcdc->groups();
                foreach my $group (values(%$groups)) {
                    foreach my $cond (@$group) {
                        foreach my $sense (0, 1) {
                            my $t = $cond->count($sense)->[0];
                            $cond->set_tla($sense, $changedStatementTla{$t})
                                if exists($changedStatementTla{$t});
                        }
                    }
                }
            }
        }
    }
}

sub recategorizeTlaAsBaseline
{
    # intended use:  this file appears to have been added to the "coverage"
    # suite - but the file itself is old/has been around for a long time.
    #   - by default, we will see this as "Included Code"
    #      - which means that 'un-exercised' code will be "UIC"
    #   - but:  non-zero UIC will fail our Jenkins coverage ratchet.
    # As a workaround:  treat this file as if the baseline data was the same
    # as 'current' - so code will be categorized as "CBC/UBC" - which will not
    # trigger the coverage criteria.
    my $self    = shift;
    my $lineMap = $self->lineMap();
    my %remap = ('UIC' => 'UBC',
                 'GIC' => 'CBC');

    while (my ($line, $data) = each(%$lineMap)) {
        die("unexpected $line 'in_base'") if $data->in_base();

        my $lineTla = $data->tla();
        if (exists($remap{$lineTla})) {
            # don't remap GNC, UNC, etc
            $data->tla($remap{$lineTla});
        }

        # branch coverage...
        if ($lcovutil::br_coverage && defined($data->differential_branch())) {
            my $br = $data->differential_branch();

            foreach my $block ($br->blocks()) {
                my $diff = $block->elements();
                foreach my $b (@$diff) {
                    my $tla = $b->tla();
                    if (exists($remap{$tla})) {
                        $b->set_tla($remap{$tla});
                    }
                }
            }
        }    # if branch data

        # MC/DC coverage...
        if ($lcovutil::mcdc_coverage && defined($data->differential_mcdc())) {
            my $mcdc = $data->differential_mcdc();

            # groups() materializes a fresh hash on each call, so hold it in a
            #   lexical: each() over a new hash restarts every iteration.
            my $mcdcGroups = $mcdc->groups();
            while (my ($groupSize, $group) = each(%$mcdcGroups)) {
                foreach my $cond (@$group) {
                    # remap both the true and false sense..
                    foreach my $sense (0, 1) {
                        my $tla = $cond->count($sense)->[0];
                        if (exists($remap{$tla})) {
                            # write it through the mutator, as the branch loop
                            #   above does:  count() hands back a copy of the
                            #   differential triple in the XS backend, so
                            #   assigning to its TLA slot changes nothing there
                            $cond->set_tla($sense, $remap{$tla});
                        }
                    }
                }
            }
        }    # if MCDC data

        # function coverage..
        if ($lcovutil::func_coverage && defined($data->differential_function()))
        {
            my $func = $data->differential_function();
            # through the mutator, as the branch and MC/DC loops above are:
            #   'hit()' hands back a copy of the differential pair in the XS
            #   backend, so assigning to its TLA slot changes nothing there
            my $tla = $func->tla();
            if (exists($remap{$tla})) {
                $func->set_tla($remap{$tla});
            }

            foreach my $alias ($func->aliasNames()) {
                my $data = $func->alias($alias);
                my $tla  = $data->tla();
                if (exists($remap{$tla})) {
                    $data->set_tla($remap{$tla});
                }
            }
        }    # if function data

        # callgraph coverage..
        # This remap reaches the file's own bins and its own pages - which is
        #   what the coverage ratchet this option exists for looks at.  It does
        #   not reach the 'callers of this function' table on the page of a
        #   *callee* in some other file:  that table shows the category which
        #   'main::categorize_all_call_sites' computed in the parent, because the
        #   file it belongs to may be built in a different process, and this
        #   decision cannot be made in the parent - it needs the file's
        #   annotation, which is what the children are forked to do.  So a site
        #   in a file this option rewrites is 'CBC' where its own file displays
        #   it and 'GIC' where its callee does
        if ($lcovutil::callgraph_coverage) {
            foreach my $site ($data->call_sites()) {
                my $tla = $site->tla();
                $site->set_tla($remap{$tla})
                    if exists($remap{$tla});
            }
        }
    }
}

sub _categorize
{
    my ($baseCount, $currCount, $excluded) = @_;
    my $tla;
    if (0 == $baseCount) {
        $tla = (0 == $currCount) ? "UBC" : "GBC";
    } elsif (0 == $currCount) {
        $tla = "LBC";
    } else {
        $tla = "CBC";
    }
    if (defined($excluded) && $excluded) {
        return $currCount == 0 ? 'EUC' : 'ECC';
    }
    return $tla;
}

sub _categorizeIfExcluded
{
    my ($count, $excluded, $missTla, $hitTla) = @_;
    unless ($excluded) {
        return $count == 0 ? $missTla : $hitTla;
    } else {
        return $count == 0 ? 'EUC' : 'ECC';
    }
}

sub _findLineData
{
    my ($self, $diffMap, $filename, $base_lineNo) = @_;
    my $current_lineNo =
        $diffMap->lookup($filename, $diffMap->OLD, $base_lineNo);
    my $type = $diffMap->type($filename, $diffMap->OLD, $base_lineNo);

    my $lineDataMap = $self->lineMap();
    my $linedata;

    if ($type != DiffMap::DELETE) {
        if (!defined($lineDataMap->{$current_lineNo})) {
            $linedata = LineData->new($type);
            $lineDataMap->{$current_lineNo} = $linedata;
            $linedata->lineNo('current', $current_lineNo, $filename);
        } else {
            $linedata = $lineDataMap->{$current_lineNo};
        }
        $linedata->lineNo('base', $base_lineNo, $filename);
    } else {
        # nothing walks the keylist so a prefix is sufficient to distinguish
        # records that should be summarized but not displayed
        my $dline = "<<<" . $base_lineNo;
        if (!exists($lineDataMap->{$dline})) {
            $linedata = LineData->new($type);
            $linedata->lineNo('base', $base_lineNo, $filename);
            $lineDataMap->{$dline} = $linedata;
            # look up and/or down to find the first baseline line
            # which is not deleted - and store that as the corresponding
            # 'current' line.
            # this way, we can know the extents of the deleted region
            my $c = $diffMap->find_deleted_line_leader($filename, $base_lineNo);
            $linedata->lineNo('current', -$c, $filename);
        } else {
            $linedata = $lineDataMap->{$dline};
        }
    }
    return $linedata;
}

# categorize line coverage numbers
sub _categorizeLineCov
{
    my ($self, $filename, $base_data, $current_data, $diffMap, $verbose) = @_;
    my $lineDataMap = $self->lineMap();

    print("categorize lines $filename\n")
        if ($verbose);

    # $lineCovBase, $lineCovCurrent are CountData objects
    my $lineCovBase;
    $lineCovBase = $base_data->sum() if defined($base_data);
    my $lineCovCurrent = $current_data->sum();

    if ($lcovutil::check_data_consistency) {
        # walk the branch coverpoints to check for data consistency:
        #  - we expect a line coverpoint in every location which has branches
        #  - if not found, the generate message and/or create a fake coverpoint
        # LLVM seems to like to generate inconsistent data.
        my $branchCurrent = $current_data->sumbr();
        foreach my $line ($branchCurrent->keylist()) {
            # just ignore bogus data - we already warned when we read the data
            next if ($line <= 0);

            my $type = $diffMap->type($filename, $diffMap->NEW, $line);
            if ($type == DiffMap::DELETE) {
                # LCOV_UNREACHABLE_START
                lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                    "'current' line $filename:$line should not be marked 'delete'"
                );
                delete($branchCurrent->{$line});
                next;
                # LCOV_UNREACHABLE_STOP
            }
        }
    }

    # it is sufficient to just walk the 'global' (merged) line
    #  coverage dataset because we only care/we only show total
    #  coverage - not changed coverage per testcase.
    #  (This observation is also true for branch and function
    #  coverages.)
    foreach my $line ($lineCovCurrent->keylist()) {
        # just ignore bogus data - we already warned when we read the data
        next if ($line <= 0);
        my $type = $diffMap->type($filename, $diffMap->NEW, $line);
        if ($type == DiffMap::DELETE) {
            # can happen in some inconsistent case, when there are certain
            # out-of-range references in a file which contained diffs - and we
            # ignored the error check
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "'current' line $filename:$line should not be marked 'delete'");
            $lineCovCurrent->remove($line);
            next;
        }
        my $linedata;
        if (!exists($lineDataMap->{$line})) {
            $linedata = LineData->new($type);
            $lineDataMap->{$line} = $linedata;
        } else {
            $linedata = $lineDataMap->{$line};
        }
        # @todo support exclusion markers for linecov??
        my $val = $lineCovCurrent->value($line);
        $linedata->lineNo("current", $line, $filename);
        $linedata->curr_count($val);
        $linedata->tla($val == 0 ? 'UNC' : 'GNC')
            if (!defined($lineCovBase));
    }
    return unless (defined($lineCovBase));

    foreach my $bline ($lineCovBase->keylist()) {
        # just ignore bogus data - we already warned when we read the data
        next if ($bline <= 0);
        my $linedata = $self->_findLineData($diffMap, $filename, $bline);
        my $val      = $lineCovBase->value($bline);
        $linedata->base_count($val);
    }
    # walk the diff data here to mark deleted regions so we can highlight
    #   them in the source view
    my $deletedLineData = $diffMap->compute_deleted_lines($filename);
    $self->[DELETED_LINE_LEADER] = $deletedLineData
        if $deletedLineData;

    if ($verbose) {
        print("  line data map:\n");
        foreach my $line (sort keys %$lineDataMap) {
            my $data = $lineDataMap->{$line};
            print("    $line: ",
                  $data->type(),
                  ' curr:',
                  $data->in_curr() ? $data->lineNo('current') : '-',
                  ' base:',
                  $data->in_base() ? $data->lineNo('base') : '-',
                  "\n");
        }
    }
    foreach my $line (sort keys %$lineDataMap) {
        my $linedata = $lineDataMap->{$line};
        my $tla;
        if ($linedata->type() == DiffMap::INSERT) {
            if (!$linedata->in_curr()) {
                # can get here if the 'diff' file is wrong with respect to
                # baseline vs. current coverage data - e.g., showing that
                # an unchanged line has a difference
                lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                    "$filename:$line: 'diff' data claims this line is inserted but it is not in 'current' coverage data"
                );
                next;
            }
            $tla = ($linedata->curr_count() > 0) ? "GNC" : "UNC";
            print("  insert $line $tla\n") if ($verbose);
        } elsif ($linedata->type() == DiffMap::DELETE) {
            if (!$linedata->in_base()) {
                # similarly:  can get here if the diff vs baseline/current data
                # is inconsistent.
                lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                    "$filename:$line: 'diff' data claims this line is deleted but it is not in 'baseline' coverage data"
                );
                next;
            }
            $tla = ($linedata->base_count() > 0) ? "DCB" : "DUB";
            print("  delete $line $tla\n") if ($verbose);
        } else {
            die("FileCoverageInfo:: deleted segment line=$line file=$filename")
                unless $linedata->type() == DiffMap::EQUAL;

            if ($linedata->in_base() && $linedata->in_curr()) {
                $tla =
                    _categorize($linedata->base_count(),
                                $linedata->curr_count());
            } elsif ($linedata->in_base()) {
                $tla = ($linedata->base_count() > 0) ? "ECB" : "EUB";
                $linedata->tla($tla);
            } else {
                die("FileCoverageInfo:: non-executed line line=$line file=$filename"
                ) unless $linedata->in_curr();
                $tla = ($linedata->curr_count() > 0) ? "GIC" : "UIC";
            }
            print("  equal $line $tla in:" .
                  ($linedata->in_base() ? ' base' : '') .
                  ($linedata->in_curr() ? ' curr' : '') . "\n")
                if ($verbose);
        }
        $linedata->tla($tla);
    }
}

sub cloneBlock
{
    my ($cloneInto, $cloneFrom, $missTla, $hitTla, $categorizeExcluded) = @_;

    # same location:  it is part of the identity of the block
    $cloneInto->setLocationOffset($cloneFrom->locationOffset());
    foreach my $br (@{$cloneFrom->elements()}) {
        my $count = $br->count();
        my $tla =
            _categorizeIfExcluded($count,
                                  $categorizeExcluded && $br->is_excluded(),
                                  $missTla, $hitTla);
        $br->set_differential($tla, undef, $count); # undef == "not in baseline"
        $cloneInto->appendElement($br);
    }
}

sub _cloneBranchLocation
{
    my ($cloneInto, $cloneFrom, $missTla, $hitTla, $categorizeExcluded) = @_;
    foreach my $code ($cloneFrom->codes(1)) {
        foreach my $from (@{$cloneFrom->getList($code)}) {
            my $to = BranchBlock->new();
            cloneBlock($to, $from, $missTla, $hitTla, $categorizeExcluded);
            $cloneInto->insertBlock($to);
        }
    }
}

# categorize branch coverage numbers
sub _categorizeBranchCov
{
    my ($self, $filename, $base_data, $current_data, $diffMap, $verbose) = @_;
    my $lineDataMap = $self->lineMap();

    my $branchBaseline;
    $branchBaseline = $base_data->sumbr() if defined($base_data);
    my $branchCurrent = $current_data->sumbr();

    my %branchCovLines;
    # look through the 'current' data, to find all the branch data
    # keep track of hit count in baseline, current - in element 2 of the
    #  retained branch data.  These counts are useful - for example, to report
    #  the hit count in the baseline for LBC branches:
    #   - e.g., in random testing: is this branch lost because it was a
    #     low probability event (..baselinecount is a small number)>
    #     Or because we did something bad and no longer reach what had been
    #     a high probability event?
    foreach my $line ($branchCurrent->keylist()) {
        next if ($line <= 0);    # ignore bogus
        unless (exists($lineDataMap->{$line})) {
            # unless ignored, should have been caught or fixed during
            #  TraceInfo::_checkConsistency
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "\"$filename\":$line line has branchcov but no linecov data (skipping)."
            );
            next;
        }
        my $data = $lineDataMap->{$line};

        $branchCovLines{$line} = 1;
        # we expect that the line number matches...
        $data->lineNo("current", $line, $filename);
        # append this branch data for the line
        my $currBranchData = $branchCurrent->value($line);
        $data->current_branch($currBranchData);
        if (!defined($branchBaseline)) {
            my $categorized = BranchLocation->new($line);
            $data->differential_branch($categorized);
            die("no branch data for deleted $filename:$line")
                unless defined($currBranchData);
            _cloneBranchLocation($categorized, $currBranchData, 'UNC', 'GNC',
                                 1);
        }
    }    # foreach line in 'current' branch data

    return unless defined($branchBaseline);

    # now look through the baseline to find matching data

    foreach my $base_line ($branchBaseline->keylist()) {
        my $data      = $self->_findLineData($diffMap, $filename, $base_line);
        my $curr_line = $data->lineNo('current');
        my $type      = $data->type();
        if ($type != DiffMap::DELETE) {
            $branchCovLines{$curr_line} = 1;
        } else {
            # the line has been deleted...just record the data
            my $deleteKey = "<<<" . $base_line;
            $branchCovLines{$deleteKey} = 1;
        }
        my $baseBranchData = $branchBaseline->value($base_line);
        $data->baseline_branch($baseBranchData);
    }    # foreach line in baseline data

    # go through all the branch data for each line, and categorize everything
    foreach my $line (keys(%branchCovLines)) {
        my $data        = $self->lineMap()->{$line};
        my $type        = $data->type();
        my $curr        = $data->current_branch();
        my $base        = $data->baseline_branch();
        my $categorized = BranchLocation->new($line);
        $data->differential_branch($categorized);

        if ($type == DiffMap::INSERT) {
            # can get here if diff data vs baseline/current is not consistent
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "baseline branch data should not be defined for inserted line $filename:$line"
            ) if defined($base);
            if (defined($curr)) {
                _cloneBranchLocation($categorized, $curr, 'UNC', 'GNC', 1);
            } else {
                # LCOV_UNREACHABLE_START
                lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                    "current branch data should not be defined for inserted line $filename:$line"
                );
                # LCOV_UNREACHABLE_STOP
            }
        } elsif ($type == DiffMap::DELETE) {
            # similarly: get here if diff data vs baseline/current is not consistent
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "current branch data should not be defined for deleted line $filename:$line"
            ) if defined($curr);

            if (defined($base)) {
                _cloneBranchLocation($categorized, $base, 'DUB', 'DCB');
            } else {
                # LCOV_UNREACHABLE_START
                lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                    "baseline branch data should not be defined for deleted line $filename:$line"
                );
                # LCOV_UNREACHABLE_STOP
            }
        } else {
            lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                     "unexpected branch coverage type $type at $filename:$line")
                if $type != DiffMap::EQUAL;
            # go through all the codes baseline - handle whether in
            #   current or not
            my $numCurr;
            $numCurr = $curr->numBlocks()
                if defined($curr);
            # sort the set of codes - so blocks get created in an easily
            #  explained order
            my @baselineCodes;
            @baselineCodes = $base->codes(1)
                if defined($base);

            foreach my $code (@baselineCodes) {
                my $baseList = $base->getList($code);
                if (defined($curr) && $curr->containsCode($code)) {
                    my $currList = $curr->getList($code);
                    my $blkIdx   = 0;
                    foreach my $baseBlock (@$baseList) {
                        my $catBlock = BranchBlock->new();
                        # same code, so the same location as the current block
                        $catBlock->setLocationOffset(
                                                  $baseBlock->locationOffset());
                        if ($blkIdx <= $#$currList) {
                            my $currBlock = $currList->[$blkIdx++];
                            my $elemIdx   = 0;
                            foreach my $base_br (@{$baseBlock->elements()}) {
                                my $curr_br =
                                    $currBlock->getElement($elemIdx++);
                                my $baseCount = $base_br->count();
                                my $currCount = $curr_br->count();
                                my $tla =
                                    _categorize($baseCount, $currCount,
                                                $curr_br->is_excluded());

                                $curr_br->set_differential($tla, $baseCount,
                                                           $currCount);
                                $catBlock->appendElement($curr_br);
                            }
                        } else {
                            # this block not in current - clone and mark
                            #   that it was deleted
                            cloneBlock($catBlock, $baseBlock, 'DUB', 'DCB');
                        }
                        $categorized->insertBlock($catBlock);
                    }
                    # now handle any blocks that are in current but not base
                    while ($blkIdx <= $#$currList) {
                        my $catBlock  = BranchBlock->new();
                        my $currBlock = $currList->[$blkIdx++];
                        cloneBlock($catBlock, $currBlock, 'UIC', 'GIC', 1);
                        $categorized->insertBlock($catBlock);
                    }
                } else {
                    # this code not in current - so clone/mark as deleted
                    foreach my $baseBlock (@$baseList) {
                        my $b = BranchBlock->new();
                        cloneBlock($b, $baseBlock, 'DUB', 'DCB');
                        $categorized->insertBlock($b);
                    }
                }
            }
            # now find all the codes in current that were not in base..
            if (defined($curr)) {
                foreach my $code ($curr->codes(1)) {
                    next if defined($base) && $base->containsCode($code);
                    foreach my $currBlock (@{$curr->getList($code)}) {
                        my $b = BranchBlock->new();
                        cloneBlock($b, $currBlock, 'UIC', 'GIC', 1);
                        $categorized->insertBlock($b);
                    }
                }
            }
        }
    }
}

sub _cloneMcdcEntry
{
    my ($cloneInto, $cloneFrom, $missTla, $hitTla, $categorizeExcluded) = @_;
    # see the comment at the first each(%$...Groups) loop: groups() is not
    #   cached, so it has to be hoisted out of the each().
    my $fromGroups = $cloneFrom->groups();
    while (my ($groupKey, $group) = each(%$fromGroups)) {
        foreach my $expr (@$group) {
            foreach my $sense (0, 1) {
                my $count = $expr->count($sense);
                my $excluded =
                    $categorizeExcluded && $expr->is_excluded($sense);
                my $tla =
                    _categorizeIfExcluded($count, $excluded, $missTla, $hitTla);
                $count = [$tla, undef, $count]
                    ;    # [TLA, baseline value, current value]
                $cloneInto->insertExpr('unknownFile', $groupKey,
                                       $sense, $count,
                                       $expr->index(), $expr->expression(),
                                       $excluded);
            }
        }
    }
}

sub _categorizeMcdcCov
{
    my ($self, $filename, $base_data, $current_data, $diffMap, $verbose) = @_;
    my $lineDataMap = $self->lineMap();

    my $mcdcBaseline;
    $mcdcBaseline = $base_data->mcdc() if defined($base_data);
    my $mcdcCurrent = $current_data->mcdc();

    my %mcdcCovLines;
    # look through the 'current' data, to find all the MC/DC data
    # keep track of hit count in baseline, current - in element 2 of the
    #  retained MC/DC data.  These counts are useful - for example, to report
    #  the hit count in the baseline for LBC elements:
    #   - e.g., in random testing: is this branch lost because it was a
    #     low probability event (..baseline count is a small number)>
    #     Or because we did something bad and no longer reach what had been
    #     a high probability event?
    foreach my $line ($mcdcCurrent->keylist()) {
        next if ($line <= 0);    # ignore bogus
        unless (exists($lineDataMap->{$line})) {
            # unless ignored, should have been caught or fixed during
            #  TraceInfo::_checkConsistency
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "\"$filename\":$line line has MC/DC but no linecov data (skipping)."
            );
            next;
        }
        my $data = $lineDataMap->{$line};

        $mcdcCovLines{$line} = 1;
        # we expect that the line number matches...
        $data->lineNo("current", $line, $filename);
        # append this MC/DC data for the line (this is an MCDC_Block)
        my $currMcdcData = $mcdcCurrent->value($line);
        $data->current_mcdc($currMcdcData);
        if (!defined($mcdcBaseline)) {
            my $categorized = MCDC_Block->new($line);
            $data->differential_mcdc($categorized);
            _cloneMcdcEntry($categorized, $currMcdcData, 'UNC', 'GNC', 1);
        }
    }    # foreach line in 'current' branch data

    return unless defined($mcdcBaseline);

    # now look through the baseline to find matching data

    foreach my $base_line ($mcdcBaseline->keylist()) {
        next if ($base_line <= 0);    # ignore bogus
        my $data      = $self->_findLineData($diffMap, $filename, $base_line);
        my $curr_line = $data->lineNo('current');
        my $type      = $data->type();
        if ($type != DiffMap::DELETE) {
            $mcdcCovLines{$curr_line} = 1;
        } else {
            # the line has been deleted...just record the data
            my $deleteKey = "<<<" . $base_line;
            $mcdcCovLines{$deleteKey} = 1;
        }
        my $baseMcdcData = $mcdcBaseline->value($base_line);
        $data->baseline_mcdc($baseMcdcData);
    }    # foreach line in baseline data

    # go through all the MC/DC data for each line, and categorize everything
    foreach my $line (keys(%mcdcCovLines)) {
        my $data        = $self->lineMap()->{$line};
        my $type        = $data->type();
        my $curr        = $data->current_mcdc();
        my $base        = $data->baseline_mcdc();
        my $categorized = MCDC_Block->new($line);
        $data->differential_mcdc($categorized);
        # handle case that baseline and/or current do not contain MC/DC data
        my $currGroups = defined($curr) ? $curr->groups() : ();
        my $baseGroups = defined($base) ? $base->groups() : ();

        if ($type == DiffMap::INSERT) {
            # can get here if diff data vs baseline/current is not consistent
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "baseline MC/DC data should not be defined for inserted line $filename:$line"
            ) if defined($base);
            _cloneMcdcEntry($categorized, $curr, 'UNC', 'GNC', 1);
        } elsif ($type == DiffMap::DELETE) {
            # similarly: get here if diff data vs baseline/current is not consistent
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "current MC/DC data should not be defined for deleted line $filename:$line"
            ) if defined($curr);
            _cloneMcdcEntry($categorized, $base, 'DUB', 'DCB');
        } else {
            lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                      "unexpected MC/DC coverage type $type at $filename:$line")
                if $type != DiffMap::EQUAL;
            # group might or might not be in both baseline and current
            while (my ($groupKey, $bgroup) = each(%$baseGroups)) {
                if (defined($currGroups) && exists($currGroups->{$groupKey})) {
                    my $cgroup = $currGroups->{$groupKey};

                    for (my $i = 0; $i < scalar(@$bgroup); ++$i) {
                        my $b = $bgroup->[$i];
                        my $c = $cgroup->[$i];
                        die("mismatched expressions")
                            unless $b->expression() eq $c->expression();

                        foreach my $sense (0, 1) {
                            my $b_count  = $b->count($sense);
                            my $c_count  = $c->count($sense);
                            my $excluded = $c->is_excluded($sense);
                            my $tla =
                                _categorize($b_count, $c_count, $excluded);
                            $categorized->insertExpr(
                                             'unknownFile', $groupKey,
                                             $sense, [$tla, $b_count, $c_count],
                                             $i, $c->expression(),
                                             $excluded);
                        }
                    }
                } else {
                    # not found in current
                    foreach my $b (@$bgroup) {
                        foreach my $sense (0, 1) {
                            my $b_count = $b->count($sense);
                            my $tla     = $b_count ? 'ECB' : 'EUB';
                            $categorized->insertExpr('unknownFile', $groupKey,
                                                $sense, [$tla, $b_count, undef],
                                                $b->index(), $b->expression());
                        }
                    }
                }
            }    #foreach group in base

            # ..and now the groups which are in 'current' but not in the
            #   baseline - which is every group of a file that is not in the
            #   baseline at all.  Without this, the coverpoints are dropped:
            #   the 'MCF/MCH' totals count them but no TLA bin does, and the
            #   source view shows no MC/DC data for the line.
            #   See the corresponding loop in '_categorizeBranchCov'.
            if (defined($currGroups)) {
                while (my ($groupKey, $cgroup) = each(%$currGroups)) {
                    next
                        if (defined($baseGroups) &&
                            exists($baseGroups->{$groupKey}));
                    foreach my $c (@$cgroup) {
                        foreach my $sense (0, 1) {
                            my $c_count  = $c->count($sense);
                            my $excluded = $c->is_excluded($sense);
                            my $tla =
                                _categorizeIfExcluded($c_count,
                                                      $excluded, 'UIC', 'GIC');
                            $categorized->insertExpr(
                                                'unknownFile', $groupKey,
                                                $sense, [$tla, undef, $c_count],
                                                $c->index(), $c->expression(),
                                                $excluded);
                        }
                    }
                }
            }
        }    # endif deleted line
    }    # foreach line
}

sub _cloneFunctionEntry
{
    my ($cloneInto, $cloneFrom, $missTla, $hitTla) = @_;

    my $hit = $cloneFrom->hit();
    my $tla = (0 == $hit) ? $missTla : $hitTla;
    $cloneInto->setCountDifferential([$hit, $tla]);
    foreach my $alias ($cloneFrom->aliasNames()) {
        $hit = $cloneFrom->alias($alias)->count();
        $tla = (0 == $hit) ? $missTla : $hitTla;
        $cloneInto->addAliasDifferential($alias, [$hit, $tla]);
        # ..and the names it represents - see _mergedNameNote
        $cloneInto->alias($alias)
            ->add_merged(%{$cloneFrom->alias($alias)->merged() // {}});
    }
}

sub _categorizeFunctionCov
{
    my ($self, $filename, $base_data, $current_data, $diffMap, $verbose) = @_;
    die("map should not be defined yet") unless !defined($self->functionMap());
    my $differentialMap = {};
    $self->[FUNCTIONMAP] = $differentialMap;
    my $lineDataMap = $self->lineMap();

    my $funcBase;
    $funcBase = $base_data->func() if defined($base_data);
    my $funcCurrent = $current_data->func();
    # use merged line coverage to categorize function by checking for
    #   edits in function range
    # $lineCovBase and $lineCovCurrent are 'CountData' objects
    #  - of lineNo->hit count
    my $lineCovBase;
    $lineCovBase = $base_data->sum() if defined($base_data);
    my $lineCovCurrent = $current_data->sum();
    # the lines of the multi-line statements of each version:  a line of one
    #   of them is code, though only its first line has a coverpoint
    my $stmtCurrent = $self->[STATEMENTS];
    my $stmtBase    = defined($base_data) ? _statementMap($base_data) : {};

    my %funcCovLines;
    foreach my $key ($funcCurrent->keylist()) {
        my $func = $funcCurrent->findKey($key);
        my $line = $func->line();
        next if ($line <= 0);    # ignore bogus
        my $type = $diffMap->type($filename, $diffMap->NEW, $line);
        $funcCovLines{$line} = 1;
        lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                 "'current' line $filename:$line should not be marked 'delete'")
            if $type == DiffMap::DELETE;
        my $data;
        if (!exists($lineDataMap->{$line})) {
            $data = LineData->new($type);
            $lineDataMap->{$line} = $data;
        } else {
            $data = $lineDataMap->{$line};
            lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                                      "type mismatch " .
                                          $data->type() .
                                          " -> $type for $filename:$line"
            ) unless $data->type() == $type;
        }
        # we expect that the line number matches...
        $data->lineNo("current", $line, $filename);
        # function data for the line
        $data->current_function($func);
        if (!defined($funcBase)) {
            my $name = $func->name();
            my $categorized =
                FunctionEntry->new($name, $funcCurrent,
                                   $line, $func->end_line());
            $differentialMap->{$name} = $categorized;
            $data->differential_function($categorized);
            _cloneFunctionEntry($categorized, $func, 'UNC', 'GNC');
            if ('UNK' eq $data->tla()) {
                # There is a function here but no line coverage data for the
                #   line it starts on, so '_categorizeLineCov' (which ran
                #   before this) left the line's category at its initial 'UNK'
                #   - and 'UNK' is not a key of '%SummaryInfo::tlaLocation', so
                #   counting the line later is an ERROR_UNKNOWN_CATEGORY.  Take
                #   the category from the function, exactly as the baseline path
                #   does at the end of this function.  Reachable input:  a gcov
                #   which does not emit function end lines leaves lcov to derive
                #   them, and an inline or template function then arrives as an
                #   'FN:' record on a line with no 'DA:' record.
                # The count is left alone:  'in_curr' is false for a line with
                #   no line coverage data, which is the only case this arm can
                #   see, and the baseline path likewise sets a count only when
                #   the line is in 'current'.
                my ($hit, $funcTla) = @{$categorized->hit()};
                $data->tla($funcTla);
                $data->curr_count($hit) if $data->in_curr();
            }
        }
    }    # foreach function in current data

    return unless (defined($funcBase));

    # A function is matched to the one which starts at the same line of the
    #   other version.  Two compilers might disagree on which line of an
    #   unchanged declaration is the first line of the function - say,
    #   the return type or the declarator - and then no start line matches.
    # Thus a baseline function which starts on an unchanged line where the
    #   current version doesn't have a function is paired with a current
    #   function of the same kind:
    #     - it starts on an  unchanged line where no baseline function starts,
    #     - has a alias in common, and
    #     - has a range which overlaps the baseline function's range in
    #       current line numbers.
    #       The closest start wins.
    # Whether its body changed is then decided from the diff - the same as
    # any other pair
    my %baseStart;    # current line -> 1 if a baseline function maps there
    my @unpaired;     # [baseline function, current start, current end]
    foreach my $key ($funcBase->keylist()) {
        my $func = $funcBase->findKey($key);
        my $line = $func->line();
        next if ($line <= 0);
        next
            if $diffMap->type($filename, $diffMap->OLD, $line) !=
            DiffMap::EQUAL;
        my $curr_line = $diffMap->lookup($filename, $diffMap->OLD, $line);
        $baseStart{$curr_line} = 1;
        my $end = $func->end_line();
        next
            if (!defined($end) ||
                (exists($lineDataMap->{$curr_line}) &&
                 defined($lineDataMap->{$curr_line}->current_function())));
        push(@unpaired,
             [$func, $curr_line,
              $diffMap->lookup($filename, $diffMap->OLD, $end)
             ]);
    }
    my %paired;    # baseline function start line -> current LineData
    if (@unpaired) {
        my @candidates;
        foreach my $key ($funcCurrent->keylist()) {
            my $func = $funcCurrent->findKey($key);
            my $line = $func->line();
            next
                if ($line <= 0 ||
                    exists($baseStart{$line})   ||
                    !defined($func->end_line()) ||
                    $diffMap->type($filename, $diffMap->NEW, $line) !=
                    DiffMap::EQUAL);
            push(@candidates, [$func, {map({ $_ => 1 } $func->aliasNames())}]);
        }
        foreach my $u (sort { $a->[1] <=> $b->[1] } @unpaired) {
            my ($func, $start, $end) = @$u;
            my $best;
            foreach my $c (@candidates) {
                next unless defined($c);
                my $curr = $c->[0];
                next
                    if ($curr->line() > $end ||
                        $curr->end_line() < $start ||
                        !grep({ exists($c->[1]->{$_}) } $func->aliasNames()));
                $best = $c
                    if (!defined($best) ||
                        abs($curr->line() - $start) <
                        abs($best->[0]->line() - $start));
            }
            next unless defined($best);
            my $curr = $best->[0];
            $paired{$func->line()} = $lineDataMap->{$curr->line()};
            @candidates =
                map({ (defined($_) && $_ != $best) ? $_ : undef } @candidates);
            lcovutil::info(1,
                           $func->name() .
                               " at $filename:" .
                               $func->line() .
                               " is paired with the function at line " .
                               $curr->line() . "\n");
        }
    }

    # look through the baseline to find matching data
    foreach my $key ($funcBase->keylist()) {
        my $func = $funcBase->findKey($key);
        my $line = $func->line();
        next if ($line <= 0);    # ignore bogus
        if (exists($paired{$line})) {
            my $data = $paired{$line};
            # the line of the current function is unchanged, so it has a
            #   baseline line - though maybe no coverpoint there
            $data->lineNo('base',
                          $diffMap->lookup($filename, $diffMap->NEW,
                                           $data->lineNo('current')),
                          $filename) unless defined($data->lineNo('base'));
            $data->baseline_function($func);
            next;
        }
        my $data = $self->_findLineData($diffMap, $filename, $line);

        my $type      = $data->type();
        my $curr_line = $data->lineNo('current');
        if ($type != DiffMap::DELETE) {
            $funcCovLines{$curr_line} = 1;
        } else {
            # the line has been deleted...just record the data
            my $deleteKey = "<<<" . $line;
            $funcCovLines{$deleteKey} = 1;
        }
        $data->baseline_function($func);
    }    # foreach function in baseline data

    # go through function data for each line and categorize...
    foreach my $line (keys %funcCovLines) {
        my $data = $lineDataMap->{$line};
        my $type = $data->type();
        my $curr = $data->current_function();
        my $base = $data->baseline_function();
        my $categorized;
        if (defined($curr)) {
            # also copy the end line
            $categorized = $curr->cloneWithEndLine(1);
        } else {
            # not in current - don't copy end line
            # @todo if needed, could compute where the end line of the deleted
            #  function is now
            $categorized = $base->cloneWithEndLine(0);
        }
        my $name = $categorized->name();
        $differentialMap->{$name} = $categorized;
        $data->differential_function($categorized);

        if (!defined($base)) {
            # either this line was inserted or the line hasn't changed but
            #   wasn't recognized as a function before (e.g., unused template)
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "$filename:$line: unexpected undef baseline function data for deleted $name"
            ) if $type == DiffMap::DELETE;
            _cloneFunctionEntry($categorized,
                                $curr,
                                $type == DiffMap::INSERT ? 'UNC' : 'UIC',
                                $type == DiffMap::INSERT ? 'GNC' : 'GIC');
        } elsif (!defined($curr)) {
            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "$filename:$line: unexpected undef current function data for inserted $name"
            ) if $type == DiffMap::INSERT;
            _cloneFunctionEntry($categorized,
                                $base,
                                $type == DiffMap::DELETE ? 'DUB' : 'EUB',
                                $type == DiffMap::DELETE ? 'DCB' : 'ECB');
        } else {
            lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                   "unexpected function coverage type $type at $filename:$line")
                if $type != DiffMap::EQUAL;
            # if we know end lines for this function, then check if there
            # have been any changes in the function body.  If any changes,
            # then mark GNC or UNC
            my $changed;
            my $end_line = $curr->end_line();

            if (defined($end_line)) {
                # we keep list of functions and branch coverpoints contained
                # in the function - and can report per-function coverage
                # in the function detail view.  Maybe user will prioritize
                # functions which are hit but whose coverage is low
                $changed = 0;
                for (my $line = $curr->line(); $line <= $end_line; ++$line) {
                    # data for this line
                    my $type = $diffMap->type($filename, $diffMap->NEW, $line);

                    # claim a change if the line is new and is source code:
                    # it has a coverpoint, or is part of a multiline
                    # statement which has a coverpoint.
                    # Neither:
                    #  - a blank or comment line outside a statement, or
                    #  - an unchanged line, whether or not it has a
                    #    coverpoint in each version:
                    #      - the source is the same, and a coverpoint which
                    #        only one of the two compilations emitted - say,
                    #       on a closing brace - is an artifact of the
                    #       compiler, not an edit of the body
                    # count as a change.
                    if ($type == DiffMap::INSERT &&
                        (defined($lineCovCurrent->value($line)) ||
                            exists($stmtCurrent->{$line}))
                    ) {
                        $changed = 1;
                        last;
                    }
                }    # end for each current line in current function
                $end_line = $base->end_line();
                if (defined($end_line) && !$changed) {
                    # check for baseline lines which were deleted
                    for (my $bline = $base->line();
                         $bline <= $end_line;
                         ++$bline) {
                        # data for this line
                        my $type =
                            $diffMap->type($filename, $diffMap->OLD, $bline);
                        # claim a change if line is deleted and was code
                        #  before - in the same sense as above
                        if ($type !=
                            DiffMap::EQUAL &&    # line is in old but not in new
                            (defined($lineCovBase->value($bline)) ||
                             exists($stmtBase->{$bline}))
                        ) {
                            $changed = 1;
                            last;
                        }
                    }    # end for each current line in current function
                }
                lcovutil::info(1, "$name body at $filename:$line is changed\n")
                    if ($changed);
            }
            my $tla = _categorize($base->hit(), $curr->hit());
            if (defined($changed) &&
                $changed) {
                if ($tla eq 'UBC') {
                    $tla = 'UNC';
                } elsif ($tla eq 'GBC' ||
                         $tla eq 'CBC') {
                    $tla = 'GNC';
                }    # else is LBC - leave it that way
                lcovutil::info(2,
                            "$name recategorized to $tla at $filename:$line\n");
            }

            $categorized->setCountDifferential([$curr->hit(), $tla]);
            # particular alias may be in both versions
            foreach my $alias ($base->aliasNames()) {
                my $hit = $base->alias($alias)->count();

                my $tla;
                my $currAlias = $curr->alias($alias);
                if (defined($currAlias)) {
                    my $hitCurr = $currAlias->count();
                    $tla = _categorize($hit, $hitCurr);
                    $hit = $hitCurr;
                    # adjust TLA if function range known..
                    if (defined($changed) &&
                        $changed) {
                        if ($tla eq 'UBC') {
                            $tla = 'UNC';
                        } elsif ($tla eq 'GBC' ||
                                 $tla eq 'CBC') {
                            $tla = 'GNC';
                        }    # else is LBC - leave it that way
                        lcovutil::info(2,
                            "$name alias $alias recategorized to $tla at $filename:$line\n"
                        );
                    }
                } else {
                    $tla = (0 == $hit) ? 'EUB' : 'ECB';
                }
                $categorized->addAliasDifferential($alias, [$hit, $tla]);
                # ..representing the aliases merged into it in the version whose
                #   count it shows:  the two are merged each on its own, so they
                #   need not agree, and a name the other version did not merge
                #   is row of its own there
                $categorized->alias($alias)
                    ->add_merged(
                       %{($currAlias // $base->alias($alias))->merged() // {}});
            }
            # now look for aliases that are in current but not in baseline
            foreach my $alias ($curr->aliasNames()) {
                next if defined($base->alias($alias));

                my $hit = $curr->alias($alias)->count();
                my $tla = (0 == $hit) ? "UIC" : "GIC";
                $categorized->addAliasDifferential($alias, [$hit, $tla]);
                $categorized->alias($alias)
                    ->add_merged(%{$curr->alias($alias)->merged() // {}});
            }
        }

        if ('UNK' eq $data->tla()) {
            # there is a function here - but no line - manufacture some data
            my $d = $categorized->hit();
            my ($hit, $funcTla) = @$d;
            $data->tla($funcTla);
            if (defined($base) &&
                $data->in_base()) {
                $data->base_count($base->hit());
            }
            if (defined($curr) &&
                $data->in_curr()) {
                $data->curr_count($hit);
            }
        }
    }
}

sub _findCurrentLineData
{
    # the LineData of a line of the current version, created if that line has no
    #   coverpoint of any other kind.  '_findLineData' is the baseline-side
    #   equivalent, and has to do more work because a baseline line may have been
    #   deleted
    my ($self, $filename, $diffMap, $line) = @_;
    my $lineDataMap = $self->lineMap();
    my $data        = $lineDataMap->{$line};
    return $data if defined($data);

    my $type = $diffMap->type($filename, $diffMap->NEW, $line);
    lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                 "'current' line $filename:$line should not be marked 'delete'")
        if $type == DiffMap::DELETE;
    $data = LineData->new($type);
    $lineDataMap->{$line} = $data;
    $data->lineNo('current', $line, $filename);
    return $data;
}

sub categorizeCallSites
{
    # Categorize the call sites of one file:  answer every site of either version
    #   as a CallgraphSite whose category is set.  This is the 'per file' view
    #   of the metric - the sites contained in this file's functions, which is
    #   what 'FNCF'/'FNCH' count - so it is driven by the FunctionMap of each
    #   version.
    #
    # A free function rather than a method, and it touches no line data, because
    #   it has two callers:  '_categorizeCallgraphCov' below, which attaches the
    #   sites to the lines of one file, and 'categorizeAllCallSites' in the
    #   parent, which runs it for every file for the side effect alone.  That side
    #   effect is 'set_tla' writing each category through to the real 'current'
    #   FunctionEntry, which is where the 'callers of this function' table of a
    #   *different* file reads it from - and that table is written while some
    #   other file is being processed, possibly in a different process.  Nothing
    #   here is order-dependent or destructive, so running it twice is harmless.
    # '$changed' is the set of the current lines of the changed statements -
    #   see 'changedStatementLines'
    my ($filename, $funcBase, $funcCurrent, $diffMap, $changed) = @_;

    # Every site of either version, categorized at the end.  Two passes and then
    #   a third rather than categorizing in place, because a site's category
    #   depends on whether the other version has it
    my @sites;
    # The current sites, indexed for the baseline match by
    #   (caller, current line, column, callee) - deliberately not by the site
    #   key, whose 'ordinal' is a position among the sites at one (line, column)
    #   and so shifts when an edit adds or removes a call there.  Each bucket is
    #   in ordinal order and is paired positionally, which is an exact match in
    #   the ordinary case of one site per (line, column, callee).
    my %currentSites;
    foreach my $key ($funcCurrent->keylist()) {
        my $func   = $funcCurrent->findKey($key);
        my $caller = $func->name();
        foreach my $siteKey ($func->sortedCallSiteKeys()) {
            my ($line, $column, $ordinal, $count, $callee, $siteFile, undef,
                $statement)
                = $func->callSiteData($siteKey);
            # ignore bogus line numbers - already warned about when read
            next if ($line <= 0);
            # the file the line belongs to, which is not '$filename' for a call
            #   written in an '#include'd fragment:  every question below about
            #   what the diff did to the line has to be asked about that file
            my $where = defined($siteFile) ? $siteFile : $filename;
            my $site =
                CallgraphSite->new($line, $column, $ordinal, $callee,
                                   $caller, undef, $count, undef,
                                   $func, undef, $siteFile,
                                   defined($siteFile) ? $func->line() :
                                                     $statement // $line);
            push(@sites, $site);
            # ..and into the bucket the baseline side looks its own sites up in
            my $bucket = "$where:$line:$column:$callee";
            push(@{$currentSites{$caller}->{$bucket}}, $site);
        }
    }

    if (defined($funcBase)) {
        foreach my $key ($funcBase->keylist()) {
            my $func   = $funcBase->findKey($key);
            my $caller = $func->name();
            foreach my $siteKey ($func->sortedCallSiteKeys()) {
                my ($line, $column, $ordinal, $count, $callee, $siteFile,
                    undef, $statement)
                    = $func->callSiteData($siteKey);
                # ignore bogus line numbers, as on the current side
                next if ($line <= 0);
                # ..the file the line is in, as on the current side above - but
                #   spelled the way the current version spells it, since that is
                #   the name the diff is keyed by and the name the current sites
                #   above are bucketed under.  The two spellings differ when the
                #   diff renames the file the call is written in, and a site
                #   which went looking for the baseline's name would find no
                #   diff data and no bucket:  every site would read as inserted
                #   code
                my $siteIn =
                    defined($siteFile) ?
                    $diffMap->current_file_name($siteFile) :
                    undef;
                my $in   = defined($siteIn) ? $siteIn : $filename;
                my $type = $diffMap->type($in, $diffMap->OLD, $line);
                my $matched;

                if ($type != DiffMap::DELETE &&
                    exists($currentSites{$caller})) {
                    my $mapped = $diffMap->lookup($in, $diffMap->OLD, $line);
                    my $bucket =
                        $currentSites{$caller}->{"$in:$mapped:$column:$callee"};
                    $matched = shift(@$bucket) if defined($bucket) && @$bucket;
                }
                if (defined($matched)) {
                    $matched->set_base_count($count);
                } else {
                    # A site the baseline has and the current version does not.
                    #   It is shown where the code that made the call was:  on
                    #   the baseline line itself if that line was deleted (the
                    #   source view recreates the baseline text for a deleted
                    #   region), and otherwise on the surviving current line
                    my $where =
                        $type == DiffMap::DELETE ? $line :
                        $diffMap->lookup($in, $diffMap->OLD, $line);
                    # ..and the line of *this* file it is counted on, which for a
                    #   site written elsewhere is where its caller was.  A
                    #   baseline line, like BASE_LINE beside it:  the attachment
                    #   goes through '_findLineData', which is what maps it
                    # ..carrying the current spelling of the file it is written
                    #   in, as the match above used:  the categorization below
                    #   asks the diff about it again, and the page which displays
                    #   it is the current one
                    push(@sites,
                         CallgraphSite->new($where,
                                            $column,
                                            $ordinal,
                                            $callee,
                                            $caller,
                                            $count,
                                            undef,
                                            undef,
                                            undef,
                                            $line,
                                            $siteIn,
                                            defined($siteIn) ? $func->line() :
                                                $statement // $line));
                }
            }
        }
    }

    # ..and now categorize.  The arms are the ones '_categorizeLineCov' uses for
    #   a line, because a call site is a point on one line:  unlike a function,
    #   it has no body whose edits could recategorize it.  Only the statement
    #   it is written in can - as it does the line's own coverpoint
    foreach my $site (@sites) {
        # a count of '-' - the call is there and its count is not known, see
        #   FunctionEntry::SITE_COUNT - reads as 0 here, which is what
        #   'BranchElement::count' does for a branch which was never evaluated.
        #   There is no category for "unknown", and of the two which exist the
        #   only honest one is the not-hit one:  the marker is kept for display,
        #   which is where the difference can actually be told to the reader
        my $base = $site->base_count();
        my $curr = $site->curr_count();
        $base = lcovutil::site_count_value($base) if defined($base);
        $curr = lcovutil::site_count_value($curr) if defined($curr);
        # ..and the questions about the diff are about the file the site's line
        #   belongs to, which is not this file for a site written elsewhere
        my $in = defined($site->file()) ? $site->file() : $filename;
        my $tla;
        if (defined($curr)) {
            if (defined($base)) {
                $tla = _categorize($base, $curr);
            } elsif (!defined($funcBase) ||
                     $diffMap->type($in, $diffMap->NEW, $site->line()) ==
                     DiffMap::INSERT) {
                $tla = $curr ? 'GNC' : 'UNC';
            } else {
                $tla = $curr ? 'GIC' : 'UIC';
            }
            # a site of this file, written in a changed statement
            $tla = $changedStatementTla{$tla}
                if (defined($changed) &&
                    !defined($site->file())   &&
                    $changed->{$site->line()} &&
                    exists($changedStatementTla{$tla}));
        } else {
            # ..a deleted category if the line the site is attached to was
            #   deleted, too:  that is a deleted record (see '_findLineData'),
            #   whose category is not one of the current version.  The site's
            #   own line need not be deleted with it - a call on an unchanged
            #   later line of a statement whose first line was edited, or one
            #   in an '#include'd fragment called from a deleted function
            my $deleted =
                $diffMap->type($in, $diffMap->OLD, $site->base_line()) ==
                DiffMap::DELETE;
            $deleted ||=
                $diffMap->type($filename, $diffMap->OLD, $site->home_line()) ==
                DiffMap::DELETE;
            $tla = $deleted ? ($base ? 'DCB' : 'DUB') : ($base ? 'ECB' : 'EUB');
        }
        # 'set_tla' also stores the category on the real 'current' FunctionEntry -
        #   see the header comment.  A baseline-only site has no current record to
        #   store it on, and so does not appear in that table:  it is counted and
        #   displayed by the file it belongs to
        $site->set_tla($tla);
    }
    return @sites;
}

sub _categorizeCallgraphCov
{
    # Attach this file's categorized call sites to the lines they are displayed
    #   on.  The 'per function' view (which functions call this one) is cross-file
    #   and has no per-file baseline to compare against; it reads the categories
    #   which 'categorizeCallSites' stored.
    my ($self, $filename, $base_data, $current_data, $diffMap, $verbose,
        $changed)
        = @_;

    my $funcBase;
    $funcBase = $base_data->func() if defined($base_data);

    print("categorize call sites $filename\n")
        if ($verbose);

    foreach my $site (categorizeCallSites($filename, $funcBase,
                                          $current_data->func(), $diffMap,
                                          $changed
    )) {
        # a baseline-only site is looked up with the line it was read from, since
        #   that is the side of the diff the lookup has to start on - and a
        #   deleted line has no current line to be keyed by at all
        # ..and the line is always one of *this* file, which for a site written
        #   in another file is not the line the site is on - see
        #   CallgraphSite::HOME_LINE
        my $data =
            defined($site->curr_count()) ?
            $self->_findCurrentLineData($filename, $diffMap, $site->home_line())
            :
            $self->_findLineData($diffMap, $filename, $site->home_line());
        $data->add_call_site($site);
        lcovutil::info(2,
                       "  call site " .
                           $site->caller() . ' -> ' .
                           $site->callee() . ' at '
                           .
                           (defined($site->file()) ? $site->file() : $filename
                           ) .
                           ':' .
                           $site->line() . ' is ' .
                           $site->tla() . "\n");
    }

    # the sites of one line, in source order:  'categorizeCallSites' answered
    #   them in whatever order the FunctionMap iterated
    my $lineDataMap = $self->lineMap();
    foreach my $data (values(%$lineDataMap)) {
        next unless $data->num_call_sites();
        $data->sort_call_sites() if $data->num_call_sites() > 1;
        next unless 'UNK' eq $data->tla();
        # A call site on a line with no coverpoint of any other kind, so
        #   '_findCurrentLineData' above created the line and left it at its
        #   initial 'UNK' - which is not a key of '%SummaryInfo::tlaLocation',
        #   making the line an ERROR_UNKNOWN_CATEGORY when it is counted.  Take
        #   the category from the first site on the line, exactly as the function
        #   path in '_categorizeFunctionCov' takes it from the function.
        # Reachable input:  an '.info' whose line records were filtered away
        #   while its 'FNC:' records were kept - which is what a capture by a
        #   version of this tool older than the filter fix looks like - or any
        #   other producer of a call on a line it emits no 'DA:' for.  A capture
        #   by this version does not have it:  a line with a call site is not a
        #   line the filters remove
        my @sites = $data->call_sites();
        $data->tla($sites[0]->tla());
    }
}

package DiffMap;

# @todo Could convert this use a callback API - similar to annotate, etc.
#  that would be more consistent and might execute faster.

use constant {
              LINEMAP  => 0,
              FILEMAP  => 1,
              BASELINE => 2,
              # keep track of line number where file entry is found in diff file
              #   - use line number in error messages.
              DIFF_FILENAME => 3,
              LOCATION      => 4,
              UNCHANGED     => 5,
              ALIASES       => 6,
              DIFF_ROOT     => 7,
              # old_filename->new_filename, for the files the diff renames
              RENAMED => 8,
              # the names used by the 'current' coverage data, and the diff
              #   entries indexed by basename - see 'baselineSource'
              CURRENT   => 9,
              BASENAMES => 10,

              OLD  => 0,
              NEW  => 1,
              TYPE => 2,

              _START => 0,
              _END   => 1,
};

sub new
{
    my $class = shift;
    # every slot has to be initialized here:  'findName' is called for every
    #   file in the report, whether a diff was read or not, and 'lc(undef)' -
    #   unlike the '.=' the case-sensitive arm uses - warns
    my $self = [{},          # linemap
                {},          # filemap: new_filename->old_filename
                {},          # baseline: filename -> baseline lineno -> text
                undef,       # diff filename
                [{}, {}],    # def location
                             # element 0: old filename -> line number where this
                             #             entry starts
                             # element 1: new filename -> line number
                {},          # unchanged
                {},          # aliases
                Cwd::cwd(),  # diff root: default, overridden by the diff's
                             #   'Git Root:' comment - and not '$main::cwd',
                             #   which is not set until after this constructor
                             #   has run
                {},          # renamed: old_filename->new_filename
                {},          # current: the names the 'current' data uses
                {}           # basenames: basename->[diff entry, ..]
    ];
    bless $self, $class;
    return $self;
}

sub load
{
    my ($self, $path, $info, $buildDirs) = @_;
    $self->_read_udiff($path);

    # the names the 'current' coverage data uses, and the diff entries indexed
    #   by basename:  'baselineSource' needs both, to decide whether a baseline
    #   file whose name is not in the diff is nevertheless described by it.
    #   'check_path_consistency' makes the same decision for the categorization
    #   - but not until after the baseline source has been read.
    $self->[CURRENT]   = {};
    $self->[BASENAMES] = {};
    if (defined($info)) {
        foreach my $f ($info->files()) {
            $self->[CURRENT]->{$lcovutil::case_insensitive ? lc($f) : $f} = 1;
        }
    }
    foreach my $d (keys(%{$self->[LINEMAP]})) {
        push(@{$self->[BASENAMES]->{File::Basename::basename($d)}}, $d);
    }

    # find list of soft links in [buildDirs] which may point to files in $info
    #  we need to keep all the aliases as there may be files in baseline
    #  which are not in current
    if (@$buildDirs) {
        my @stack = @$buildDirs;
        while (@stack) {
            my $dir = pop(@stack);
            die("unexpected non-directory '$dir'") unless -d $dir;
            $dir = File::Spec->catdir($main::cwd, $dir)
                unless File::Spec->file_name_is_absolute($dir);

            opendir(my $dh, $dir) or die("can't open directory $dir: $!");
            while (my $entry = readdir($dh)) {
                next if $entry eq '.' || $entry eq '..';
                my $path = File::Spec->catfile($dir, $entry);
                if (-d $path) {
                    push(@stack, $path);
                } elsif (-l $path) {
                    my $l = Cwd::realpath($path);
                    next if (!-e $l || TraceFile::skipCurrentFile($l));
                    # may need to turn $l into relative path??
                    $self->[ALIASES]->{$path} = $l if (-f $l);
                    #lcovutil::info("add alias '$path' -> '$l'\n");
                    # really, this should be a file...
                    die("unexpected soft link $path to directory")
                        unless -f $l;
                }
                # else just ignore file entry
            }
            closedir($dh);
        }
    }
    return $self;
}

sub empty
{
    my $self = shift;
    return !scalar(%{$self->[LINEMAP]});
}

sub findName
{
    my ($self, $file) = @_;
    my $f = $lcovutil::case_insensitive ? lc($file) : $file;
    $f = $self->[ALIASES]->{$f} if exists($self->[ALIASES]->{$f});

    if (File::Spec->file_name_is_absolute($f) &&
        !exists($self->[LINEMAP]->{$f})) {
        my $p =
            $lcovutil::case_insensitive ?
            lc($self->[DIFF_ROOT]) :
            $self->[DIFF_ROOT];
        $p .= $lcovutil::dirseparator;
        my $l = length($p);
        if (length($f) > $l &&
            $p eq substr($f, 0, $l)) {
            my $s = substr($f, $l);
            if (exists($self->[LINEMAP]->{$s})) {
                $f = $s;
            } elsif (exists($self->[ALIASES]->{$s})) {
                $f = $self->[ALIASES]->{$s};
            }
        }
    }
    return $f;
}

sub containsFile
{
    my ($self, $file) = @_;
    $file = $self->findName($file);
    return exists($self->[LINEMAP]->{$file});
}

sub baselineSource
{
    # The baseline text of $filename has to be recreated out of the patch when
    #   the diff describes the file.  Return the name the diff data is filed
    #   under, together with the name to read the current source from - or the
    #   empty list, when the diff says nothing about this file.
    # The two names are not always the baseline's own:  a rename files the
    #   chunks under the new name, and '--elide-path-mismatch' says that a diff
    #   entry whose basename matches IS this file.  Recreating the baseline out
    #   of the wrong entry - or, worse, silently handing back the CURRENT text
    #   as the baseline's - makes every filter and every exclusion marker see
    #   the wrong source.
    my ($self, $filename) = @_;

    my $f   = $lcovutil::case_insensitive ? lc($filename) : $filename;
    my $key = $self->findName($filename);
    return () if exists($self->[UNCHANGED]->{$key});
    if (!exists($self->[LINEMAP]->{$key})) {
        if (exists($self->[RENAMED]->{$key})) {
            # the diff renames the file:  the baseline knows it by the old name
            $key = $self->[RENAMED]->{$key};
        } else {
            # 'check_path_consistency' additionally requires the file to be
            #   missing from both .info files, which it cannot know here:  the
            #   baseline is what is being read.  It does not need to be that
            #   strict - a diff entry which no 'current' file claims is the
            #   only candidate either way.
            return () unless $main::elide_path_mismatch;
            my $candidates =
                $self->[BASENAMES]->{File::Basename::basename($key)};
            return () unless defined($candidates);
            my @unused = grep(!exists($self->[CURRENT]->{$_}), @$candidates);
            return () unless 1 == scalar(@unused);
            $key = $unused[0];
        }
    }
    # read the current text under the name the 'current' coverage data uses:
    #   the name in hand is the baseline's, which need not exist any more, and
    #   the diff's spelling of an elided path need not exist at all
    return ($key, exists($self->[CURRENT]->{$f}) ? $filename : $key);
}

sub recreateBaseline
{
    my ($self, $filename, $currentSrcLines, $key) = @_;

    # $key is the name the diff data is filed under, which is not necessarily
    #   the baseline's own name - see 'baselineSource'
    $key = $self->findName($filename) unless defined($key);
    my $diffs  = $self->[LINEMAP]->{$key};
    my $lineNo = $self->[LOCATION]->[NEW]->{$key};
    my $location =
        $self->[DIFF_FILENAME] . (defined($lineNo) ? ":$lineNo" : '');
    my $also = $key eq $filename ? '' : " (as '$key')";
    unless (defined($diffs)) {
        # the only caller - ReadBaselineSource::open - passes the name which
        #   'baselineSource' found in the diff data
        # LCOV_UNREACHABLE_START
        lcovutil::ignorable_error(
                       $lcovutil::ERROR_PATH,
                       "no 'diff' data for baseline file '$filename'$also in " .
                           $self->[DIFF_FILENAME] .
                           ": treating the file as unchanged");
        # message ignored:  the best we can do is use the current text
        return $currentSrcLines;
        # LCOV_UNREACHABLE_STOP
    }

    # the deleted text is filed under the name the diff's '---' line used, which
    #   is not the name the chunks are filed under when the file was renamed
    my $baseName = $self->baseline_file_name($key);
    my $deleted  = $self->[BASELINE]->{$baseName};
    my @lines;
    my $didWarn = 0;
    # the last line of the current file which some chunk accounted for:  a
    #   unified diff says nothing at all about the text after its last hunk, so
    #   the chunk list stops there - see 'lookup' and 'type', which treat a line
    #   past the last chunk as unchanged.  We have to do the same, below.
    my $lastCurrent = 0;
    foreach my $chunk (@$diffs) {
        $lastCurrent = $chunk->[NEW]->[_END]
            if $chunk->[NEW]->[_END] > $lastCurrent;
        if ($chunk->[TYPE] == EQUAL) {
            my ($from, $to) = @{$chunk->[NEW]};
            my $f = $from - 1;
            my $t = $to - 1;
            if ($t <= $#$currentSrcLines) {
                push(@lines, @{$currentSrcLines}[$f .. $t]);
            } else {
                lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                    "$filename: inconsistent diff data vs current source code: diff refers to 'current' line range [$f:$t] but source code has only "
                        . scalar(@$currentSrcLines)
                        . " lines")
                    unless $didWarn;
                $didWarn = 1;
                # if error is ignored, then append up to the data we have
                while ($f <= $#$currentSrcLines) {
                    push(@lines, $currentSrcLines->[$f++]);
                }
            }
        } elsif ($chunk->[TYPE] == DiffMap::DELETE) {
            my $r = $chunk->[OLD];
            for (my $i = $r->[_START]; $i <= $r->[_END]; ++$i) {
                unless (defined($deleted) && exists($deleted->{$i})) {
                    # every line of a DELETE chunk is a '-' line, whose text
                    #   was filed under the '---' name which 'baseline_file_name'
                    #   returns.  The one name which breaks that - the alias
                    #   'check_path_consistency' adds for an elided path - is
                    #   made after the baseline has been read
                    # LCOV_UNREACHABLE_START
                    lcovutil::ignorable_error(
                        $lcovutil::ERROR_INCONSISTENT_DATA,
                        "$location: no baseline text for line $i of '$baseName'"
                            .
                            ($baseName eq $filename ? '' :
                                 " (baseline of '$filename')") .
                            ": do the diff's '---' and '+++' names differ?");
                    # message ignored:  keep the line numbering intact - every
                    #   line after this one would otherwise shift
                    push(@lines, '');
                    next;
                    # LCOV_UNREACHABLE_STOP
                }
                my $d = $deleted->{$i};
                die("undef deleted line $filename:$i") unless defined($d);
                push(@lines, $d);
            }
        }
        # else 'insert':  nothing to do/those lines are not in baseline
    }
    # everything after the last hunk is identical in the two versions, so the
    #   tail of the current file is the tail of the baseline.  Without this, the
    #   recreated baseline ended at the last hunk:  every exclusion marker after
    #   that point was missed and every baseline coverage point past it was
    #   reported as an out-of-range (ERROR_RANGE) line - which is what a
    #   differential report against a baseline whose last change is not at the
    #   end of the file looks like.
    push(@lines, @{$currentSrcLines}[$lastCurrent .. $#$currentSrcLines])
        if $lastCurrent <= $#$currentSrcLines;
    return \@lines;
}

sub _findChunk
{
    my ($lineMap, $vers, $line, $filename) = @_;
    my $notThis = $vers == OLD ? INSERT : DELETE;
    # LCOV_EXCL_START
    my $linearSearch = sub {
        my $idx = 0;
        while ($idx <= $#$lineMap) {
            my $chunk = $lineMap->[$idx];
            my $v     = $chunk->[$vers];
            last
                if ($v->[_START] <= $line &&
                    $line <= $v->[_END] &&
                    $chunk->[TYPE] != $notThis);
            ++$idx;
        }
        return $idx;
    };
    # LCOV_EXCL_STOP

    # might be marginally faster to use linear search up to some small
    #   list size threshold...maybe 5 or 10?
    my $max = $#$lineMap;
    my $min = 0;
    my $mid;
    while (1) {
        $mid = int(($max + $min) / 2);
        my $chunk = $lineMap->[$mid];
        my $d     = $chunk->[$vers];
        if ($line < $d->[_START]) {
            $max = $mid;
        } elsif ($line > $d->[_END]) {
            $min = $mid;
        } else {
            # this entry is in range - match is either this one
            #  or the one on one side or the other.
            # There are at most 2 entries for any particular line -
            #  and there are two only if this is the insert or delete point
            if ($chunk->[TYPE] != $notThis) {
                die("bad lookup")
                    unless (!$lcovutil::debug ||
                            $mid == &$linearSearch());
                return $chunk;
            }
            # is it one side or the other?
            die("unexpectedly at beginning") if $mid == 0;
            my $prev = $lineMap->[$mid - 1];
            my $pd   = $prev->[$vers];
            if ($pd->[_END] >= $line) {
                die("unexpected prev element")
                    unless ($pd->[_START] <= $line &&
                            $prev->[TYPE] != $notThis);
                die("bad lookup 2")
                    unless (!$lcovutil::debug ||
                            $mid - 1 == &$linearSearch());
                return $prev;
            }
            if ($mid == $#$lineMap) {
                # we are at last element
                die("wrong place")
                    unless (!$lcovutil::debug ||
                            &$linearSearch() == $#$lineMap + 1);
                return undef;
            }
            my $next = $lineMap->[$mid + 1];
            my $nd   = $next->[$vers];
            die("expected 'next' to match but did not")
                unless ($nd->[_START] <= $line &&
                        $nd->[_END] >= $line &&
                        $next->[TYPE] != $notThis);
            die("bad lookup 3")
                unless (!$lcovutil::debug ||
                        $mid - 1 == &$linearSearch());
            return $next;
        }
        my $diff = $max - $min;
        if ($diff <= 1) {
            $mid = $min;
            $mid = $max
                if $line > $lineMap->[$min]->[$vers]->[_END];
            last;
        }
    }
    my $chunk = $lineMap->[$mid];
    my $d     = $chunk->[$vers];
    if ($d->[_START] <= $line &&
        $d->[_END] >= $line) {
        if ($chunk->[TYPE] != $notThis) {
            die("bad lookup 4")
                unless (!$lcovutil::debug ||
                        $mid == &$linearSearch());
            return $chunk;
        }
        if ($mid <= $#$lineMap) {
            # we aren't at the last element in the list
            my $next = $lineMap->[$mid + 1];
            my $nd   = $next->[$vers];
            if ($nd->[_START] <= $line &&
                $nd->[_END] >= $line &&
                $next->[TYPE] != $notThis) {
                die("wrong lookup")
                    unless (!$lcovutil::debug ||
                            $mid + 1 == &$linearSearch());
                return $next;
            }
        }
    }
    die("didn't find element for $filename:$line: $#$lineMap")
        unless (!$lcovutil::debug ||
                $#$lineMap + 1 == &$linearSearch());
    return undef;
}

sub lookup
{
    # given line in OLD or NEW version, return corresponding line in the
    # other.
    #  $vers == OLD if $line is in OLD (ie., we are looking for NEW
    #     and
    #  $vers == NEW if $line is in NEW and we are looking for line number in OLD

    my ($self, $file, $vers, $line) = @_;

    $file = $self->findName($file);

    if (!exists($self->[LINEMAP]->{$file})) {
        #mapping is identity when no diff was read
        return $line;
    }

    # search from end of list to find last chunk which starts before this line
    my $lineMap = $self->[LINEMAP]->{$file};
    my $chunk   = _findChunk($lineMap, $vers, $line, $file);
    my $alt     = ($vers == OLD) ? NEW : OLD;
    my $c;
    if (defined($chunk)) {
        my $delta = $line - $chunk->[$vers]->[_START];
        $c = $chunk->[$alt]->[_START] + $delta;
        $c += $chunk->[TYPE] == DiffMap::DELETE;
    } else {
        # this element is past the last chunk
        my $v     = $lineMap->[-1];
        my $delta = $line - $v->[$vers]->[_END];
        $c = $v->[$alt]->[_END] + $delta;
    }
    return $c;
}

sub type
{
    my ($self, $file, $vers, $line) = @_;

    $file = $self->findName($file);

    if (!defined($self->[LINEMAP]->{$file})) {
        #mapping is identity when no diff was read
        if (defined($main::show_tla) &&
            (@main::base_filenames ||
                $main::diff_filename)
        ) {
            return DiffMap::EQUAL;    # categories will be "GIC", "UIC"
        } else {
            return DiffMap::INSERT;    # categories will be "GNC", "UNC"
        }
    }

    if (!defined($self->[FILEMAP]->{$file})) {
        #mapping with no filemap when baseline file was deleted
        return DiffMap::DELETE;
    }
    my $lineMap = $self->[LINEMAP]->{$file};
    my $chunk   = _findChunk($lineMap, $vers, $line, $file);
    # '$line' is past the end of the last chunk in the diff -
    #   all the lines which weren't mentioned must be equal
    return EQUAL unless defined($chunk);

    die("DiffMap::type(): got undef type at $file, $vers, $line")
        unless defined($chunk->[TYPE]);
    return $chunk->[TYPE];
}

sub find_deleted_line_leader
{
    my ($self, $filename, $base_lineNo) = @_;

    # find the 'delete' chunk which contains this line -
    #   - the line number of the leader in the baseline is the line
    #     immediately before the first line in the chunk (in the 'OLD'
    #     section
    #   - the line number of the leader in the current file is the
    #     first line in the 'NEW' section of this chunk.
    #       - we expect the 'NEW' begin and end lines are the same
    #       - we also expect the leader to be the 'end' line of the
    #         'NEW' section in the previous chunk.

    my $file    = $self->findName($filename);
    my $lineMap = $self->[LINEMAP]->{$file};
    # there must be a lineMap, if we have a deleted line
    die("lineMap must exist $filename:$base_lineNo") unless defined($lineMap);

    my $chunk = _findChunk($lineMap, OLD, $base_lineNo, $filename);
    # should not fall off end of 'diff' - there must be a 'delete' chunk
    die("missing 'delete' chunk in diff $filename:$base_lineNo")
        unless defined($chunk);
    die("unexpected chunk $filename:$base_lineNo")
        unless ($chunk->[TYPE] == DELETE &&
                $chunk->[NEW]->[_START] == $chunk->[NEW]->[_END]);
    return $chunk->[NEW]->[_START];
}

sub compute_deleted_lines
{
    my ($self, $filename) = @_;
    my $file    = $self->findName($filename);
    my $lineMap = $self->[LINEMAP]->{$file};
    return undef unless defined($lineMap);
    my %hash;
    foreach my $chunk (@$lineMap) {
        next unless $chunk->[TYPE] == DELETE;
        $hash{$chunk->[NEW]->[_START]} = $chunk->[OLD];
    }
    return %hash ? \%hash : undef;
}

sub baseline_file_name
{
    # file may have been moved between baseline and current...
    my ($self, $current_name) = @_;

    my $key = $self->findName($current_name);
    if (exists($self->[FILEMAP]->{$key})) {
        return $self->[FILEMAP]->{$key};
    }
    return $current_name;
}

sub current_file_name
{
    # ..and the other direction:  the name the 'current' version of a file the
    #   baseline calls '$baseline_name' is known by, which is the name every
    #   other method here takes - the chunks of a file the diff renames are
    #   filed under its new name (see 'baselineSource').  The name itself when
    #   the diff does not rename it, which is the ordinary case, and also when
    #   the file is gone in the current version:  a deleted file has no current
    #   name, and answering its own is what leaves 'type' free to say DELETE.
    # Wanted where a name out of the baseline data has to be matched against one
    #   out of the current data:  a per-file lookup can go through
    #   'baseline_file_name' instead, but the file a *call site* is written in is
    #   recorded in each version's own spelling - see 'categorizeCallSites'
    my ($self, $baseline_name) = @_;

    my $key = $self->findName($baseline_name);
    return exists($self->[RENAMED]->{$key}) ? $self->[RENAMED]->{$key} :
        $baseline_name;
}

sub files
{
    my $self = shift;
    return keys(%{$self->[FILEMAP]});
}

sub dump_map
{
    my $self = shift;
    foreach my $file (keys %{$self->[FILEMAP]}) {
        my $currfile =
            defined($self->[FILEMAP]->{$file}) ? $self->[FILEMAP]->{$file} :
            "[deleted]";
        printf("In $file (was: $currfile):\n");
        foreach my $chunk (@{$self->[LINEMAP]->{$file}}) {
            _printChunk($chunk);
        }
    }
    return $self;
}

sub check_version_match
{
    my ($self, $baseline, $current) = @_;
    return unless $lcovutil::versionCallback;

    # skip files which were dropped (no longer in project) or were
    #  just added to the project (was not in the baseline - so we aren't
    #  looking for differences.
    foreach my $curr ($current->files()) {
        next unless $baseline->file_exists($curr);
        my $currData     = $current->data($curr);
        my $curr_version = $currData->version();
        my $baseData     = $baseline->data($curr);
        my $base_version = $baseData->version();

        # silently compare version...
        my $versionMatch =
            lcovutil::checkVersionMatch($curr, $base_version, $curr_version,
                                        "diff entry compare", 1);
        if ($self->containsFile($curr)) {
            # file is in 'diff' data:  we expect the version to be different
            #   between baseline/current
            if ($versionMatch) {
                lcovutil::ignorable_error(
                               $lcovutil::ERROR_INCONSISTENT_DATA,
                               "File \"$curr\" appears in 'diff' data file '" .
                                   $self->[DIFF_FILENAME] .
                                   "' but 'baseline' and 'current' versions '" .
                                   ($curr_version ? $curr_version : '<undef>') .
                                   "' match");
            }
        } else {
            # not in 'diff':  we expect the versions to be identical
            if (!$versionMatch) {
                lcovutil::ignorable_error(
                              $lcovutil::ERROR_INCONSISTENT_DATA,
                              "File \"$curr\" version changed from '" .
                                  ($base_version ? $base_version : '<undef') .
                                  "' to '" .
                                  ($curr_version ? $curr_version : '<undef>') .
                                  "' but file not found in 'diff' data file '" .
                                  $self->[DIFF_FILENAME] . "'.");
            }
        }
    }
}

sub check_path_consistency
{
    # check that paths which appear in diff also appear in baseline or current
    #  .info files - if not, then there is likely a path consistency issue
    # $baseline and $current are both TraceFile structs -
    # return 0 if inconsistency found

    my ($self, $baseline, $current) = @_;
    (ref($baseline) eq 'TraceFile' && ref($current) eq 'TraceFile') or
        die("wrong arg types");

    # check that files which are in both baseline and current and are NOT
    # in the 'diff' data have the same version.
    # That is:  files whose version differs should appear in the diff data
    $self->check_version_match($baseline, $current);

    my %diffMap;        # current_filename -> where_used
    my %diffBaseMap;    # current_directory -> []
                        # for every 'current' filename in the udiff file
    foreach my $f ($self->files()) {
        $diffMap{$f} = 0;    # this file not used in baseline or current (yet)
        my $b = File::Basename::basename($f);
        $diffBaseMap{$b} = [[], {}]
            unless exists($diffBaseMap{$b});
        push(@{$diffBaseMap{$b}->[0]}, $f);
    }
    # foreach unchanged file in udiff data
    foreach my $f (keys %{$self->[UNCHANGED]}) {
        # unchanged in baseline and current
        $diffMap{$f} = 3;
    }
    my %missed;
    # for each file in 'current' info:
    foreach my $curr ($current->files()) {
        my $b = File::Basename::basename($curr);
        if ($self->containsFile($curr)) {
            my $alias =
                exists($self->[ALIASES]->{$curr}) ? $self->[ALIASES]->{$curr} :
                $curr;
            $diffMap{$alias} |= 1;    # used in current
            $diffBaseMap{$b}->[1]->{$alias} = 0
                unless exists($diffBaseMap{$b}->[1]->{$alias});
            ++$diffBaseMap{$b}->[1]->{$alias};
        } elsif (!exists($self->[UNCHANGED]->{$self->findName($curr)})) {
            $missed{$curr} = 1;       # in current but not in diff
        }
    }
    # for each file in 'baseline' info:
    foreach my $base ($baseline->files()) {
        my $b = File::Basename::basename($base);
        if ($self->containsFile($base)) {
            my $alias =
                exists($self->[ALIASES]->{$base}) ? $self->[ALIASES]->{$base} :
                $base;
            $diffMap{$alias} |= 2;    # used in baseline
            $diffBaseMap{$b}->[1]->{$alias} = 0
                unless exists($diffBaseMap{$b}->[1]->{$alias});
            ++$diffBaseMap{$b}->[1]->{$alias};
        } elsif (!exists($self->[UNCHANGED]->{$self->findName($base)})) {
            # in baseline but not in diff
            if (exists($missed{$base})) {
                $missed{$base} |= 2;
            } else {
                $missed{$base} = 2;
            }
        }
    }
    my $ok = 1;
    foreach my $f (sort keys(%missed)) {
        my $b = File::Basename::basename($f);
        next unless exists($diffBaseMap{$b});

        # this basename is in the diff file and didn't match any other
        #   trace filename entry (i.e., same filename in more than one
        #   source code directory) - then warn about possible pathname issue
        my ($diffFiles, $sourceFiles) = @{$diffBaseMap{$b}};
        # find the files which appear in the 'diff' list which have the
        #   same basename and were not matched - those might be candidates
        my @unused;
        for my $d (@$diffFiles) {
            # my $location = $self->[DIFF_FILENAME] . ':' . $self->[LOCATION]->[NEW]->{$d};
            push(@unused, $d)
                unless exists($sourceFiles->{$d});
        }
        next unless @unused;

        # my $baseData = $baseline->data($f);
        # my $baseLocation = join(":", ${$baseData->location()});
        # my $currData = $current->data($f);
        # my $currLocation = join(":", ${$currData->location()});

        my $type;
        if (2 == $missed{$f}) {
            $type = "baseline";
        } elsif (1 == $missed{$f}) {
            $type = "current";
        } else {
            $type = "both baseline and current";
        }
        my $single = 1 == scalar(@unused);
        # @todo could print line numbers in baseline, current .info files and
        #   in diff file ..
        if (lcovutil::warn_once($lcovutil::ERROR_MISMATCH, $f)) {
            my $suffix =
                $main::elide_path_mismatch ? ' (elided)' :
                lcovutil::explain_once(
                'elide-path-mismatch',
                '  Perhaps see "--elide-path-mismatch", "--substitute" and "--build-directory" options in \'man '
                    . $lcovutil::tool_name . '\'');
            lcovutil::ignorable_warning(
                                       $lcovutil::ERROR_MISMATCH,
                                       "source file '$f' (in $type .info file" .
                                           ($missed{$f} == 3 ? "s" : "") .
                                           ") has same basename as 'diff' "
                                           .
                                           ($single ? 'entry ' : "entries:\n\t"
                                           ) .
                                           "'" .
                                           join("'\n\t", @unused) .
                                           "' - but a different path." .
                                           ($single ? "  " : "\n\t") .
                                           'Possible pathname mismatch?' .
                                           $suffix);
        }
        if ($main::elide_path_mismatch &&
            $missed{$f} == 3 &&
            $single) {
            $self->[FILEMAP]->{$f} = $f;
            $self->[LINEMAP]->{$f} = $self->[LINEMAP]->{$unused[0]};
        } else {
            $ok = 0;
        }
    }
    return $ok;
}

sub _printChunk
{
    my $chunk = shift;
    printf("  %6s\t[%d:%d]\t[%d:%d]\n",
           $DiffMap::type2str[$chunk->[TYPE]],
           $chunk->[OLD]->[_START],
           $chunk->[OLD]->[_END],
           $chunk->[NEW]->[_START],
           $chunk->[NEW]->[_END]);
}

sub _newChunk
{
    my ($type, $baseline_start, $current_start) = @_;
    # new chunk starts and ends on the same line - until we see more lines and
    #   extend either the old or new range
    return [[$baseline_start, $baseline_start],
            [$current_start, $current_start],
            $type
    ];
}

sub show_map
{
    my ($self, $file) = @_;

    $file = $self->findName($file);
    return $self unless exists($self->[FILEMAP]->{$file});
    my $currfile =
        defined($self->[FILEMAP]->{$file}) ? $self->[FILEMAP]->{$file} :
        "[deleted]";
    print("In $file" . ($currfile ne $file ? " (was: $currfile)" : '') . ":\n");
    foreach my $chunk (@{$self->[LINEMAP]->{$file}}) {
        _printChunk($chunk);
    }
    return $self;
}

sub _read_udiff
{
    my $self      = shift;
    my $diff_file = shift;    # Name of diff file
    my $line;                 # Contents of current line
    my $file_old;             # Name of old file in diff section
    my $file_new;             # Name of new file in diff section
    my $filename;             # Name of common filename of diff section

    # Check if file exists and is readable
    stat($diff_file);
    if (!(-r _)) {
        die("cannot read udiff file $diff_file!\n");
    }

    $self->[DIFF_FILENAME] = $diff_file;

    my $diffFile = InOutFile->in($diff_file);
    my $diffHdl  = $diffFile->hdl();

    my $chunk;
    my $old_block = 0;
    my $new_block = 0;
    # would like to use Regexp::Common::time - but module not installed
    #my $time = $RE{time}{iso};
    my $time =
        '[1-9]{1}[0-9]{3}\-[0-9]{2}\-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]*)?( .[0-9]+)?';
    # Parse diff file line by line
    my $verbose         = 0;
    my $skipCurrentFile = 0;
    while (<$diffHdl>) {
        chomp($_);
        s/\r//g;
        $line = $_;

        # the 'diff' new/old file name line may be followed by a timestamp
        #   If so, remove it so our regexp matches more easily.
        # p4 and git diff outputs do not have the timestamp
        if ($line =~ /^[-+=]{3} \S.*(\s+$time)$/) {
            $line =~ s/\Q$1\E$//;
        }
        foreach ($line) {
            /^Git Root: (.+)$/ && do {
                # save match:  'check_path_separator' matches further
                #   regexps and overwrites $1
                my $root = $1;
                $root =
                    lcovutil::check_path_separator($root, $diff_file, $.,
                                                   'diff');
                $self->[DIFF_ROOT] = ReadCurrentSource::resolve_path($root, 1);
                last;
            };

            # Filename of unchanged file:
            # === <filename>
            /^=== (.+)$/ && do    # note: filename may contain whitespace
            {
                if ($filename && !$skipCurrentFile) {
                    die("not case insensitive")
                        unless !$lcovutil::case_insensitive ||
                        ($filename eq lc($filename));
                    push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                    undef $filename;
                }
                my $file = $1;
                # a name written on the other platform is put into this
                #   platform's terms first:  everything below - the directory
                #   stripping, '--substitute', and the comparison against the
                #   names in the coverage data - works in host-style paths
                $file =
                    lcovutil::check_path_separator($file, $diff_file, $.,
                                                   'diff');
                $file = lcovutil::strip_directories($file, $main::strip);
                my $key = ReadCurrentSource::resolve_path($file, 1);
                # skip diff data for excluded files - but skip quietly
                $skipCurrentFile = TraceFile::skipCurrentFile($key, 'diff');
                last if $skipCurrentFile;

                $key = lc($key) if $lcovutil::case_insensitive;
                if (exists($self->[UNCHANGED]->{$key})) {
                    # unchanged entry flag value should be 1
                    die("$diff_file:$.:  $key already in linemap - marked unchanged"
                            . ($file eq $key ? '' : " (substituted '$file')"))
                        unless $self->[UNCHANGED]->{$key};
                    lcovutil::ignorable_error($lcovutil::ERROR_FORMAT,
                        "$diff_file:$.:  duplicate 'unchanged' entry for $key\n"
                    );
                    last;
                }
                $verbose = (defined($main::verboseScopeRegexp) &&
                            $key =~ m/$main::verboseScopeRegexp/);
                print("  $key: unchanged\n") if $verbose;
                if (exists($self->[LINEMAP]->{$key})) {
                    # LCOV_UNREACHABLE_START
                    lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                        "$diff_file:$.:  $key 'unchanged' entry found but diff records exist"
                            . ($file eq $key ? '' : " (substituted '$file')"));
                    # message ignored - delete the diff records
                    delete($self->[LINEMAP]->{$key});
                    # LCOV_UNREACHABLE_STOP
                }
                $self->[UNCHANGED]->{$key} = 1;
                last;
            };

            next if $skipCurrentFile;

            # Filename of old file:
            # --- <filename>
            /^--- (.+)$/ && do {
                if ($filename) {
                    die("not case insensitive")
                        unless !$lcovutil::case_insensitive ||
                        ($filename eq lc($filename));
                    push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                    undef $filename;
                }
                $file_old = $1;
                $file_old =
                    lcovutil::check_path_separator($file_old, $diff_file, $.,
                                                   'diff');
                $file_old =
                    lcovutil::strip_directories($file_old, $main::strip);
                $file_old = ReadCurrentSource::resolve_path($file_old, 1);
                $file_old = lc($file_old) if $lcovutil::case_insensitive;
                $self->[LOCATION]->[OLD]->{$file_old} = $.;
                last;
            };
            # Filename of new file:
            # +++ <filename>
            /^\+\+\+ (.+)$/ && do {
                # Add last file to resulting hash
                $file_new = $1;
                $file_new =
                    lcovutil::check_path_separator($file_new, $diff_file, $.,
                                                   'diff');
                $file_new =
                    lcovutil::strip_directories($file_new, $main::strip);
                my $key = ReadCurrentSource::resolve_path($file_new, 1);
                $key = lc($key)
                    if $lcovutil::case_insensitive;
                my $notNull = $file_new ne $lcovutil::devnull;
                $filename = $notNull ? $key : undef;

                if ($filename) {
                    if (exists($self->[UNCHANGED]->{$key})) {
                        # LCOV_UNREACHABLE_START
                        lcovutil::ignorable_error(
                            $lcovutil::ERROR_INTERNAL,
                            "$diff_file:$.: $filename marked unchanged but diff record found"
                                .
                                ($file_new eq $key ? '' :
                                     " (substituted '$file_new')"));
                        # OK - error ignored...remove the 'unchanged' marker
                        delete($self->[UNCHANGED]->{$key});
                        # LCOV_UNREACHABLE_STOP
                    }
                    $self->[LINEMAP]->{$key} = [];
                }
                $verbose = (defined($main::verboseScopeRegexp) &&
                            $key =~ m/$main::verboseScopeRegexp/);
                print("file $key\n") if $verbose;
                if ($notNull) {
                    $self->[FILEMAP]->{$key} = $file_old;
                    # ..and the reverse, for a file the diff renames:  the
                    #   baseline coverage data knows it by its old name, while
                    #   the chunks are filed under the new one - see
                    #   'baselineSource'
                    $self->[RENAMED]->{$file_old} = $key
                        if (defined($file_old) &&
                            $file_old ne $key &&
                            $file_old ne $lcovutil::devnull);
                    # keep track of location where this file was found
                    $self->[LOCATION]->[NEW]->{$key} =
                        $.;    # record original name too.. $file_new
                }
                # new file - chunk starts here
                $chunk = _newChunk(EQUAL, 1, 1);
                last;
            };
            # Start of diff block:
            # @@ -old_start[,old_num] +new_start[,new_num] @@
            #   both counts are optional:  a range whose length is 1 is written
            #   as the start line alone ('@@ -4 +4 @@')
            /^\@\@\s+-(\d+)(?:,(\d+))?\s+\+(\d+)(?:,(\d+))?\s+\@\@.*$/ && do {
                if ($1 > ($chunk->[OLD]->[_END])) {
                    # old start skips "equal" lines
                    if ($chunk->[TYPE] != EQUAL) {
                        if ($filename) {
                            push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                            _printChunk($chunk) if ($verbose);
                        }
                        $chunk =
                            _newChunk(EQUAL,
                                      $chunk->[OLD]->[_END] + 1,
                                      $chunk->[NEW]->[_END] + 1);
                    }
                }
                # "END" will be incremented on content lines
                $chunk->[OLD]->[_END] = $1 - 1;
                $chunk->[NEW]->[_END] = $3 - 1;
                # an omitted count means 1 - and 0 is a legal count ('@@ -0,0
                #   +1,3 @@' for a created file), so the default has to be
                #   applied on 'defined', not on truth
                $old_block = defined($2) ? $2 : 1;
                $new_block = defined($4) ? $4 : 1;
                #printf "equal [%d:%d] [%d:%d]\n", $l[0], $l[1], $l[2], $l[3];
                last;
            };
            # ..and a '@@' line this reader does not understand is a malformed
            #   patch:  falling through to the content arms below would leave
            #   the hunk's lines attributed to whatever the previous header said
            /^\@\@/ && do {
                lcovutil::ignorable_error($lcovutil::ERROR_FORMAT,
                    "$diff_file:$.: unexpected 'diff' hunk header '$line': expected '\@\@ -<start>[,<count>] +<start>[,<count>] \@\@'"
                );
                last;
            };
            # Unchanged line
            # <line starts with blank>
            /^ / && do {
                if ($old_block == 0 && $new_block == 0) {
                    last;
                }
                if ($chunk->[TYPE] != EQUAL) {
                    if ($filename) {
                        push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                        _printChunk($chunk) if ($verbose);
                    }
                    # next chunk starts right after current one
                    $chunk = _newChunk(EQUAL,
                                       $chunk->[OLD]->[_END] + 1,
                                       $chunk->[NEW]->[_END] + 1);
                } else {
                    $chunk->[NEW]->[_END] += 1;
                    $chunk->[OLD]->[_END] += 1;
                }
                last;
            };
            # Line as seen in old file
            # <line starts with '-'>
            /^-(.*)$/ && do {
                if ($old_block == 0 && $new_block == 0) {
                    last;
                }
                my $baseline_lineno = $chunk->[OLD]->[_END] + 1;
                # really only need to keep track of baseline content if user
                #   is planning on doing any filtering
                my $lines;
                if (exists($self->[BASELINE]->{$file_old})) {
                    $lines = $self->[BASELINE]->{$file_old};
                } else {
                    $lines = {};
                    $self->[BASELINE]->{$file_old} = $lines;
                }
                $lines->{$baseline_lineno} = $1;

                if ($chunk->[TYPE] != DELETE) {
                    if ($filename) {
                        push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                        _printChunk($chunk) if ($verbose);
                    }
                    $chunk = _newChunk(DELETE, $baseline_lineno,
                                       $chunk->[NEW]->[_END]);
                } else {
                    $chunk->[OLD]->[_END] = $baseline_lineno;
                }
                last;
            };
            # Line as seen in new file
            # <line starts with '+'>
            /^\+/ && do {
                if ($old_block == 0 && $new_block == 0) {
                    last;
                }
                if ($chunk->[TYPE] != INSERT) {
                    if ($filename) {
                        push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                        _printChunk($chunk) if ($verbose);
                    }
                    $chunk = _newChunk(INSERT,
                                       $chunk->[OLD]->[_END],
                                       $chunk->[NEW]->[_END] + 1);
                } else {
                    $chunk->[NEW]->[_END] += 1;
                }
                last;
            };
            # Empty line
            /^$/ && do {
                if ($old_block == 0 && $new_block == 0) {
                    last;
                }
                if ($chunk->[TYPE] != EQUAL) {
                    if ($filename) {
                        push(@{$self->[LINEMAP]->{$filename}}, $chunk);
                        _printChunk($chunk) if ($verbose);
                    }
                    $chunk = _newChunk(EQUAL,
                                       $chunk->[OLD]->[_END] + 1,
                                       $chunk->[NEW]->[_END] + 1);
                } else {
                    $chunk->[NEW]->[_END] += 1;
                    $chunk->[OLD]->[_END] += 1;
                }
                last;
            };
        }
    }

    # Add final diff file section to resulting hash
    if ($filename) {
        push(@{$self->[LINEMAP]->{$filename}}, $chunk);
        _printChunk($chunk) if ($verbose);
    }

    # (the default root is applied by the constructor:  it is needed whether a
    #   diff was read or not)

    if ($self->empty()) {
        # this is probably OK - there are no differences between 'baseline' and current.
        lcovutil::ignorable_error($lcovutil::ERROR_EMPTY,
            "'diff' data file $diff_file contains no differences (this may be OK, if there are no difference between 'baseline' and 'current').\n"
                . "Make sure to use 'diff -u' when generating the diff file.");
    }
    return $self;
}

package InInterestingRegion;

use constant {
              NEXT         => 0,
              PREV         => 1,
              STACK        => 2,
              ANNOTATE_OBJ => 3,
              LINECOV_HASH => 4,
              # non-code line in a contiguous region before or after the
              # 'interesting' code lie - should also be included -
              # keep track of the length of that region, above and below
              LINES_BEFORE => 5,
              LINES_AFTER  => 6,

};

our $num_context_lines = 5;

sub new
{
    my ($class, $srcFileStruct, $lineCovHash) = @_;

    my $self = [undef, undef,
                Storable::dclone($srcFileStruct->interesting_lines()),
                $srcFileStruct, $lineCovHash
    ];
    # we will call the $annotateObj->line(int) to collect annotate data
    #   for certain lines - to find out of a non-code line is in a
    #   contiguous region by the same author, in the same SHA or etc.
    $self->[NEXT] = shift(@{$self->[STACK]});
    if (defined($self->[NEXT]) && $self->[NEXT] != 1) {
        _computeContextBefore($self, 0);
    }
    return bless $self, $class;
}

sub _computeContextBefore
{
    my ($self, $prev) = @_;

    my $count    = 0;
    my $data     = $self->[LINECOV_HASH];
    my $annotate = $self->[ANNOTATE_OBJ];
    # find contiguous source region which matches the select criteria.
    #   That might include non-code lined (e.g., comments)
    for (my $l = $self->[NEXT] - 1; $l > $prev; --$l) {
        my $lineData;
        $lineData = $data->{$l} if exists($data->{$l});
        my $annotateData = $annotate->line($l);
        last
            unless SummaryInfo::selected($lineData, $annotateData,
                                         $self->[ANNOTATE_OBJ]->path(), $l);
        ++$count;
    }
    # region of interest is the (possibly empty) contiguous region we found
    # plus the number of context lines
    $self->[LINES_BEFORE] = $num_context_lines + $count;
}

sub interesting
{
    my ($self, $lineNum) = @_;
    die("unexpected lineNum '$lineNum'") if $lineNum < 1;
    if (defined($self->[NEXT])) {
        if ($lineNum == $self->[NEXT]) {
            $self->[PREV] = $self->[NEXT];
            $self->[NEXT] = shift(@{$self->[STACK]});
            # compute following context lines - starting from here
            #  and going to either end of file or next interesting line
            my $max = defined($self->[NEXT]) ? $self->[NEXT] :
                $self->[ANNOTATE_OBJ]->num_lines();
            my $count    = 0;
            my $data     = $self->[LINECOV_HASH];
            my $annotate = $self->[ANNOTATE_OBJ];
            for (my $l = $self->[PREV] + 1; $l < $max; ++$l) {
                my $lineData;
                $lineData = $data->{$l} if exists($data->{$l});
                my $annotateData = $annotate->line($l);
                last
                    if !SummaryInfo::selected($lineData, $annotateData,
                                             $self->[ANNOTATE_OBJ]->path(), $l);
                ++$count;
            }
            $self->[LINES_AFTER] = $num_context_lines + $count;

            # and how many lines before the next interesting one?
            if (defined($self->[NEXT])) {
                $self->_computeContextBefore($self->[PREV]);
            } else {
                $self->[LINES_BEFORE] = 0;
            }
            return 1;
        } elsif ($lineNum >= $self->[NEXT] - $self->[LINES_BEFORE]) {
            return 1;
        }
    }
    if (defined($self->[PREV])) {
        if ($lineNum <= $self->[PREV] + $self->[LINES_AFTER]) {
            return 1;
        }
        $self->[PREV] = undef;
    }
    return 0;
}

package SourceLine;

use constant {
              LINE         => 0,
              TEXT         => 1,
              OWNER        => 2,
              FULL_NAME    => 3,
              DATE         => 4,
              AGE          => 5,
              COMMIT       => 6,
              LINE_TLA     => 7,
              BRANCH_TLA   => 8,
              MCDC_TLA     => 9,
              FUNCTION_TLA => 10,
              # the LineData of this line, when it has call sites:  the source
              #   view annotates each site individually, so what is kept is the
              #   whole list rather than one category
              CALL_SITES => 11,
};

sub new
{
    my $class = shift;
    # [lineNo, text, abbrev_name, full_name, date, age, commitID, lineTLA, branchTLA,
    #  MCDC_TLA, functionTLA, callSites]
    my @data = @_;
    my $self = \@data;
    bless $self, $class;
    return $self;
}

sub to_list
{
    # used by 'select' callback - if not a package
    my $self = shift;
    if ($#$self >= OWNER) {
        my @rtn = @{$self}[OWNER, FUNCTION_TLA];
        return \@rtn;
    }
    return undef;
}

sub owner
{
    my $self = shift;
    return $#$self >= OWNER ? $self->[OWNER] : undef;
}

sub full_name
{
    my $self = shift;
    return $#$self >= FULL_NAME ? $self->[FULL_NAME] : undef;
}

# line coverage TLA
sub tla
{
    my ($self, $tla) = @_;
    $self->[LINE_TLA] = $tla
        if (defined($tla));
    return $#$self >= LINE_TLA ? $self->[LINE_TLA] : undef;
}

sub branchElem
{
    my ($self, $branchElem) = @_;
    $self->[BRANCH_TLA] = $branchElem
        if defined($branchElem);
    return $#$self >= BRANCH_TLA ? $self->[BRANCH_TLA] : undef;
}

sub mcdcElem
{
    my ($self, $mcdcElem) = @_;
    $self->[MCDC_TLA] = $mcdcElem
        if defined($mcdcElem);
    return $#$self >= MCDC_TLA ? $self->[MCDC_TLA] : undef;
}

sub functionElem
{
    my ($self, $funcElem) = @_;
    $self->[FUNCTION_TLA] = $funcElem
        if defined($funcElem);
    return $#$self >= FUNCTION_TLA ? $self->[FUNCTION_TLA] : undef;
}

sub callSiteElem
{
    my ($self, $callSiteElem) = @_;
    $self->[CALL_SITES] = $callSiteElem
        if defined($callSiteElem);
    return $#$self >= CALL_SITES ? $self->[CALL_SITES] : undef;
}

sub commit
{
    my $self = shift;
    return $#$self >= COMMIT ? $self->[COMMIT] : undef;
}

sub date
{
    my $self = shift;
    return $#$self >= DATE ? $self->[DATE] : undef;
}

sub age
{
    my $self = shift;
    return $#$self >= AGE ? $self->[AGE] : undef;
}

sub line
{
    my $self = shift;
    return $self->[LINE];
}

sub text
{
    my $self = shift;
    return $self->[TEXT];
}

package SourceFile;
our @annotateScript;
our $annotateCallback;
our $annotateTooltip = 'Line %l: commit %C on %d by %F';
our $annotatedFiles  = 0;
our $totalFiles      = 0;

use constant {
              PATH              => 0,
              LINES             => 1,
              INTERESTING_LINES => 2,
              LINE_OWNERS       => 3,
              LINE_CATEGORIES   => 4,
              BRANCH_OWNERS     => 5,
              BRANCH_CATEGORIES => 6,
              MCDC_OWNERS       => 7,
              MCDC_CATEGORIES   => 8,
              # a call site is one line, so - unlike a function - it has one
              #   owner and one date
              CALLGRAPH_OWNERS     => 9,
              CALLGRAPH_CATEGORIES => 10,
              # line -> the SourceLine which gives the date and owner of the
              #   coverpoints on that line, for the lines of the multi-line
              #   statements whose most recent edit is not on the line itself
              ATTRIBUTION => 11,
};

# the coverpoint types which keep a (owner, category) pair of slots, so that the
#   allocation in 'new' and the pruning in 'simplify' do not each carry their own
#   copy of the list
our @ownerCategorySlots = (LINE_OWNERS, LINE_CATEGORIES,
                           BRANCH_OWNERS, BRANCH_CATEGORIES,
                           MCDC_OWNERS, MCDC_CATEGORIES,
                           CALLGRAPH_OWNERS, CALLGRAPH_CATEGORIES);

sub new
{
    my ($class, $filepath, $fileSummary, $fileCovInfo, $hasNoBaselineData) = @_;

    (ref($fileSummary) eq 'SummaryInfo' &&
     ref($fileCovInfo) eq "FileCoverageInfo") or
        die("unexpected input args");

    my $self = [$filepath,
                [],       # lines
                undef,    # list of interesting lines
    ];
    foreach my $t (@ownerCategorySlots) {
        # table of owner -> hash of TLAs->list of lines for coverpoint type
        # table of TLA -> list of lines holding that TLA for coverpoint
        push(@$self, {});
    }
    push(@$self, {});    # attribution
    bless $self, $class;

    $fileSummary->fileDetails($self);

    # use the line coverage count to synthesize a fake file, if we can't
    #   find an actual file
    $self->_load($fileCovInfo);
    $self->_attributeStatements($fileCovInfo);

    if ($hasNoBaselineData) {
        my $fileAge = $self->age();
        if (defined($fileAge) &&
            (!defined($main::age_basefile) ||
                $fileAge > $main::age_basefile)
        ) {
            # go through the fileCov data and change UIC->UBC, GIC->CBC
            #  - pretend that we already saw this file data - this is the first
            #    coverage report which contains this data.
            $fileCovInfo->recategorizeTlaAsBaseline();
        }
    }

    # sort lines in ascending numerical order - we want the 'owner'
    #   and 'tla' line lists to be sorted - and it is probably faster to
    #   sort the file list once than to sort each of the sub-lists
    #   individually afterward.
    # DCB, DUB category keys have leading "<<<" characters - which we strip
    #  in order to compare
    my $currentTla;
    my $regionStartLine;
    my $lineCovData = $fileCovInfo->lineMap();

    my @lineArray;    # interesting line numbers
    my $inRegion;
    if (defined($selectCallback)) {
        # This implementation looks for all the 'line' coverpoints - then
        #   expands the selected region around those points - e.g., by
        #   adding noncode lines which are in the selected changelist and
        #   surrounding the selected region with 'num_context_lines' of
        #   context.
        # A side effect of this criteria is that disjoint noncode regions -
        #   e.g., comments or unused #ifdef code - will not be selected.
        # A different implementation would go through the annotated source
        #   and mark all selected lines, then go through again to add
        #   context.
        # It isn't clear which approach is best - but the current approach
        #   seems to match user expectations - so I'm going with it, at
        #   least for now.
        #   Not too hard to do - but significant overkill - to make the
        #   approach configurable.  Let's see if there is user demand.
        while (my ($line, $lne) = each(%$lineCovData)) {
            # ignore deleted lines as they don't appear in source listing
            my $tla     = $lne->tla();
            my $deleted = exists($SummaryInfo::deletedTla{$tla});
            # no annotations for deleted line
            my $annotateData;
            $annotateData = $self->line($line) unless $deleted;
            # callback arguments are (LineData, SourceLine)
            if (SummaryInfo::selected($lne, $annotateData,
                                      $self->path(), $line)) {
                # A deleted line is keyed '<<<N' by its baseline line number
                #   and is displayed next to the current line the loop below
                #   maps it to - so record that line.  Everything which reads
                #   this list is arithmetic ('interesting', the sort here);
                #   a '<<<N' key numified to 0, which made every line from
                #   there on 'interesting'.
                push(@lineArray, $deleted ? -$lne->lineNo('current') : $line);
            }
        }
        # unique as well as ascending:  'interesting' advances its stack only on
        #   an exact match, so a repeated entry would stick there
        my %seenLine;
        @lineArray = sort({ $a <=> $b }
                          grep({ !$seenLine{$_}++ } @lineArray));
        $self->[INTERESTING_LINES] = \@lineArray;
        $inRegion = InInterestingRegion->new($self, $lineCovData);
    }
    # deleted line associated with first 'current' line above -
    # or line below, if there is no current line above.  The lines are visited
    #   in the order of the line they are displayed at, which is what the region
    #   is a stream over:  'interesting' only moves forward, and so does the
    #   source view which asks it the same question again.  A deleted line's own
    #   number is a line of the baseline, which says nothing about where it is
    #   among the current ones
    my %displayedAt;
    # category lists which hold a coverpoint out of order - see
    #   _countBranchTlaData
    my %displaced;
    while (my ($line, $lne) = each(%$lineCovData)) {
        $displayedAt{$line} =
            exists($SummaryInfo::deletedTla{$lne->tla()}) ?
            -$lne->lineNo('current') :
            $line;
    }
    foreach my $line (sort({
                               my $ka =
                                   ("<" ne substr($a, 0, 1)) ? $a :
                                   substr($a, 3);
                               my $kb =
                                   ("<" ne substr($b, 0, 1)) ? $b :
                                   substr($b, 3);
                               $displayedAt{$a} <=> $displayedAt{$b} ||
                                   $ka <=> $kb
                      } keys(%{$lineCovData}))
    ) {
        # is this line within N of an interesting one?
        my $lne     = $lineCovData->{$line};
        my $tla     = $lne->tla();
        my $lineNum = $displayedAt{$line};

        if (defined($inRegion) &&
            !$inRegion->interesting($lineNum)) {
            lcovutil::info(1,
                           "  drop $line" .
                               ($line eq $lineNum ? '' : " ($lineNum)") . "\n");
            $fileSummary->removeLine($lne);
            delete($lineCovData->{$line});
            next;
        }
        $self->_countLineTlaData($line, $lne, $fileSummary);

        $displaced{+BRANCH_CATEGORIES} = 1
            if ($lcovutil::br_coverage &&
                defined($lne->differential_branch()) &&
                $self->_countBranchTlaData($line, $lne, $fileSummary));

        $displaced{+MCDC_CATEGORIES} = 1
            if ($lcovutil::mcdc_coverage &&
                defined($lne->differential_mcdc()) &&
                $self->_countMcdcTlaData($line, $lne, $fileSummary));

        $self->_countFunctionTlaData($line, $lne, $fileSummary)
            if ($lcovutil::func_coverage &&
                defined($lne->differential_function()));

        $self->_countCallgraphTlaData($line, $lne, $fileSummary)
            if ($lcovutil::callgraph_coverage && $lne->num_call_sites());
    }
    foreach my $category (keys(%displaced)) {
        foreach my $list (values(%{$self->[$category]})) {
            # the order and the uniqueness binarySearchLine expects
            my %seen;
            @$list = map({ $_->[1] }
                         sort({ $a->[0] <=> $b->[0] }
                              map({ [/^<*([0-9]+)$/, $_] }
                                  grep({ !$seen{$_}++ } @$list))));
        }
    }
    if (defined($main::show_dateBins) &&
        %$lineCovData &&                    # haven't filtered out everything
        !$self->isProjectFile()
    ) {
        lcovutil::info("no owner/date info for '$filepath'\n");
    }
    return $self;
}

sub simplify
{
    my $self = shift;
    # retain only the information required to populate the hyperlinks in
    #   the parent 'directory details' table
    # This struct can be huge, for a large, complicated file
    $self->[INTERESTING_LINES] = undef;

    my %keep;
    # keep the first line in each date bin..
    for (my $bin = 0; $bin <= $#ageGroupHeader; ++$bin) {
        foreach my $tla (keys %{$self->[LINE_CATEGORIES]}) {
            # at least for the moment, skip deleted lines
            next if exists($SummaryInfo::deletedTla{$tla});
            my $line = $self->nextInDateBin($bin, $tla);
            $keep{$line} = 1 if defined($line);
        }
        if ($lcovutil::br_coverage) {
            foreach my $tla (keys %{$self->[BRANCH_CATEGORIES]}) {
                next if exists($SummaryInfo::unbinnedTla{$tla});
                my $line = $self->nextBranchInDateBin($bin, $tla);
                $keep{$line} = 1 if defined($line);
            }
        }
        if ($lcovutil::mcdc_coverage) {
            foreach my $tla (keys %{$self->[MCDC_CATEGORIES]}) {
                next if exists($SummaryInfo::unbinnedTla{$tla});
                my $line = $self->nextMcdcInDateBin($bin, $tla);
                $keep{$line} = 1 if defined($line);
            }
        }
        if ($lcovutil::callgraph_coverage) {
            foreach my $tla (keys %{$self->[CALLGRAPH_CATEGORIES]}) {
                next if exists($SummaryInfo::unbinnedTla{$tla});
                my $line = $self->nextCallgraphInDateBin($bin, $tla);
                $keep{$line} = 1 if defined($line);
            }
        }
    }

    # retain first location of each TLA (globally) and each TLA for each owner
    foreach my $bin (@ownerCategorySlots) {
        while (my ($key, $list) = each(%{$self->[$bin]})) {
            if ('ARRAY' eq ref($list)) {
                next if exists($SummaryInfo::unbinnedTla{$key});
                # retain the first entry and any interesting entries
                $keep{$list->[0]} = 1;
                @$list = grep(exists($keep{$_}), @$list);
            } else {
                die("unexpected type") unless 'HASH' eq ref($list);
                while (my ($tla, $l) = each(%$list)) {
                    next if exists($SummaryInfo::unbinnedTla{$tla});
                    # retain the first entry
                    $keep{$l->[0]} = 1;
                    @$l = grep(exists($keep{$_}), @$l);
                }
            }
        }
    }
    # throw away everything we aren't interested in
    for (my $l = $self->num_lines(); $l > 0; --$l) {
        if (!exists($keep{$l})) {
            $self->[LINES]->[$l - 1] = undef;
        }
    }
}

sub _countBranchTlaData
{
    my ($self, $line, $lineData, $fileSummary) = @_;
    my $differentialData = $lineData->differential_branch();

    my ($src_age, $developer, $srcLine);
    my $lineTla = $lineData->tla();

    if ($SummaryInfo::tlaLocation{$lineTla} & 0x1) {
        # skip check if line was deleted - no age/owner data for deleted code
        $srcLine = $self->line($line);
        if (!defined($srcLine)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                       "no data for 'branch' line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
        } else {
            $srcLine->branchElem($differentialData);
            if (@SourceFile::annotateScript &&
                !grep(/^$lineTla$/, ('DUB', 'DCB'))) {
                # deleted lines don't have owner data...
                # if this line is not in the project (e.g., from some 3rd party
                #   library - then we might not have file history for it.
                # ..of the statement the line is part of
                my $who = $self->attribution($line);
                $src_age   = $who->age();
                $developer = $who->owner();

                if (defined($developer)) {
                    my $shash = $self->[BRANCH_OWNERS];
                    if (!exists($shash->{$developer})) {
                        $shash->{$developer} = {};
                        $shash->{$developer}->{lines} = [];
                    }
                    my $l = $shash->{$developer}->{lines};
                    # NOTE: string compare as either line number could be
                    #   "<<<X" if it was deleted
                    push(@$l, $line)
                        unless @$l && $l->[-1] eq $line;
                }
            }
        }
    }

    # the navigation links go to the line the block is written at - see
    #   BranchBlock::locationOffset.  Such a line is out of order in the
    #   category lists, which the caller sorts if required
    my $displaced = 0;
    foreach my $block ($differentialData->blocks()) {
        my $diff    = $block->elements();
        my $blockId = $block->idx();
        my $at      = $line;
        my $offset  = $block->locationOffset();
        if ($offset && '<' ne substr($line, 0, 1)) {
            $at += $offset;
            $displaced = 1;
        }
        foreach my $br (@$diff) {
            my $tla = $br->tla();
            # don't count excluded coverpoints
            unless (defined($tla)) {
                # LCOV_UNREACHABLE_START
                lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                                          "undef TLA for branch $blockId of " .
                                              $self->path() .
                                              ":$at - lineTLA:$lineTla taken:" .
                                              $br->data());
                next;
                # LCOV_UNREACHABLE_STOP
            }
            next if exists($SummaryInfo::excludedCoverpointTla{$tla});
            $fileSummary->[SummaryInfo::BRANCH_DATA]->[SummaryInfo::DATA]
                ->{$tla} += 1;
            # keep track of all the branch TLAs found on this line...
            $self->[BRANCH_CATEGORIES]->{$tla} = []
                unless exists($self->[BRANCH_CATEGORIES]->{$tla});
            my $l = $self->[BRANCH_CATEGORIES]->{$tla};
            # see 'string compare' comment above
            push(@$l, $at)
                unless @$l && $l->[-1] eq $at;
            next
                if (0 == ($SummaryInfo::tlaLocation{$tla} & 0x1));
            # skip "DUB' and 'DCB' categories - which are not in current
            #   and thus have no line associated
            # and the age...
            #lcovutil::info("$l: $tla" . $lineData->in_curr() . "\n");

            unless (defined($srcLine) && defined($src_age)) {
                # No annotation data, so there is no age bin to update.
                #   The per-TLA total was already incremented above - do NOT
                #   count it again here (that double-counted every branch
                #   coverpoint in the TLA columns).
                next;
            }

            # increment count of branches of this age we found for this TLA
            $fileSummary->branchCovCount($tla, "age", $src_age, 1);

            # HGC:  could clean this up...no need to keep track
            #   of 'hit' as we can just compute from CBC + GNC + ...
            # found another line...
            my $hit = exists($SummaryInfo::hitTla{$tla});
            $fileSummary->branchCovCount("found", "age", $src_age, 1);
            $fileSummary->branchCovCount("hit", "age", $src_age, 1)
                if $hit;
            next
                unless defined($developer);
            # add this line to those that belong to this owner..
            # first:  increment line count in 'file summary'
            my $ohash =
                $fileSummary->[SummaryInfo::BRANCH_DATA]->[SummaryInfo::OWNERS];
            if (!exists($ohash->{$developer})) {
                my %data = ('hit'   => $hit ? 1 : 0,
                            'found' => 1,
                            $tla    => 1);
                $ohash->{$developer} = \%data;
            } else {
                my $d = $ohash->{$developer};
                $d->{$tla} = 0
                    unless exists($d->{$tla});
                $d->{$tla}  += 1;
                $d->{found} += 1;
                $d->{hit}   += 1
                    if $hit;
            }
            # now append this branchTLA to the owner...
            my $dhash = $self->[BRANCH_OWNERS]->{$developer};
            die("expected initialized") unless defined($dhash);
            $dhash->{$tla} = []
                unless exists($dhash->{$tla});
            my $ll = $dhash->{$tla};
            # see 'string compare' comment above
            push(@$ll, $line)
                unless @$ll && $ll->[-1] eq $line;
        }
    }
    return $displaced;
}

sub _countMcdcTlaData
{
    my ($self, $line, $lineData, $fileSummary) = @_;
    my $differentialData = $lineData->differential_mcdc();

    my ($src_age, $developer, $srcLine);
    my $lineTla = $lineData->tla();
    if ($SummaryInfo::tlaLocation{$lineTla} & 0x1) {
        # skip check if line was deleted - no age/owner data for deleted code
        $srcLine = $self->line($line);
        if (!defined($srcLine)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                        "no data for 'MC/DC' line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
        } else {
            $srcLine->mcdcElem($differentialData);
            if (@SourceFile::annotateScript &&
                !grep(/^$lineTla$/, ('DUB', 'DCB'))) {
                # deleted lines don't have owner data...
                # if this line is not in the project (e.g., from some 3rd party
                #   library - then we might not have file history for it.
                # ..of the statement the line is part of
                my $who = $self->attribution($line);
                $src_age   = $who->age();
                $developer = $who->owner();

                if (defined($developer)) {
                    my $shash = $self->[MCDC_OWNERS];
                    if (!exists($shash->{$developer})) {
                        $shash->{$developer} = {};
                        $shash->{$developer}->{lines} = [];
                    }
                    my $l = $shash->{$developer}->{lines};
                    # see 'string compare' comment in branch method, above
                    push(@$l, $line)
                        unless @$l && $l->[-1] eq $line;
                }
            }
        }
    }

    # see the 'displaced' comment in _countBranchTlaData
    my $displaced  = 0;
    my $mcdcGroups = $differentialData->groups();
    while (my ($groupKey, $group) = each(%$mcdcGroups)) {
        my $at = $line;
        my ($size, $offset) = MCDC_Block::parseGroupKey($groupKey);
        if ($offset && '<' ne substr($line, 0, 1)) {
            $at += $offset;
            $displaced = 1;
        }
        foreach my $expr (@$group) {
            foreach my $sense (0, 1) {
                my $count = $expr->count($sense);
                my $tla   = $count->[0];
                # don't count excluded coverpoints
                next if exists($SummaryInfo::excludedCoverpointTla{$tla});
                unless (defined($tla)) {
                    # LCOV_UNREACHABLE_START
                    lcovutil::ignorable_error(
                                        $lcovutil::ERROR_INTERNAL,
                                        "undef TLA for sense $sense of MC/DC " .
                                            $expr->index() . ' of ' .
                                            $self->path() .
                                            ":$at - lineTLA:$lineTla taken:" .
                                            $count->[1]);
                    next;
                    # LCOV_UNREACHABLE_STOP
                }
                $fileSummary->[SummaryInfo::MCDC_DATA]->[SummaryInfo::DATA]
                    ->{$tla} += 1;
                # keep track of all the branch TLAs found on this line...
                if (!exists($self->[MCDC_CATEGORIES]->{$tla})) {
                    $self->[MCDC_CATEGORIES]->{$tla} = [];
                }
                my $l = $self->[MCDC_CATEGORIES]->{$tla};
                # see 'string compare' comment in branch method, above
                push(@$l, $at)
                    unless @$l && $l->[-1] eq $at;

                next
                    if (0 == ($SummaryInfo::tlaLocation{$tla} & 0x1));
                # skip "DUB' and 'DCB' categories - which are not in current
                #   and thus have no line associated

                # and the age...
                #lcovutil::info("$l: $tla" . $lineData->in_curr() . "\n");

                unless (defined($srcLine) && defined($src_age)) {
                    # see comment in _countBranchTlaData:  the per-TLA total
                    #   was already incremented above, and there is no age
                    #   bin to update without annotation data
                    next;
                }

                # increment count of branches of this age we found for this TLA
                $fileSummary->mcdcCovCount($tla, "age", $src_age, 1);

                my $hit = exists($SummaryInfo::hitTla{$tla});
                $fileSummary->mcdcCovCount("found", "age", $src_age, 1);
                $fileSummary->mcdcCovCount("hit", "age", $src_age, 1)
                    if $hit;

                next
                    unless defined($developer);

                # add this line to those that belong to this owner..

                # first:  increment line count in 'file summary'
                my $ohash =
                    $fileSummary->[SummaryInfo::MCDC_DATA]
                    ->[SummaryInfo::OWNERS];
                if (!exists($ohash->{$developer})) {
                    my %data = ('hit'   => $hit ? 1 : 0,
                                'found' => 1,
                                $tla    => 1);
                    $ohash->{$developer} = \%data;
                } else {
                    my $d = $ohash->{$developer};
                    $d->{$tla} = 0
                        unless exists($d->{$tla});
                    $d->{$tla}  += 1;
                    $d->{found} += 1;
                    $d->{hit}   += 1
                        if $hit;
                }

                # now append this mcdc TLA to the owner...
                my $dhash = $self->[MCDC_OWNERS]->{$developer};
                die("expected initialized") unless defined($dhash);
                $dhash->{$tla} = []
                    unless exists($dhash->{$tla});
                my $ll = $dhash->{$tla};
                # see 'string compare' comment in branch method, above
                push(@$ll, $line)
                    unless @$ll && $ll->[-1] eq $line;
            }
        }
    }
    return $displaced;
}

sub _countCallgraphTlaData
{
    # The per-line accumulator for call sites.
    #   The call site is associated with a particular line in the source -
    #   so has annotation data.  (In contrast:  a function isn't associated
    #   with a single line - so we don't have an author or age.
    my ($self, $line, $lineData, $fileSummary) = @_;

    my ($src_age, $developer, $srcLine);
    my $lineTla = $lineData->tla();
    if ($SummaryInfo::tlaLocation{$lineTla} & 0x1) {
        # skip check if line was deleted - no age/owner data for deleted code
        $srcLine = $self->line($line);
        if (!defined($srcLine)) {
            # A call site beyond the end of the source is caught by the range
            #   check before this point - an error, or with '--ignore range' the
            #   source is padded out to it, and '--filter range' drops the site -
            #   and a missing source is an error or is synthesized in full.  So
            #   every current-source line with a site has source text here
            # LCOV_UNREACHABLE_START
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                    "no data for 'callgraph' line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            # LCOV_UNREACHABLE_STOP
        } else {
            $srcLine->callSiteElem($lineData);
            if (@SourceFile::annotateScript &&
                !grep(/^$lineTla$/, ('DUB', 'DCB'))) {
                # deleted lines don't have owner data...
                # if this line is not in the project (e.g., from some 3rd party
                #   library - then we might not have file history for it.
                # ..of the statement the line is part of
                my $who = $self->attribution($line);
                $src_age   = $who->age();
                $developer = $who->owner();

                if (defined($developer)) {
                    my $shash = $self->[CALLGRAPH_OWNERS];
                    if (!exists($shash->{$developer})) {
                        $shash->{$developer} = {};
                        $shash->{$developer}->{lines} = [];
                    }
                    my $l = $shash->{$developer}->{lines};
                    # see 'string compare' comment in branch method, above
                    push(@$l, $line)
                        unless @$l && $l->[-1] eq $line;
                }
            }
        }
    }

    foreach my $site ($lineData->call_sites()) {
        my $tla = $site->tla();
        $fileSummary->[SummaryInfo::CALLGRAPH_DATA]->[SummaryInfo::DATA]->{$tla}
            += 1;
        # keep track of all the callee TLAs found on this line...
        $self->[CALLGRAPH_CATEGORIES]->{$tla} = []
            unless exists($self->[CALLGRAPH_CATEGORIES]->{$tla});
        my $l = $self->[CALLGRAPH_CATEGORIES]->{$tla};
        # see 'string compare' comment in branch method, above
        push(@$l, $line)
            unless @$l && $l->[-1] eq $line;

        next
            if (0 == ($SummaryInfo::tlaLocation{$tla} & 0x1));
        # skip 'DUB' and 'DCB' categories - which are not in current and thus
        #   have no line associated

        unless (defined($srcLine) && defined($src_age)) {
            # see comment in _countBranchTlaData:  the per-TLA total was already
            #   incremented above, and there is no age bin to update without
            #   annotation data
            next;
        }

        # increment count of call sites of this age we found for this TLA
        $fileSummary->callgraphCovCount($tla, "age", $src_age, 1);

        my $hit = exists($SummaryInfo::hitTla{$tla});
        $fileSummary->callgraphCovCount("found", "age", $src_age, 1);
        $fileSummary->callgraphCovCount("hit", "age", $src_age, 1)
            if $hit;

        next
            unless defined($developer);

        # add this line to those that belong to this owner..

        # first:  increment site count in 'file summary'
        my $ohash =
            $fileSummary->[SummaryInfo::CALLGRAPH_DATA]->[SummaryInfo::OWNERS];
        if (!exists($ohash->{$developer})) {
            my %data = ('hit'   => $hit ? 1 : 0,
                        'found' => 1,
                        $tla    => 1);
            $ohash->{$developer} = \%data;
        } else {
            my $d = $ohash->{$developer};
            $d->{$tla} = 0
                unless exists($d->{$tla});
            $d->{$tla}  += 1;
            $d->{found} += 1;
            $d->{hit}   += 1
                if $hit;
        }

        # now append this callee TLA to the owner...
        my $dhash = $self->[CALLGRAPH_OWNERS]->{$developer};
        die("expected initialized") unless defined($dhash);
        $dhash->{$tla} = []
            unless exists($dhash->{$tla});
        my $ll = $dhash->{$tla};
        # see 'string compare' comment in branch method, above
        push(@$ll, $line)
            unless @$ll && $ll->[-1] eq $line;
    }
}

sub _countLineTlaData
{
    my ($self, $line, $lineData, $fileSummary) = @_;
    # there is differential line coverage data...
    my $tla = $lineData->tla();

    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        # this case can happen if the line number annotations are
        #   wrong in the .info file - so the first line of some function
        #   or some branch coverage line number turns out not to be an
        #   executable source code line
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
               "unexpected category $tla for line " . $self->path() . ":$line");
        return;
    }
    # one more line in this bucket...
    $fileSummary->[SummaryInfo::LINE_DATA]->[SummaryInfo::DATA]->{$tla} += 1;
    # create the category list, if necessary
    $self->[LINE_CATEGORIES]->{$tla} = []
        unless exists($self->[LINE_CATEGORIES]->{$tla});

    push(@{$self->[LINE_CATEGORIES]->{$tla}}, $line);

    # and the age data...

    if ($SummaryInfo::tlaLocation{$tla} & 0x1) {
        # skip "DUB' and 'DCB' categories - which are not in current
        #   and thus have no line associated
        # @todo if desired, we _could_ enhance the 'annotate' callback
        #       to look up the baseline SHA/CL and get age/author information
        #       from that.  Seems unnecessary, though.

        #lcovutil::info("$l: $tla" . $lineData->in_curr() . "\n");

        my $l = $self->line($line);

        if (!defined($l)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                      "no data for line:$line, TLA:$tla, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            return;
        }
        # set the TLA of this line...
        $l->tla($tla);

        # the date and owner are those of the statement the line is part of
        $l = $self->attribution($line);
        my $src_age = $l->age();
        # if this line is not in the project (e.g., from some 3rd party
        #   library - then we might not have file history for it.
        return
            unless defined($src_age);

        # increment count of lines of this age we found for this TLA
        $fileSummary->lineCovCount($tla, "age", $src_age, 1);

        if ($lineData->in_curr()) {
            # HGC:  could clean this up...no need to keep track
            #   of 'hit' as we can just compute from CBC + GNC + ...
            # found another line...
            $fileSummary->lineCovCount("found", "age", $src_age, 1);
            if ($lineData->curr_count() > 0) {
                $fileSummary->lineCovCount("hit", "age", $src_age, 1);
            }
        }

        if (defined($l->owner())) {
            # add this line to those that belong to this owner..
            my $developer = $l->owner();

            # first:  increment line count in 'file summary'
            my $ohash =
                $fileSummary->[SummaryInfo::LINE_DATA]->[SummaryInfo::OWNERS];
            $ohash->{$developer} = {}
                unless exists($ohash->{$developer});
            my $d = $ohash->{$developer};
            $d->{$tla} = 0
                unless exists($d->{$tla});
            $d->{$tla} += 1;

            # now push this line onto the list of in this file, belonging
            #   to this owner
            $self->[LINE_OWNERS]->{$developer} = {}
                unless exists($self->[LINE_OWNERS]->{$developer});
            my $dhash = $self->[LINE_OWNERS]->{$developer};
            $dhash->{lines} = []
                unless exists($dhash->{lines});
            push(@{$dhash->{lines}}, $line);
            $dhash->{$tla} = []
                unless exists($dhash->{$tla});
            # and the list of lines with this TLA, belonging to this user
            push(@{$dhash->{$tla}}, $line);
        }
    }
}

sub _accountFunction
{
    my ($fileSummary, $tla, $src_age) = @_;

    unless (defined($tla)) {
        # LCOV_UNREACHABLE_START
        lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                                  "undef function TLA for age '$src_age' of " .
                                      $fileSummary->name());
        return 1;    # error
                     # LCOV_UNREACHABLE_STOP
    }

    $fileSummary->[SummaryInfo::FUNCTION_DATA]->[SummaryInfo::DATA]->{$tla} +=
        1;

    if (defined($src_age)) {
        $fileSummary->functionCovCount($tla, 'age', $src_age, 1);

        my $hit = exists($SummaryInfo::hitTla{$tla});
        $fileSummary->functionCovCount("found", "age", $src_age, 1);
        $fileSummary->functionCovCount("hit", "age", $src_age, 1)
            if $hit;
    }
    return 0;
}

sub _countFunctionTlaData
{
    my ($self, $line, $lineData, $fileSummary) = @_;
    my $func = $lineData->differential_function();

    my %foundFunctionTlas;
    my ($src_age, $developer, $srcLine);

    my $h         = $func->hit();
    my $mergedTla = $h->[1];
    if (!defined($mergedTla)) {
        # LCOV_UNREACHABLE_START
        lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                                  "undef TLA for function '" .
                                      $func->name() .
                                      "' hit " .
                                      $h->[0] .
                                      " at line " .
                                      $line . " (" .
                                      $lineData->tla() . ' ' .
                                      $lineData->curr_count() . ")");
        #die("this should not happen");
        # This is new code - somehow miscategorized.
        $mergedTla = $h->[0] == 0 ? 'UNC' : 'GNC';
        $h->[1] = $mergedTla;
        #return;
        # LCOV_UNREACHABLE_STOP
    }

    if (!grep(/^$mergedTla$/, ('DUB', 'DCB'))) {
        # deleted lines don't have owner data...
        $srcLine = $self->line($line);
        # info might not be available, if no annotations
        if (defined($srcLine)) {
            # should probably look at the source code to find the open/close
            #  parens - then claim the age is the youngest line
            $src_age = $srcLine->age();
            $srcLine->functionElem($func);
        }
    }

    if ($main::merge_function_aliases) {
        _accountFunction($fileSummary, $mergedTla, $src_age);
    } else {
        foreach my $alias ($func->aliasNames()) {
            my $data = $func->alias($alias);
            my $tla  = $data->tla();
            if (!defined($tla)) {
                # LCOV_UNREACHABLE_START
                lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                                          "undef TLA for alias:'$alias' hit:" .
                                              $data->count() .
                                              " of function '" .
                                              $func->name() .
                                              "' hit " .
                                              $h->[0] .
                                              " at line " .
                                              $line . " (" .
                                              $lineData->tla() . ' ' .
                                              $lineData->curr_count() . ")");
                # die("this should not happen either");
                $tla = $data->count() == 0 ? 'UNC' : 'GNC';
                $data->set_tla($tla);
                # LCOV_UNREACHABLE_STOP
            }
            _accountFunction($fileSummary, $tla, $src_age);
        }
    }
}

sub path
{
    my $self = shift;
    return $self->[PATH];
}

sub isProjectFile
{
    # return 'true' if no owner/date information for this file.
    my $self = shift;
    return scalar(%{$self->[LINE_OWNERS]});
}

sub locationHref
{
    # what a link from the page header to one line of this file says - see
    #   CallgraphPageIndex::locationHref, which is the same question asked of a
    #   callees page
    my ($self, $line) = @_;
    return "#L$line";
}

sub line
{
    my $self = shift;
    my $i    = shift;
    die("bad line index '$i'")
        unless ($i =~ /^[0-9]+$/);
    return $self->[LINES]->[$i - 1];
}

sub spanAnnotation
{
    # @return the SourceLine of the most recent edit of lines 'first'..'last':
    #   the one which supplies the date and owner of a statement written over
    #   those lines.  Of two edits made at the same time, the lower line's wins.
    #   A line with no annotation does not count, nor does a synthesized one if
    #   any real line has an annotation.  Undef if no line has one
    my ($self, $first, $last) = @_;
    my ($best, $bestWhen, $synthetic);
    foreach my $i ($first .. $last) {
        my $l = $self->line($i);
        next unless defined($l) && defined($l->age());
        if (defined($l->owner()) && $l->owner() eq 's.n.thetic') {
            $synthetic = $l unless defined($synthetic);
            next;
        }
        if (defined($best)) {
            next if $l->age() > $best->age();
            if ($l->age() == $best->age()) {
                # the same day:  compare the time of the edit
                $bestWhen = lcovutil::parse_w3cdtf($best->date())->epoch()
                    unless defined($bestWhen);
                my $when = lcovutil::parse_w3cdtf($l->date())->epoch();
                next if $when <= $bestWhen;
                $bestWhen = $when;
            } else {
                $bestWhen = undef;
            }
        }
        $best = $l;
    }
    return defined($best) ? $best : $synthetic;
}

sub _attributeStatements
{
    # find the SourceLine which gives the date and owner of each line of each
    #   multi-line statement - see 'spanAnnotation'
    my ($self, $fileCovInfo) = @_;
    my $map = $self->[ATTRIBUTION];
    my %seen;
    while (my ($line, $stmt) = each(%{$fileCovInfo->statements()})) {
        next if $line > $self->num_lines();
        $seen{$stmt} = $self->spanAnnotation(@$stmt)
            unless exists($seen{$stmt});
        my $l = $seen{$stmt};
        $map->{$line} = $l
            if (defined($l) && $l != $self->line($line));
    }
}

sub attribution
{
    # the SourceLine which gives the date and owner of the coverpoints written on
    #   line '$line':  that of its statement if it is part of a multi-line one,
    #   and otherwise its own
    my ($self, $line) = @_;
    my $l = $self->[ATTRIBUTION]->{$line};
    return defined($l) ? $l : $self->line($line);
}

# how old is the oldest (or youngest) line in this file?
#   returns undef if this file has no annotation data at all.
#   Note that we cannot use 'isProjectFile' as the guard here:  the owner
#   bins which it looks at are not filled in until '_countLineTlaData' has
#   visited every line - which happens after the constructor's
#   'recategorizeTlaAsBaseline' check calls us.  Look at the per-line
#   annotation data which '_load' has already stored, instead.
sub age
{
    my ($self, $youngest) = @_;

    my $age;
    foreach my $line (@{$self->lines()}) {
        my $a = $line->age();
        next unless defined($a);
        if (!defined($age) ||
            (defined($youngest) ? $a < $age : $a > $age)) {
            $age = $a;
        }
    }
    return $age;
}

sub lines
{
    my $self = shift;
    return $self->[LINES];
}

sub num_lines
{
    my $self = shift;
    return scalar(@{$self->[LINES]});
}

sub is_empty
{
    my $self = shift;
    # anything interesting here?
    return defined($self->interesting_lines()) &&
        0 == @{$self->interesting_lines()};
}

sub interesting_lines
{
    my $self = shift;
    # return list of lines containing coverpoints, which are marked by
    #  the $selectionCallback - see the --select-script parameter
    return $self->[INTERESTING_LINES];
}

sub binarySearchLine
{
    my ($list, $after) = @_;

    defined($list) && 0 != scalar(@$list) or
        die("invalid location list");

    my $max = $#$list;
    my $min = 0;
    my $mid;
    while (1) {
        $mid = int(($max + $min) / 2);
        my ($v) = $list->[$mid] =~ /^<*([0-9]+)$/; # handle deleted line markers
        if ($v > $after) {
            $max = $mid;
        } elsif ($v < $after) {
            $min = $mid;
        } else {
            while ($list->[$mid] =~ /<<</) {
                # skip deleted
                ++$mid;
                return undef if $mid > $#$list;
            }
            return $mid;
        }
        my $diff = $max - $min;
        if ($diff <= 1) {
            $mid = $min;
            my ($v) = $list->[$min] =~ /^<*([0-9]+)$/;
            $mid = $max
                if $v < $after;
            last;
        }
    }
    while ($list->[$mid] =~ /<<</) {
        # skip deleted
        ++$mid;
        return undef if $mid > $#$list;
    }
    return $list->[$mid] >= $after ? $mid : undef;
}

sub nextTlaGroup
{
    # return number of first line of next group of specified linecov TLA -
    #  for example, if line [5:8] and [13:17] are 'CNC', then:
    #     5 = nextTlaGroup('CBC')     : "after == undef"
    #    13 = nextTlaGroup('CBC', 5)  : skip contiguous group of CBC lines
    #  undef = nextTlaGroup('CBC', 13) : no following group
    my ($self, $tla, $after) = @_;
    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown linecov TLA '$tla'");
        return undef;
    }

    # note that the "$self->line(...)" argument is 1-based (not zero-base)
    my $line;
    if (defined($after) &&
        defined($self->line($after)->tla())) {
        die("$after is not in $tla group")
            unless ($self->line($after)->tla() eq $tla);
        # skip to the end of the current section...
        # if the TLA of this group is unset (non-code line: comment,
        #   blank, etc) - then look for next code line.  If that line's
        #   TLA matches, then treat as a contiguous group.
        # This way, we avoid visual clutter from having a lot of single-line
        #   TLA segments.
        my $lastline = scalar(@{$self->[LINES]});
        for ($line = $after + 1; $line <= $lastline; ++$line) {
            my $t = $self->line($line)->tla();
            last
                if (defined($t) &&
                    $t ne $tla);
        }
    } else {
        $line = 1;
    }
    my $locations = $self->[LINE_CATEGORIES]->{$tla};
    my $idx       = binarySearchLine($locations, $line);
    return defined($idx) ? $locations->[$idx] : undef;
}

sub nextCategoryTlaGroup
{
    # return number of first line of next group of specified branchcov TLA -
    # note that all branch lines are independent - so we will
    # report and go the next branch, even if it is on the adjacent line
    my ($type, $category, $self, $tla, $after) = @_;
    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown $type TLA '$tla'");
        return undef;
    }
    die("no $type data for TLA '$tla'")
        unless exists($self->[$category]->{$tla});
    my $locations = $self->[$category]->{$tla};
    $after = defined($after) ? $after + 1 : 1;
    my $idx = binarySearchLine($locations, $after);
    return defined($idx) ? $locations->[$idx] : undef;
}

sub nextBranchTlaGroup
{
    # ($self, $tla, $after_line)
    return nextCategoryTlaGroup('branch', BRANCH_CATEGORIES, @_);
}

sub nextMcdcTlaGroup
{
    return nextCategoryTlaGroup('MC/DC', MCDC_CATEGORIES, @_);
}

sub nextCallgraphTlaGroup
{
    return nextCategoryTlaGroup('callgraph', CALLGRAPH_CATEGORIES, @_);
}

sub nextInDateBin
{
    my ($self, $dateBin, $tla, $after) = @_;

    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown linecov TLA '$tla'");
        return undef;
    }
    $dateBin <= $#SummaryInfo::ageGroupHeader or
        die("unexpected age group $dateBin");
    # note that the "$self->line(...)" argument is 1-based (not zero-base)
    my $line;
    if (defined($after)) {
        die("$after is not in $tla group")
            unless ($self->line($after)->tla() eq $tla);
        my $lastline = scalar(@{$self->[LINES]});
        # skip to the end of the current section...
        for ($line = $after + 1; $line <= $lastline; ++$line) {
            my $t = $self->line($line)->tla();
            my $a = $self->attribution($line)->age();
            if (!defined($a)) {
                lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                            "no age data for line:$line, file:" . $self->path())
                    if (!$lcovutil::warn_once_per_file ||
                        lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                            $self->path()));
                return undef;
            }
            last
                if (defined($t) &&
                    ($t ne $tla ||
                     $dateBin != SummaryInfo::findAgeBin($a)));
        }
    } else {
        $line = 1;
    }
    # the data isn't stored by date bin (at least for now) - so the
    #   only way to find it currently is by searching forward.
    my $tlaLocations = $self->[LINE_CATEGORIES]->{$tla};
    my $idx          = binarySearchLine($tlaLocations, $line);
    return undef unless defined($idx);
    my $max = scalar(@$tlaLocations);
    for (; $idx < $max; ++$idx) {
        $line = $tlaLocations->[$idx];
        my $l = $self->line($line);
        if (!defined($l)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                                "no data for line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            return undef;
        }
        my $a = $self->attribution($line)->age();
        if (!defined($a)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                            "no age data for line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            return undef;
        }
        my $bin = SummaryInfo::findAgeBin($a);
        if ($bin == $dateBin) {
            my $t = $l->tla();
            return $line
                if (defined($t) &&
                    $t eq $tla);
        }
    }
    return undef;
}

sub nextInOwnerBin
{
    my ($self, $owner, $tla, $after) = @_;

    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown linecov TLA '$tla'");
        return undef;
    }
    unless (exists($self->[LINE_OWNERS]->{$owner}) &&
            exists($self->[LINE_OWNERS]->{$owner}->{$tla})) {
        # LCOV_UNREACHABLE_START
        lcovutil::ignorable_error($lcovutil::ERROR_INTERNAL,
                "$owner not responsible for any $tla lines in" . $self->path());
        return undef;
        # LCOV_UNREACHABLE_STOP
    }

    # note that the "$self->line(...)" argument is 1-based (not zero-base)
    my $line;
    if (defined($after)) {
        ($self->line($after)->tla() eq $tla) or
            die("$after is not in $tla group");

        my $lastline = scalar(@{$self->[LINES]});
        # skip to the end of the current section...
        for ($line = $after + 1; $line <= $lastline; ++$line) {
            my $l = $self->line($line);
            if (!defined($l)) {
                lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                                "no data for line:$line, file:" . $self->path())
                    if (!$lcovutil::warn_once_per_file ||
                        lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                            $self->path()));
                return undef;
            }
            my $t = $l->tla();
            my $o = $self->attribution($line)->owner();
            if (!defined($o)) {
                lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                          "no owner data for line:$line, file:" . $self->path())
                    if (!$lcovutil::warn_once_per_file ||
                        lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                            $self->path()));
                return undef;
            }
            last
                if (defined($t) &&
                    ($t ne $tla ||
                     $o ne $owner));
        }
    } else {
        $line = 1;
    }

    my $locations = $self->[LINE_OWNERS]->{$owner}->{$tla};
    my $idx       = binarySearchLine($locations, $line);
    return defined($idx) ? $locations->[$idx] : undef;
}

sub nextCategoryInDateBin
{
    my ($type, $category, $self, $dateBin, $tla, $after) = @_;

    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown $type TLA '$tla'");
        return undef;
    }
    $dateBin <= $#SummaryInfo::ageGroupHeader or
        die("unexpected age group $dateBin");

    # note that the "$self->line(...)" argument is 1-based (not zero-base)
    $after = defined($after) ? $after + 1 : 1;

    die("no $type $tla in " . $self->path())
        unless exists($self->[$category]->{$tla});

    my $lines = $self->[$category]->{$tla};
    my $idx   = binarySearchLine($lines, $after);

    return undef unless defined($idx);
    my $max = scalar(@$lines);
    for (; $idx < $max; ++$idx) {
        my $line = $lines->[$idx];
        my $l    = $self->line($line);
        if (!defined($l)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                                "no data for line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            next;
        }
        my $a = $self->attribution($line)->age();
        if (!defined($a)) {
            lcovutil::ignorable_error($lcovutil::ERROR_UNMAPPED_LINE,
                            "no age data for line:$line, file:" . $self->path())
                if (!$lcovutil::warn_once_per_file ||
                    lcovutil::warn_once($lcovutil::ERROR_UNMAPPED_LINE,
                                        $self->path()));
            return undef;
        }
        my $bin = SummaryInfo::findAgeBin($a);
        if ($bin == $dateBin) {
            return $line;
        }
    }
    return undef;
}

sub nextBranchInDateBin
{
    # ($self, $dateBin, $tla, $after) = @_;
    return nextCategoryInDateBin('branch', BRANCH_CATEGORIES, @_);
}

sub nextMcdcInDateBin
{
    return nextCategoryInDateBin('MC/DC', MCDC_CATEGORIES, @_);
}

sub nextCallgraphInDateBin
{
    return nextCategoryInDateBin('callgraph', CALLGRAPH_CATEGORIES, @_);
}

sub nextCategoryInOwnerBin
{
    my ($type, $category, $self, $owner, $tla, $after) = @_;

    if (!exists($SummaryInfo::tlaLocation{$tla})) {
        lcovutil::ignorable_error($lcovutil::ERROR_UNKNOWN_CATEGORY,
                                  "unknown $type TLA '$tla'");
        return undef;
    }

    # note that the "$self->line(...)" argument is 1-based (not zero-base)
    $after = defined($after) ? $after + 1 : 1;

    if (exists($self->[$category]->{$owner})) {
        my $od = $self->[$category]->{$owner};
        if (exists($od->{$tla})) {
            my $l   = $od->{$tla};
            my $idx = binarySearchLine($l, $after);
            return defined($idx) ? $l->[$idx] : undef;
        }
    }
    return undef;
}

sub nextBranchInOwnerBin
{
    # ($self, $owner, $tla, $after) = @_;
    return nextCategoryInOwnerBin('branch', BRANCH_OWNERS, @_);
}

sub nextMcdcInOwnerBin
{
    # ($self, $owner, $tla, $after) = @_;
    return nextCategoryInOwnerBin('MC/DC', MCDC_OWNERS, @_);
}

sub nextCallgraphInOwnerBin
{
    # ($self, $owner, $tla, $after) = @_;
    return nextCategoryInOwnerBin('callgraph', CALLGRAPH_OWNERS, @_);
}

sub _computeAge
{
    my ($when, $path) = @_;

    # if SOURCE_DATE_EPOCH is set, then use that as 'now':  age of this
    #   file is as of the epoch date.
    # if this file is newer than that ($when is in the future of epoch) - then
    #  warn and put this file into the 'zero age' bin.
    my $now =
        exists($ENV{SOURCE_DATE_EPOCH}) ?
        DateTime->from_epoch(epoch => $ENV{SOURCE_DATE_EPOCH}) :
        DateTime->now();
    my $then = lcovutil::parse_w3cdtf($when);
    if ($then > $now) {
        if (lcovutil::warn_once($lcovutil::ERROR_INCONSISTENT_DATA, $path)) {
            # issue annotation warning at most once per file
            # also attempt to clarify where the date comes from
            my $data =
                exists($ENV{SOURCE_DATE_EPOCH}) ?
                (
                lcovutil::warn_once($lcovutil::ERROR_INCONSISTENT_DATA,
                                    'SOURCE_DATE_EPOCH') ?
                    "computed from your 'SOURCE_DATE_EPOCH=$ENV{SOURCE_DATE_EPOCH}' environment variable - see 'man genhtml'"
                :
                    "'SOURCE_DATE_EPOCH=$ENV{SOURCE_DATE_EPOCH}'") :
                "'now'";

            lcovutil::ignorable_error($lcovutil::ERROR_INCONSISTENT_DATA,
                "File \"$path\": '$now' ($data) is older than annotate time '$when'"
            );
        }
        return 0;
    }
    return $then->delta_days($now)->in_units('days');
}

sub _load
{
    my ($self, $fileCovInfo) = @_;

    my $start = Time::HiRes::gettimeofday();
    ++$totalFiles;

    my $path = ReadCurrentSource::resolve_path($self->path());
    # try to simplify path - 'realpath' will fail if the file does
    #   not exist - but that might be fine if it exists in the repo
    my $repo_path = Cwd::realpath($path);
    if (!defined($repo_path)) {
        if (!defined($annotateCallback) &&
            !$main::synthesizeMissingFile) {
            my $suffix =
                lcovutil::explain_once('synthesize',
                           ' (see --synthesize-missing option to work around)');
            lcovutil::ignorable_error($lcovutil::ERROR_SOURCE,
                      "\"" . $self->path() . "\" does not exist: $!" . $suffix);
        }
        $repo_path = $self->path();
    }

    # check for version mismatch...
    if (@lcovutil::extractVersionScript) {
        my $currentVersion = $fileCovInfo->version('current');
        my $version        = lcovutil::extractFileVersion($repo_path);
        if (defined($version) &&
            '' ne $version) {
            if (defined($currentVersion)) {
                lcovutil::checkVersionMatch($repo_path, $version,
                                            $currentVersion, 'load');
            } else {
                my $suffix = lcovutil::explain_once('missingVersionMsg',
                    "\n\tSee the 'compute_file_version' section in man lcovrc(5)."
                );
                lcovutil::ignorable_error($lcovutil::ERROR_VERSION,
                    "'$repo_path': computed '$version' but version not defined in 'current' data file "
                        . $main::info_filenames[0]
                        . $suffix);
            }
        } elsif (defined($currentVersion)) {
            lcovutil::ignorable_error($lcovutil::ERROR_VERSION,
                "'$repo_path': version mismatch: your '--version-script' returned empty but 'current' data in "
                    . $main::info_filenames[0]
                    . " defines '$currentVersion'");
        }
        my $end = Time::HiRes::gettimeofday();
        $lcovutil::profileData{check_version}{$self->path()} = $end - $start;
    }

    if (defined($annotateCallback) &&
        # also skip if we already emitted 'missing file' error
        (defined($lcovutil::versionCallback) ||
         !lcovutil::fileExistenceBeforeCallbackError($repo_path))
    ) {
        my $begin = Time::HiRes::gettimeofday();
        my ($status, $lines);
        eval { ($status, $lines) = $annotateCallback->annotate($repo_path); };
        if ($@) {
            my $context = MessageContext::context();
            lcovutil::ignorable_error($lcovutil::ERROR_CALLBACK,
                          'annotate(' . $self->path() . ") failed$context: $@");
            $status = 1;
            # set $lines so exit status error below prints something
            $lines = [[$@]];
        }
        if (!$status && defined($lines)) {
            my $found;   # check that either all lines are annotated or none are
            my $lineNum = 0;
            foreach my $line (@$lines) {
                my ($text, $abbrev, $full, $when, $commit) = @$line;
                ++$lineNum;    # source line numbers start at 1 (one)
                my $age = _computeAge($when, $path);
                if ($commit ne 'NONE') {
                    die("inconsistent 'annotate' data for '$repo_path': both 'commit' and 'no commit' lines"
                    ) if (defined($found) && !$found);
                    $found = 1;
                    defined($abbrev) or
                        die("owner is undef for $repo_path:$lineNum");
                } else {
                    die("inconsistent 'annotate' data for '$repo_path': both 'no commit' and 'commit' lines"
                    ) if (defined($found) && $found);
                    $found  = 0;
                    $abbrev = "no.body";
                }
                $full = $abbrev unless defined($full);
                push @{$self->[LINES]},
                    SourceLine->new($lineNum, $text, $abbrev, $full,
                                    $when, $age, $commit);
            }
            my $end = Time::HiRes::gettimeofday();
            $lcovutil::profileData{annotate}{$self->path()} = $end - $begin;

            ++$annotatedFiles if $found;
            $self->_synthesize($fileCovInfo, 1);    # fake annotations too
            return $self;
        } else {
            # non-zero exit status:  something bad happened in annotation
            # if we ignore the error - then fall through and just try to
            # load the file
            my $text = '';
            $text = ': ' . $lines->[0]->[0] . '...'
                if $lines && @$lines;
            # might be useful to provide more than one line of context - if
            #  there is more than one line?
            lcovutil::report_exit_status($lcovutil::ERROR_ANNOTATE_SCRIPT,
                                         "annotate command failed",
                                         $status, '', $text);
        }    # end if error
    }    # end if annotate script exists

    # Check if file exists and is readable
    my $begin = Time::HiRes::gettimeofday();
    if (!-r $path) {
        # perhaps this error should be ignorable: if the source is not
        #  found and the 'source' error is ignored, then synthesize
        # Note that we can't extract version data from synthesized code.
        if ($main::synthesizeMissingFile ||
            # don't complain if we weren't going to do anything with the file -
            # not generating source view and not checking versions or annotating
            ($main::no_sourceview &&
             0 == scalar(@lcovutil::extractVersionScript) &&
             !lcovutil::is_filter_enabled())
        ) {
            $self->_synthesize($fileCovInfo,
                               defined($SourceFile::annotateCallback));
            my $end = Time::HiRes::gettimeofday();
            $lcovutil::profileData{synth}{$self->path()} = $end - $begin;
            return $self;
        }
        die($self->path() .
                " is not readable or doesn't exist. See the '--substitute', '--filter missing' and '--synthesize-missing' $lcovutil::tool_name options for methods to fix the path or ignore the problem."
        );
    }
    $self->_bare_load($path);
    $self->_synthesize($fileCovInfo, defined($SourceFile::annotateCallback));
    my $end = Time::HiRes::gettimeofday();
    $lcovutil::profileData{load}{$self->path()} = $end - $begin;
    return $self;
}

sub _synthesize
{
    my ($self, $fileCovInfo, $annotate) = @_;

    my $lineData    = $fileCovInfo->lineMap();
    my $currentLast = scalar(@{$self->[LINES]});
    my $last_line   = 0;
    while (my ($l, $d) = each(%$lineData)) {
        $last_line = $l if ('<' ne substr($l, 0, 1) && $l > $last_line);
    }
    my %functionDecls;
    if ($lcovutil::func_coverage) {
        while (my ($fnName, $funcEntry) = each(%{$fileCovInfo->functionMap()}))
        {
            my $tla = $funcEntry->hit()->[1];
            # deleted function doesn't count
            next if exists($SummaryInfo::deletedTla{$tla});
            my $line = $funcEntry->line();
            my $end  = $funcEntry->end_line();
            $last_line = $line if $line > $last_line;
            $functionDecls{$line} = "/* BEGIN: function \"$fnName\" */"
                if ($line >= $currentLast);
            if (defined($end)) {
                $functionDecls{$end} = "/* END: function \"$fnName\" */"
                    if ($end >= $currentLast);
                if ($end > $last_line) {
                    # function end is not an executable line,
                    # but is after last executable line
                    $last_line = $end;
                }
            }
        }
    }
    return $self if ($last_line < 1 ||
                     $currentLast >= $last_line);
    my $why;
    if (0 == $currentLast) {
        # Synthesize source data from coverage trace to replace unreadable file
        my $suffix =
            $lcovutil::ignore[$lcovutil::ERROR_SOURCE] ?
            ' - synthesizing fake content.' :
            '.';
        lcovutil::ignorable_error($lcovutil::ERROR_SOURCE,
                                  "cannot read '" .
                                      $self->path() .
                                      "' - file is empty or unreadable$suffix"
        ) unless $main::no_sourceview;
        $why = 'empty or unreadable';
    } else {
        my $suffix = '';
        if ($lcovutil::ignore[$lcovutil::ERROR_RANGE]) {
            my $num    = $last_line - $currentLast;
            my $plural = $num == 1 ? 'line' : "$num lines";
            $suffix = ' ... synthesizing fake content for last ' . $plural;
        }
        lcovutil::ignorable_error(
                                $lcovutil::ERROR_RANGE,
                                $self->path() .
                                    ' contains only ' .
                                    $currentLast .
                                    ' lines but coverage data refers to line ' .
                                    $last_line .
                                    $suffix);
        $why = 'not long enough';
    }
    # Simulate gcov behaviour
    my $notFound = "/* " . $self->path() . " $why */";
    my $synth    = "/* (content generated from coverage data) */";
    my $idx      = 1;
    my @fakeline = (undef,    # line number
                    undef);    # source text
    if ($annotate) {
        my $now =
            exists($ENV{SOURCE_DATE_EPOCH}) ?
            DateTime->from_epoch(epoch => $ENV{SOURCE_DATE_EPOCH}) :
            DateTime->now();
        push(@fakeline, 's.n.thetic',             # owner
             'faked synthetic user',              # full name
             $now,                                # when
             _computeAge($now, $self->path()),    # age
             'synthesized');    # commit ID
    }
    for (my $line = $currentLast + 1; $line <= $last_line; $line++) {
        my $mod = $idx++ % 20;
        my $text;
        # if there is function decl here...mark it.
        if (exists($functionDecls{$line})) {
            $text = $functionDecls{$line};
        } else {
            $text = (($mod == 1) ? $notFound :
                         ($mod == 2) ? $synth :
                         "/* ... */");
        }
        splice(@fakeline, 0, 2, $line, $text);
        push(@{$self->[LINES]}, SourceLine->new(@fakeline));
    }
    return $self;
}

sub _bare_load
{
    my ($self, $path) = @_;

    my $lineno = 0;
    local *HANDLE;    # File handle for reading the diff file

    open(HANDLE, "<", $path) or
        die("unable to open '" . $self->path() . "': $!\n");
    while (my $line = <HANDLE>) {
        chomp $line;
        $line =~ s/\r//g;    # Also remove CR from line-end

        $lineno++;
        push @{$self->[LINES]}, SourceLine->new($lineno, $line);
    }
    close(HANDLE) or die("unable to close $path: $!\n");
    return $self;
}

# a class to hold either line or branch counts for each testcase -
#   used by the "--show-details" feature.
package TestcaseTlaCount;

sub new
{
    # $testcaseCounts: either 'CountData' or 'BranchData' structure
    #     - the data for this testcase
    # $fileDetails: SourceFile structure - data for the filename
    # $covtype:  'line' or 'branch'
    my ($class, $testcaseCounts, $fileDetails, $covtype) = @_;

    my %tlaData;
    if ($covtype != SummaryInfo::FUNCTION_DATA) {
        $tlaData{found} = $testcaseCounts->found();
        $tlaData{hit}   = $testcaseCounts->hit();
    } else {
        $tlaData{found} =
            $testcaseCounts->numFunc($main::merge_function_aliases);
        $tlaData{hit} = $testcaseCounts->numHit($main::merge_function_aliases);
    }
    if ($main::show_tla &&
        defined($fileDetails)) {
        for my $tla (("CBC", "GBC", "GIC", "GNC")) {
            $tlaData{$tla} = 0;
        }
        if (SummaryInfo::LINE_DATA == $covtype) {
            foreach my $line ($testcaseCounts->keylist()) {
                # skip uncovered lines...
                next if $testcaseCounts->value($line) == 0;
                my $lineData =
                    $fileDetails->line($line);    # "SourceLine" structure
                my $tla = $lineData->tla();
                die("unexpected TLA '$tla' in CountData for line $line")
                    unless exists($tlaData{$tla});
                $tlaData{$tla} += 1;
            }
        } elsif (SummaryInfo::BRANCH_DATA == $covtype) {
            foreach my $line ($testcaseCounts->keylist()) {
                my $lineData =
                    $fileDetails->line($line);    # "SourceLine" structure
                my $branchEntry = $lineData->branchElem();
                foreach my $blk ($branchEntry->blocks()) {
                    my $block = $blk->elements();
                    foreach my $br (@$block) {
                        $tlaData{$br->tla()} += 1;
                    }
                }
            }
        } elsif (SummaryInfo::MCDC_DATA == $covtype) {
            foreach my $line ($testcaseCounts->keylist()) {
                my $lineData =
                    $fileDetails->line($line);    # "SourceLine" structure
                my $mcdcEntry  = $lineData->mcdcElem();
                my $mcdcGroups = $mcdcEntry->groups();
                while (my ($groupSize, $group) = each(%$mcdcGroups)) {
                    foreach my $expr (@$group) {
                        foreach my $sense (0, 1) {
                            # use 'current' count...
                            my ($tla, $b_count, $c_count) =
                                @{$expr->count($sense)};
                            $tlaData{$tla} += 1;
                        }
                    }
                }
            }
        } else {
            die("$covtype not supported yet")
                unless $covtype == SummaryInfo::FUNCTION_DATA;
            foreach my $key ($testcaseCounts->keylist()) {
                my $func = $testcaseCounts->findKey($key);
                my $line = $func->line();
                # differential FunctionEntry
                my $lineData     = $fileDetails->line($line);
                my $differential = $lineData->functionElem();
                my @tlas;
                if ($main::merge_function_aliases) {
                    push(@tlas, $differential->hit()->[1]);
                } else {
                    foreach my $alias ($differential->aliasNames()) {
                        push(@tlas, $differential->alias($alias)->tla());
                    }
                }
                foreach my $tla (@tlas) {
                    $tlaData{$tla} += 1;
                }
            }
        }
    }
    my $self = [$testcaseCounts, $fileDetails, \%tlaData, $covtype];
    bless $self, $class;
    return $self;
}

sub covtype
{
    my $self = shift;
    return $self->[3];
}

sub count
{
    my ($self, $tla) = @_;

    my $tlaCounts = $self->[2];
    return exists($tlaCounts->{$tla}) ? $tlaCounts->{$tla} : 0;
}

package GenHtml;

use constant {
              TOP         => 0,
              WORKLIST    => 1,
              PENDING     => 2,
              JOBS        => 3,
              FORK_MGR    => 4,
              TMPDIR      => 5,
              DELAY_TIMER => 6,
              WEIGHTS     => 7,
};

sub new
{
    my ($class, $current_data) = @_;
    my $self = [
           SummaryInfo->new("top", ''),    # top has empty name
           [], # worklist: dependencies are complete - this can run immediately
           {}, # %pending; # map of name->list of as-yet incomplete dependencies
               # This task can be scheduled as soon as its last dependency
               #  is complete.
           [], # jobs which are to be scheduled for execution
           undef,    # the fork manager - 'compute' owns the children, the retry
                     #   counts and the count of jobs currently running
           File::Temp->newdir(
                          "genhtml_XXXX",
                          DIR     => $lcovutil::tmp_dir,
                          CLEANUP => !defined($lcovutil::preserve_intermediates)
           ),
           0,        # delay timer
           {},       # file key -> its record count, for the memory throttle
    ];
    bless $self, $class;

    lcovutil::info(1, "Writing temporary data to " . $self->[TMPDIR] . "\n");
    my $pending           = $self->[PENDING];
    my $worklist          = $self->[WORKLIST];
    my $top_level_summary = $self->[0];
    # no parent data for top-level
    my $toplevelPerTestData =
        ($main::hierarchical || $main::flat) ? [{}, {}, {}, {}] : undef;
    $pending->{""} = [
                      ['top',
                       [$top_level_summary, $toplevelPerTestData,
                        $top_level_summary->name()
                       ],
                       ['root'],
                       ['root'],
                       [undef, undef]
                      ],
                      {}
    ];

    # if the worklist is sorted alphabetically, then each segment tends to
    #   contain files from the same directory.
    # However, large files (which may take a long time to process) often
    #   cluster inside the same directory - so a random (hash) order often
    #   performs better.
    # Better is to look at profile data from the prior execution of
    #   this job - say, from last night's regressions - and to distribute
    #   the files we think will be long-running (...because they ran a long
    #   the last time) into different segments so they can run in parallel.
    # We also want to schedule those long-running files so they are executed
    #   first.  That way, we don't end up starting some long job late in the
    #   game - and then have to wait a long time for a single task to finish
    #   (as opposed to it running in parallel with a lot of other stuff).
    # A file whose predicted runtime is large enough gets its own dedicated
    #   segment (see $lcovutil::dedicate_segment_threshold) so it is not
    #   batched behind up to $max_tasks_per_core other files and does not
    #   serialize the tail of the run.  Such files are also scheduled first.
    # The prediction is EXACT when '--history-script' data is available (we
    #   know how long the file took last time).  Without history, we only
    #   estimate - from the instrumented-line count - for files large enough
    #   to plausibly cross the threshold; every other unknown file stays cheap
    #   and is handled as before.
    my @predicted;    # [$f, $filename, $predictedSeconds]
    my @unknown;      # no useful prediction
    my $weights = $self->[WEIGHTS];
    foreach my $f ($current_data->files()) {
        my $traceInfo = $current_data->data($f);
        # This is the name every output path below is derived from - the
        #   directory hierarchy, the page names, the links between them - so it
        #   is the name in this platform's spelling, whatever spelling the input
        #   used.  See 'lcovutil::native_path';  '$f' is still the name as read,
        #   and is what the data is keyed by
        my $filename =
            lcovutil::native_path(
                       ReadCurrentSource::resolve_path($traceInfo->filename()));

        # What a child which is given this file has to hold:  its records, which
        #   the memory throttle turns into bytes with a rate it measures - see
        #   'lcovutil::ForkManager::_estimate'.  Collected here because this is
        #   the one place which already has the file's data in hand;  the
        #   scheduler only ever sees the summary object.
        $weights->{$f} = $traceInfo->found() + $traceInfo->branch_found();

        my $predicted;
        if (   defined($lcovutil::profileHistoryCallback)
            &&
            defined($predicted =
                        $lcovutil::profileHistoryCallback->history($filename))
        ) {
            # exact - this is how long the file took the last time it ran
            push(@predicted, [$f, $filename, $predicted]);
        } elsif ($lcovutil::dedicate_segment_threshold &&
             $lcovutil::dedicate_segment_line_estimate &&
             $traceInfo->found() >= $lcovutil::dedicate_segment_line_estimate) {
            # no history, but the file is large enough that we should guess:
            #   estimate runtime from instrumented lines so a big straggler
            #   still gets a dedicated segment on a first (history-less) run
            push(@predicted,
                 [$f,
                  $filename,
                  $traceInfo->found() /
                      $lcovutil::dedicate_segment_line_estimate
                 ]);
        } else {
            # put the ones we don't know about at the start of the list
            #  - work on them first, trusting that we will have parallelism
            #    capacity for the ones we know about
            push(@unknown, [$f, $filename]);
        }
    }
    lcovutil::info(scalar(@unknown) . ' (of ' .
                       (scalar(@predicted) + scalar(@unknown)) .
                       ") files do not appear in \'--history\' profile.\n")
        if (defined($lcovutil::profileHistoryCallback) &&
            @unknown);

    # sort the 'predicted' ones based on expected execution time
    #  tie break alphabetically
    @predicted =
        sort({ $b->[2] <=> $a->[2] or $a->[1] cmp $b->[1] } @predicted);

    # Split off the files predicted to run at least the threshold: these get
    #   their own dedicated segment.  @fileOrder entries are
    #   [$f, $filename, $isDedicated].
    my @fileOrder;
    my @shared;
    foreach my $p (@predicted) {
        if ($lcovutil::dedicate_segment_threshold &&
            $p->[2] >= $lcovutil::dedicate_segment_threshold) {
            # already in descending-cost order - schedule first, one per
            #  segment (dedicated flag = 1)
            push(@fileOrder, [$p->[0], $p->[1], 1]);
        } else {
            push(@shared, $p);
        }
    }
    lcovutil::info(
                scalar(@fileOrder) . " file(s) assigned a dedicated segment.\n")
        if @fileOrder;

    # interleave the remaining long-running files so they get distributed
    #  between segments
    my $offset = 0;
    my $idx    = 0;
    for (my $i = 0; $i <= $#shared; ++$i) {
        push(@fileOrder, [$shared[$idx]->[0], $shared[$idx]->[1], 0]);
        $idx += $lcovutil::maxParallelism;
        if ($idx > $#shared) {
            ++$offset;
            $idx = $offset;
        }
    }
    push(@fileOrder, [$_->[0], $_->[1], 0]) foreach @unknown;  # unknown to back

    foreach my $d (@fileOrder) {
        my ($f, $filename, $dedicated) = @$d;
        #my $traceInfo = $current_data->data($f);
        #my $filename  = ReadCurrentSource::resolve_path($traceInfo->filename());
        my ($vol, $parentDir, $file) = File::Spec->splitpath($filename);
        if (!File::Spec->file_name_is_absolute($filename)) {
            if ($parentDir) {
                $parentDir = File::Spec->catfile($main::cwd, $parentDir);
            } else {
                $parentDir = $main::cwd;
            }
            $filename = File::Spec->catfile($parentDir, $file);
        }
        my $short_name =
            $main::no_prefix ? $filename :
            main::apply_prefix($filename, @main::dir_prefix);
        my $is_absolute = File::Spec->file_name_is_absolute($short_name);
        # a host which takes both separators takes a name rooted at either
        my $root =
            $lcovutil::accepts_both_separators ? '[\\\\/]' :
            $lcovutil::dirseparator_re;
        $short_name =~ s|^$root||;
        my @short_path = File::Spec->splitdir($short_name);
        my @path       = File::Spec->splitdir($parentDir);

        my @rel_dir_stack =
            @short_path;    # @rel_dir_stack: relative path to parent dir of $f
        pop(@rel_dir_stack);    # remove filename from the end
        my $pendingParent;
        if ($main::hierarchical) {
            # excludes trailing '/'
            my $base = substr($filename, 0, -(length($short_name) + 1));
            my $relative_path = "";
            my $path          = $base;
            $pendingParent =
                $pending->{""};    # this is the top-level object dependency
            my @sp;
            my @p = split(/$lcovutil::dirseparator_re/, substr($base, 0, -1))
                ;                  # remove trailing '/'
            while (scalar(@rel_dir_stack)) {
                my $element = shift(@rel_dir_stack);
                $relative_path .= $element;
                $path          .= $lcovutil::dirseparator . $element;
                push(@p, $element);
                push(@sp, $element);
                if (exists($pending->{$path})) {
                    $pendingParent = $pending->{$path};
                } else {
                    my $perTestData = [{}, {}, {}, {}];

                    my @dirData = (SummaryInfo->new("directory", $relative_path,
                                                    $is_absolute),
                                   $perTestData,
                                   $path);
                    add_dependency($pendingParent, $path);
                    my @spc = @sp;
                    my @pc  = @p;
                    $pendingParent = [
                                      ['dir', \@dirData,
                                       \@spc, \@pc,
                                       $pendingParent
                                      ],
                                      {}
                    ];
                    die("unexpected pending entry")
                        if exists($pending->{$dirData[2]});
                    $pending->{$dirData[2]} = $pendingParent;
                }
                $relative_path .= $lcovutil::dirseparator;
            }
        } elsif (!$main::flat) {
            # not hierarchical
            my $relative_path = File::Spec->catdir(@rel_dir_stack);
            if (!exists($pending->{$parentDir})) {
                my $perTestData = [{}, {}, {}, {}];
                my @dirData = (SummaryInfo->new(
                                       "directory", $relative_path, $is_absolute
                               ),
                               $perTestData,
                               $parentDir);
                $pending->{$parentDir} = [
                                     ['dir', \@dirData, \@rel_dir_stack, \@path,
                                      $pending->{$top_level_summary->name()}
                                     ],
                                     {}
                ];
            }
            $pendingParent = $pending->{$parentDir};

            # my directory is dependency for the top-level
            add_dependency($pending->{$top_level_summary->name()}, $parentDir);
        }

        # current file is a dependency of the top-level for a flat (2-level)
        #  report - or of the parent directory otherwise
        my $mergeInto = $main::flat ? $pending->{$top_level_summary->name()} :
            $pendingParent;
        add_dependency($mergeInto, $f);
        # this file is ready to be processed
        # 4-element tuple: [summary, [{line},{branch},{fn}], file, mcdc_hash]
        # index [3] (mcdc_hash) accessed at line 13484; must be present
        my @fileData =
            (SummaryInfo->new("file", $filename), [{}, {}, {}], $f, {});
        # tuple index [5] (dedicated) flags a file that should occupy its own
        #  segment - see _segment_worklist
        push(@$worklist,
             ['file', \@fileData, \@short_path, \@path, $mergeInto, $dedicated]
        );
        # Where this file's pages will be written, keyed by the name the report
        #   knows the file by.  The cross-file hyperlinks of the call site page
        #   need the page location of a file other than the one being processed,
        #   and 'SummaryInfo::relativeDir' cannot answer that:  it is set per task
        #   as the task is dispatched, so in a forked child only the files of
        #   that child's own segment have it.  This is the same
        #   computation '_segment_worklist' does, made once here in the parent so
        #   that every child inherits the whole map across the fork
        if ($lcovutil::callgraph_coverage) {
            my $pageDir =
                File::Spec->catdir(@short_path[0 .. $#short_path - 1]);
            $main::filePageDir{$f} =
                $lcovutil::case_insensitive ? lc($pageDir) : $pageDir;
        }
    }

    $self->compute();
    # remove empty directories produced when no data in the directory
    #   was selected.  We want to clean both the directory and its parents.
    foreach my $dir (@cleanDirectoryList) {
        while ($dir) {
            my $d = File::Spec->catfile($main::output_directory, $dir);
            if (-d $d) {
                print("removing empty $d\n");
                if (!rmdir($d)) {
                    # directory not empty - stop
                    last;
                }
            }
            $d = File::Basename::dirname($dir);    # look up
            last if $d eq $dir;
            $dir = $d;
        }
    }
    $lcovutil::profileData{mergeDelayTimer} = $self->[DELAY_TIMER];
    printf("overall delay: %0.3fs\n", $self->[DELAY_TIMER])
        if $main::debugScheduler;
    return $self;
}

sub top()
{
    my $self = shift;
    return $self->[0];
}

sub add_dependency
{
    my ($parent, $name) = @_;
    lcovutil::debug(1,
                    "add depend '$name' in -> " . $parent->[0]->[1]->[2] . "\n")
        unless exists($parent->[1]->{$name});
    print("add depend $name -> " . $parent->[0]->[1]->[2] . "\n")
        if $main::debugScheduler > 1;
    $parent->[1]->{$name} = 1;
}

sub completed_dependency
{
    # return 0 when last dependency is removed
    my ($self, $parent, $name) = @_;

    my $pending = $self->[PENDING];
    die("missing pending '$parent'")
        unless exists($pending->{$parent});
    my $pendingParent = $pending->{$parent};
    die("missing pending entry for $name (in $parent")
        unless exists($pendingParent->[1]->{$name});
    delete($pendingParent->[1]->{$name});
    print("completed $name -> $parent " . scalar(%{$pendingParent->[1]}) . "\n")
        if $main::debugScheduler > 1;
    # LCOV_EXCL_START
    if ($main::debugScheduler > 1) {
        # print parent dependencies
        while (my ($k, $d) = each(%{$pendingParent->[1]})) {
            die("unexpected parent dependency $k ARRAY: " .
                $d->[0] . ' ' .
                join('/', @{$d->[2]}))
                if ('ARRAY' eq ref($d) || 1 != $d);
            print("  $k\n");
        }
    }
    # LCOV_EXCL_STOP
    if (!%{$pendingParent->[1]}) {
        # no more dependencies - schedule this one
        my $p = $pendingParent->[0];
        print("completed dependencies - schedule " .
              $p->[0] . ' ' .
              join('/', @{$p->[2]}) . "\n")
            if $main::debugScheduler > 1;
        push(@{$self->[WORKLIST]}, $p);
        delete($pending->{$parent});
    }
}

sub merge_one
{
    my ($self, $parentPerTestData, $fullname, $perTest, $summary,
        $parentSummary, $parentPath, $parallel)
        = @_;
    my $type = $summary->type();
    if ('file' eq $type) {
        # the key the file table looks this up under - so the same last element
        #   'process_file' wrote the pages under.  '$fullname' is the name as
        #   read (it is what the dependency bookkeeping below is keyed by), so
        #   it has to be spelled for this platform first
        my $base_name =
            File::Basename::basename(lcovutil::native_path($fullname));
        for (my $i = 0; $i < scalar(@$perTest); $i++) {
            $parentPerTestData->[$i]->{$base_name} = $perTest->[$i];
        }
    } elsif ('directory' eq $type) {
        for (my $i = 0; $i < scalar(@$perTest); $i++) {
            while (my ($basename, $data) = each(%{$perTest->[$i]})) {
                $parentPerTestData->[$i]->{$basename} = $data;
            }
        }
    } else {
        die("unexpected type $type")
            unless $type eq 'top';
        # set the top-level to this (restored) value...
        $self->[0] = $summary if $parallel;
    }
    if ($type ne 'top') {
        my $mergeInto = $main::flat ? $self->top() : $parentSummary;
        $mergeInto->append($summary);

        my $parentName = $main::flat ? '' : $parentPath;
        $self->completed_dependency($parentName, $fullname);
    }
}

sub compute_one
{
    my ($type, $name, $summary, $parentSummary, $perTestData,
        $rel_dir, $base_dir, $trunc_dir)
        = @_;

    my $start = Time::HiRes::gettimeofday();

    if ('file' eq $type) {
        my ($testdata, $testfncdata, $testbrdata, $testcase_mcdc) =
            main::process_file($summary, $parentSummary,
                               $trunc_dir, $rel_dir, $name);
        $perTestData = [$testdata, $testfncdata, $testbrdata, $testcase_mcdc];
    } elsif ('dir' eq $type) {
        # process the directory...
        main::write_summary_pages($name, 1,    # this is a directory,
                                  $summary, $main::show_details,
                                  $rel_dir, $base_dir, $trunc_dir,
                                  $perTestData);
    } else {
        die("unexpected task")
            unless 'top' eq $type;
        # Create sorted pages
        main::write_summary_pages($name, 0,    # 0 == list directories
                                  $summary,
                                  # generate top-level 'details' in flat or hierarchical modes
                                  $main::show_details &&
                                      ($main::flat || $main::hierarchical),
                                  ".", "", undef, $perTestData);
    }
    $summary->checkCoverageCriteria();
    if ('file' eq $type &&
        1 < $lcovutil::maxParallelism &&
        !($main::buildSerializableDatabase || $main::show_details)) {
        if ($main::no_sourceview ||
            $main::frames ||
            !$main::show_tla) {
            $summary->[SummaryInfo::FILE_DETAILS] = undef;
        } elsif ($main::show_tla) {
            # just store the location of the first coverpoint in each display
            #   group - rather than returning the whole detail structure?
            $summary->[SummaryInfo::FILE_DETAILS]->simplify();
        }
    }
    my $end = Time::HiRes::gettimeofday();
    $lcovutil::profileData{file}{$name} = $end - $start;

    return $perTestData;
}

sub _running
{
    # how many of our jobs are in flight.  The manager owns the children, and
    #   it exists for the whole of 'compute' - which is the only place that
    #   forks - so anywhere else the answer is none.
    my $mgr = $_[0]->[FORK_MGR];
    return $mgr ? $mgr->count() : 0;
}

sub _reschedule
{
    my ($self, $jobID, $jobs) = @_;
    # clean up
    foreach my $task (@$jobs) {
        my $selfSummary = $task->[1];
        $selfSummary->unsetDirs();    # reset state
    }
    push(@{$self->[JOBS]}, [$jobs, $jobID]);    # put job back
    print(" reschedule $jobID current:",
          $self->_running(), " jobs: ", scalar(@{$self->[JOBS]}), "\n")
        if $main::debugScheduler;
}

sub _process_child
{
    # I'm the child:  compute my jobs and hand the results back.  The manager
    #   owns the capture, the log files and the dump - see 'ForkManager'.
    my ($self, $jobs, $jobId) = @_;

    my $childStart = Time::HiRes::gettimeofday();
    # clear counters so we store count only what we saw in the child
    $SourceFile::annotatedFiles = 0;
    $SourceFile::totalFiles     = 0;

    my $status = 0;
    my @rtnData;
    # a scope, not a loop:  the manager's capture used to be here, and the work
    #   below is what it wrapped
    {
        foreach my $t (@$jobs) {
            my ($task, $sSummary, $rel_dir, $full_dir_path, $base_dir,
                $trunc_dir)
                = @$t;
            my @taskData;
            push(@rtnData, \@taskData);

            my ($type, $data, $short_path, $path, $parentData) = @$task;
            my ($selfSummary, $perTestData, $name) = @$data;
            die("inconsistent")
                unless $selfSummary == $sSummary;
            my ($parentSummary, $parentPerTestData, $parentPath);
            ($parentSummary, $parentPerTestData, $parentPath) =
                @{$parentData->[0]->[1]}
                unless 'top' eq $type;

            eval {
                my $thisTestData =
                    compute_one($type, $name, $selfSummary, $parentSummary,
                                $perTestData, $rel_dir, $base_dir, $trunc_dir);

                # clear the parent pointer that we hacked into place.  Don't want that
                #   extra data returned by dumper.
                $selfSummary->[SummaryInfo::PARENT]  = undef;
                $selfSummary->[SummaryInfo::SOURCES] = {}
                    if $selfSummary->type() ne 'file';
                my $objname =
                    $selfSummary->type() eq 'top' ? "" : $selfSummary->name();
                my $criteria;
                $criteria = $CoverageCriteria::coverageCriteria{$objname}
                    if exists($CoverageCriteria::coverageCriteria{$objname});

                push(@taskData,
                     $thisTestData, $parentPerTestData,
                     $selfSummary, $criteria);
            };    # eval
            if ($@) {
                $status = 1;
                print(STDERR $@);
                # @todo maybe this should be an ignorable error
                next;
            }

        }    # foreach
    }

    my $childEnd = Time::HiRes::gettimeofday();
    $lcovutil::profileData{child}{$jobId} = $childEnd - $childStart;
    return ([\@rtnData,
             [$SourceFile::annotatedFiles, $SourceFile::totalFiles],
             [$childStart, $childEnd]
            ],
            $status);
}

sub _segment_worklist
{
    my ($self, $segmentID) = @_;
    my $worklist = $self->[WORKLIST];

    my $nTasks = scalar(@$worklist);
    # how many cores are available?
    my $nCores = $lcovutil::maxParallelism - $self->_running();
    # let's distribute them evenly
    #   could be more sophisticated and look at the compute time used
    #   by each of those tasks previously - then balance the expected load
    my $tasksPerCore =
        $lcovutil::maxParallelism > 1 ? ($nTasks + $nCores - 1) / $nCores :
        1;
    $tasksPerCore = $lcovutil::max_tasks_per_core
        if ($tasksPerCore > $lcovutil::max_tasks_per_core);
    while (@$worklist &&
           scalar(@{$self->[JOBS]}) <= $nCores) {
        # How many tasks go in this segment?  Normally $tasksPerCore, but a
        #  file flagged 'dedicated' (worklist tuple index [5]) gets a segment
        #  to itself: if the next task is dedicated, take just it; otherwise
        #  take a normal batch but stop before the first dedicated task so it
        #  starts a fresh segment.
        my $batch = $tasksPerCore;
        if ($worklist->[0]->[5]) {
            $batch = 1;
        } else {
            for (my $i = 1; $i < $batch && $i < scalar(@$worklist); ++$i) {
                if ($worklist->[$i]->[5]) {
                    $batch = $i;
                    last;
                }
            }
        }
        my @jobs;
        push(@{$self->[JOBS]}, [\@jobs, $segmentID++]);
        foreach my $task (splice(@$worklist, 0, $batch)) {
            my ($type, $data, $short_path, $path, $parentData) = @$task;
            my ($selfSummary, $perTestData, $name) = @$data;
            #main::info("$type: $name\n");
            # break initialization into 2 statements - see
            # https://stackoverflow.com/questions/26676488/why-is-the-variable-not-available
            my ($parentSummary, $parentPerTestData, $parentPath);
            ($parentSummary, $parentPerTestData, $parentPath) =
                @{$parentData->[0]->[1]}
                unless 'top' eq $type;

            my $rel_dir;
            my $full_dir_path;
            if ($type eq 'file') {
                $rel_dir =
                    File::Spec->catdir(@{$short_path}[0 .. $#$short_path - 1]);
                die("file error for " . File::Spec->catdir(@$short_path))
                    if '' eq $rel_dir;
                $full_dir_path = File::Spec->catdir(@{$path}[0 .. $#$path - 1]);
            } elsif ($type eq 'dir') {
                $rel_dir       = File::Spec->catdir(@$short_path);
                $full_dir_path = File::Spec->catdir(@$path);
            } else {
                $rel_dir       = '.';
                $full_dir_path = '.';
            }
            $rel_dir = lc($rel_dir) if ($lcovutil::case_insensitive);
            my $p = File::Spec->catdir($main::output_directory, $rel_dir);
            File::Path::make_path($p) unless -d $p || $main::no_html;
            my $base_dir  = main::get_relative_base_path($rel_dir);
            my $trunc_dir = ($rel_dir eq '') ? 'root' : $rel_dir;

            push(@jobs,
                 [$task, $selfSummary, $rel_dir,
                  $full_dir_path, $base_dir, $trunc_dir
                 ]);
        }    # foreach task assigned to this core
    }
    return $segmentID;
}

sub compute
{
    my $self = shift;

    my $worklist  = $self->[WORKLIST];
    my $pending   = $self->[PENDING];
    my $joblist   = $self->[JOBS];
    my $segmentID = 0;

    # This scheduler cannot use 'ForkManager::run':  its queue is dependency
    #   ordered (a job becomes runnable when the last job it depends on is
    #   merged), so it dispatches from its own job list and drives 'throttle',
    #   'fork_one' and 'reap_one' itself.  Everything below the dispatch - the
    #   child wrapper, the reap, the retries and the profile keys - is in the
    #   common framework.
    my $mgr =
        lcovutil::ForkManager->new(
                 operation => 'genhtml',
                 phase     => 'segment',
                 tempDir   => '' . $self->[TMPDIR],
                 prefix    => 'genhtml',
                 # non-parallel execution prints stuff to stdout - so we should too
                 showStdout => ($lcovutil::verbose >= 0),
                 # the segment children are the big ones:  a job is a set of files whose
                 #   source, annotations and per-testcase detail all have to be live at
                 #   once
                 memoryThrottle => 1,
                 # ..and how much of that there is scales with the records of the files in
                 #   the job.  A directory or top-level job aggregates what its children
                 #   already computed and weighs nothing here, which leaves the estimate
                 #   at "a copy of us" for it - see 'ForkManager::_estimate'.
                 unitWeight => sub {
                     my $jobs   = shift;
                     my $weight = 0;
                     foreach my $task (@$jobs) {
                         next unless 'file' eq $task->[0]->[0];
                         $weight += $self->[WEIGHTS]->{$task->[0]->[1]->[2]}
                             // 0;
                     }
                     return $weight;
                 },
                 remaining => sub {
                     # not covered:  the memory throttle's wait message is the
                     #   only caller - see the note on 'remaining' and
                     #   'childFailMessage' in lcovutil::ForkManager
                     return scalar(@$worklist) + scalar(keys(%$pending));
                 },
                 # 'next' is the framework's dispatch loop, which this
                 #   scheduler does not use:  see above.
                 # The job list is built by '_segment_worklist' and
                 #   dispatched below.
                 next  => undef,
                 child => sub {
                     my ($jobs, $jobId) = @_;
                     return $self->_process_child($jobs, $jobId);
                 },
                 postFork => sub {
                     my ($jobs, $jobId) = @_;
                     print("forked $jobId current: ",
                           $self->_running(), " jobs:", scalar(@$joblist), "\n")
                         if $main::debugScheduler;
                 },
                 postStore => sub {
                     my ($jobs, $jobId, $dumpfile, $dumpStart) = @_;
                     printf("  %d: dump %d %d jobs %0.3fs %0.3fMb %s\n",
                            $jobId,
                            $$,
                            scalar(@$jobs),
                            Time::HiRes::gettimeofday() - $dumpStart,
                            (-f $dumpfile ? (-s $dumpfile) : 0) / (1024 * 1024),
                            DateTime->now()) if ($main::debugScheduler);
                 },
                 merge => sub {
                     my ($jobs, $jobId, $payload, $ctx) = @_;
                     $self->merge_child($jobs, $jobId, $payload, $ctx);
                 },
                 postReap => sub {
                     my $ctx = shift;
                     my $end = Time::HiRes::gettimeofday();
                     $lcovutil::profileData{segment}{$ctx->{id}} =
                         $end - $ctx->{forkAt};
                     $lcovutil::profileData{merge_segment}{$ctx->{id}} =
                         $end - $ctx->{reapAt};
                 },
                 requeue => sub {
                     my ($jobs, $jobId) = @_;
                     $self->_reschedule($jobId, $jobs);
                 },
                 forkFailWhen => sub { return "process segment $_[0]"; },
                 retryWhen    => sub {
                     my $ctx = shift;
                     return 'compute job ' .
                         $ctx->{id} . " (child $ctx->{child})";
                 },
                 mergeFailMessage => sub {
                     my $ctx = shift;
                     return
                         "unable to deserialize $ctx->{dumpfile}: $ctx->{error}";
                 },
                 childFailMessage => sub {
                     # also not covered:  a segment child which returns
                     #   non-zero and still leaves a readable dump - see note
                     #   in lcovutil::ForkManager
                     my $ctx = shift;
                     my $msg = 'compute job ' . $ctx->{id};
                     $msg .= ": unable to deserialize $ctx->{dumpfile}"
                         unless defined($ctx->{payload});
                     return $msg;
                 },);
    $self->[FORK_MGR] = $mgr;

    WORK:
    while ($mgr->count() ||
           @$joblist  ||
           @$worklist ||
           %$pending) {
        if (1 < $lcovutil::maxParallelism) {
            # wait here for child:
            #   - while we are oversubscribed
            #       - too many parallel jobs or
            #       - consuming too much memory), OR
            #   - if the worklist is empty and there are no jobs ready to
            #     go (these are jobs which failed and were reschedule - e.g.,
            #     due to out-of-memory).
            #     There are two possibilities:
            #       - there are pending jobs:
            #         they will be put on the worklist when their dependency
            #         finishes (at least one of those dependencies must be
            #         running now - we could go check that...)
            #       - there are no pending jobs:  so there must be just
            #         one remaining top-level job currently running -
            #         when it finishes, we are done.
            # Also do a nonblocking wait here to collect any children that
            #   have finished - so we have a better chance to parallelize
            #   more/have more tasks that we can dispatch
            print(" currentParallel:",
                  $mgr->count(), " pending:", scalar(%$pending), "\n")
                if ($main::debugScheduler > 1 ||
                    ($main::debugScheduler &&
                     0 == scalar(@$worklist) &&
                     0 == scalar(@$joblist)));
            my $reaped = 0;
            if (0 == scalar(@$worklist) && 0 == scalar(@$joblist)) {
                # nothing we could dispatch even if there was room:  wait for
                #   whatever is running to finish and unblock its dependents
                $reaped += $mgr->reap_one(1);
            } else {
                # about the job we would dispatch next, when there is one:  the
                #   worklist may not have been cut into jobs yet, and then there
                #   is nothing to weigh
                $reaped += $mgr->throttle(@$joblist ? @{$joblist->[-1]} : ());
            }
            # and collect anything else which has already finished, so we have
            #   more tasks to dispatch below
            while ($mgr->reap_one(0)) {
                ++$reaped;
            }
            print("reaped $reaped current:", $mgr->count(),
                  " jobs:", scalar(@$joblist),
                  " work:", scalar(@$worklist),
                  " pending:", scalar(%$pending),
                  "\n") if ($main::debugScheduler && $reaped);
            next WORK if $reaped;
        }
        # LCOV_EXCL_START
        unless (@$worklist || @$joblist) {
            foreach my $e (keys %$pending) {
                # something went wrong - print some debug data
                lcovutil::info("me: $e: depends\n");
                my $p = $pending->{$e};
                while (my ($k, $d) = each(%{$p->[1]})) {
                    lcovutil::info("  $k\n");
                    die("unexpected data for depend $k: $d") unless $d == 1;
                }
                lcovutil::info("   parent: " .
                               $p->[0]->[0] . ' ' .
                               join('/', @{$p->[0]->[2]}) . "\n");
            }
            # can get here if child process hit a 'die' (as opposed to an error)
            # and "--keep-going" was specified.
            die("unexpected empty worklist??");
        }
        # LCOV_EXCL_STOP

        # schedule a few items from the worklist if we can..
        $segmentID = $self->_segment_worklist($segmentID);

        while (@$joblist) {
            if (1 < $lcovutil::maxParallelism) {
                # need to wait here if insufficient resources
                #  (only wait until resource available - pending and
                #  worklist are managed above)
                # ..and the job we are about to take is the one to ask about, so
                #   that the memory estimate is for the work it really holds
                $mgr->throttle(@{$joblist->[-1]});
            }
            my $d = pop(@$joblist);
            my ($jobs, $jobId) = @$d;

            my $start = Time::HiRes::gettimeofday();
            foreach my $task (@$jobs) {
                # keep track of where this data is stored - need it later for
                #  top-level 'flat' view
                my $selfSummary = $task->[1];
                my $relDir      = $task->[2];
                my $fullDir     = $task->[3];
                $selfSummary->relativeDir($relDir);
                $selfSummary->fullDir($fullDir);
            }

            # distribute this job to parallel execution unless there is
            #   nothing else running.  In that case, we won't continue
            #   until this job is finished - so might as well do it
            #   locally and not incur parallelism overhead.
            if (1 < $lcovutil::maxParallelism &&
                ($mgr->count() > 0 ||
                    0 != scalar(@$joblist) ||
                    scalar(@$jobs) > 1)
            ) {
                $lcovutil::profileData{nJobs}{$jobId} = scalar(@$jobs);
                # a failed fork has already requeued this job - and slept, so
                #   that the next attempt has a chance of succeeding
                next unless $mgr->fork_one($jobs, $jobId);
            } else {
                #not parallel
                lcovutil::info(1, "serial execution of task $jobId\n")
                    if ($lcovutil::maxParallelism > 1);
                die("unexpected distribution") unless 1 == scalar(@$jobs);
                my ($task, $sSummary, $rel_dir, $full_dir_path,
                    $base_dir, $trunc_dir)
                    = @{$jobs->[0]};

                my ($type, $data, $short_path, $path, $parentData) = @$task;
                my ($selfSummary, $perTestData, $name) = @$data;
                die("inconsistent") unless $selfSummary == $sSummary;
                my ($parentSummary, $parentPerTestData, $parentPath);
                ($parentSummary, $parentPerTestData, $parentPath) =
                    @{$parentData->[0]->[1]}
                    unless 'top' eq $type;

                my $thisTestData =
                    compute_one($type, $name, $selfSummary, $parentSummary,
                                $perTestData, $rel_dir, $base_dir, $trunc_dir);

                $self->merge_one($parentPerTestData, $name,
                                 $thisTestData, $selfSummary,
                                 $parentSummary, $parentPath);
                my $end = Time::HiRes::gettimeofday();
                $lcovutil::profileData{$type}{$name} = $end - $start;
            }
        }    # while (job list not empty)
    }    # while (work remains)
        # the manager did the waiting, so it is the one which knows how long for
    $self->[DELAY_TIMER] = $mgr->delay_timer();
    # The manager's callbacks close over '$self', and '$self' holds the manager -
    #   so this reference cycle keeps the whole task graph, including the
    #   'File::Temp' child data directory, alive until global destruction.  We
    #   are done with the children, so break it here:  that releases the temp
    #   directory now, while 'temp_cleanup' can still take its parent away.
    $self->[FORK_MGR] = undef;
    $self->[TMPDIR]   = undef;
}

sub merge_child
{
    # One child's results, in the parent.  The manager has already reaped it,
    #   shown what it had to say and restored its payload;  what is left is
    #   ours.  Anything which throws here is reported once, by the manager, as
    #   'unable to deserialize <dumpfile>'.
    my ($self, $jobs, $jobId, $payload, $ctx) = @_;

    printf("  %d restore %d: %0.3fs %s (parallel %d)\n",
           $jobId, $ctx->{child}, Time::HiRes::gettimeofday() - $ctx->{reapAt},
           DateTime->now(), $self->_running())
        if $main::debugScheduler;

    my ($jobData, $countData, $otherData) = @$payload;

    die("error processing child")
        if (scalar(@$jobData) != scalar(@$jobs));

    $SourceFile::annotatedFiles += $countData->[0];
    $SourceFile::totalFiles     += $countData->[1];

    $lcovutil::profileData{startDelay}{$jobId} =
        $otherData->[0] - $ctx->{forkAt};
    $lcovutil::profileData{mergeDelay}{$jobId} =
        $ctx->{reapAt} - $otherData->[1];

    foreach my $t (@$jobs) {
        my $task = $t->[0];
        my ($type, $data, $short_path, $fullname, $parentData) = @$task;
        my ($childSummary, $perTestData, $name) = @$data;
        my ($parentSummary, $parentPerTestData, $parentPath);
        ($parentSummary, $parentPerTestData, $parentPath) =
            @{$parentData->[0]->[1]}
            unless 'top' eq $type;

        my $taskData = shift(@$jobData);
        # there was an error while processing the child
        die("error processing child " . scalar(@$taskData))
            if (scalar(@$taskData) != 4);

        my ($thisTestData, $pPerTestData, $summary, $criteria) = @$taskData;
        $childSummary->copyGuts($summary);
        $self->merge_one($parentPerTestData, $name, $thisTestData,
                         $childSummary, $parentSummary, $parentPath, 1);

        # and save the deserialized criteria data
        if (defined($criteria)) {
            my $name =
                $childSummary->type() eq 'top' ? "" :
                $childSummary->name();
            $CoverageCriteria::coverageCriteria{$name} = $criteria;
            $criteria->[1] = 0 if $criteria->[1] eq '';
            my $v = $criteria->[1];
            die('unexpected criteria data \'' . join(' ', @$criteria) . '\'')
                unless (Scalar::Util::looks_like_number($v));
            # criteria failure is sticky.
            #   The criteria of the merged jobs is independent.
            #   We want the parent to fail if any child fails (so don't
            #   change the parent flag unless it is to mark a fail.
            $CoverageCriteria::coverageCriteriaStatus = $v
                if $v != 0;
        }
    }    # foreach job
}

# Where the callgraph numbers of the header of a call site page lead.  There
#   the numbers count exactly the rows of the table below them - on the callees
#   page the call sites this file's functions contain, as everywhere else in the
#   report, and on the callers page the calls into this file's functions (see
#   'withCallgraphDestinations') - so the header leads into that table rather
#   than into the source view:  each number to the first row it counts.  This is
#   the table's own index of those rows, built as the page is, and it answers
#   the three questions the header asks of a SourceFile - see
#   SourceFile::nextCallgraphTlaGroup, nextCallgraphInDateBin and
#   nextCallgraphInOwnerBin - for the rows of the page instead of for the lines
#   of the file.
# The date and owner bins are those of the line each number is binned by:  on
#   the callees page the line a call is on, whichever function it is in, and on
#   the callers page the line the function it calls starts on - which is the
#   date and owner the Age and Owner columns of that page show.
# A number may have no row to lead to:  a site written in an '#include'd file
#   is counted in the header of that file and listed on the page of the file
#   which includes it.  The header then writes the number without a link - it is
#   not an error here, as it would be in the source view
package CallgraphPageIndex;

sub new
{
    my $class = shift;
    return bless({tla => {}, date => {}, owner => {}}, $class);
}

sub add
{
    # one row of the page, in page order:  its category, the annotation of the
    #   line it is binned by (or undef), and the anchor which leads to it
    my ($self, $tla, $annot, $anchor) = @_;
    $self->{tla}->{$tla} = $anchor unless exists($self->{tla}->{$tla});
    return unless defined($annot);
    my $date  = $annot->{bin} . "\0" . $tla;
    my $owner = $annot->{owner} . "\0" . $tla;
    $self->{date}->{$date}   = $anchor unless exists($self->{date}->{$date});
    $self->{owner}->{$owner} = $anchor
        unless exists($self->{owner}->{$owner});
}

sub locationHref
{
    my ($self, $anchor) = @_;
    return "#$anchor";
}

sub firstTlaGroup
{
    my ($self, $tla) = @_;
    return $self->{tla}->{$tla};
}

sub firstInDateBin
{
    my ($self, $bin, $tla) = @_;
    return $self->{date}->{$bin . "\0" . $tla};
}

sub firstInOwnerBin
{
    my ($self, $owner, $tla) = @_;
    return $self->{owner}->{$owner . "\0" . $tla};
}

